	NoVNoHBlend, NoVHPower, HueShiftFlip, HueTilling, HueSwitch2D3D, HueOffset, HueIntensity, HueShiftColor, HueShiftChannel, \
	float3(Hl0_FlowMin, Hl1_FlowMin, Hl2_FlowMin), float3(Hl0_EdgeLift, Hl1_EdgeLift, Hl2_EdgeLift), \
	float3(Hl0_Position, Hl1_Position, Hl2_Position), \
	float3(Hl0_UseNoiseOffset, Hl1_UseNoiseOffset, Hl2_UseNoiseOffset), \
	float3(Hl0_UseNoise, Hl1_UseNoise, Hl2_UseNoise), float3(Hl0_ScaleArea, Hl1_ScaleArea, Hl2_ScaleArea), \
	float3(Hl0_Scale, Hl1_Scale, Hl2_Scale), float3(Hl0_Width, Hl1_Width, Hl2_Width), \
	float3(Hl0_NoiseUpIntensity, Hl1_NoiseUpIntensity, Hl2_NoiseUpIntensity), \
	float3(Hl0_NoiseDownIntensity, Hl1_NoiseDownIntensity, Hl2_NoiseDownIntensity), \
	float3(Hl0_UseMiddleMute, Hl1_UseMiddleMute, Hl2_UseMiddleMute), \
	float3(Hl0_HighlightColorIntensity, Hl1_HighlightColorIntensity, Hl2_HighlightColorIntensity), \
	float3(Hl0_HighlightColorIntensity_Dark, Hl1_HighlightColorIntensity_Dark, Hl2_HighlightColorIntensity_Dark), \
	float3(Hl0_HairRimHiddenChannel, Hl1_HairRimHiddenChannel, Hl2_HairRimHiddenChannel), \
	float3(Hl0_HairMaskChannel, Hl1_HairMaskChannel, Hl2_HairMaskChannel), \
	Noise1_TilingU, Noise1_OffsetU, Noise1_Intensity, Noise2_TilingU, Noise2_OffsetU, Noise2_Intensity
#define WUWA_HV2R5_ARGS_D \
	EmissionColor, E_Motion_Emissive, SelectionColor, SkinSubsurfaceColor, SubsurfaceColor, RaytracingReflectionFix, \
