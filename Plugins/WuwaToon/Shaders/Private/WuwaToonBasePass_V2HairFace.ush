#define WUWA_HV2R5_ARGS_C \
	GameTime, WorldCameraOrigin, ClipToView00, LocalToWorldRow2, LocalToWorldRow3, \
	DamageIntensity, Damage_Skin_Intensity, SkinMin, SkinMax, UseFaceAni_SkinMask, \
	SkinColor, Damage_Dirty_SkinColorTint, Damage_Dirty_ColorTint, Damage_Dirty_Intensity, Damage_Skin_ColorTint, BaseColorTint, \
