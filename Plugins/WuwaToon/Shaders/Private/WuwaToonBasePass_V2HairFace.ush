// HLSL -> Kuro names as above, plus DisturebanceUVParameter -> "Disturebance UV Parameter", SparkleStep -> "step",
// SparkleStrengthFOV -> "SparkleStrength(FOV)"; Second_RotCos / Second_RotSin = CPU uniform expressions cos / sin(Second_Rotation * 2pi).
#define WUWA_HV2R5_P_SPARKLEMW \
	, Texture2D CommonNoiseMap, SamplerState CommonNoiseMapSampler, Texture2D DisturebanceNoise_Tex, SamplerState DisturebanceNoise_TexSampler, \
	Texture2D MilkWay_Tex, SamplerState MilkWay_TexSampler, float2 UV1, float2 UV2, float VertexColorB, float3 WorldTangent, \
	float TangentSign, float GameTime, float3 WorldCameraOrigin, float ClipToView00, float3 LocalToWorldRow2, float3 LocalToWorldRow3, \
	float SparkleChannel, float SparkleRange, float SparkleSoft, float SparkleBaseLuminance, float4 Sparkle_UV_Switch, float SparkleTiling, \
	float SparkleTimeSpeed, float SparkleIntensity, float SparkleIntensityMax, float SparkleColorful, float SparkleStep, float3 HueShiftValue, \
	float SparkleStrengthFOV, float UseSparkleFOVStrength, \
	float3 DisturebanceUVParameter, float DisturebanceNoise_Tilling, float MilkWay_Tilling_X, float MilkWay_Tilling_Y, \
	float HeightRatioInput, float MilkWay_Intensity, float3 MilkWay_Color, float MilkWay_RangeOffset, float MilkWay_RangePower, \
	float TopMask_Offset_MilkWay, float TopMask_Power_MilkWay, float MilkWayRimRange_SmoothMin, float MilkWayRimRange_SmoothMax, \
