	float2 UV0, float UV3X, WUWA_R4_P_GEOM_REST, WUWA_R4_P_MAT1, WUWA_R4_P_MAT2,
	float4 SDFColor, float4 SDFColor02, float ShakeNoiseInt, float UVpositionX, float UVpositionY, float UVScaleX, float UVScaleY,
	float XHRotCos, float XHRotSin, float XingHenControl, float SDFStart, float SoundWaveTiling01, float SoundWaveSpeed01, float SoundWaveInt01,
	float SoundWaveTiling02, float SoundWaveSpeed02, float SoundWaveInt02, float XHMax, float XingHenPosition,
	float CPD1, float CPD13, WUWA_R4_P_TAIL, float GameTime)
{
	float3 XHCol; float XHAlpha, XHW;
	WuwaBPXingHen(D, DSampler, Noise, NoiseSampler, Noise02, Noise02Sampler, UV0, UV3X, GameTime,
		SDFColor, SDFColor02, ShakeNoiseInt, UVpositionX, UVpositionY, UVScaleX, UVScaleY,
		XHRotCos, XHRotSin, XingHenControl, SDFStart, SoundWaveTiling01, SoundWaveSpeed01, SoundWaveInt01,
		SoundWaveTiling02, SoundWaveSpeed02, SoundWaveInt02, XHMax, XingHenPosition, XHCol, XHAlpha, XHW);
	return WuwaToonCommonBasePass_Impl(true, false, true, false, false, false, false, false,
		WUWA_R4_A_TEX_TM, UV0, UV3X, float4(0.0, 0.0, 0.0, 0.0), WUWA_R4_A_GEOM_REST, WUWA_R4_A_MAT1, 0.0, WUWA_R4_A_MAT2,
		WUWA_R4_A_NOSTOCK, WUWA_R4_A_TAIL, WUWA_R4_A_NOBREATH, 1.0,
		true, XHCol, XHAlpha, XHW, true, true, false, false, 1.0);
}

