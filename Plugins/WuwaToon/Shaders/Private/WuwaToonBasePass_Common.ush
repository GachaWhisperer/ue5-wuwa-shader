	float2 UV0, float UV3X, WUWA_R4_P_GEOM_REST, WUWA_R4_P_MAT1, float RampInt, WUWA_R4_P_MAT2, WUWA_R4_P_STOCK,
	float CPD1, float CPD13, float3 CPD_Knee1, float CPD17, float3 CPD_Knee2, float CPD21, WUWA_R4_P_TAIL)
