// =====================================================================================================================
// Round 6: Zanni skin Md20011 fur shells / UseFurryParallax (research/roster/round6/common.md). Same algorithms as the V2 fur
// helpers (WuwaToonBasePass_V2Body.ush: WuwaV2BodyParallaxUV, the UseFurry clip block, WuwaV2BodyApplyPDO, WuwaV2BodyPrimDither);
// copied here for M_Char_Com (that file is not included) with the M_Char_Com differences noted per function.
// =====================================================================================================================

// Kuro primitive screen dither (Primitive[43]); same formula as WuwaPrimDitherClip (WriteStencil.ush) / WuwaV2BodyPrimDither.
float WuwaBPFurPrimDither(float KuroPrimDitherEnable, float KuroPrimDitherFade, float2 SvPositionXY)
{
	float f = (0.0 < KuroPrimDitherEnable) ? saturate(KuroPrimDitherFade) : 1.0;
	bool  partial = (f < 1.0);
	float thr = (f + f) / (f + 1.0);
	float2 cell = floor(SvPositionXY * 0.25);
	float n = frac(dot(cell, float2(asfloat(0x3D897143u), asfloat(0x3BBF4590u))));   // 0.0671105608, 0.00583714992
	n = frac(n * asfloat(0x4253EE82u));                                             // 52.9829178
	thr = thr - n;
	return partial ? thr : 1.0;
}

// UseFurryParallax gate (PS __299207 l.80-85, __50708 l.97-102): vertex alpha in [0.4, 0.6] * UseVertexAMask.
float WuwaBPFurParallaxGate(float VertexColorA, float UseVertexAMask)
{
	precise float g = ((VertexColorA >= 0.4) ? 1.0 : 0.0) * ((0.6 >= VertexColorA) ? 1.0 : 0.0);
	return g * UseVertexAMask;
}

// UseFurryParallax ray march (PS __299207 l.86-167; __50708 l.103-196 precise; the custom-output chunks repeat it): the algorithm
// of WuwaV2BodyParallaxUV. h = Gate * Height * 0.01; off = -(T.V, B.V) / (N.V) * h; uvP0 = UV0 + off * (Plane - 1);
// steps = lerp(MaxStep, MinStep, min(|N.V|, 1)), floor(steps) + 2 iterations with the coarse screen derivatives of uvP0 for both
// SampleGrad reads (FlowmapMap .xy, HeightMap .r); the march height is faded by the vertex-normal rim smoothstep
// [ParallaxRimFadeMin, max(ParallaxRimFadeMax, 1e-4)] of normalize(WorldCameraOrigin - WorldPosition). M_Char_Com difference: the
// fade is also multiplied by (TypeMask.r(UV0, LOD MipBias) <= 0.9): FadeGate = Gate * that (l.115-119). Loop only where Gate == 1.
// Returns the UV of the material textures: UV0 + off * (Plane - 1) + accumulated offset / HeightMapSize.
float2 WuwaBPFurParallaxUV(Texture2D HeightMap, SamplerState HeightMapSampler, Texture2D FlowmapMap, SamplerState FlowmapMapSampler,
	float2 UV0, float3 T, float3 Bt, float3 Nv, float3 V, float3 WorldPosition, float3 WorldCameraOrigin, float GateP, float FadeGate,
	float Height, float Plane, float HeightMapSize, float MinStep, float MaxStep, float ParallaxRimFadeMin, float ParallaxRimFadeMax,
	float FlowmapScale, float FlowMapInt, float FurRootInv)
{
	const float FLTMAX = asfloat(0x7F7FFFFFu);
	float  h01 = min(Height * 0.01, FLTMAX);                                                   // preshader Height * 0.01
	float  K = min((1.0 - Plane) * -1.0, FLTMAX);                                              // preshader (1 - Plane) * -1
	float  kF = min(FlowmapScale / HeightMapSize, FLTMAX);                                     // preshader FlowmapScale / HeightMapSize
	float  rfMax = max(ParallaxRimFadeMax, asfloat(0x38D1B717u));                              // preshader max(Max, 0.0001)
	float  h = GateP * h01;
	float  tv = dot(T, V), bv = dot(Bt, V), nv = dot(Nv, V);
	float4 off = -float4(tv, bv, tv, bv) / nv;
	off = h * off;
	float4 o7 = off * float4(K, K, HeightMapSize, HeightMapSize);
	float2 uvP0 = off.xy * K + UV0;
	float  steps = min(abs(nv), 1.0) * (MinStep - MaxStep) + MaxStep;
	float  nsteps = floor(steps);
	float  inv = 1.0 / steps;
	float2 stepUV = inv * o7.zw;
	float2 dx = ddx_coarse(uvP0), dy = ddy_coarse(uvP0);
	float3 cv = WorldCameraOrigin - WorldPosition;
	cv = cv / sqrt(dot(cv, cv));
	float  rf = saturate((dot(Nv, cv) - ParallaxRimFadeMin) * (1.0 / (rfMax - ParallaxRimFadeMin)));
	rf = (rf * rf) * (rf * -2.0 + 3.0);
	float  fg = FadeGate * rf;
	float2 flowBase = UV0 * FlowmapScale + o7.xy;
	float2 acc = float2(0.0, 0.0);
	if (GateP == 1.0)
	{
		float limit = nsteps + 2.0;
		float fri = FurRootInv * -2.0 + 1.0;
		float cur = 1.0, prevL = 1.0, prevH = 1.0;
		[loop] for (int i = 0; ; ++i)
		{
			float fi = (float)i;
			if (fi >= limit)
				break;
			float2 su = stepUV * fi;
			float2 fuv = stepUV * kF + su * kF;
			fuv = flowBase + fuv;
			float2 fl = FlowmapMap.SampleGrad(FlowmapMapSampler, fuv, dx, dy).xy * 2.0 + -1.0;
			fl = fl * FlowMapInt;
			fl = inv * fl;
			float  hh = HeightMap.SampleGrad(HeightMapSampler, uvP0 * HeightMapSize + acc, dx, dy).r;
			float  hz = fg * hh;
			if (cur < hz)
			{
				float d1 = fg * hh - cur;
				float w  = d1 / (d1 + (prevL - prevH));
				acc = -w * (fl * fri + stepUV) + acc;
				break;
			}
			float2 su2 = o7.zw * inv + su;
			float  m = FurRootInv * (fi * -2.0 + limit) + fi;
			acc = m * fl + su2;
			prevL = cur;
			prevH = hz;
			cur = cur - inv;
		}
	}
	return (off.xy * K + acc / HeightMapSize) + UV0;
}

// UseFurry clip + material pixel depth offset (PS __64048 l.409-491; __50708 l.573-641; __316924 l.586-665): the V2 fur block with
// the vertex-alpha fur gate (UseVertexColor). fade = lerp(1, COLOR0.r, FurBlendUseVertexRFade); fur = Fur_Tex.r(UV2 * (FurTexU, 1) (UV2 = TEXCOORD1.xy, l.424),
// bias MipBias + FurTexBias) * (1 - fade * sat(|N_vertex . normalize(WorldCameraOrigin - WorldPosition)| * FurRangeStep +
// FurRangeStepOffset)) [* lerp(1, smoothstep(MIN, MAX, (TwoSidedSign * cross(N, T)) . V), fade) with UseTangentClip];
// dither = (DitherTemporalAA pattern + noise) / 6 (precise divide); clip = gate ? fur * FurAlphaIntensity + dither - 0.5 : 1 with
// gate = (0.25 >= lerp(1, COLOR0.a, UseVertexColor)), then lerp(clip, clip * t, UseMainTexAlpha) with t = saturate(opacity)
// (FurClip 2) or, UseTranslucent (FurClip 1), saturate(dither + lerp(TranslucentDitherVaule, 1, opacity) - 0.5); discard when
// min(clip - 0.3333, Kuro primitive dither) < 0. Returns PDO = ((dither + 0.5) - 0.5) * FurBlendIntensity * fade * gate.
float WuwaBPFurClip(const uint FurClip, const bool bTangentClip,
	Texture2D Fur_Tex, SamplerState Fur_TexSampler, float2 UV2, float FurTexU, float FurTexBias, float MaterialTextureMipBias,
	float VertexColorR, float VertexColorA, float FurBlendUseVertexRFade, float UseVertexColor,
	float3 Nv, float3 T, float TwoSidedSign, float3 V, float3 WorldPosition, float3 WorldCameraOrigin,
	float FurRangeStep, float FurRangeStepOffset, float FurTangentMin, float FurTangentMax,
	Texture2D DitherNoise, SamplerState DitherNoiseSampler, float2 SvPositionXY, float2 ViewRectMin, float TemporalAAParamsX,
	float FurAlphaIntensity, float OpacityBase, float TranslucentDitherVaule, float UseMainTexAlpha, float FurBlendIntensity,
	float KuroPrimDitherEnable, float KuroPrimDitherFade)
{
	precise float fade = (VertexColorR + -1.0) * FurBlendUseVertexRFade + 1.0;
	float  ft = Fur_Tex.SampleBias(Fur_TexSampler, UV2 * float2(FurTexU, 1.0), MaterialTextureMipBias + FurTexBias).r;
	float3 cv = WorldCameraOrigin - WorldPosition;
	cv = cv / sqrt(dot(cv, cv));
	float  rs = saturate(abs(dot(Nv, cv)) * FurRangeStep + FurRangeStepOffset);
	ft = ft * (fade * -rs + 1.0);
	if (bTangentClip)   // UseTangentClip (PS __64048 l.409-418, 422-423)
	{
		float3 sT  = TwoSidedSign * T;
		float3 tcv = Nv.yzx * sT.zxy - sT.yzx * Nv.zxy;
		float  tct = saturate((dot(tcv, V) - FurTangentMin) * (1.0 / (FurTangentMax - FurTangentMin)));
		float  tcs = (tct * tct) * (tct * -2.0 + 3.0) + -1.0;
		ft = (fade * tcs + 1.0) * ft;
	}
	precise float2 fpp = SvPositionXY - ViewRectMin;
	uint2  fpq = (uint2)(fpp + TemporalAAParamsX);
	precise float fdz = DitherNoise.SampleBias(DitherNoiseSampler, fpp / 64.0, MaterialTextureMipBias).r + (float)(((fpq.y << 1) + fpq.x) % 5u);
	precise float dz6 = fdz / 6.0;
	float  cl = ft * FurAlphaIntensity + dz6;
	precise float va = (VertexColorA + -1.0) * UseVertexColor + 1.0;
	float  gate = (0.25 >= va) ? 1.0 : 0.0;
	cl = gate * (cl + -1.5) + 1.0;
	float  t;
	if (FurClip == 1u)   // UseTranslucent (PS __50708 l.596-599): saturate(dither + lerp(TranslucentDitherVaule, 1, opacity) - 0.5)
	{
		float  u = OpacityBase * (1.0 - TranslucentDitherVaule) + TranslucentDitherVaule;
		t = saturate((dz6 + u) + -0.5);
	}
	else                 // PS __64048 l.451: saturate(opacity)
		t = saturate(OpacityBase);
	cl = UseMainTexAlpha * (cl * t - cl) + cl;
	precise float pd = dz6 + 0.5;
	pd = pd + -0.5;
	pd = pd * FurBlendIntensity;
	precise float fg = fade * gate;
	precise float om = cl + asfloat(0xBEAAA64Cu);                                                      // -0.3333
	if (min(om, WuwaBPFurPrimDither(KuroPrimDitherEnable, KuroPrimDitherFade, SvPositionXY)) < 0.0)
		discard;
	return fg * pd;
}

// UE 4.26 ApplyPixelDepthOffsetToMaterialParameters as compiled in the Kuro PS (PS __64048 l.459-473; = WuwaV2BodyApplyPDO): device
// depth with the material pixel depth offset (orthographic gate |w - 1| <= 1e-5), clamped to SvPosition.z, the offset recomputed
// from the clamped depth and the world position moved along the camera vector. The original evaluates the GBuffer custom outputs
// (shadow factor, shadow colour, opacity / rim byte, GBufferD) and the OutOfBoundsMask debug colour after this, at the moved position.
void WuwaBPApplyPDO(float PDO, float2 SvPositionZW, float3 CameraVector, float3 WorldPosition, float3 PreViewTranslation,
	out float3 WorldPositionPDO, out float3 TranslatedWorldPositionPDO)
{
	precise float sz = SvPositionZW.x * SvPositionZW.y;                                                // ScreenPosition.z
	precise float sw = 1.0 * SvPositionZW.y;                                                           // ScreenPosition.w
	precise float ortho = ((sw >= asfloat(0x3F7FFF58u)) ? 1.0 : 0.0) * ((asfloat(0x3F800054u) >= sw) ? 1.0 : 0.0);
	precise float pdo = (1.0 - ortho) * PDO;
	precise float d = min(sz / (pdo + sw), SvPositionZW.x);
	precise float pc = (-(sw * d) + sz) / d;
	precise float3 mv = pc * CameraVector;
	WorldPositionPDO = WorldPosition + mv;
	TranslatedWorldPositionPDO = WorldPositionPDO + PreViewTranslation;
}

// _Impl argument lists with a substituted material-texture UV, world position (post-PDO pass) and emissive-scale / OOB inputs
// (pass 1 returns the raw emissive: skip 1, OOB 0; the entry applies WuwaBPFinalEmissive at the post-PDO position).
#define WUWA_R6_A_GEOM(WP, TWP) WorldTangent, WorldNormal, TangentSign, WP, TWP, CameraVector, LightDirVS, MotionEmissiveMask
#define WUWA_R6_A_TAIL(SKIP, OOB) \
	MPC_GlobalCharSkyLightIntensity, MPC_GlobalCharacterAmbientSkinColor, MPC_GlobalCharacterDebugLightDirection, \
	ToonLight0, ToonLight1, ToonLight2, ToonLight3, \
	TranslatedWorldToView, MaterialTextureMipBias, NormalOverrideParameter, KuroGBufferMode, \
	KuroEmissiveScale, SKIP, OOB, ObjectWorldPosition, ObjectBounds, LightingChannelMask
#define WUWA_R6_A_FUR(UV, WP, TWP, SKIP, OOB) WUWA_R4_A_TEX_TM, UV, UV3X, float4(0.0, 0.0, 0.0, 0.0), WUWA_R6_A_GEOM(WP, TWP), \
	WUWA_R4_A_MAT1, RampInt, WUWA_R4_A_MAT2, WUWA_R4_A_STOCK, WUWA_R6_A_TAIL(SKIP, OOB)
// trailing _Impl arguments: no breath, TwoSidedSign 1 (N2 one-sided), no XingHen, bPowEps, bNoDoubleSpec off, bAllRampColor off,
// bAniSwitchShadow + Dark, then bHET .. bNoNormalMap off, bAniMaskDecode off, FurForms, bNmapIn + NmapIn
#define WUWA_R6_A_FURTAIL(BANI, NMIN, NM) WUWA_R4_A_NOBREATH, 1.0, WUWA_R4_A_NOXH, false, false, BANI, AniSwitch_ShadowColorDark, \
	false, false, false, float3(0.0, 0.0, 0.0), false, 0.0, false, 0.0, false, false, 0.0, 0.0, Forms, NMIN, NM

// Shared body of the UseFurry entries: two _Impl passes as the Kuro PS evaluates them -
//   pass 1 (main chain, `precise`, pre-PDO; Forms = the map's WUWA_R6F_* expression orders, used by both passes): emissive (raw)
//   and GBufferC.rgb; then the fur clip (discard) and the pixel depth offset;
//   pass 2 (GBuffer custom-output chain, post-PDO world position; with UseFurryParallax its own ray march at that position and the
//   material textures re-sampled at that UV, the shading normal of pass 1): GBufferA.z, GBufferB, GBufferC.a, GBufferD; the
//   OutOfBoundsMask debug colour of the emissive uses the post-PDO position too.
// Inputs = the Down signature (TypeMask band / stocking inputs; entries without stocking pass neutral values that fxc drops) +
// AniSwitch_ShadowColorDark + fur + parallax inputs. OpacityMask = 1 (the entry discards itself); PixelDepthOffset = the material
// pixel depth offset (UE applies it to the depth; the port applies it to the world position of pass 2 itself).
FWuwaToonGBuffer WuwaToonCommonBasePass_FurImpl(const bool bStocking, const bool bRampMask, const bool bNoSkinRampC,
	const bool bAniSwitchShadow, const bool bParallax, const uint FurClip, const bool bTangentClip, const uint Forms,
	WUWA_R4_P_TEX_TM, float2 UV0, float UV3X, WUWA_R4_P_GEOM_REST, WUWA_R4_P_MAT1, float RampInt, WUWA_R4_P_MAT2, WUWA_R4_P_STOCK,
	float CPD1, float CPD13, float3 CPD_Knee1, float CPD17, float3 CPD_Knee2, float CPD21, WUWA_R4_P_TAIL, float AniSwitch_ShadowColorDark,
	float VertexColorR, float VertexColorA, float2 UV2, float3 WorldCameraOrigin, float3 PreViewTranslation, float2 SvPositionXY,
	float2 SvPositionZW, float2 ViewRectMin, float TemporalAAParamsX, float TwoSidedSign,
	Texture2D Fur_Tex, SamplerState Fur_TexSampler, Texture2D DitherNoise, SamplerState DitherNoiseSampler,
	float FurTexU, float FurTexBias, float FurBlendUseVertexRFade, float UseVertexColor, float FurRangeStep, float FurRangeStepOffset,
	float FurTangentMin, float FurTangentMax, float FurAlphaIntensity, float TranslucentDitherVaule, float UseMainTexAlpha,
	float FurBlendIntensity, float KuroPrimDitherEnable, float KuroPrimDitherFade,
	Texture2D HeightMap, SamplerState HeightMapSampler, Texture2D FlowmapMap, SamplerState FlowmapMapSampler, float Height,
	float UseVertexAMask, float Plane, float HeightMapSize, float MinStep, float MaxStep, float ParallaxRimFadeMin, float ParallaxRimFadeMax,
	float FlowmapScale, float FlowMapInt, float FurRootInv,
	out float OpacityMask, out float PixelDepthOffset)
{
	float3 TangentY = cross(WorldNormal, WorldTangent) * TangentSign;
	float2 UVP = UV0;
	float  gate = 0.0, fgate = 0.0;
	if (bParallax)
	{
		gate = WuwaBPFurParallaxGate(VertexColorA, UseVertexAMask);
		float tmF = (0.9 >= TypeMask.SampleLevel(TypeMaskSampler, UV0, MaterialTextureMipBias).r) ? 1.0 : 0.0;
		fgate = gate * tmF;
		UVP = WuwaBPFurParallaxUV(HeightMap, HeightMapSampler, FlowmapMap, FlowmapMapSampler, UV0, WorldTangent, TangentY, WorldNormal,
			CameraVector, WorldPosition, WorldCameraOrigin, gate, fgate, Height, Plane, HeightMapSize, MinStep, MaxStep,
			ParallaxRimFadeMin, ParallaxRimFadeMax, FlowmapScale, FlowMapInt, FurRootInv);
	}
	FWuwaToonGBuffer G1 = WuwaToonCommonBasePass_Impl(true, bStocking, bRampMask, bNoSkinRampC, false, false, false, false,
		WUWA_R6_A_FUR(UVP, WorldPosition, TranslatedWorldPosition, 1.0, 0.0), WUWA_R6_A_FURTAIL(bAniSwitchShadow, false, float3(0.0, 0.0, 0.0)));
	float A = MainTex.SampleBias(MainTexSampler, UVP, MaterialTextureMipBias).a * OpacityIntensity;
	PixelDepthOffset = WuwaBPFurClip(FurClip, bTangentClip, Fur_Tex, Fur_TexSampler, UV2, FurTexU, FurTexBias, MaterialTextureMipBias,
		VertexColorR, VertexColorA, FurBlendUseVertexRFade, UseVertexColor, WorldNormal, WorldTangent, TwoSidedSign, CameraVector,
		WorldPosition, WorldCameraOrigin, FurRangeStep, FurRangeStepOffset, FurTangentMin, FurTangentMax,
		DitherNoise, DitherNoiseSampler, SvPositionXY, ViewRectMin, TemporalAAParamsX,
		FurAlphaIntensity, A, TranslucentDitherVaule, UseMainTexAlpha, FurBlendIntensity, KuroPrimDitherEnable, KuroPrimDitherFade);
	OpacityMask = 1.0;
	float3 WPm, TWPm;
	WuwaBPApplyPDO(PixelDepthOffset, SvPositionZW, CameraVector, WorldPosition, PreViewTranslation, WPm, TWPm);
	float2 UVP2 = UV0;
	float3 Nm1 = float3(0.0, 0.0, 0.0);
	if (bParallax)
	{
		UVP2 = WuwaBPFurParallaxUV(HeightMap, HeightMapSampler, FlowmapMap, FlowmapMapSampler, UV0, WorldTangent, TangentY, WorldNormal,
			CameraVector, WPm, WorldCameraOrigin, gate, fgate, Height, Plane, HeightMapSize, MinStep, MaxStep,
			ParallaxRimFadeMin, ParallaxRimFadeMax, FlowmapScale, FlowMapInt, FurRootInv);
		// the main chain's normal-map term (same expressions as _Impl at UVP)
		float4 NRM1 = Normal_Roughness_Metallic.SampleBias(Normal_Roughness_MetallicSampler, UVP, MaterialTextureMipBias);
		float2 nxy1 = (NRM1.xy * 2.0 + -1.0) * NormalStrength;
		Nm1 = TangentY * nxy1.y;
		Nm1 = nxy1.x * WorldTangent + Nm1;
		Nm1 = Nm1 + WorldNormal;
	}
	FWuwaToonGBuffer G2 = WuwaToonCommonBasePass_Impl(true, bStocking, bRampMask, bNoSkinRampC, false, false, false, false,
		WUWA_R6_A_FUR(UVP2, WPm, TWPm, KuroSkipEmissiveScale, OutOfBoundsMask), WUWA_R6_A_FURTAIL(bAniSwitchShadow, bParallax, Nm1));
	FWuwaToonGBuffer G;
	G.Emissive = WuwaBPFinalEmissive(G1.Emissive, KuroSkipEmissiveScale, KuroEmissiveScale, OutOfBoundsMask, WPm, ObjectWorldPosition, ObjectBounds);
	G.A = G2.A;
	G.B = G2.B;
	G.C = float4(G1.C.rgb, G2.C.a);
	G.D = G2.D;
	return G;
}

