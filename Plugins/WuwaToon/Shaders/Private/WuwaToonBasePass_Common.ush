// =====================================================================================================================
// Round 4 (research/roster/Port_CharCom_Coverage.md#round-4): more M_Char_Com body variants, all as combinations of the
// verified compile-time switches plus the round-4 trailing switches of _Impl (bNoDoubleSpec, bAllRampColor,
// bAniSwitchShadow). Signatures reuse the existing entry signatures (same names / order) plus appended inputs; the
// WUWA_R4_* macros only spell the shared parameter / argument lists once.
// =====================================================================================================================
#define WUWA_R4_P_TEX_TM \
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler, Texture2D TypeMask, SamplerState TypeMaskSampler, \
	Texture2D MainTex, SamplerState MainTexSampler, Texture2D MatCapTex, SamplerState MatCapTexSampler, Texture2D Ramp, SamplerState RampSampler
