// WuwaToonBasePass_Common.ush — M_Char_Com base pass, MSM_ToonCommon (GBufferB id 12).
//
// Permutations (research/shaders/ToonCommon.md §7):
//   WuwaToonCommonBasePass_BodyUp : Body + Up MIs (both resolve to shader map 735ACC98; vertex-colour band mask)
//   WuwaToonCommonBasePass_Down   : Down MI (map D3C56258; static switches UseStocking + UseTypeMask)
// Line refs: B### = Body PS __215096.asm.txt, D### = Down PS __85731.asm.txt (research/hlsl/ToonCommon_BasePass.hlsl).
//
// UE wiring notes (see Specs/ToonCommon_*.json):
//   WorldTangent / WorldNormal / TangentSign = the raw interpolated TEXCOORD10 / TEXCOORD11 (Kuro does not renormalise
//     them; UE's Parameters.TangentToWorld rows are the same vectors).
//   LightDirVS / MotionEmissiveMask = WuwaToonBaseVS_LightDir / WuwaToonBaseVS_WPO through Vertex Interpolators.
//   CameraVector = UE CameraVector (= Kuro rsqrt(dot(-TWP,-TWP)) * -TWP).
#pragma once

#include "WuwaToonBasePassShared.ush"

float WuwaBPSmooth(float x) { float k = x * -2.0 + 3.0; return (x * x) * k; }   // mad(x,-2,3), x*x, mul

// Round 6 (UseFurry / UseFurryParallax M_Char_Com maps, research/roster/round6/common.md). The fur maps compile the material chain
// `precise` (pixel depth offset); a few sums / products then keep their source association where every other map shows fxc's
// re-associated form. FurForms bits of WuwaToonCommonBasePass_Impl (0 = the verified non-fur forms):
#define WUWA_R6F_SPOT 1u   // toon spot term min((1 - spot^2) + distFrac, 1) (WuwaBPMainLightDirP; PS __64048 l.202-205), not (-spot^2 + distFrac) + 1
#define WUWA_R6F_HL   2u   // half-Lambert (N2.L * 0.5 + 0.5) + shadow offset (l.262-265, 580-583), not (N2.L * 0.5 + so) + 0.5
#define WUWA_R6F_SPEC 4u   // toon specular ((SpecPow + 2) * 1/2pi) * (SpecPow * S) (PS __64048 only: l.305-311, 686-687), not ((SpecPow * S) * (SpecPow + 2)) * 1/2pi
#define WUWA_R6F_P    7u   // all of the above (both chains of PS __64048; __50708 / __316924 use SPOT | HL)
#define WUWA_R6F_RAMPU 8u  // ramp U = sat((rp - threshold) + 0.5) (custom-output chain of PS __299207 l.583-584), not sat((rp + 0.5) - threshold)

// Copy of WuwaBPMainLightDir (WuwaToonBasePassShared.ush, read-only) with the precise source-order spot term (WUWA_R6F_SPOT): PS
// __64048 l.156-223 (as WuwaV2BodyMainLightDir(bSpotP = true) of the V2 fur maps). Same arguments.
float3 WuwaBPMainLightDirP(float LightOffset_Pitch,
	float3 MPC_GlobalCharacterAmbientSkinColor, float3 MPC_GlobalCharacterDebugLightDirection,
	float4 ToonLight0, float4 ToonLight1, float4 ToonLight2, float4 ToonLight3,
	float3 ObjectWorldPosition, float3 WorldPosition, float3 LocalLightTarget,
	float CPD13, float CPD1, float3 LightDirVS)
{
	float  absPitch  = abs(LightOffset_Pitch);
	float  pitchLerp = saturate(absPitch / asfloat(0x42340000u | (asuint(absPitch) >> 31)));   // CPU preshader: true divide by 45
	float  pitchOn = (absPitch >= 0.5) ? 1.0 : 0.0;
	float3 Lmpc = (MPC_GlobalCharacterAmbientSkinColor - MPC_GlobalCharacterDebugLightDirection) * pitchLerp;
	Lmpc = pitchOn * Lmpc + MPC_GlobalCharacterDebugLightDirection;
	Lmpc = Lmpc / sqrt(dot(Lmpc, Lmpc));
	float3 anchor   = ObjectWorldPosition + float3(0.0, 0.0, 100.0);
	float3 toAnchor = ToonLight0.xyz - anchor;
	float3 toTarget = ToonLight0.xyz - LocalLightTarget;
	float3 Lpt = CPD13 * (toTarget - toAnchor) + toAnchor;
	Lpt = Lpt / sqrt(dot(Lpt, Lpt));
	float3 dA = anchor - ToonLight0.xyz;
	float  distFrac = saturate(sqrt(dot(dA, dA)) * ToonLight0.w);
	float  type = (float)((asuint(ToonLight1.w) >> 16) & 3u);
	float  isT1 = min((1.1 >= type) ? 1.0 : 0.0, (type >= 0.9) ? 1.0 : 0.0);
	float  isT2 = min((2.1 >= type) ? 1.0 : 0.0, (type >= 1.9) ? 1.0 : 0.0);
	float  typeF = isT2 * (-isT1 * 0.5 + 1.0) + isT1 * 0.5;
	float3 toPixel = ToonLight0.xyz - WorldPosition;
	float3 dirL = toPixel * (1.0 / sqrt(dot(toPixel, toPixel)));
	dirL = dirL / sqrt(dot(dirL, dirL));
	float3 axis = ToonLight1.xyz / sqrt(dot(ToonLight1.xyz, ToonLight1.xyz));
	float  spot = saturate((dot(dirL, axis) - ToonLight2.x) * ToonLight2.y);
	precise float sq = 1.0 - spot * spot;
	float  spotTerm = min(sq + distFrac, 1.0);
	float  isSpot = max(typeF * 2.0 - 1.0, 0.0);
	float  blend  = isSpot * (spotTerm - distFrac) + distFrac;
	float3 Lt = blend * (Lmpc - Lpt) + Lpt;
	float3 L  = ToonLight3.z * (Lt - Lmpc) + Lmpc;
	float  vsW = saturate(CPD1);
	L = vsW * (LightDirVS - L) + L;
	return L / sqrt(dot(L, L));
}

// Round 7: UseIDColor base tint (PS __104587 l.38-57). The weights are the WuwaBPBandClassify band indicators of the TypeMask.r
// classifier c (exactly one is 1, the others 0, so the sum is exact in any order): w0 = c <= 0.05, w1 = (0.05, 0.3], w2 = (0.3, 0.5],
// w3 = (0.5, 0.9] (= BandMask), w4 = skin band. Sum in the original's order ((C1 w0 + C2 w1) + C3 w2) + (C4 w3 + C5 w4).
float3 WuwaBPIDTint(float c, float3 C1, float3 C2, float3 C3, float3 C4, float3 C5)
{
	float BandMask;
	float w4 = WuwaBPBandClassify(c, BandMask);
	float w0 = (0.05 >= c) ? 1.0 : 0.0;
	float w1 = (0.05 >= c) ? 0.0 : (((c >= 0.05) ? 1.0 : 0.0) * ((0.3 >= c) ? 1.0 : 0.0));
	float w2 = (1.0 - w1) * (((c >= 0.3) ? 1.0 : 0.0) * ((0.5 >= c) ? 1.0 : 0.0));
	float3 t = C1 * w0 + C2 * w1;
	t = t + C3 * w2;
	return t + (C4 * BandMask + C5 * w4);
}

// Compile-time switches (Yangyang entries: BodyUp = false/false/false, Down = true/true/false; asm-identical to the
// pre-roster single bDown flag, re-verified). Roster variants: research/roster/Port_CharCom_Coverage.md.
//   bTypeMask (UseTypeMask)  band/skin classifier from TypeMask.r (SampleLevel at the View mip bias), no COLOR0
//   bStocking (UseStocking)  Down: band-widened shadow step, stocking/anisotropy/knee block, PBRBase composite
//   bRampMask (UseRampMask)  ramp weight = (sky >= 0.05) * TypeMask.g instead of * RampInt   (PS __155992 l.309-311)
//   bNoSkinRampC (UseSkinAllRampColor off, PS __299247 l.290-299): GBufferC = desaturate(Lit * Bright) without the skin ramp
//                blend (the ramp still feeds the shadow colour)
//   bBreath      (UseBreathLight, PS __25708 l.256-268): the MainTex.a emission breathes with EmissionStrength *
//                BreatheStrength * (cos(GameTime * BreatheFrequency) + BreathePropotion) unless SpecPart <= EmissionBreathThreshold
//   bNoRamp      (UseRampColor off, PS __118018): no Ramp texture; GBufferC = desaturate(Lit * Bright), shadow colour =
//                desaturate(skin-lerped subsurface colour)
//   bTwoSided    (two-sided MI, PS __79737 l.41-43, 78-79): the shading normal uses N * TwoSidedSign
//                (Kuro View[147].w * Primitive[4].w * (front ? 1 : -1) = UE Parameters.TwoSidedSign)
//   bNoVDL       (UseVDLShadowoffset off, PS __118018 l.168-178): shadow threshold = ShadowProcess (no view-dependent
//                Front/BackShadowProcessOffset term)
//   bXingHen     (UseXingHen, round 3, PS __68245 l.296-396, 418-456): the XingHen star-mark colour XHCol (WuwaBPXingHen)
//                replaces the PBR metal highlight in the emissive and the lit colour in GBufferC, weighted by
//                XHW * XHAlpha. Trailing defaulted parameters: existing callers are unchanged.
//   bPowEps      the 'x <= 0 ? 0 : pow' guards (roughness, shadow offset, stocking anisotropy) compare against
//                0x33000002 (2.98e-8) as every original does. Default true since round 3b (coordinator decision; the
//                pre-round-3 entries changed asm and were re-verified); false reproduces the older 0.0 guard only for A/B tests
FWuwaToonGBuffer WuwaToonCommonBasePass_Impl(const bool bTypeMask, const bool bStocking, const bool bRampMask, const bool bNoSkinRampC,
	const bool bBreath, const bool bNoRamp, const bool bNoVDL, const bool bTwoSided,
	// ---- textures (each with its own sampler; SSM_FromTextureAsset) ----
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler,
	Texture2D TypeMask, SamplerState TypeMaskSampler,
	Texture2D MainTex, SamplerState MainTexSampler,
	Texture2D MatCapTex, SamplerState MatCapTexSampler,
	Texture2D Ramp, SamplerState RampSampler,
	// ---- interpolants ----
	float2 UV0, float UV3X, float4 VertexColor, float3 WorldTangent, float3 WorldNormal, float TangentSign,
	float3 WorldPosition, float3 TranslatedWorldPosition, float3 CameraVector, float3 LightDirVS, float MotionEmissiveMask,
	// ---- material parameters (M_Char_Com names) ----
	float3 SkinColor, float3 BaseColorTint, float3 EmissionColor, float3 E_Motion_Emissive, float4 SelectionColor,
	float3 SkinSubsurfaceColor, float3 SubsurfaceColor, float LightOffset_Pitch, float NormalStrength, float RaytracingReflectionFix,
	float DefaultSkinFactor, float UseSkinMask_DYN, float UseFaceAni_SkinMask, float MetallicIntensityDebug, float RoughnessIntensityDebug,
	float MetalSpecularPower, float SpecularPower, float ShadowProcess, float FrontShadowProcessOffset, float BackShadowProcessOffset,
	float ShadowWidth, float OpacityIntensity, float DecodeShadowThreshold, float DecodeSpecThreshold, float SolidShadowProcess,
	float ShadowOffsetAdjustFactor, float ShadowOffsetPower, float MaskShadowOffsetStrength, float SolidShadowWidth,
	float PBRRateIntensity, float MetalEmissionStrength, float MetalMatCapBack, float MatCapInt, float MetalMatCapInt,
	float AniSwitch_ShadowColorBright, float SolidShadow_RampPosition, float RampPosition, float RampInt, float Desaturation,
	float SolidShadowStrength, float ToonRimWidth, float SSAOSkinIntensity, float SSAOIntensity, float FFTIntensity,
	// ---- Down-only material parameters ----
	float3 AnistropyColor, float3 StockingKnee_Color, float3 StockingColor, float3 StockingEdgeColor, float3 StockingLightColor,
	float AnistropyInt, float AnistropyNormalInt, float StockingKnee_MaskRadius, float StockingKnee_CurvatureRange,
	float StockingKnee_BlendRange, float StockingRangeMax, float StockingRangeMin, float StockingIntensity,
	float StockingLightRangeMax, float StockingLightRangeMin, float UseIDBMaskInStockingLight,
	// ---- CustomPrimitiveData ----
	float CPD1, float CPD13, float3 CPD_Knee1, float CPD17, float3 CPD_Knee2, float CPD21,
	// ---- MPC_GlobalShaderParameters ----
	float MPC_GlobalCharSkyLightIntensity, float3 MPC_GlobalCharacterAmbientSkinColor, float3 MPC_GlobalCharacterDebugLightDirection,
	// ---- ToonShadowLightData (CB1) ----
	float4 ToonLight0, float4 ToonLight1, float4 ToonLight2, float4 ToonLight3,
	// ---- View / Primitive ----
	float4x4 TranslatedWorldToView, float MaterialTextureMipBias, float4 NormalOverrideParameter, float KuroGBufferMode,
	float3 KuroEmissiveScale, float KuroSkipEmissiveScale, float OutOfBoundsMask, float3 ObjectWorldPosition, float3 ObjectBounds,
	uint LightingChannelMask,
	float GameTime, float BreatheStrength, float BreatheFrequency, float BreathePropotion, float EmissionStrength, float EmissionBreathThreshold,
	float TwoSidedSign,
	const bool bXingHen = false, float3 XHCol = float3(0.0, 0.0, 0.0), float XHAlpha = 0.0, float XHW = 0.0,
	const bool bPowEps = true,
	// ---- Round 4 (trailing defaulted parameters; every earlier call site is unchanged and asm-identical) ----
	//   bNoDoubleSpec    UseDoubleSpecular off (PS __214913 / __190072 / __9798): the toon specular uses saturate(dot(N2, H))
	//                    for every pixel (no shadow-mirrored light, no IsMetal lerp to NoH1)
	//   bAllRampColor    UseAllRampColor (PS __37287 / __314618): GBufferC = desaturate(0.5 * (RampW * (Ramp - Lit * Bright)
	//                    + 2 * Lit * Bright)), no skin lerp
	//   bAniSwitchShadow UseAniSwitchShadow (PS __170739 / __295986 / __262959): TypeMask.a (a) and s = (ShadowColorDark >= 0.95):
	//                    shadow *= solid * (s * (1 - a) + a); Lit*Bright -> lerp(Lit*Dark, Lit*Bright, a); the solid ratio
	//                    used by the ramp U and GBufferA.z becomes s * (R - R*a) + a*R
	const bool bNoDoubleSpec = false, const bool bAllRampColor = false, const bool bAniSwitchShadow = false,
	float AniSwitch_ShadowColorDark = 1.0,
	//   bHET             IsHairHET on a body MI (PS __212568 l.502-510): mode-1 GBufferC.a = opacity byte with LSB 1
	//                    ((round_ni(min(max(A, 0), 1) * 255 + 0.5) | 1) / 255, as the hair HETA redraw) instead of the rim byte
	const bool bHET = false,
	//   bNoPBR           UsePBR off (PS __144444): no specular / matcap / metal: lit colour = base colour, emissive without the
	//                    metal highlight, mode-0 GBufferD.y = 240/255 and the FFT nibble = the hair formula (only negative FFTIntensity)
	const bool bNoPBR = false,
	// ---- Round 5 (trailing defaulted parameters; every earlier call site is unchanged and asm-identical) ----
	//   bSecond          UseSecond + UseEffectMaterial (PS __240571 l.295-336): the Second-layer colour SecondC (WuwaBPSecond:
	//                    rotated / scrolled / refined Second_RGB x R_Noise_A_Mask effect mask) is added together with the motion
	//                    emissive: Emissive + (MotionEmissiveMask * E_Motion_Emissive + SecondC); the FFT nibble sees it too
	const bool bSecond = false, float3 SecondC = float3(0.0, 0.0, 0.0),
	//   bAniLitW         AniSwitch dark/bright lit colour without UseAniSwitchShadow (PS __105818 l.416-424): Lit*Bright ->
	//                    lerp(Lit*Dark, Lit*Bright, AniLitW) for GBufferC only (AniLitW = MaskTex.b of the AniSwitch 2x4 atlas cell,
	//                    sampled by the wrapper); shadow / ramp / GBufferA.z unchanged
	const bool bAniLitW = false, float AniLitW = 0.0,
	//   bToonSpec        UseToonSpecular (PS __105818 l.203-207, 373-380; verified with stocking only): the stocking base colour gets
	//                    + NoV * SpecStrength * (clamp(T, 1 - NoV, 1) - (1 - NoV)) / max(NoV', 1e-4), T = (clamp(A, DST, DSpT) - DST)
	//                    / (DSpT - DST) (A = MainTex.a * OpacityIntensity, DST / DSpT = Decode Shadow / Spec Threshold)
	const bool bToonSpec = false, float SpecStrength = 0.0,
	//   bNoNormalMap     UseNormalMap off (PS __67268 l.30-35): the normal-map term is absent, Nraw = WorldNormal * nw + (1 - nw) *
	//                    WorldNormal (no Normal_Roughness_Metallic texture; only valid together with bNoPBR, which leaves metallic /
	//                    roughness unused)
	const bool bNoNormalMap = false,
	// ---- Round 6 (trailing defaulted parameters; every earlier call site is unchanged and asm-identical) ----
	//   bAniMaskDecode   AniSwitch MaskTex atlas decode (PS __112638 l.201-238, __286072 l.201-216): MaskTex is read at the
	//                    AniSwitch_FaceShadow 2x4 atlas cell (WuwaBPAniMaskAtlas, sampled by the wrapper); its .y replaces the
	//                    MainTex.a shadow decode (ShadowPart: shadow-offset smoothstep and solid ratio) and its .w the MainTex.a
	//                    emission decode (SpecPart); A = MainTex.a * OpacityIntensity still feeds GBufferC.a and the opacity mask
	const bool bAniMaskDecode = false, float AniShadowPart = 0.0, float AniSpecPart = 0.0,
	//   FurForms         expression-order bits of the UseFurry maps (PS __64048 / __50708 / __316924 compile the material chain
	//                    `precise`, which keeps the source association that fxc re-associates in the other maps); WUWA_R6F_*
	//   bNmapIn          split pass 2 of UseFurryParallax (PS __316924 l.783-800, 854): the custom-output chain re-samples TypeMask /
	//                    MainTex / Normal_Roughness_Metallic.zw at its own parallax UV but keeps the main chain's shading normal:
	//                    NmapIn (the main chain's normal-map term) replaces the one built from this call's Normal_Roughness_Metallic.xy
	const uint FurForms = 0u, const bool bNmapIn = false, float3 NmapIn = float3(0.0, 0.0, 0.0),
	// ---- Round 7 (trailing defaulted parameters; every earlier call site is unchanged and asm-identical) ----
	//   bIDColor         UseIDColor (weapons, PS __104587 l.38-58): the base tint is one of five ID colours picked by the TypeMask.r
	//                    band weights of WuwaBPBandClassify (<= 0.05, (0.05, 0.3], (0.3, 0.5], (0.5, 0.9], skin band); replaces
	//                    BaseColorTint: TexColor = MainTex.rgb * WuwaBPIDTint(c, IDTint1..5)
	const bool bIDColor = false, float3 IDTint1 = float3(1.0, 1.0, 1.0), float3 IDTint2 = float3(1.0, 1.0, 1.0),
	float3 IDTint3 = float3(1.0, 1.0, 1.0), float3 IDTint4 = float3(1.0, 1.0, 1.0), float3 IDTint5 = float3(1.0, 1.0, 1.0),
	//   bScalarPBR       UsePBRMask off (使用PBRMask; PS __288574, __60830): metallic / roughness are the scalar parameters Metalllic (sic) /
	//                    Roughness instead of NRM.z * MetallicIntensity(Debug) / NRM.w * RoughnessIntensity(Debug)
	const bool bScalarPBR = false, float MetalllicScalar = 0.0, float RoughnessScalar = 0.0,
	//   bAlphaEmission   UseAlphaBlendMode (PS __238690 l.206-207, __266607): emissive = SpecPart * EmissionColor, without the base
	//                    colour (as WuwaToonBasePass_Face.ush bAlphaEmission); only without UseBreathLight / UseXingHen
	const bool bAlphaEmission = false,
	//   bEffRim          UseRim + UseEffectMaterial (FresnelRim effect colour; PS __156479 l.298-318, __112449): rim = pow(max(|1 -
	//                    max(N.V, 0)|, 1e-4), RimRange) * (1 - Smooth) + Smooth, rim = Reverse * (1 - 2 rim) + rim (N = GBuffer normal);
	//                    SecondC = (EffS * EffTint + rim * RimColor) * EffMask (with UseSecond: EffS = the untinted Second colour,
	//                    EffTint = Second_ColorTint) or, bEffNoSec, (rim * RimColor + EffS) * EffMask (EffS = EffectMaskColor);
	//                    EffMask = the WuwaBPSecondP effect mask. Added to the emissive as bSecond (bSecond must be set)
	const bool bEffRim = false, const bool bEffNoSec = false, float3 EffS = float3(0.0, 0.0, 0.0), float3 EffTint = float3(0.0, 0.0, 0.0),
	float3 EffMask = float3(0.0, 0.0, 0.0), float3 FresnelRim_RimColor = float3(0.0, 0.0, 0.0), float FresnelRim_RimRange = 0.0, float FresnelRim_Smooth = 0.0,
	float FresnelRim_Reverse = 0.0,
	//   bPreDecode       UseMainTexA off (PS __114103 / __157238 / __172311, with bAniMaskDecode = the constant decode): the solid-shadow
	//                    terms are CPU preshader constants in the original (true division; WARP's GPU div differs in the last ulp):
	//                    PreSolidRatio = min(SSP, 0.001 + SSP) / max(SSP, 0.01) (cb[96].z of __114103), PreSolid = the solid factor
	//                    (cb[102].y), PreAZ = 1 - ((1 - R) * SolidShadowStrength) (cb[103].x); spec uniform_expression inputs
	const bool bPreDecode = false, float PreSolidRatio = 0.0, float PreSolid = 0.0, float PreAZ = 0.0,
	// ---- Round 8a (trailing defaulted parameters; every earlier call site is unchanged and asm-identical) ----
	//   bToonSpecM       UseToonSpecular without stocking (PS __173812 l.94-105; MainTex + MaskTex map, UsePBR off): the lit colour gets
	//                    + (NoV * SpecStrength) * (clamp(T, 1 - NoV, 1) - (1 - NoV)) / max(1 - (1 - NoV), 1e-4) with T = ToonSpecT
	//                    (= MaskTex.x at the AniSwitch atlas cell, sampled by the wrapper); NoV = saturate(N2.V). Only valid without
	//                    bStocking (the stocking form is bToonSpec); verified with bNoPBR (Lit = base colour)
	const bool bToonSpecM = false, float ToonSpecT = 0.0,
	//   bBackLight       Use_FastSSSLight back-light block (PS __282176 l.281-366, __93810 l.345-416, __24974 l.244-360): c = lerp(
	//                    BackLight_Color, GBufferC.rgb, BackLight_ColorBlend); b = saturate(saturate(normalize(Range_Back * Nmap + normalize(
	//                    S.xy, S.z * VectorZ_Int_Back)).(-V)) ^ Power_Back * Int_Back) (S = KuroSSSDirection = Kuro View[296].xyz, Nmap =
	//                    the un-normalised normal-map term); + (bBackLightFront, Use_FastSSSFrontLight) the same with Range_Front * Nmap
	//                    - normalize(S.xy, S.z * VectorZ_Int_Front); fresnel = saturate((FresnelLight_Offset - saturate(Nmap.V)) + 1)
	//                    * FresnelLightColor * FresnelLight_Intensity * (saturate(-V.S) ^ BackLightClip_Power + BackLightClip_Offset);
	//                    BL = (b * c [+ c * bF]) + fresnel; emissive (before the selection colour, also seen by the FFT nibble)
	//                    += BL, or (bBackLightThick, Use_ThicknessMap) BL * (BackLight_ThickInt * (MainTex.a * OpacityIntensity - 1) + 1)
	const bool bBackLight = false, const bool bBackLightFront = false, const bool bBackLightThick = false,
	float3 KuroSSSDirection = float3(0.0, 0.0, 1.0), float3 BackLight_Color = float3(0.0, 0.0, 0.0), float BackLight_ColorBlend = 0.0,
	float BackLight_VectorZ_Int_Back = 0.0, float BackLight_Range_Back = 0.0, float BackLight_Power_Back = 0.0, float BackLight_Int_Back = 0.0,
	float BackLight_VectorZ_Int_Front = 0.0, float BackLight_Range_Front = 0.0, float BackLight_Power_Front = 0.0, float BackLight_Int_Front = 0.0,
	float3 FresnelLightColor = float3(0.0, 0.0, 0.0), float FresnelLight_Intensity = 0.0, float FresnelLight_Offset = 0.0,
	float BackLightClip_Power = 0.0, float BackLightClip_Offset = 0.0, float BackLight_ThickInt = 0.0,
	//   bParallaxCrystal Use_ParallaxCrystal (PS __24974 l.363-443): GBufferC.rgb += pow(saturate(Nmap.V), ParallaxRange_Power) *
	//                    lerp(ParallaxC, GBufferC.rgb, ParallaxCrystalColorBlend); ParallaxC = Parallax_Tex.rgb * ParallaxEmissiveColor.rgb
	//                    at the ray-marched HightMap UV (WuwaBPCrystalParallaxUV, sampled by the wrapper). The back-light colour uses
	//                    GBufferC before this term
	const bool bParallaxCrystal = false, float3 ParallaxC = float3(0.0, 0.0, 0.0), float ParallaxCrystalColorBlend = 0.0,
	float ParallaxRange_Power = 0.0,
	// ---- Round 8 b (trailing defaulted parameters; every earlier call site is unchanged and asm-identical) ----
	//   bFaceRamp        UseFaceRamp (weapons, PS __317009 l.408-457, __260533 l.384-430): ramp U = saturate(FaceRampPre - Threshold),
	//                    FaceRampPre = -((A - T) + 1) * 0.5 + 1.5 from the face SDF (MaskTex.b at the WuwaFaceSDFSetup UV of L,
	//                    A = 1 - pow(SDF.b, 1.5); WuwaBPCommonFaceRampPre in WuwaToonBasePass_CommonFaceRamp.ush, computed by the wrapper)
	//   bCurve           UseCurve (CurveAtlasRowParameter `Param`; PS __85365 l.416-417, __260533 l.432-433): ramp V = CurveV =
	//                    (Param + 0.5) / TextureSize(atlas).x and the ramp texture (= the curve atlas, passed as Ramp) is sampled
	//                    without mip bias
	const bool bFaceRamp = false, float FaceRampPre = 0.0, const bool bCurve = false, float CurveV = 0.0)
{
	FWuwaToonGBuffer G;
	const float3 V = CameraVector;

	// ---- B62-64 / D63-65: bitangent = cross(N, T) * sign --------------------------------------------------------------
	float3 TangentY = cross(WorldNormal, WorldTangent) * TangentSign;

	// ---- B74-85 / D75-86: normal map (xy only, no z reconstruction), View[144].w blend ------------------------------
	float4 NRM = Normal_Roughness_Metallic.SampleBias(Normal_Roughness_MetallicSampler, UV0, MaterialTextureMipBias);
	float2 nxy = (NRM.xy * 2.0 + -1.0) * NormalStrength;
	float3 Nmap = TangentY * nxy.y;
	Nmap = nxy.x * WorldTangent + Nmap;
	Nmap = Nmap + WorldNormal;
	if (bNoNormalMap)
		Nmap = WorldNormal;                                                            // round 5, PS __67268 l.30-32
	if (bNmapIn)
		Nmap = NmapIn;                                                                 // round 6, PS __316924 l.854 (main chain's normal)
	float  nw = NormalOverrideParameter.w;
	float3 Nraw = Nmap * nw + (1.0 - nw) * WorldNormal;
	float  NrawRsq = rsqrt(dot(Nraw, Nraw));
	float3 N = Nraw * NrawRsq;                                            // r5: GBuffer / matcap / NoH1 normal

	// ---- B86-96 / D87-98: band mask (Body/Up: vertex colour R; Down: TypeMask.R via sample_l at LOD = MipBias) ------
	float2 TM = float2(0.0, 0.0);
	float  RampMaskG = 0.0;
	float  AniA = 0.0;                                                                 // round 4: TypeMask.a (UseAniSwitchShadow)
	float  c;
	if (bTypeMask)
	{
		float4 TMs = TypeMask.SampleLevel(TypeMaskSampler, UV0, MaterialTextureMipBias);
		TM = TMs.xz;                                                                   // .x = R band, .y = B stocking gate
		RampMaskG = TMs.y;                                                             // UseRampMask
		AniA = TMs.w;
		c = TM.x;
	}
	else
	{
		c = VertexColor.r;
		if (bRampMask)                                                                 // round 4: UseRampMask without UseTypeMask (PS __46584 l.339)
			RampMaskG = TypeMask.SampleLevel(TypeMaskSampler, UV0, MaterialTextureMipBias).y;
	}
	float BandMask;
	float vcSkin = WuwaBPBandClassify(c, BandMask);

	// ---- B97-105 / D99-107: skin factor, base colour ----------------------------------------------------------------
	float  Skin = WuwaBPSkinFactor(vcSkin, UseSkinMask_DYN, DefaultSkinFactor, UseFaceAni_SkinMask);
	float3 SkinTint = Skin * (SkinColor - 1.0) + 1.0;
	float4 MT = MainTex.SampleBias(MainTexSampler, UV0, MaterialTextureMipBias);
	float3 TexColor  = MT.rgb * BaseColorTint;
	if (bIDColor)
		TexColor = WuwaBPIDTint(c, IDTint1, IDTint2, IDTint3, IDTint4, IDTint5) * MT.rgb;   // round 7, PS __104587 l.49-57
	float3 BaseColor = SkinTint * TexColor;                               // r8

	// ---- B106-107: metallic = NRM.z, roughness = NRM.w ---------------------------------------------------------------
	float Metallic  = NRM.z * MetallicIntensityDebug;
	float Roughness = NRM.w * RoughnessIntensityDebug;
	if (bScalarPBR)
	{
		Metallic  = MetalllicScalar;                                                   // round 7: UsePBRMask off
		Roughness = RoughnessScalar;
	}

	// ---- B108-110 / D110-112: shading normal N2, NoV (Down keeps it unsaturated) ------------------------------------
	float3 N2;
	if (bTwoSided)
		N2 = RaytracingReflectionFix * (-N * TwoSidedSign + WorldNormal) + N * TwoSidedSign;
	else
		N2 = RaytracingReflectionFix * (-Nraw * NrawRsq + WorldNormal) + N;
	float  NoV_raw = dot(N2, V);
	float  NoV_sat = saturate(NoV_raw);

	// ---- B111-118: roughness -> spec exponent / intensity -------------------------------------------------------------
	const float PowEps = bPowEps ? asfloat(0x33000002u) : 0.0;   // original guard constant 2.98e-8 (prints as 0.000000)
	float r01 = (PowEps >= Roughness) ? 0.0 : exp2(log2(Roughness) * 0.1);
	float SpecIntensity = (1.0 - r01) * 19.9 + 0.1;
	float SpecExponent  = r01 * -999.0 + 1000.0;

	// ---- B119-122: metal flag & specular power ------------------------------------------------------------------------
	float IsMetal = (Metallic >= 0.85) ? 1.0 : 0.0;
	float SpecPow = IsMetal * (MetalSpecularPower - SpecularPower) + SpecularPower;

	// ---- B123-181: light direction (MPC + ToonShadowLightData + VS override), anchor target = pixel ----------------
	float3 L;
	if (FurForms & WUWA_R6F_SPOT)                                                        // round 6: precise spot form
		L = WuwaBPMainLightDirP(LightOffset_Pitch, MPC_GlobalCharacterAmbientSkinColor, MPC_GlobalCharacterDebugLightDirection,
			ToonLight0, ToonLight1, ToonLight2, ToonLight3, ObjectWorldPosition, WorldPosition, WorldPosition, CPD13, CPD1, LightDirVS);
	else
		L = WuwaBPMainLightDir(LightOffset_Pitch, MPC_GlobalCharacterAmbientSkinColor, MPC_GlobalCharacterDebugLightDirection,
			ToonLight0, ToonLight1, ToonLight2, ToonLight3, ObjectWorldPosition, WorldPosition, WorldPosition, CPD13, CPD1, LightDirVS);

	// ---- B182-191 / D182-195: shadow threshold band -------------------------------------------------------------------
	float fb = (dot(L, V) * (1.0 - abs(V.z)) + 1.0) * 0.5;
	float ShadowOffset = fb * (FrontShadowProcessOffset - BackShadowProcessOffset) + BackShadowProcessOffset;
	float Threshold = bNoVDL ? ShadowProcess                                               // preshader ((0 + SP) + 0)
	                         : ShadowOffset * (1.0 - NoV_sat) + (0.0 + ShadowProcess);    // preshader (0 + ShadowProcess)
	float Lo, Hi;
	if (bStocking)
	{
		float w = saturate(BandMask * (0.2 - ShadowWidth) + ShadowWidth);                // D193-194
		Lo = -w + Threshold;
		Hi = w + Threshold;
	}
	else
	{
		Lo = Threshold - ShadowWidth;                                                    // B190-191
		Hi = Threshold + ShadowWidth;
	}

	// ---- B192-200: MainTex.a decode ------------------------------------------------------------------------------------
	float A = MT.a * OpacityIntensity;
	float ShadowPart = min(max(A, 0.0), DecodeShadowThreshold) / DecodeShadowThreshold;
	float SpecPart   = (min(max(A, DecodeSpecThreshold), 1.0) - DecodeSpecThreshold) / (1.0 - DecodeSpecThreshold);
	if (bAniMaskDecode)                                                                // round 6, PS __112638 l.209-212, 228-229, 258
	{
		ShadowPart = AniShadowPart;                                                    // MaskTex.y at the atlas cell
		SpecPart   = AniSpecPart;                                                      // MaskTex.w at the atlas cell
	}

	// ---- B201-216: alpha-driven shadow offset + half-Lambert ---------------------------------------------------------
	float so = WuwaBPSmooth(saturate((1.0 / (1.0 - SolidShadowProcess)) * (ShadowPart - SolidShadowProcess)));
	so = so * ShadowOffsetAdjustFactor;
	so = (PowEps >= so) ? 0.0 : exp2(log2(so) * ShadowOffsetPower) * MaskShadowOffsetStrength;
	float HL;
	if (FurForms & WUWA_R6F_HL)                                                          // round 6: (N2.L * 0.5 + 0.5) + so
	{
		precise float hl0 = dot(N2, L) * 0.5 + 0.5;
		HL = hl0 + so;
	}
	else
	{
		HL = dot(N2, L) * 0.5 + so;
		HL = HL + 0.5;
	}

	// ---- B217-232: toon shadow step x solid-shadow mask, lit flag ------------------------------------------------------
	float Shadow = WuwaBPSmooth(saturate((1.0 / (Hi - Lo)) * (HL - Lo)));
	float SolidRatio = min(ShadowPart, SolidShadowProcess) / max(SolidShadowProcess, 0.01);               // preshader max
	float oneMinusSSW = 1.0 - SolidShadowWidth;                                                          // preshader
	float Solid = (min(max(SolidRatio, oneMinusSSW), 1.0) - oneMinusSSW) / max(1.0 - (1.0 - SolidShadowWidth), 0.0001);
	if (bPreDecode)                                                                      // round 7: CPU preshader constants
	{
		SolidRatio = PreSolidRatio;
		Solid = PreSolid;
	}
	const float AniSel = (AniSwitch_ShadowColorDark >= 0.95) ? 1.0 : 0.0;           // round 4 (PS __170739 l.232-237)
	float SolidRatioR = SolidRatio;                                                  // ratio used by the ramp U and GBufferA.z
	if (bAniSwitchShadow)
	{
		Shadow = Shadow * (Solid * (AniSel * (1.0 - AniA) + AniA));
		SolidRatioR = AniSel * (-SolidRatio * AniA + SolidRatio) + AniA * SolidRatio;  // l.339-341
	}
	else
		Shadow = Shadow * Solid;
	bool  bLit  = (Shadow >= 0.4);
	float IsLit = bLit ? 1.0 : 0.0;

	// ---- B233-259: toon specular (lit: Blinn H with N; shadow: light mirrored in XY) ---------------------------------
	float3 Lm = (L * IsLit) * float3(2.0, 2.0, 0.0);
	Lm = L * float3(-1.0, -1.0, 1.0) + Lm;
	float3 H1 = V + Lm;
	H1 = H1 / sqrt(dot(H1, H1));
	float  NoH1 = saturate(dot(H1, N));
	float3 H = V + L;
	H = H / sqrt(dot(H, H));
	float  NoH = saturate(dot(N2, H));
	float  NoHs = IsMetal * (NoH - NoH1) + NoH1;
	if (bNoDoubleSpec)
		NoHs = NoH;                                                                  // round 4: UseDoubleSpecular off
	float  Spec = exp2(log2(NoHs) * SpecExponent);
	if (FurForms & WUWA_R6F_SPEC)                                                        // round 6: ((SpecPow + 2) * 1/2pi) * (SpecPow * S)
	{
		precise float sk = (SpecPow + 2.0) * asfloat(0x3E22F983u);
		precise float ss = SpecPow * Spec;
		precise float sp = sk * ss;
		Spec = saturate((sp + -0.6) * asfloat(0x3F555556u));
	}
	else
	{
		Spec = SpecPow * Spec;
		Spec = Spec * (SpecPow + 2.0);
		Spec = saturate((Spec * asfloat(0x3E22F983u) + -0.6) * asfloat(0x3F555556u));   // 0.159155 (1/2pi), 0.833333
	}
	Spec = WuwaBPSmooth(Spec) * SpecIntensity;

	// ---- B260-278: PBR terms (EnvBRDFApprox with NoV fixed at 1) ------------------------------------------------------
	float  F0d = (Metallic * 0.5 + 0.5) * 0.08;
	float3 MetalBase = Metallic * BaseColor;
	float3 SpecColor = Metallic * (SkinTint * TexColor - F0d) + F0d;
	float4 eb = Roughness * float4(-1.0, -0.0275, -0.572, 0.022) + float4(1.0, 0.0425, 1.04, -0.04);
	float  a004 = min(eb.x * eb.x, asfloat(0x3AD2D6DFu)) * eb.x + eb.y;                // 0.00160857651 = 2^-9.28
	float2 AB = a004 * float2(-1.04, 1.04) + eb.zw;
	AB.y = AB.y * saturate(SpecColor.g * 50.0);
	float3 EnvBRDF = SpecColor * AB.x + AB.y;
	float3 SpecColorP = SpecColor * PBRRateIntensity;
	float3 MetalHL = Spec * SpecColorP;
	EnvBRDF = EnvBRDF * PBRRateIntensity;
	float3 Diffuse = PBRRateIntensity * -MetalBase + BaseColor;
	MetalHL = (IsMetal * MetalHL) * MetalEmissionStrength;

	// ---- B279-284: PBR mask ---------------------------------------------------------------------------------------------
	float PBRMask = (1.0 - max(BandMask, Skin)) * (((-NRM.w * RoughnessIntensityDebug + 1.0) >= 0.01) ? 1.0 : 0.0);
	if (bScalarPBR)
		PBRMask = (1.0 - max(BandMask, Skin)) * (((1.0 - RoughnessScalar) >= 0.01) ? 1.0 : 0.0);   // round 7: preshader 1 - Roughness

	// ---- B285-290: emissive (pre-selection copy feeds the FFT nibble) --------------------------------------------------
	float3 Emissive;
	if (bBreath)
	{
		float3 e0 = BaseColor * SpecPart;
		float3 eB = e0 * EmissionColor;
		float  br = cos(GameTime * BreatheFrequency);
		br = BreatheStrength * br + BreatheStrength * BreathePropotion;
		br = br * EmissionStrength;
		eB = br * eB;
		float sel = (EmissionBreathThreshold >= SpecPart) ? 1.0 : 0.0;
		Emissive = sel * (EmissionColor * e0 - eB) + eB;
	}
	else
	{
		Emissive = (BaseColor * SpecPart) * EmissionColor;
		if (bAlphaEmission)
			Emissive = SpecPart * EmissionColor;                                           // round 7, PS __238690 l.206
	}
	if (bXingHen)
	{
		// PS __68245 l.288, 375-376, 381-386: lerp(PBRMask * MetalHL, XHCol, XHW * XHAlpha), then + EmissionColor * e0
		// + UseBreathLight (PS __160507 l.363-374): the breathing emissive computed above + the XingHen lerp
		float3 MHLm = MetalHL * PBRMask;
		float3 XH = XHW * (XHAlpha * (XHCol - PBRMask * MetalHL)) + MHLm;
		if (bBreath)
			Emissive = Emissive + XH;
		else
			Emissive = EmissionColor * (BaseColor * SpecPart) + XH;
	}
	else if (!bNoPBR)
	{
		Emissive = PBRMask * MetalHL + Emissive;
	}
	if (bEffRim)                                                                         // round 7, PS __156479 l.298-318
	{
		float rim = exp2(log2(max(abs(1.0 - max(dot(N, V), 0.0)), 0.0001)) * FresnelRim_RimRange);
		rim = rim * (1.0 - FresnelRim_Smooth) + FresnelRim_Smooth;                    // preshader (1 - Smooth)
		rim = FresnelRim_Reverse * (rim * -2.0 + 1.0) + rim;
		float3 ec;
		if (bEffNoSec)
			ec = rim * FresnelRim_RimColor + EffS;
		else
		{
			float3 rc = rim * FresnelRim_RimColor;
			ec = EffS * EffTint + rc;
		}
		SecondC = ec * EffMask;
	}
	if (bSecond)
		Emissive = Emissive + (MotionEmissiveMask * E_Motion_Emissive + SecondC);         // round 5, PS __240571 l.335-336
	else
		Emissive = MotionEmissiveMask * E_Motion_Emissive + Emissive;
	float3 EmissivePreSel = Emissive;
	Emissive = SelectionColor.a * (SelectionColor.rgb - Emissive) + Emissive;

	float3 Lit = SpecColorP * Spec + Diffuse;                                            // B291

	// ---- D296-365: stocking / anisotropy / knee (Down only) -----------------------------------------------------------
	float3 PBRBase = BaseColor;
	if (bStocking)
	{
		// D296 dp3(v0, r10): r10 is the normalised half vector H = normalize(V + L) from D246-249 (the same H as the
		// metal NoH above), not L. Anisotropy is the tangent-vs-half-vector term: sin^2(T,H) and smooth(T.H + 1).
		float TdotH = dot(WorldTangent, H);
		float sTL   = WuwaBPSmooth(saturate(TdotH + 1.0));
		float sin2  = -TdotH * TdotH + 1.0;
		float an    = (PowEps >= sin2) ? 0.0 : exp2(log2(sin2) * AnistropyInt) * sTL;
		float Aniso = saturate(-nxy.x * AnistropyNormalInt + an);
		float3 AnisoC = Aniso * AnistropyColor;                                          // r10
		float3 AK     = AnisoC * StockingKnee_Color;                                     // r16
		float3 AKmix  = (Aniso * AnistropyColor - AK) * 0.5 + AK;
		float  invR   = 1.0 / max(1e-05, StockingKnee_MaskRadius);                       // preshader
		float3 d1 = WorldPosition + -CPD_Knee1;
		float  k1 = saturate(-sqrt(dot(d1, d1)) * invR + 1.0);
		k1 = k1 * saturate(CPD17 * StockingKnee_CurvatureRange);
		float3 d2 = WorldPosition + -CPD_Knee2;
		float  k2 = saturate(-sqrt(dot(d2, d2)) * invR + 1.0);
		float  k2w = saturate(CPD21 * StockingKnee_CurvatureRange);
		float  sel = (0.5 >= UV3X) ? 1.0 : 0.0;                                          // D328 (UV3.x selects the knee)
		float  Knee = sel * (k2w * k2 - k1) + k1;
		AnisoC = StockingKnee_BlendRange * ((-Aniso * AnistropyColor + AKmix) * Knee) + AnisoC;
		float  st = WuwaBPSmooth(saturate((1.0 / (StockingRangeMax - StockingRangeMin)) * (NoV_raw - StockingRangeMin)));
		float3 Sk = st * (StockingColor - StockingEdgeColor) + StockingEdgeColor;
		Sk = StockingIntensity * (BaseColor * Sk - BaseColor) + BaseColor;
		float  sl = WuwaBPSmooth(saturate((1.0 / (StockingLightRangeMax - StockingLightRangeMin)) * (NoV_sat - StockingLightRangeMin)));
		float3 SL = sl * StockingLightColor;
		SL = (TM.y * UseIDBMaskInStockingLight) * -SL + SL;
		Sk = Sk + SL;
		float3 SkK = (-StockingKnee_Color * Sk + Sk) * 0.5 + Sk * StockingKnee_Color;
		Sk = StockingKnee_BlendRange * ((SkK - Sk) * Knee) + Sk;
		PBRBase = BandMask * (-SkinTint * TexColor + Sk) + BaseColor;                   // D363-364
		if (bToonSpec)                                                                   // round 5, PS __105818 l.373-380
		{
			float tsp = (min(max(A, DecodeShadowThreshold), DecodeSpecThreshold) - DecodeShadowThreshold)
			          / (DecodeSpecThreshold - DecodeShadowThreshold);                   // l.203-207
			float omv = 1.0 - NoV_sat;
			float tsx = (min(max(omv, tsp), 1.0) - omv) / max(1.0 - omv, 0.0001);
			PBRBase = (NoV_sat * SpecStrength) * tsx + PBRBase;
		}
		PBRBase = BandMask * AnisoC + PBRBase;                                           // D365
	}

	// ---- B292-305 / D367-380: view-space matcap UV = cross(Pview, Nview).yx * 0.5 + 0.5 -----------------------------
	float3 Pv = mul(float4(TranslatedWorldPosition, 1.0), TranslatedWorldToView).xyz;
	// B296 / D371: the original sums |Pv|^2 in (y, z, x) order (dp3 r9.xzw, r9 = Pv.yzzx). fxc canonicalises dot(Pv, Pv) to
	// (x, y, z), which differs by 1 ulp on some pixels and then moves the matcap UV. The min() against FLT_MAX is a
	// value no-op for finite input that fxc cannot see through, so the dp3 keeps the (y, z, x) operand order.
	float3 PvYZX = min(Pv.yzx, 3.402823466e+38);
	Pv = Pv / sqrt(dot(PvYZX, PvYZX));
	float3 Nv = mul(N, (float3x3)TranslatedWorldToView);
	float2 MatCapUV = float2(Pv.z * Nv.x - Pv.x * Nv.z, Pv.y * Nv.z - Pv.z * Nv.y) * 0.5 + 0.5;
	float4 MC = MatCapTex.SampleBias(MatCapTexSampler, MatCapUV, MaterialTextureMipBias);

	// ---- B306-314: roughness selects one of four matcap channels -----------------------------------------------------
	float  mc = saturate(Roughness * 3.0) * (MC.y - MC.x) + MC.x;
	float2 ab = saturate(Roughness * float2(3.0, 3.0) + float2(-1.0, -2.0));
	if (bScalarPBR)                                                                      // round 7: preshader weights of the scalar Roughness
	{
		precise float r3 = RoughnessScalar * 3.0;
		mc = saturate(r3) * (MC.y - MC.x) + MC.x;
		precise float r3a = r3 - 1.0;
		precise float r3b = r3a - 1.0;                                                // preshader ((R * 3) - 1) - 1
		ab = saturate(float2(r3a, r3b));
	}
	mc = ab.x * (MC.z - mc) + mc;
	mc = ab.y * (MC.w - mc) + mc;

	// ---- B315-323: matcap intensity (lit vs shadow, metal vs not) ----------------------------------------------------
	float backI = IsMetal * (MetalMatCapBack - MatCapInt) + MatCapInt;
	float inSh  = bLit ? 0.0 : 1.0;
	float shI   = inSh * backI;
	float litI  = IsMetal * (MetalMatCapInt - MatCapInt) + MatCapInt;
	float mcI   = IsLit * (-backI * inSh + litI) + shI;
	mc = mc * mcI;

	// ---- B324-327 / D399-401: PBR composite -> lit colour ---------------------------------------------------------------
	Lit = EnvBRDF * mc + Lit;
	if (bStocking)
	{
		Lit = Lit - PBRBase;
		Lit = PBRMask * Lit + PBRBase;
	}
	else
	{
		Lit = -SkinTint * TexColor + Lit;
		Lit = PBRMask * Lit + BaseColor;
	}
	if (bNoPBR)
	{
		if (bStocking)
			Lit = PBRBase;                                                           // round 5, PS __264933 l.251-253: the stocking base
		else
			Lit = BaseColor;                                                         // PS __144444 l.~150: LitB = Base * Bright
	}
	if (bToonSpecM)                                                                      // round 8a, PS __173812 l.94-105
	{
		float omv = 1.0 - NoV_sat;
		float tsx = (min(max(omv, ToonSpecT), 1.0) - omv) / max(1.0 - omv, 0.0001);
		Lit = (NoV_sat * SpecStrength) * tsx + Lit;
	}
	float3 LitB = Lit * AniSwitch_ShadowColorBright;
	if (bAniLitW)
	{
		float3 LitD = Lit * AniSwitch_ShadowColorDark;                               // round 5, PS __105818 l.416, 423-424
		LitB = AniLitW * (AniSwitch_ShadowColorBright * Lit - LitD) + LitD;
	}
	else if (bAniSwitchShadow)
	{
		float3 LitD = Lit * AniSwitch_ShadowColorDark;                               // PS __170739 l.334-336
		LitB = AniA * (AniSwitch_ShadowColorBright * Lit - LitD) + LitD;
	}

	// ---- B328-336: ramp lookup --------------------------------------------------------------------------------------------
	float rp = min(max(HL, 0.0), SolidShadow_RampPosition);
	rp = SolidRatioR * (HL - rp) + rp;
	float2 RampUV;
	if (FurForms & WUWA_R6F_RAMPU)                                                       // round 6: sat((rp - thr) + 0.5)
	{
		precise float rpt = rp - Threshold;
		RampUV = float2(saturate(rpt + 0.5), Skin * (0.1 - RampPosition) + RampPosition);
	}
	else
	{
		rp = rp + 0.5;
		RampUV = float2(saturate(rp - Threshold), Skin * (0.1 - RampPosition) + RampPosition);
	}
	if (bFaceRamp)                                                                       // round 8 b, PS __317009 l.454
		RampUV.x = saturate(FaceRampPre - Threshold);
	if (bCurve)                                                                          // round 8 b, PS __85365 l.416
		RampUV.y = CurveV;
	float3 RampC = bNoRamp ? float3(0.0, 0.0, 0.0)
	             : (bCurve ? Ramp.Sample(RampSampler, RampUV).rgb : Ramp.SampleBias(RampSampler, RampUV, MaterialTextureMipBias).rgb);

	// ---- B337-347: ramp blend (skin) + desaturation -> GBufferC.rgb ------------------------------------------------------
	float  RampW = ((MPC_GlobalCharSkyLightIntensity >= 0.05) ? 1.0 : 0.0) * (bRampMask ? RampMaskG : RampInt);
	if (bAllRampColor)
	{
		// round 4, PS __37287 / __314618: no skin lerp, mad(-Bright, Lit, Ramp) as the skin-ramp path
		G.C.rgb = WuwaBPDesaturate((RampW * (-AniSwitch_ShadowColorBright * Lit + RampC) + (LitB + LitB)) * 0.5, Desaturation);
	}
	else if (bNoSkinRampC || bNoRamp)
	{
		if (bXingHen)                                                                // round 4, PS __140544: XingHen lerp, no skin ramp
			G.C.rgb = WuwaBPDesaturate(XHW * ((XHCol - AniSwitch_ShadowColorBright * Lit) * XHAlpha) + LitB, Desaturation);
		else
			G.C.rgb = WuwaBPDesaturate(LitB, Desaturation);
	}
	else if (bXingHen)
	{
		// PS __68245 l.433-456: X = lerp(Lit * Bright, XHCol, XHW * XHAlpha) replaces Lit * Bright in the skin ramp blend
		float3 X  = XHW * ((XHCol - AniSwitch_ShadowColorBright * Lit) * XHAlpha) + LitB;
		float3 Cc = RampC - X;
		Cc = RampW * Cc + (X + X);
		Cc = Cc * 0.5 - X;
		Cc = Skin * Cc + X;
		G.C.rgb = WuwaBPDesaturate(Cc, Desaturation);
	}
	else
	{
		float3 Cc = -AniSwitch_ShadowColorBright * Lit + RampC;
		if (bAniSwitchShadow)
			Cc = RampC - LitB;                                                       // PS __170739 l.353
		Cc = RampW * Cc + (LitB + LitB);
		Cc = Cc * 0.5 - LitB;
		Cc = Skin * Cc + LitB;
		G.C.rgb = WuwaBPDesaturate(Cc, Desaturation);
	}

	// ---- round 8a: Use_FastSSSLight back light (PS __282176 l.281-366) and Use_ParallaxCrystal (PS __24974 l.433-443) ----------------
	if (bBackLight)
	{
		float3 blc = BackLight_ColorBlend * (G.C.rgb - BackLight_Color) + BackLight_Color;          // l.330-331
		float3 Lb = float3(KuroSSSDirection.xy, KuroSSSDirection.z * BackLight_VectorZ_Int_Back);  // l.281-285
		Lb = Lb / sqrt(dot(Lb, Lb));
		float3 db = BackLight_Range_Back * Nmap + Lb;
		db = db / sqrt(dot(db, db));
		float  bb = saturate(exp2(log2(saturate(dot(db, -V))) * BackLight_Power_Back) * BackLight_Int_Back);   // no pow guard
		float3 bl = bb * blc;
		if (bBackLightFront)                                                                         // l.332-347
		{
			float3 Lf = float3(KuroSSSDirection.xy, KuroSSSDirection.z * BackLight_VectorZ_Int_Front);
			Lf = Lf / sqrt(dot(Lf, Lf));
			float3 df = BackLight_Range_Front * Nmap - Lf;
			df = df / sqrt(dot(df, df));
			float  bf = saturate(exp2(log2(saturate(dot(df, -V))) * BackLight_Power_Front) * BackLight_Int_Front);
			bl = bl + blc * bf;
		}
		float  fr = saturate((FresnelLight_Offset - saturate(dot(Nmap, V))) + 1.0);                // l.348-352
		float3 fc = (fr * FresnelLightColor) * FresnelLight_Intensity;
		float  cp = saturate(-dot(V, KuroSSSDirection));                                            // l.353-360
		cp = (PowEps >= cp) ? 0.0 : exp2(log2(cp) * BackLightClip_Power);
		cp = cp + BackLightClip_Offset;
		bl = fc * cp + bl;
		if (bBackLightThick)                                                                         // l.362-364
			EmissivePreSel = bl * (BackLight_ThickInt * (A - 1.0) + 1.0) + EmissivePreSel;
		else
			EmissivePreSel = EmissivePreSel + bl;                                                    // PS __93810 l.414
		Emissive = SelectionColor.a * (SelectionColor.rgb - EmissivePreSel) + EmissivePreSel;
	}
	if (bParallaxCrystal)
	{
		float pv = saturate(dot(Nmap, V));
		pv = (PowEps >= pv) ? 0.0 : exp2(log2(pv) * ParallaxRange_Power);
		float3 pc = ParallaxCrystalColorBlend * (G.C.rgb - ParallaxC) + ParallaxC;
		G.C.rgb = pv * pc + G.C.rgb;
	}

	// ---- B380-397: emissive -> SceneColor -----------------------------------------------------------------------------------
	G.Emissive = WuwaBPFinalEmissive(Emissive, KuroSkipEmissiveScale, KuroEmissiveScale, OutOfBoundsMask,
		WorldPosition, ObjectWorldPosition, ObjectBounds);

	// ---- B398-404: shadow colour -> GBufferB.rgb -----------------------------------------------------------------------------
	float3 SC = Skin * (SkinSubsurfaceColor - SubsurfaceColor) + SubsurfaceColor;
	if (!bNoRamp)
		SC = RampW * (RampC - SC) + SC;
	SC = WuwaBPDesaturate(SC, Desaturation);

	// ---- B405-408: GBufferA.z = toon shadow factor ----------------------------------------------------------------------------
	float az = -(1.0 - SolidRatioR) * SolidShadowStrength + 1.0;
	if (bPreDecode)
		az = PreAZ;                                                                      // round 7: preshader 1 - ((1 - R) * SSS)
	G.A.z = az * (Shadow * 0.5 + 0.5);

	// ---- B409-493: two packings selected by View[276].x (integer compare with 1) ---------------------------------------
	G.A.xy  = WuwaBPOctEncode(N);
	G.B.rgb = sqrt(saturate(SC));
	G.B.a   = WuwaBPShadingModelByte(LightingChannelMask, 12u);
	if (KuroGBufferMode == 1.0)                                                          // B410-436
	{
		if (bHET)
		{
			uint op = (uint)floor(min(max(A, 0.0), 1.0) * 255.0 + 0.5);
			G.C.a = (float)(op | 1u) * WUWA_INV255;
		}
		else
			G.C.a = WuwaBPRimByteEven(ToonRimWidth);
		G.D   = float4(0.0, 0.0, 0.0, 0.0);
		G.A.w = 1.0;
	}
	else                                                                                 // B437-492
	{
		float metalPBR = IsMetal * PBRMask;
		float rr = metalPBR * (min(max(Roughness, 0.0), 0.3999) + -1.0) + 1.0;
		float mp = min(max(metalPBR, 0.0), 0.9);
		rr = min(rr, 1.0);
		float packedY = WuwaPackU8Lo4(rr, mp);
		float ao  = saturate(Skin * (SSAOSkinIntensity - SSAOIntensity) + SSAOIntensity);
		float mx  = max(EmissivePreSel.b, max(EmissivePreSel.g, EmissivePreSel.r));
		float fft = (mp * mx) * FFTIntensity;
		float fsel = (FFTIntensity >= 0.0) ? fft : (FFTIntensity * -1.0);               // preshader (FFTIntensity * -1)
		fft = saturate((0.00001 < abs(FFTIntensity)) ? fsel : fft);
		if (bNoPBR)
		{
			packedY = WUWA_240OVER255;                                                   // PS __144444 l.~366
			float neg = (FFTIntensity >= 0.0) ? 0.0 : (FFTIntensity * -1.0);
			fft = saturate((0.00001 < abs(FFTIntensity)) ? neg : 0.0);
		}
		float packedW = WuwaPackU8Lo4(ao, fft);
		G.D   = float4(ToonRimWidth, packedY, 0.0, packedW);                            // ToonRimWidth not saturated
		G.A.w = WUWA_099999;                                                             // 0.99999 (printed 0.999990)
		G.C.a = A;                                                                       // MainTex.a * OpacityIntensity
	}
	return G;
}

