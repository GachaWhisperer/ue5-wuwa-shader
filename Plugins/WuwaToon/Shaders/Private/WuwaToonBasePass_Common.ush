	// GBufferA.z / B / C.a / D); both keep (N2.L * 0.5 + 0.5) + so (l.309-311, 576), the custom-output chain forms the ramp U as
	// sat((rp - threshold) + 0.5) (l.583-584)
	FWuwaToonGBuffer G1 = WuwaToonCommonBasePass_Impl(true, false, true, false, false, false, false, false,
		WUWA_R4_A_TEX_TM, UVP, 0.0, float4(0.0, 0.0, 0.0, 0.0), WUWA_R4_A_GEOM_REST, WUWA_R4_A_MAT1, 0.0, WUWA_R4_A_MAT2, WUWA_R4_A_NOSTOCK,
		WUWA_R4_A_TAIL, WUWA_R4_A_NOBREATH, 1.0, WUWA_R4_A_NOXH, false, false, false, 1.0, false, false, false, float3(0.0, 0.0, 0.0),
		false, 0.0, false, 0.0, false, false, 0.0, 0.0, WUWA_R6F_HL);
	FWuwaToonGBuffer G2 = WuwaToonCommonBasePass_Impl(true, false, true, false, false, false, false, false,
		WUWA_R4_A_TEX_TM, UVP, 0.0, float4(0.0, 0.0, 0.0, 0.0), WUWA_R4_A_GEOM_REST, WUWA_R4_A_MAT1, 0.0, WUWA_R4_A_MAT2, WUWA_R4_A_NOSTOCK,
		WUWA_R4_A_TAIL, WUWA_R4_A_NOBREATH, 1.0, WUWA_R4_A_NOXH, false, false, false, 1.0, false, false, false, float3(0.0, 0.0, 0.0),
		false, 0.0, false, 0.0, false, false, 0.0, 0.0, WUWA_R6F_HL | WUWA_R6F_RAMPU);
	FWuwaToonGBuffer G = G2;
	G.Emissive = G1.Emissive;
	G.C.rgb = G1.C.rgb;
	return G;
}

