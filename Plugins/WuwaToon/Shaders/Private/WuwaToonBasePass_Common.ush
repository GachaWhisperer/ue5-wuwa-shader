	float3 KuroEmissiveScale, float KuroSkipEmissiveScale, float OutOfBoundsMask, float3 ObjectWorldPosition, float3 ObjectBounds, \
	uint LightingChannelMask
#define WUWA_R4_P_BREATH \
	float GameTime, float BreatheStrength, float BreatheFrequency, float BreathePropotion, float EmissionStrength, float EmissionBreathThreshold

#define WUWA_R4_A_TEX_TM \
	Normal_Roughness_Metallic, Normal_Roughness_MetallicSampler, TypeMask, TypeMaskSampler, \
	MainTex, MainTexSampler, MatCapTex, MatCapTexSampler, Ramp, RampSampler
#define WUWA_R4_A_TEX_BODY \
	Normal_Roughness_Metallic, Normal_Roughness_MetallicSampler, MainTex, MainTexSampler, \
