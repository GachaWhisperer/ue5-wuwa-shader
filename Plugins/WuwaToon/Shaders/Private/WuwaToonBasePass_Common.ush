// UseXingHen ("XingHen" star mark painted on the body, PS __68245 l.288-390; the M_Char_XinHen material function of
// WuwaToonBasePass_Star.ush, but on a UV-transformed copy of UV0 and blended into the toon body):
//   uvD     = rotate((UV0 - 0.5) * UVScale - (0.5 + UVpos) + 0.5) + (0.5 + UVpos) - UVpos      (l.297-304). cos/sin of
//             Rotation * 2pi are Kuro CPU preshaders: they enter as XHRotCos / XHRotSin (spec kind uniform_expression,
//             evaluated on the CPU like a UE uniform expression), not as GPU cos/sin (round 3b)
//   D / Noise / Noise02 are sampled without mip bias (sample, not sample_b); the sound-wave clock is fmod(Time, 48).
//   XHCol   = lerp(k * SDFColor02.rgb, SDFColor.rgb * SDFColor.a, mask)
//   XHAlpha = saturate(D.a * mask) inside the 0.01..0.99 UV window, else 0                     (l.372-381)
//   XHW     = clamp(2P - 1, 0, 1) lerp of the UV3.x half selection by XingHenPosition P          (l.383-390)
void WuwaBPXingHen(Texture2D D, SamplerState DSampler, Texture2D Noise, SamplerState NoiseSampler,
	Texture2D Noise02, SamplerState Noise02Sampler, float2 UV0, float UV3X, float GameTime,
	float4 SDFColor, float4 SDFColor02, float ShakeNoiseInt, float UVpositionX, float UVpositionY, float UVScaleX, float UVScaleY,
	float XHRotCos, float XHRotSin, float XingHenControl, float SDFStart, float SoundWaveTiling01, float SoundWaveSpeed01, float SoundWaveInt01,
	float SoundWaveTiling02, float SoundWaveSpeed02, float SoundWaveInt02, float XHMax, float XingHenPosition,
	out float3 XHCol, out float XHAlpha, out float XHW,
	const bool bNoRotate = false)   // round 4: UseRotate180UV off (PS __291279 l.~300): uvD = ((UV0 - 0.5) * UVScale + 0.5) - UVpos
{
	// ---- preshaders (Kuro CPU side, float32) ---------------------------------------------------------------------------
	float2 UVpos  = float2(UVpositionX, UVpositionY);
	float2 UVpos5 = float2(0.5, 0.5) + UVpos;                         // cb[17]; cb[19] = cb[17] * -1
	float2 Row0   = float2(XHRotCos, XHRotSin * -1.0);                 // cb[20] = float2(cos, sin * -1)
	float2 Row1   = float2(XHRotSin, XHRotCos);                        // cb[21] = float2(sin, cos)
	float  shakeAbs = abs(ShakeNoiseInt);
	float  xhc    = min(XingHenControl, asfloat(0x3F59999Au));         // min(XingHenControl, 0.85)
	float  k      = ((shakeAbs >= asfloat(0x3A83126Fu)) ? asfloat(0x3E4CCCCDu) : 0.0) + SDFColor02.a;
	float3 sdfPremul = SDFColor.rgb * SDFColor.a;
	float  P2x    = XingHenPosition * 2.0;
	precise float shake03 = ShakeNoiseInt * asfloat(0x3E99999Au);      // cb[94].x preshader (ShakeNoiseInt * 0.3); precise keeps
	                                                                    // fxc from re-associating p2 * (Shake * 0.3)

	// ---- l.296-305: transformed UV, D ------------------------------------------------------------------------------------
	float2 uvD;
	if (bNoRotate)
	{
		uvD = (UV0 + -0.5) * float2(UVScaleX, UVScaleY) + 0.5;
		uvD = uvD - UVpos;
	}
	else
	{
		uvD = (UV0 + -0.5) * float2(UVScaleX, UVScaleY) + UVpos5 * -1.0;
		uvD = uvD + 0.5;
		uvD = float2(dot(uvD, Row0), dot(uvD, Row1));
		uvD = uvD + UVpos5;
		uvD = uvD - UVpos;
	}
	float4 Dt = D.Sample(DSampler, uvD);

	// ---- l.306-311: inner mask faded out by the shake amount ----------------------------------------------------------------
	float inner = 1.0 - Dt.r;
	float s = saturate(shakeAbs * 3.0);
	s = (s * s) * (s * -2.0 + 3.0);
	float mask = s * -inner + inner;

	// ---- l.312-347: sound waves on uvD, clock = fmod(GameTime, 48) --------------------------------------------------------
	float  P1x = xhc * (asfloat(0x3F99999Au) - SDFStart) + SDFStart;
	float4 Q = xhc * (float4(3.5, asfloat(0x40333333u), asfloat(0xBE4CCCCDu), 15.0)
		- float4(SoundWaveTiling01, SoundWaveTiling02, SoundWaveSpeed01, SoundWaveInt01))
		+ float4(SoundWaveTiling01, SoundWaveTiling02, SoundWaveSpeed01, SoundWaveInt01);   // (Tiling01, Tiling02, Speed01, Int01)
	float  tt = GameTime * asfloat(0x3CAAAAABu);                       // / 48
	tt = (tt >= -tt) ? frac(abs(tt)) : -frac(abs(tt));
	float  T48 = tt * 48.0;
	float  T144 = tt * 144.0;
	float2 uv1 = uvD * float2(1.0, Q.x) + float2(0.0, Q.z) * float2(tt, T48);
	float  n1 = Noise.Sample(NoiseSampler, uv1).r;
	n1 = n1 * asfloat(0xBD6A0EC7u) + asfloat(0x3C1C0A8Du);              // -0.0571429, 0.00952381
	n1 = n1 * max(Q.w * 0.5, 1.0);
	float2 S2 = xhc * (float2(asfloat(0xBECCCCCDu), 15.0) - float2(SoundWaveSpeed02, SoundWaveInt02)) + float2(SoundWaveSpeed02, SoundWaveInt02);
	float2 uv2 = uvD * float2(1.0, Q.y) + float2(tt, T48) * float2(0.0, S2.x);
	float  n2 = Noise02.Sample(Noise02Sampler, uv2).r;
	n2 = n2 * asfloat(0xBD6A0EC7u) + asfloat(0x3C1C0A8Du);
	float  side = (asfloat(0x3F0353F8u) >= uvD.x) ? 1.0 : 0.0;          // 0.513
	float  wave = side * (n2 * max(S2.y * 0.5, 1.0) - n1) + n1;
	float  stepv = ((P1x * 0.5 - wave) >= Dt.g) ? 1.0 : 0.0;
	mask = mask + stepv;

	// ---- l.348-369: travelling pulse ----------------------------------------------------------------------------------------
	float e = saturate(shakeAbs) * asfloat(0xC1EC3D71u) + 30.0;           // -29.53
	float p = (asfloat(0x33000002u) >= Dt.b) ? 0.0 : min(exp2(log2(Dt.b) * e), 1.0);
	float x = frac(p * 3.0 + T144);
	float sm1 = (x * -2.0 + 3.0) * (x * x);
	float w = saturate((x + -1.0) * (1.0 / (XHMax + -1.0)));
	w = (w * w) * (w * -2.0 + 3.0);
	float p2 = p * (w * sm1);
	mask = p2 * shake03 + mask;

	// ---- l.370-390: colour, alpha window, half selection -----------------------------------------------------------------
	XHCol = k * SDFColor02.rgb;
	XHCol = mask * (-SDFColor02.rgb * k + sdfPremul) + XHCol;
	float2 inW = float2((uvD.x >= asfloat(0x3C23D70Au)) ? 1.0 : 0.0, (uvD.y >= asfloat(0x3C23D70Au)) ? 1.0 : 0.0)    // 0.01
	           * float2((asfloat(0x3F7D70A4u) >= uvD.x) ? 1.0 : 0.0, (asfloat(0x3F7D70A4u) >= uvD.y) ? 1.0 : 0.0);  // 0.99 (scalar ?: for HLSL 2021)
	XHAlpha = ((inW.y * inW.x) >= 1.0) ? Dt.a * mask : 0.0;
	XHAlpha = saturate(XHAlpha);
	bool  hi = (UV3X >= 0.5);
	float a = hi ? 1.0 : (1.0 - clamp(P2x, 0.0, 1.0));
	float b = hi ? 0.0 : 1.0;
	XHW = clamp(P2x - 1.0, 0.0, 1.0) * (b - a) + a;
}

