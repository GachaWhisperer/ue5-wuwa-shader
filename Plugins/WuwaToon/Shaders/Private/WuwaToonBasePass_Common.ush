// =====================================================================================================================
// Round 8a (research/roster/round8/a.md): the last M_Char_Com weapon / prop PS: Use_FastSSSLight back light (bBackLight*), the
// UseToonSpecular form without stocking (bToonSpecM) and Use_ParallaxCrystal (bParallaxCrystal + the ray march below).
// =====================================================================================================================
// Use_ParallaxCrystal ray march (PS __24974 l.363-433): uvP = lerp(UV0, UV3, Parallax_UV0_UV3); off = -(T.V, B.V) / (N.V) * HeightRatio
// (T / B / N = the raw interpolated tangent frame); base = uvP * UVTile + off * (ReferencePlane - 1); steps = lerp(clamp((1 - saturate((|WP -
// WorldCameraOrigin| - 1000) * 0.001)) * MaxSteps, 1, 48), clamp(MinSteps, 1, 5), min(|N.V|, 1)); floor(steps) + 2 linear steps of 1 / steps from
// height 1 down (HightMap.r, SampleGrad with the coarse screen derivatives of base); at the first sample above the ray, 3 bisection
// steps between the previous and the current point. Returns the Parallax_Tex UV (base + accumulated offset).
float2 WuwaBPCrystalParallaxUV(Texture2D HightMap, SamplerState HightMapSampler, float2 UV0, float2 UV3, float3 T, float3 Bt, float3 Nv,
	float3 V, float3 WorldPosition, float3 WorldCameraOrigin, float Parallax_UV0_UV3, float Parallax_UVTile, float HeightRatio,
	float ReferencePlane, float MaxSteps, float MinSteps)
{
	float2 uvP = Parallax_UV0_UV3 * (UV3 - UV0) + UV0;
	float  tv = dot(T, V), bv = dot(Bt, V), nv = dot(Nv, V);
	float2 off = -float2(tv, bv) / nv;
	off = off * HeightRatio;
	float2 base = uvP * Parallax_UVTile + off * ((1.0 - ReferencePlane) * -1.0);   // preshader (1 - Plane) * -1 (exact: = Plane - 1)
	float3 dc = WorldPosition - WorldCameraOrigin;
	float  fade = saturate((sqrt(dot(dc, dc)) + -1000.0) * 0.001);
	float  ms = min(max((1.0 - fade) * MaxSteps, 1.0), 48.0);
	float  steps = min(abs(nv), 1.0) * (clamp(MinSteps, 1.0, 5.0) - ms) + ms;      // preshader clamp(MinSteps, 1, 5)
	float  limit = floor(steps) + 2.0;
	float  inv = 1.0 / steps;
	float2 dx = ddx_coarse(base), dy = ddy_coarse(base);
	float2 acc = float2(0.0, 0.0);
	float  z = 1.0, zp = 1.0;
	[loop] for (int i = 0; ; ++i)
	{
		if ((float)i >= limit)
			break;
		float h = HightMap.SampleGrad(HightMapSampler, base + acc, dx, dy).r;
		if (z < h)
		{
			float2 pA = -off * inv + acc;
			float2 cA = acc;
			float  pZ = zp, cZ = z;
			[loop] for (int j = 0; j < 3; ++j)
			{
				float2 s  = pA + cA;
				float2 mA = s * 0.5;
				float  mZ = (cZ + pZ) * 0.5;
				float  hm = HightMap.SampleGrad(HightMapSampler, s * 0.5 + base, dx, dy).r;
				if (mZ < hm)
				{
					cA = mA;
					cZ = mZ;
				}
				else
				{
					pA = mA;
					pZ = mZ;
				}
			}
			acc = cA;
			break;
		}
		acc = off * inv + acc;
		zp = z;
		z = z - inv;
	}
	return base + acc;
}

