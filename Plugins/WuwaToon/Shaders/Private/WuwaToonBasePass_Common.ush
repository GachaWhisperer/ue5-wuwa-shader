// ---- UseNormalMap off + UsePBR off + UseRampColor off: MainTex-only body (round 5) ----
// Only MainTex is bound; the NRM / MatCap / Ramp texture inputs of BodyUp are removed (their scalar parameters stay, unused).
// Lit = base colour, GBufferC = desaturate(Base * Bright), shadow colour = desaturate(skin-lerped subsurface colour).
#define WUWA_R5_SIG_MT Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float4 VertexColor, WUWA_R4_P_GEOM_REST, WUWA_R4_P_MAT1, 	float RampInt, WUWA_R4_P_MAT2, float CPD1, float CPD13, WUWA_R4_P_TAIL
