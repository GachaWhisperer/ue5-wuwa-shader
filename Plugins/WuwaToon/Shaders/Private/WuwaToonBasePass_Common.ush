#define WUWA_R5_A_MT_TAIL false, false, false, 1.0, false, true, false, float3(0.0, 0.0, 0.0), false, 0.0, false, 0.0, true
// PS __67268 (MI_R2T1TaohuaMd10011Bag, MI_EBulanteJuziMd10011): + UseVDLShadowoffset off + UseBreathLight
FWuwaToonGBuffer WuwaToonCommonBasePass_BodyUpNoNormalMapNoPBRNoRampNoVDLBreath(WUWA_R5_SIG_MT, WUWA_R4_P_BREATH)
{ return WuwaToonCommonBasePass_Impl(false, false, false, false, true, true, true, false, WUWA_R5_A_MT, WUWA_R4_A_BREATH, 1.0,
	WUWA_R4_A_NOXH, WUWA_R5_A_MT_TAIL); }
// PS __298548 (MI_R2T1SanhuaHuiyingMd10011, MI_ELingyangLionHeadMd10011, MI_DahuojiMd10011): as __67268 on a two-sided MI
FWuwaToonGBuffer WuwaToonCommonBasePass_BodyUpNoNormalMapNoPBRNoRampNoVDLBreathTwoSided(WUWA_R5_SIG_MT, WUWA_R4_P_BREATH, float TwoSidedSign)
{ return WuwaToonCommonBasePass_Impl(false, false, false, false, true, true, true, true, WUWA_R5_A_MT, WUWA_R4_A_BREATH, TwoSidedSign,
	WUWA_R4_A_NOXH, WUWA_R5_A_MT_TAIL); }
