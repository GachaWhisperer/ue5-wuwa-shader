// base colour (no specular / matcap / metal), GBufferC = desaturate(Lit * Bright); no MatCapTex (the Down inputs minus MatCapTex).
FWuwaToonGBuffer WuwaToonCommonBasePass_DownNoSkinRampCNoPBR(
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler, Texture2D TypeMask, SamplerState TypeMaskSampler,
