FWuwaToonGBuffer WuwaToonCommonBasePass_TypeMaskRampMaskParallax(WUWA_R4_SIG_TM, float VertexColorA, float3 WorldCameraOrigin,
	WUWA_R6_P_PARALLAX)
{
