// AniSwitch MaskTex atlas read (round 5 PS __105818 l.417-422; round 6 PS __112638 l.201-209, __286072 l.201-209): MaskTex at
// the AniSwitch_FaceShadow cell of a 2x4 atlas, frac((UV0 + cell) * (0.5, 0.25)) with cell = (floor(A - 1), floor((A - 1) / 2))
// (preshader cb[11] / cb[59]), only when A >= 0.1 (else UV0). Shared by the round-5 and round-6 wrappers.
float4 WuwaBPAniMaskAtlas(Texture2D MaskTex, SamplerState MaskTexSampler, float2 UV0, float AniSwitch_FaceShadow, float MaterialTextureMipBias)
{
	float2 cell  = float2(floor(AniSwitch_FaceShadow - 1.0), floor((AniSwitch_FaceShadow - 1.0) / 2.0));   // preshader cb[59]
	float2 aniUV = frac((UV0 + cell) * float2(0.5, 0.25));
	float  aniF  = (AniSwitch_FaceShadow >= 0.1) ? 1.0 : 0.0;
	float2 mUV   = aniF * (aniUV - UV0) + UV0;
	return MaskTex.SampleBias(MaskTexSampler, mUV, MaterialTextureMipBias);
}

// ---- AniSwitch dark/bright GBufferC from the MaskTex atlas (round 5) ----
// PS __105818 (MI_R2T1SanhuaMd10011Down / _Up): Down (stocking, RampInt) + UseSkinAllRampColor off (GBufferC without the ramp) with
// GBufferC = desaturate(lerp(Lit*Dark, Lit*Bright, MaskTex.b)), MaskTex sampled at the AniSwitch_FaceShadow 2x4 atlas cell
// (as WuwaToonBasePass_Face.ush: cell = (floor(A - 1), floor((A - 1) / 2)), only when A >= 0.1; l.417-422), + UseToonSpecular
// (bToonSpec: NoV-weighted MainTex.a toon specular added to the stocking base). MaskTex, AniSwitch_FaceShadow,
// AniSwitch_ShadowColorDark and SpecStrength appended.
FWuwaToonGBuffer WuwaToonCommonBasePass_DownNoSkinRampCAniMaskTexToonSpec(WUWA_R4_SIG_DOWN, Texture2D MaskTex, SamplerState MaskTexSampler,
	float AniSwitch_FaceShadow, float AniSwitch_ShadowColorDark, float SpecStrength)
{
	float  AniW  = WuwaBPAniMaskAtlas(MaskTex, MaskTexSampler, UV0, AniSwitch_FaceShadow, MaterialTextureMipBias).z;
	return WuwaToonCommonBasePass_Impl(true, true, false, true, false, false, false, false, WUWA_R4_A_DOWN, WUWA_R4_A_NOBREATH, 1.0,
		WUWA_R4_A_NOXH, false, false, false, AniSwitch_ShadowColorDark, false, false, false, float3(0.0, 0.0, 0.0), true, AniW,
		true, SpecStrength);
}

// ---- UsePBR off with stocking (round 5) ----
