	WUWA_R4_A_NOXH, WUWA_R5_A_MT_TAIL); }

// =====================================================================================================================
// Round 6 (research/roster/round6/common.md): AniSwitch MaskTex atlas decode (bAniMaskDecode). MaskTex at the AniSwitch_FaceShadow
// atlas cell (WuwaBPAniMaskAtlas, as PS __105818); .y replaces the MainTex.a shadow decode, .w the emission decode. Bodies of the
// masked "Alpha" MIs (the opacity mask is added by WuwaToonBasePass_CommonMasked.ush). MaskTex / AniSwitch_FaceShadow appended.
// =====================================================================================================================
// trailing _Impl arguments after bAniSwitchShadow / Dark: bHET, bNoPBR, bSecond, SecondC, bAniLitW, AniLitW, bToonSpec, SpecStrength,
// bNoNormalMap (all off), then bAniMaskDecode = true, MaskTex.y, MaskTex.w
#define WUWA_R6_A_ANIMASK(M) false, false, false, float3(0.0, 0.0, 0.0), false, 0.0, false, 0.0, false, true, M.y, M.w
// PS __112638 (MI_R2T1LupaMd10011Tail1): UseTypeMask (RampInt) + UseSkinAllRampColor off + two-sided + AniSwitch MaskTex decode
FWuwaToonGBuffer WuwaToonCommonBasePass_TypeMaskNoSkinRampCTwoSidedAniMaskDecode(WUWA_R4_SIG_TMRI, float TwoSidedSign,
	Texture2D MaskTex, SamplerState MaskTexSampler, float AniSwitch_FaceShadow)
