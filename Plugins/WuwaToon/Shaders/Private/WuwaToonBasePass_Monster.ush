// ---- ROUND 7 (research/roster/round7/singletons.md): M_CharMonster_SP ----
// PS caca5ab54d (#236962, MI_ELuokekeRuanniguaiMd10011B, Roccia prop; static switches UseGhost, UseFaceAniMap, UseSkinMask,
// UseMatCap, UseLightOffset_Yaw / _Pitch). Line refs S### = tools/shaderdiff/weapons/r3/monster_asm.py caca5ab54d (1-based).
// Not the M_CharMonster body: no normal map / PBR / matcap. The lit colour is the (FaceAniMap-blended) base colour; the emissive is
// the Ghost layer (UV3.y^4 top/bottom gradient x two Ghost_MudTex noise taps x COLOR0.b, plus an object-space fresnel band x
// Ghost_FresnelColorTex at a view-space "matcap" UV) + MainTex.a / face emission; GBufferB = Ghost_FresnelColorTex rim colour;
// the lit colour goes through a desaturation / contrast / lightness block (x BlendStat). Shared with M_CharMonster: light direction
// (WuwaMOLightDir), attack dark / fresnel pattern, selection, ShadowLord colour, MainTex.a toon shadow term, emissive tail.
// Packing: A.w = 0 (mode 0) / 1 (mode 1); B.a id 15 when Ghost_ToonRimColorMask > 0 else 12; C.a = Alpha (mode 0) / rim byte
// (mode 1); D = (ToonRimWidth, 0, 0, 0) in mode 0, 0 in mode 1. Two-sided (N x TwoSidedSign, re-normalised encode).
// Uniform expressions (CPU preshaders, spec kind uniform_expression): Ghost_NoiseSpeed2 = Ghost_NoiseTilling.zw * 0.05,
// Ghost_FresnelSizeEnd = Ghost_FresnelSize + 0.15, AniSwitch_FaceOffset = (floor(AniSwitch_Face - 1),
// floor((AniSwitch_Face - 1) / AniSwitch_Face_Int)), AniSwitch_FaceInvInt = 1 / AniSwitch_Face_Int,
// Main_ContrastLo = 0 - Main_Contrast, Main_ContrastHi = Main_Contrast + 1.
FWuwaToonGBuffer WuwaToonMonsterSPBasePass_GhostFaceAni2S(
	Texture2D Ghost_MudTex, SamplerState Ghost_MudTexSampler,
	Texture2D Ghost_FresnelColorTex, SamplerState Ghost_FresnelColorTexSampler,
	Texture2D FaceAniMap, SamplerState FaceAniMapSampler,
	Texture2D MainTex, SamplerState MainTexSampler,
	Texture2D ShadowLord_ColorTex, SamplerState ShadowLord_ColorTexSampler,
	float2 UV0, float2 UV2, float2 UV3, float VertexColorB, float3 WorldTangent, float3 WorldNormal, float TangentSign, float TwoSidedSign,
	float3 WorldPosition, float3 TranslatedWorldPosition, float3 CameraVector,
	float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float3 Ghost_BottonColor, float3 Ghost_TopColor, float4 Ghost_NoiseTilling, float2 Ghost_NoiseSpeed2,
	float Ghost_FresnelSize, float Ghost_FresnelSizeEnd, float4 Ghost_FresnelColorTexTilling, float3 Ghost_FresnelColorMulti,
	float Ghost_RimColorIntensity, float Ghost_ToonRimColorMask,
	float2 AniSwitch_FaceOffset, float AniSwitch_FaceInvInt, float FaceAniEmissionStrength,
	float3 MainTexColorTint, float FresnelAttackFactor, float Main_EmissionPower, float3 EmissionColor,
	float AttackDarkScale, float AttackFresnelRimRange, float3 AttackFresnelRimColor, float AttackFresnelRimIntensity,
	float4 SelectionColor, float Main_Desaturation, float Main_ContrastLo, float Main_ContrastHi, float Main_Lightness, float BlendStat,
	float4 ShadowLord_ColorTiling, float3 ShadowLord_ColorMulti, float ShadowLord_ColorOpacity, float UseShadowLordMaterialDynamic,
	float SolidShadowThreshold, float ShadowOffset, float ShadowRange, float SolidShadowStrength, float ToonRimWidth, float Alpha,
	float UseLightOffset_Yaw_DYN, float LightOffset_Yaw,
	float CPD0, float CPD1, float MPC_GlobalCharacterVerticalRotation, float3 MPC_GlobalCharacterDebugLightDirection,
	float4 ToonLight0, float4 ToonLight3, float3 PrimWorldToLocal0, float3 PrimWorldToLocal1, float3 PrimWorldToLocal2,
	float4x4 TranslatedWorldToView, float MaterialTextureMipBias, float4 NormalOverrideParameter, float KuroGBufferMode,
	float3 KuroEmissiveScale, float KuroSkipEmissiveScale, float OutOfBoundsMask, float3 ObjectWorldPosition, float3 ObjectBounds,
	uint LightingChannelMask, float GameTime)
{
	FWuwaToonGBuffer G;
	const float3 V = CameraVector;

	// S1-5: bitangent, screen UV
	float3 TangentY = cross(WorldNormal, WorldTangent) * TangentSign;
	float2 ScreenUV = (SvPositionXY - ViewRectMin) * ViewSizeAndInvSize.zw;

	// S17-33: vertex normal (sqrt / div), View[144] override in tangent space, to world (rsq), x TwoSidedSign
	float3 nN = WorldNormal / sqrt(dot(WorldNormal, WorldNormal));
	float3 nT = float3(dot(WorldTangent, nN), dot(TangentY, nN), dot(WorldNormal, nN));
	nT = nT * NormalOverrideParameter.w + NormalOverrideParameter.xyz;
	nT = nT * rsqrt(dot(nT, nT));
	float3 N = TangentY * nT.y;
	N = nT.x * WorldTangent + N;
	N = nT.z * WorldNormal + N;
	N = N * rsqrt(dot(N, N));
	N = TwoSidedSign * N;

	// S34-41: Ghost gradient lerp(top, bottom, UV3.y^4); 0 inside the pow guard band
	float  Dark0 = 1.0 - UV3.y;
	float  y2 = UV3.y * UV3.y;
	float  y4 = y2 * y2;
	float3 gd = y4 * (Ghost_BottonColor - Ghost_TopColor);
	if (asfloat(0x33000002u) >= UV3.y)
	{
		gd = float3(0.0, 0.0, 0.0);
	}
	float3 Ghost = gd + Ghost_TopColor;

	// S42-56: two Ghost_MudTex noise taps on UV3
	float2 n1;
	n1.x = UV3.x * Ghost_NoiseTilling.x + GameTime * Ghost_NoiseTilling.z;
	n1.y = (UV3.y * Ghost_NoiseTilling.y) * 0.5 + GameTime * Ghost_NoiseTilling.w;
	float3 G1 = Ghost_MudTex.SampleBias(Ghost_MudTexSampler, n1, MaterialTextureMipBias).xyz;
	float2 n2 = (UV3 * Ghost_NoiseTilling.xy) * float2(1.5, asfloat(0x3F333333u)) + GameTime * Ghost_NoiseSpeed2;
	n2 = (n2 - G1.x) * asfloat(0x3F4CCCCDu) + G1.x;
	float  G2 = Ghost_MudTex.SampleBias(Ghost_MudTexSampler, n2, MaterialTextureMipBias).x;
	Ghost = Ghost * (G2 * G1);

	// S57-75: object-space fresnel band (WorldToLocal rows = Primitive[6..8]): normalize(N_local.xy, V_local.z) . V_local, smoothstep
	float3x3 W2L = float3x3(PrimWorldToLocal0, PrimWorldToLocal1, PrimWorldToLocal2);
	float3 lV = mul(V, W2L);
	float3 lF = float3(mul(N, W2L).xy, lV.z);
	lF = lF / sqrt(dot(lF, lF));
	float  fz = saturate((dot(lF, lV) - Ghost_FresnelSizeEnd) * (1.0 / (Ghost_FresnelSize - Ghost_FresnelSizeEnd)));
	fz = min(WuwaMOSmooth(fz), 1.0);

	// S76-94: view-space "matcap" UV (Pv summed in (y, z, x) order) -> Ghost_FresnelColorTex x fresnel band x multiplier
	float3 Pv = mul(float4(TranslatedWorldPosition, 1.0), TranslatedWorldToView).xyz;
	float3 PvYZX = min(Pv.yzx, 3.402823466e+38);   // pins the (y, z, x) summation order of the original dp3
	Pv = Pv / sqrt(dot(PvYZX, PvYZX));
	float3 Nv = mul(N, (float3x3)TranslatedWorldToView);
	float2 FUV = float2(Pv.z * Nv.x - Pv.x * Nv.z, Pv.y * Nv.z - Pv.z * Nv.y) * 0.5 + 1.5;
	FUV = FUV * Ghost_FresnelColorTexTilling.xy;
	float3 GF = Ghost_FresnelColorTex.SampleBias(Ghost_FresnelColorTexSampler, FUV * 0.5, MaterialTextureMipBias).xyz;
	GF = (fz * GF) * Ghost_FresnelColorMulti;
	Ghost = VertexColorB * Ghost + GF;

	// S95-112: FaceAniMap atlas cell (mip bias - 1) blended over MainTex; base colour with the fresnel-attack grey
	float2 auv = frac((UV2 + AniSwitch_FaceOffset) * AniSwitch_FaceInvInt);
	float4 FA = FaceAniMap.SampleBias(FaceAniMapSampler, auv, MaterialTextureMipBias + -1.0);
	float  faceEm = (asfloat(0x3F4CCCCDu) >= FA.a) ? 0.0 : FaceAniEmissionStrength;
	float4 MT = MainTex.SampleBias(MainTexSampler, UV0, MaterialTextureMipBias);
	float  fb = (FA.a >= asfloat(0x3EE66666u)) ? 1.0 : 0.0;
	float3 Col = fb * (FA.rgb - MT.rgb) + MT.rgb;
	float3 TexColor = Col * MainTexColorTint;
	float  lum = dot(TexColor, float3(0.3, 0.59, 0.11));
	lum = saturate((lum + -0.1) * 0.3 + lum);
	float3 BaseCol = FresnelAttackFactor * (lum - MainTexColorTint * Col) + TexColor;

	// S113-127: MainTex.a emission (x (1 + face emission)) + Ghost
	float ep = exp2(log2(MT.a) * Main_EmissionPower);
	float ew = (min(max(MT.a, 0.5), asfloat(0x3F666666u)) + -0.5) * 2.5;
	ew = ew * ((ep >= 0.5) ? 1.0 : 0.0);
	float3 EmC = (ew * BaseCol) * EmissionColor;
	EmC = faceEm * EmC + EmC;
	float3 E0 = Ghost + EmC;
	float  emLum = dot(E0, float3(0.3, 0.59, 0.11));

	// S128-134: attack dark scale on 1 - UV3.y
	float Dark = (asfloat(0x33000002u) >= Dark0) ? asfloat(0x3DCCCCCDu) : min(max(exp2(log2(Dark0) * AttackDarkScale), asfloat(0x3DCCCCCDu)), 1.0);

	// S135-163: attack fresnel rim (vertex normal) with the screen dot pattern, x saturate(-view-space vertex normal y)
	float2 dots = frac(ScreenUV * float2(2.0, 200.0)) + -0.5;
	bool   inDot = (0.5 >= sqrt(dot(dots, dots)));
	float  fr0 = 1.0 - dot(nN, V);
	float  fr = (asfloat(0x33000002u) >= fr0) ? 0.0 : min(exp2(log2(fr0) * AttackFresnelRimRange), 1.0);
	float  inv = 1.0 - fr;
	inv = inv * ((asfloat(0x3F666666u) >= inv) ? 1.0 : 0.0);
	float  pat = inDot ? 0.0 : inv;
	float  frm = fr * ((fr >= asfloat(0x3DCCCCCDu)) ? 1.0 : 0.0);
	pat = frm * (1.0 - pat) + pat;
	float  down = saturate(-mul(WorldNormal, (float3x3)TranslatedWorldToView).y);
	pat = down * pat;

	// S164-171: attack emissive, selection
	float3 Rim = ((pat * AttackFresnelRimColor) * AttackFresnelRimIntensity) * FresnelAttackFactor;
	Rim = emLum * Dark + Rim;
	float3 E = FresnelAttackFactor * (Rim - E0) + E0;
	E = SelectionColor.a * (SelectionColor.rgb - E) + E;

	// S172-186: dark scale, desaturation / contrast / lightness (x BlendStat), ShadowLord colour -> GBufferC.rgb
	float3 Lit = FresnelAttackFactor * (BaseCol * Dark - BaseCol) + BaseCol;
	float  ld = dot(Lit, float3(0.3, 0.59, 0.11));
	float3 Lc = Main_Desaturation * (ld - Lit) + Lit;
	Lc = saturate(Lc * (Main_ContrastHi - Main_ContrastLo) + Main_ContrastLo);
	Lc = Lc * Main_Lightness - Lit;
	Lit = BlendStat * Lc + Lit;
	float2 sluv = (GameTime * ShadowLord_ColorTiling.zw + UV3) * ShadowLord_ColorTiling.xy;
	float3 SL = ShadowLord_ColorTex.SampleBias(ShadowLord_ColorTexSampler, sluv, MaterialTextureMipBias).rgb;
	SL = (SL * ShadowLord_ColorMulti + 0.1) * ShadowLord_ColorOpacity;
	G.C.rgb = UseShadowLordMaterialDynamic * SL + Lit;

	// S220-238: emissive tail
	G.Emissive = WuwaBPFinalEmissive(E, KuroSkipEmissiveScale, KuroEmissiveScale, OutOfBoundsMask,
		WorldPosition, ObjectWorldPosition, ObjectBounds);

	// S239-243: Ghost rim colour (Ghost_FresnelColorTex, scrolled) -> GBufferB.rgb
	float2 ruv = FUV * 0.5 + GameTime * Ghost_FresnelColorTexTilling.zw;
	float3 GR = Ghost_FresnelColorTex.SampleBias(Ghost_FresnelColorTexSampler, ruv, MaterialTextureMipBias).xyz * Ghost_RimColorIntensity;

	// S244-262 / S263-373: MainTex.a toon shadow term (half-Lambert on the vertex normal) -> GBufferA.z
	float sm = ((MT.a >= 0.0) ? 1.0 : 0.0) * ((asfloat(0x3EC28F5Cu) >= MT.a) ? 1.0 : 0.0);
	sm = sm * (0.5 - MT.a) + 0.5;
	float t2 = sm - SolidShadowThreshold;
	float so = sm + ShadowOffset;
	float k2 = (t2 / (1.0 - SolidShadowThreshold)) * (1.0 - so);
	so = saturate(WuwaMOSignSat(t2) * k2 + so);
	float3 L = WuwaMOLightDir(MPC_GlobalCharacterVerticalRotation, CPD0, CPD1, UseLightOffset_Yaw_DYN, LightOffset_Yaw,
		MPC_GlobalCharacterDebugLightDirection, ToonLight0, ToonLight3, ObjectWorldPosition);
	float HL = dot(nN, L) * 0.5 + 0.5;
	so = so * asfloat(0x3F82EE63u) - HL;
	so = (so + ShadowRange * -1.0) / ShadowRange;
	so = 1.0 - saturate(so + 1.0);
	G.A.z = (so * 0.5 + 0.5) * (1.0 - (1.0 - 1.0) * SolidShadowStrength);

	// S374-432: packings
	float3 Ne = N * rsqrt(dot(N, N));
	G.A.xy = WuwaBPOctEncode(Ne);
	G.B.rgb = sqrt(saturate(GR));
	G.B.a = WuwaBPShadingModelByte(LightingChannelMask, (0.0 < Ghost_ToonRimColorMask) ? 15u : 12u);
	if (KuroGBufferMode == 1.0)
	{
		G.C.a = WuwaBPRimByteEven(ToonRimWidth);
		G.D = float4(0.0, 0.0, 0.0, 0.0);
		G.A.w = 1.0;
	}
	else
	{
		G.D = float4(ToonRimWidth, 0.0, 0.0, 0.0);
		G.A.w = 0.0;
		G.C.a = Alpha;
	}
	return G;
}

// VS #236944 (815bd27e, M_CharMonster_SP UseGhost): always-on Ghost world-position offset (lines V175-217 of the precise main path),
// in world space; the caller adds it to the translated world position before the Kuro primitive offset / TranslatedWorldToClip.
//   f   = pow-guarded square of saturate(2 ObjectRadius / |LocalBoundsMax - LocalBoundsMin| x 3 / sum |LocalToWorld axis|)
//   ph  = ((1 - smoothstep01(saturate((UV3.y 0.7 0.5 + 0.5) 1.25))) x f WavySize + Time x TimeSpeed) x 2pi
//   WPO = LocalToWorld x ((sin ph, cos ph, 0) x f WPOsize x VertexColor.r x f)
// Every statement is `precise` like the original (the axis lengths keep the 0 x row terms of TransformLocalVector).
float3 WuwaToonMonsterSPGhostWPO(float2 UV3, float VertexColorR, float3 LocalToWorldRow0, float3 LocalToWorldRow1,
	float3 LocalToWorldRow2, float ObjectRadius, float3 LocalObjectBoundsMin, float3 LocalObjectBoundsMax, float GameTime,
	float Ghost_WPOWavySize, float Ghost_WPOTimeSpeed, float Ghost_WPOsize)
{
	precise float f = ObjectRadius * 2.0;
	precise float3 bd = LocalObjectBoundsMax - LocalObjectBoundsMin;
	precise float bl = sqrt(dot(-bd, -bd));
	f = f / bl;
	precise float3 z0 = LocalToWorldRow0 * 0.0;
	precise float3 z1 = LocalToWorldRow1 * 0.0;
	precise float3 z2 = LocalToWorldRow2 * 0.0;
	precise float3 ax = (z1 + LocalToWorldRow0) + z2;
	precise float3 ay = z2 + (z0 + LocalToWorldRow1);
	precise float3 az = (z1 + z0) + LocalToWorldRow2;
	precise float lx = sqrt(dot(-ax, -ax));
	precise float ly = sqrt(dot(-ay, -ay));
	precise float lz = sqrt(dot(-az, -az));
	precise float ls = lx + ly;
	ls = ls + lz;
	precise float k3 = 3.0 / ls;
	f = saturate(f * k3);
	precise float f2 = f * f;
	f = (asfloat(0x33000002u) >= f) ? 0.0 : f2;
	precise float s = UV3.y * asfloat(0x3F333333u);
	s = s * 0.5;
	s = s + 0.5;
	s = saturate(s * 1.25);
	precise float sk = s * -2.0;
	sk = sk + 3.0;
	precise float s2 = s * s;
	s = s2 * sk;
	s = 1.0 - s;
	precise float wv = f * Ghost_WPOWavySize;
	s = s * wv;
	precise float tt = GameTime * Ghost_WPOTimeSpeed;
	s = s + tt;
	s = s * asfloat(0x40C90FDBu);
	precise float sn, cs;
	sincos(s, sn, cs);
	precise float a = f * Ghost_WPOsize;
	precise float3 o = float3(a * sn, a * cs, 0.0);
	o = VertexColorR * o;
	o = f * o;
	precise float3 w0 = o.x * LocalToWorldRow0;
	precise float3 w1 = o.y * LocalToWorldRow1;
	precise float3 w = w1 + w0;
	precise float3 w2 = o.z * LocalToWorldRow2;
	w = w + w2;
	return w;
}
// ---- END ROUND 7 ----

#endif // WUWA_MONSTER_USH
