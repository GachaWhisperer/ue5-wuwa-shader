// =====================================================================================================================
// ROUND 7 (singletons, research/roster/round7/singletons.md): M_FlashDiamond_MP vertex-animation-texture WPO of base-pass
// VS #185988 (68344a278e; MI_EYounuoYuegongMd10011_Suishi, Iuno prop). The PS of that map is WuwaFlashDiamondMP_StructureDiamond
// (WuwaToonBasePass_DepthFX.ush, round 3); this is only its always-on World Position Offset. V### = asm lines of
// evidence/roster/shadermaps/weapons/asm/185988_*.asm.txt (V83-111):
//   t = VertexAnim_TimeDebug * (VertexAnim_Frame - 1);  f = floor(t)
//   s = lerp(Morph(UV1.x, f * inv + inv / 2), Morph(UV1.x, (f + 1) * inv + inv / 2), frac(t)),  inv = 1 / ceil(VertexAnim_Frame)
//   WPO = (s.x * L2W[0] + s.y * L2W[1] + s.z * L2W[2]) * VertexAnim_Strength   (local vector -> world, scale included)
// MorphTexture = Kuro VS t8 / s3, SampleLevel LOD -1 (vertex texture fetch as compiled); [I] the parameter name is inferred
// (the only VS material texture, VAT layout; cooked maps carry no texture names for this slot). UV1X = texcoord 1 .x
// (GPU-skin passthrough fetch of texcoord min(NumTexCoords - 1, 1)). (VertexAnim_Frame - 1), 1 / ceil(VertexAnim_Frame) and
// (1 / ceil(VertexAnim_Frame)) * 0.5 are CPU preshader values (uniform expressions). All arithmetic is `precise` like the original.
// UE contract: connect to World Position Offset (absolute-space offset added to the translated world position).
// ---------------------------------------------------------------------------------------------------------------------
float3 WuwaFlashDiamondMPVATWPO(Texture2D MorphTexture, SamplerState MorphTextureSampler, float UV1X,
	float3 LocalToWorldRow0, float3 LocalToWorldRow1, float3 LocalToWorldRow2,
	float VertexAnim_TimeDebug, float VertexAnim_FrameMinus1, float VertexAnim_InvFrames, float VertexAnim_HalfInvFrames,
	float VertexAnim_Strength)
{
	precise float t = VertexAnim_TimeDebug * VertexAnim_FrameMinus1;             // V83
	precise float f = floor(t);                                                  // V84 round_ni
	precise float v0 = f * VertexAnim_InvFrames;
	v0 = v0 + VertexAnim_HalfInvFrames;
	precise float3 s0 = MorphTexture.SampleLevel(MorphTextureSampler, float2(UV1X, v0), -1.0).xyz;   // V88
	precise float f1 = f + 1.0;
	f1 = f1 * VertexAnim_InvFrames;
	precise float v1 = f1 + VertexAnim_HalfInvFrames;
	precise float3 s1 = MorphTexture.SampleLevel(MorphTextureSampler, float2(UV1X, v1), -1.0).xyz;   // V92
	precise float fr = frac(t);
	precise float3 s = s1 - s0;
	s = fr * s;
	s = s + s0;                                                                   // V96
	precise float3 w = s.x * LocalToWorldRow0;
	precise float3 w1 = s.y * LocalToWorldRow1;
	w = w1 + w;
	precise float3 w2 = s.z * LocalToWorldRow2;
	w = w + w2;
	w = w * VertexAnim_Strength;                                                  // V102 x cb5[48].x
	return w;
}

#endif // WUWA_SPECIAL_DIAMOND_USH
