// New file (owned by round-8 agent b). Includes WuwaToonBasePass_Common.ush (whose _Impl got the trailing switches bFaceRamp /
// FaceRampPre / bCurve / CurveV) and the read-only WuwaFaceSDFSetup helper of WuwaToonBasePassShared.ush.
//   PS __317009 (MI_R5Gun503Md20001, _R folder) = PS __264549 + face-SDF ramp U          (l.408-457)
//   PS __85365  (MI_ELuhesiSickleMd10011_R_Bengti) = PS __83931 + curve-atlas ramp V       (l.416-417)
//   PS __260533 (MI_R5Sword509Md20001) = PS __80721 + face-SDF ramp U + curve-atlas ramp V (l.384-433)
#pragma once
