// UseFaceRamp ramp U before the threshold (PS __317009 l.408-453 = the face base pass's F172-221 with the Common light direction L):
// SDF.b of MaskTex at the WuwaFaceSDFSetup UV, read with Sample (no mip bias) and the shared clamp sampler; pow guard 0x33000002.
float WuwaBPCommonFaceRampPre(Texture2D MaskTexSDF, SamplerState MaskTexSDFClampSampler, float2 UV0, float3 L,
	float3 CPD_HeadForward, float3 CPD_HeadSide, float CPD11, float CPD12, float SDFPitchPosition)
{
	FWuwaFaceSDFSetup S = WuwaFaceSDFSetup(L, CPD_HeadForward, CPD_HeadSide, CPD11, CPD12, UV0, SDFPitchPosition);
	float b = MaskTexSDF.Sample(MaskTexSDFClampSampler, S.SdfUV).b;
	float A = (asfloat(0x33000002u) >= b) ? 1.0 : 1.0 - exp2(log2(b) * 1.5);
	float q = (A - S.T) + 1.0;
	return -q * 0.5 + 1.5;
}

// UseCurve ramp V (CurveAtlasRowParameter): (Param + 0.5) / TextureSize(atlas).x. Kuro adds 0.5 on the CPU (preshader, float32) and
// divides on the GPU; the float32 add is the same correctly rounded operation here.
float WuwaBPCurveV(float Param, float CurveAtlasSizeX)
{
	precise float row = Param + 0.5;
	return row / CurveAtlasSizeX;
}

