// WuwaToonBasePass_WaterFX.ush — Kuro water / liquid effect materials on character props (round 3, batch "waterfx"):
//   M_AdvancedEffect_WaterMatCap_CM   (Suisui fan faces: refraction + T-Flow matcap normal + water-cloth colour curve)
//   M_AdvancedEffect_ParallaxSubUV_CM (Suisui fan mountains: parallax sub-UV layers)
//   M_AdvancedEffect_WaterCloth_CM    (Suisui water curtain)
//   M_CharWP_Gobletliquid             (Luuk Herssen test tubes, Rebecca drink: masked unlit liquid with fill level)
// research/roster/Port_Weapons_Specials.md (round 3). Unlit effect maps: every entry returns FWuwaFXOutput
// {Emissive, Opacity} ("resolve": false); the Kuro forward tail (primitive fade, fog, emissive scale, OOB, Kuro effect
// grading, o1) is engine side and only reproduced in the diff harness.
//
// How the entries are written: each entry is a transliteration of the original DXBC material part (one HLSL statement per
// instruction on the original register names, generated by tools/shaderdiff/weapons/r3/waterfx_gen.py), with
//   * every Material-CB operand replaced by its Kuro parameter expression (decoded from the map's own preshader opcodes:
//     the entry receives the raw MI parameter values and re-derives each preshader on the GPU);
//   * preshader sub-expressions a GPU cannot reproduce bit-exactly (cos/sin of rotations, sqrt/dot normalisations, cross
//     products, texture sizes) as "uniform_expression" inputs evaluated on the CPU in float32 (spec: expr + opcode bytes);
//   * engine values as named inputs (view, primitive, MPC, interpolants; scene colour as an engine texture).
// Comparison masks are bool b<reg>_<comp>, integer temporaries int i<reg>_<comp> / uint u<reg>_<comp>.
#ifndef WUWA_WATERFX_USH
#define WUWA_WATERFX_USH

#include "WuwaToonBasePass_WeaponShared.ush"   // FWuwaFXOutput, WuwaPrimDitherClip (read-only)

// M_CharWP_Gobletliquid opacity dither: 3x3 threshold table indexed by (x mod 3) * 3 + (y mod 3) of the view-relative
// pixel (the original's immediate constant buffer; .x used): 0, 7/9, 3/9, 6/9, 5/9, 2/9, 4/9, 1/9, 8/9.
static const float4 WuwaWFXGobletDither3x3[9] = {
	float4(0.0, 0.0, 0.0, 0.0), float4(asfloat(0x3F471C72u), 0.0, 0.0, 0.0), float4(asfloat(0x3EAAAAABu), 0.0, 0.0, 0.0),
	float4(asfloat(0x3F2AAAABu), 0.0, 0.0, 0.0), float4(asfloat(0x3F0E38E4u), 0.0, 0.0, 0.0), float4(asfloat(0x3E638E39u), 0.0, 0.0, 0.0),
	float4(asfloat(0x3EE38E39u), 0.0, 0.0, 0.0), float4(asfloat(0x3DE38E39u), 0.0, 0.0, 0.0), float4(asfloat(0x3F638E39u), 0.0, 0.0, 0.0) };

// M_CharWP_Gobletliquid vertex WPO (VS #137289 lines 172-244; World Position Offset of the PS 2ffca9d7b1 / e54f81f6b9 specs).
// Vertex colour B selects a group value (B == 0 -> 0; B in [0.08, 0.12] -> WPOGroup1.x, [0.18, 0.22] -> .y, [0.28, 0.32]
// -> .z, [0.38, 0.42] -> .w, [0.48, 0.52] -> WPOGroup2.x, [0.58, 0.62] -> .y, [0.68, 0.72] -> .z, [0.78, 0.82] -> .w, else 0),
// plus a wave sin(2pi (GameTime * WPOSpeed + B)) * WPOWave, all x (B > 0), along normalize(UP_Vector) (CPU uniform
// expression) scaled per axis by the object scale |LocalToWorld rows| (computed as the original's ObjectScale node, with
// the 0 * row terms kept: precise). Absolute-space offset, added to the translated world position.
float3 WuwaFXGobletLiquidWPO(float VertexColorB, float GameTime, float3 LocalToWorldRow0, float3 LocalToWorldRow1,
	float3 LocalToWorldRow2, float4 WPOGroup1, float4 WPOGroup2, float WPOSpeed, float WPOWave, float4 UP_Vector_Normalized)
{
	float c = VertexColorB;
	precise float on = (0.0 >= c) ? 0.0 : 1.0;
	precise float t = GameTime * WPOSpeed;
	t = c + t;
	t = t * asfloat(0x40C90FDBu);
	precise float s = sin(t);
	s = s * WPOWave;
	float g = 0.0;
	bool hit = false;
	if (c == 0.0)
	{
		g = 0.0; hit = true;
	}
	else if (c >= asfloat(0x3DA3D70Au) && asfloat(0x3DF5C28Fu) >= c)
	{
		g = WPOGroup1.x; hit = true;
	}
	else if (c >= asfloat(0x3E3851ECu) && asfloat(0x3E6147AEu) >= c)
	{
		g = WPOGroup1.y; hit = true;
	}
	else if (c >= asfloat(0x3E8F5C29u) && asfloat(0x3EA3D70Au) >= c)
	{
		g = WPOGroup1.z; hit = true;
	}
	else
	{
		bool b0 = c >= asfloat(0x3EC28F5Cu) && asfloat(0x3ED70A3Du) >= c;   // 0.38 .. 0.42
		bool b1 = c >= asfloat(0x3EF5C28Fu) && asfloat(0x3F051EB8u) >= c;   // 0.48 .. 0.52
		bool b2 = c >= asfloat(0x3F147AE1u) && asfloat(0x3F1EB852u) >= c;   // 0.58 .. 0.62
		bool b3 = c >= asfloat(0x3F2E147Bu) && asfloat(0x3F3851ECu) >= c;   // 0.68 .. 0.72
		bool b4 = c >= asfloat(0x3F47AE14u) && asfloat(0x3F51EB85u) >= c;   // 0.78 .. 0.82
		float v = b3 ? WPOGroup2.z : WPOGroup2.w;
		v = b2 ? WPOGroup2.y : v;
		v = b1 ? WPOGroup2.x : v;
		g = b0 ? WPOGroup1.w : v;
		hit = b0 || b1 || b2 || b3 || b4;
	}
	g = hit ? g : 0.0;
	precise float h = g + s;
	h = on * h;
	precise float3 o = h * UP_Vector_Normalized.xyz;
	precise float3 m1 = LocalToWorldRow1 * 0.0;
	precise float3 ax = m1 + LocalToWorldRow0;
	precise float3 m2 = LocalToWorldRow2 * 0.0;
	ax = ax + m2;
	precise float3 m0 = LocalToWorldRow0 * 0.0;
	precise float3 ay = m0 + LocalToWorldRow1;
	ay = m2 + ay;
	precise float3 az = m1 + m0;
	az = az + LocalToWorldRow2;
	precise float3 sc = float3(sqrt(dot(-ax, -ax)), sqrt(dot(-ay, -ay)), sqrt(dot(-az, -az)));
	return o * sc;
}

// ---- GENERATED WaterFX entries (tools/shaderdiff/weapons/r3/waterfx_gen.py) - do not edit by hand ----
// M_AdvancedEffect_WaterMatCap_CM PS b7984d7ec8 (#283113, 405 material instr): Noise (signed 2D) x NoiseMask, matcap
// normal from a T-Flow flipbook (two frames blended, motion vectors), Base, Dissolve, pseudo refraction of the scene
// colour (Refraction_Tex offset), matcap (rotating, parallax), Second, water-cloth colour curve (WCColor).
FWuwaFXOutput WuwaFXWaterMatCap_RefractionTFlowCurve(
	Texture2D SceneColor, SamplerState SceneColorSampler, Texture2D Noise, SamplerState NoiseSampler,
	Texture2D NoiseMask, SamplerState NoiseMaskSampler, Texture2D MatcapNormal_TFlowMotionVecFlipbook,
	SamplerState MatcapNormal_TFlowMotionVecFlipbookSampler, Texture2D MatcapNormal_TFlowFlipbook,
	SamplerState MatcapNormal_TFlowFlipbookSampler, Texture2D Base, SamplerState BaseSampler, Texture2D Dissolve,
	SamplerState DissolveSampler, Texture2D Refraction_Tex, SamplerState Refraction_TexSampler, Texture2D MetalMatcap,
	SamplerState MetalMatcapSampler, Texture2D Second, SamplerState SecondSampler, Texture2D WCColorTex,
	SamplerState WCColorTexSampler, float3 WorldTangent, float3 WorldNormal, float TangentSign, float2 UV0, float2 UV1,
	float4 SvPosition, float3 TranslatedWorldPosition, float4x4 TranslatedWorldToView, float2 ViewRectMin,
	float4 ViewSizeAndInvSize, float4 KuroBufferSizeAndInvSize, float4 KuroBufferBilinearUVMinMax, float GameTime,
	float MaterialTextureMipBias, float3 KuroViewLightColorA, float3 KuroViewLightColorB, float KuroEffectSaturation,
	float MPC_KuroEffectColorGradingDesaturate, float3 MPC_KuroEffectColorGradingTint, float EffectTime,
	float UseSpecificTime, float EffectTimeScale, float MatcapNormal_TFlowFramerate, float MatcapNormal_TFlowColumn,
	float MatcapNormal_Row, float4 Noise_UVSwitch, float4 Noise_UV, float Noise_bScreenUV, float Noise_Offset,
	float Noise_UseSigned2D, float Noise_Strength, float4 NoiseMask_UV, float4 NoiseMask_UVSwitch,
	float NoiseMask_bScreenUV, float bInvertNoiseMask, float MatcapNormal_NoiseStrength,
	float MatcapNormal_TFlow_MotionIntensity, float MatcapNormal_PowerGMap, float MatcapNormal_InvertTransmission,
	float MatcapNormal_AlphaForFullTransmission, float MatcapNormal_UseTexBTransmission,
	float MatcapNormal_OpacityStrength, float4 Base_UVSwitch, float4 Base_UV, float Base_bScreenUV, float Base_bClamp,
	float4 Base_UV_Offset, float Base_NoiseStrength, float Base_bClampAfterNoise, float4 Base_AlphaSwitch,
	float Base_Alpha_Multiply, float Matcap_AlphaMutiplyAfterMatcap, float4 Dissolve_UV, float4 Dissolve_UVSwitch,
	float Dissolve_bScreenUV, float DIssolve_TimeOffset, float Dissolve_bClamp, float Dissolve_NoiseStrength,
	float Dissolve_UOffset, float Dissolve_VOffset, float4 Dissolve_ChannelSwitch, float Dissolve_MaskLerp,
	float Dissolve_Invert, float Dissolve_Smooth, float Dissolve_Dissolve, float Refraction_EdgeWidth,
	float Refraction_RefractStrength, float Refraction_RefractDistance, float4 Refraction_UV,
	float4 Refraction_UVSwitch, float Refraction_bScreenUV, float Refraction_bClamp, float4 Refraction_UV_Offset,
	float Refraction_NoiseStrength, float Matcap_Rotation, float Matcap_RotationSpeed, float MatcapNormal_Strength,
	float MatcapNormal_ParalloxHeight, float Matcap_NoiseStrength, float MatcapIntensity, float4 Second_UVSwitch,
	float4 Second_UV, float Second_bScreenUV, float Second_bClamp, float4 Second_UV_Offset, float4 Second_Contorl,
	float4 Base_EmissiveSwitch, float Base_bUseChannelAsEmissive, float4 Base_Refine, float Base_Emissive_Add,
	float Base_bAddSecond, float4 Base_ColorTint, float Matcap_AddedToBase, float Refraction_BlendInBaseColor,
	float4 WCColor_UV, float4 WCColor_UVSwitch, float WCColor_bScreenUV, float WCColor_bClamp, float4 WCColor_Control,
	float Use_bUVVAsCurveInput, float WCColorCurve, float Refraction_EdgeSoftnessDistance,
	float Refraction_EdgeSoftness, float Refraction_EmissivePremultBoost, float4 Dissolve_EdgeColor,
	float LightColorStrength, float4 NiagaraShiftLowGrayColor, float4 NiagaraShiftHighGrayColor,
	float NiagaraShiftColorParam, float4 SelectionColor, float Refraction_OpacityMultiplyAfterRefrac,
	float E_Dither_DitherValue, float E_Dither_UseDither, float ScreenFadeFrom, float ScreenFadeDistance,
	float4 Noise_RotCos, float4 Noise_RotSin, float4 NoiseMask_RotCos, float4 NoiseMask_RotSin, float4 Base_RotCos,
	float4 Base_RotSin, float4 Dissolve_RotCos, float4 Dissolve_RotSin, float4 Refraction_RotCos,
	float4 Refraction_RotSin, float4 Second_RotCos, float4 Second_RotSin, float4 WCColor_RotCos, float4 WCColor_RotSin,
	float4 TextureSize8)
{
	FWuwaFXOutput X;
	float4 r0 = 0.0, r1 = 0.0, r2 = 0.0, r3 = 0.0, r4 = 0.0, r5 = 0.0, r6 = 0.0, r7 = 0.0, r8 = 0.0, r9 = 0.0, r10 = 0.0, r11 = 0.0, r12 = 0.0;
	bool b0_w = false;
	bool b10_x = false;
	bool b10_y = false;
	bool b10_z = false;
	bool b1_w = false;
	bool b1_x = false;
	bool b1_y = false;
	bool b1_z = false;
	bool b2_w = false;
	bool b3_w = false;
	bool b3_y = false;
	bool b4_x = false;
	r1.xyz = rsqrt(dot(-TranslatedWorldPosition, -TranslatedWorldPosition)) * -TranslatedWorldPosition;
	r0.xyz = WorldTangent.yzx * WorldNormal.zxy;
	r0.xyz = WorldNormal.yzx * WorldTangent.zxy + -r0.xyz;
	r0.xyz = r0.xyz * TangentSign;
	r0.w = GameTime * asfloat(0x3991A2B4u);
	b1_w = r0.w >= -r0.w;
	r0.w = frac(abs(r0.w));
	r0.w = b1_w ? r0.w : -r0.w;
	r1.w = r0.w * 3600.0;
	r0.w = -r0.w * 3600.0 + EffectTime;
	r0.w = UseSpecificTime * r0.w + r1.w;
	r1.w = r0.w * EffectTimeScale;
	r2.w = r1.w * MatcapNormal_TFlowFramerate;
	r3.x = floor(r2.w);
	r3.y = r3.x * (MatcapNormal_TFlowColumn * MatcapNormal_Row);
	b3_y = r3.y >= -r3.y;
	r3.y = b3_y ? (MatcapNormal_TFlowColumn * MatcapNormal_Row) : -(MatcapNormal_TFlowColumn * MatcapNormal_Row);
	r3.z = 1.0 / r3.y;
	r3.x = r3.z * r3.x;
	r3.x = frac(r3.x);
	r3.z = r3.x * r3.y;
	r3.w = (MatcapNormal_TFlowColumn * MatcapNormal_Row) + asfloat(0xBF800347u);
	b3_w = r3.z >= r3.w;
	r3.x = r3.y * r3.x + 1.0;
	r3.x = b3_w ? 0.0 : r3.x;
	r2.w = frac(r2.w);
	r3.y = r3.z / MatcapNormal_TFlowColumn;
	b3_w = r3.y >= -r3.y;
	r3.y = frac(abs(r3.y));
	r3.y = b3_w ? r3.y : -r3.y;
	r4.x = r3.y * MatcapNormal_TFlowColumn;
	r3.y = r3.z * (1.0 / MatcapNormal_TFlowColumn);
	r4.y = floor(r3.y);
	r3.yz = -UV0.xy + UV1.xy;
	r4.zw = Noise_UVSwitch.y * r3.yz + UV0.xy;
	r5.xy = SvPosition.xy + -ViewRectMin.xy;
	r5.zw = r5.xy * ViewSizeAndInvSize.zw;
	r6.xy = r5.xy * ViewSizeAndInvSize.zw + -r4.zw;
	r4.zw = Noise_bScreenUV * r6.xy + r4.zw;
	r4.zw = r4.zw + -0.5;
	r6.x = dot(r4.zw, float2(Noise_RotCos.x, (Noise_RotSin.x * -1.0)));
	r6.y = dot(r4.zw, float2(Noise_RotSin.x, Noise_RotCos.x));
	r4.zw = r6.xy + 0.5;
	r4.zw = r4.zw * Noise_UV.xy;
	r4.zw = r1.w * Noise_UV.zw + r4.zw;
	r4.zw = Noise.SampleBias(NoiseSampler, r4.zw, MaterialTextureMipBias).xy;
	r4.zw = r4.zw + Noise_Offset;
	r6.xy = r4.zw + -0.5;
	r6.xy = r6.xy * 2.0 + -r4.zw;
	r4.zw = Noise_UseSigned2D * r6.xy + r4.zw;
	r4.zw = r4.zw * Noise_Strength;
	r6.x = r1.w * NoiseMask_UV.z;
	r6.y = r1.w * NoiseMask_UV.w;
	r6.zw = NoiseMask_UVSwitch.y * r3.yz + UV0.xy;
	r7.xy = r5.xy * ViewSizeAndInvSize.zw + -r6.zw;
	r6.zw = NoiseMask_bScreenUV * r7.xy + r6.zw;
	r6.zw = r6.zw + -0.5;
	r7.x = dot(r6.zw, float2(NoiseMask_RotCos.x, (NoiseMask_RotSin.x * -1.0)));
	r7.y = dot(r6.zw, float2(NoiseMask_RotSin.x, NoiseMask_RotCos.x));
	r6.zw = r7.xy + 0.5;
	r6.xy = r6.zw * NoiseMask_UV.xy + r6.xy;
	r3.w = NoiseMask.SampleBias(NoiseMaskSampler, r6.xy, MaterialTextureMipBias).x;
	r6.x = r3.w * -2.0 + 1.0;
	r3.w = bInvertNoiseMask * r6.x + r3.w;
	r4.zw = r3.w * r4.zw;
	r6.xy = r4.zw * MatcapNormal_NoiseStrength + UV0.xy;
	r6.zw = r4.xy + r6.xy;
	r6.zw = r6.zw * float2((1.0 / MatcapNormal_TFlowColumn), (1.0 / MatcapNormal_Row));
	r6.zw = MatcapNormal_TFlowMotionVecFlipbook.SampleBias(MatcapNormal_TFlowMotionVecFlipbookSampler, r6.zw, MaterialTextureMipBias).xy;
	r6.zw = r6.zw * float2(1.0, -1.0) + float2(0.0, 1.0);
	r6.zw = r6.zw * 2.0 + -1.0;
	r6.zw = r6.zw * MatcapNormal_TFlow_MotionIntensity;
	r6.zw = -r6.zw * r2.w + r6.xy;
	r4.xy = r4.xy + r6.zw;
	r4.xy = r4.xy * float2((1.0 / MatcapNormal_TFlowColumn), (1.0 / MatcapNormal_Row));
	r7.xyzw = MatcapNormal_TFlowFlipbook.SampleBias(MatcapNormal_TFlowFlipbookSampler, r4.xy, MaterialTextureMipBias).xyzw;
	r3.w = r3.x / MatcapNormal_TFlowColumn;
	b4_x = r3.w >= -r3.w;
	r3.w = frac(abs(r3.w));
	r3.w = b4_x ? r3.w : -r3.w;
	r4.x = r3.w * MatcapNormal_TFlowColumn;
	r3.x = r3.x * (1.0 / MatcapNormal_TFlowColumn);
	r4.y = floor(r3.x);
	r3.xw = r6.xy + r4.xy;
	r3.xw = r3.xw * float2((1.0 / MatcapNormal_TFlowColumn), (1.0 / MatcapNormal_Row));
	r3.xw = MatcapNormal_TFlowMotionVecFlipbook.SampleBias(MatcapNormal_TFlowMotionVecFlipbookSampler, r3.xw, MaterialTextureMipBias).xy;
	r3.xw = r3.xw * float2(1.0, -1.0) + float2(0.0, 1.0);
	r3.xw = r3.xw * 2.0 + -1.0;
	r3.xw = r3.xw * MatcapNormal_TFlow_MotionIntensity;
	r6.z = -r2.w + 1.0;
	r3.xw = r3.xw * r6.z + r6.xy;
	r3.xw = r3.xw + r4.xy;
	r3.xw = r3.xw * float2((1.0 / MatcapNormal_TFlowColumn), (1.0 / MatcapNormal_Row));
	r6.xyzw = MatcapNormal_TFlowFlipbook.SampleBias(MatcapNormal_TFlowFlipbookSampler, r3.xw, MaterialTextureMipBias).xyzw;
	r6.xyzw = -r7.xyzw + r6.xyzw;
	r6.xyzw = r2.w * r6.xyzw + r7.xyzw;
	b2_w = asfloat(0x33000002u) >= r6.z;
	r3.x = log2(r6.z);
	r3.x = r3.x * MatcapNormal_PowerGMap;
	r3.x = exp2(r3.x);
	r2.w = b2_w ? 0.0 : r3.x;
	r3.x = -r2.w + 1.0;
	r3.x = r3.x * r6.w + -r2.w;
	r2.w = saturate(ceil(MatcapNormal_InvertTransmission) * r3.x + r2.w);
	r2.w = r2.w + -1.0;
	r2.w = r2.w * MatcapNormal_AlphaForFullTransmission;
	r2.w = MatcapNormal_UseTexBTransmission * r2.w + 1.0;
	r3.x = r6.w * MatcapNormal_OpacityStrength;
	r2.w = r2.w * r3.x;
	r3.xw = Base_UVSwitch.y * r3.yz + UV0.xy;
	r4.xy = r5.xy * ViewSizeAndInvSize.zw + -r3.xw;
	r3.xw = Base_bScreenUV * r4.xy + r3.xw;
	r3.xw = r3.xw + -0.5;
	r4.x = dot(r3.xw, float2(Base_RotCos.x, (Base_RotSin.x * -1.0)));
	r4.y = dot(r3.xw, float2(Base_RotSin.x, Base_RotCos.x));
	r3.xw = r4.xy + 0.5;
	r4.x = Base_bClamp * -r1.w + r1.w;
	r4.xy = r4.x * Base_UV.zw;
	r3.xw = r3.xw * Base_UV.xy + r4.xy;
	r3.xw = r3.xw + Base_UV_Offset.xy;
	r7.xyzw = r4.zwzw * Base_NoiseStrength;
	r3.xw = r7.xy * (1.0 - Base_bClampAfterNoise) + r3.xw;
	r4.xy = saturate(r3.xw);
	r4.xy = -r3.xw + r4.xy;
	r3.xw = Base_bClamp * r4.xy + r3.xw;
	r3.xw = r7.zw * Base_bClampAfterNoise + r3.xw;
	r7.xyzw = Base.SampleBias(BaseSampler, r3.xw, MaterialTextureMipBias).xyzw;
	r3.x = dot(r7.xyzw, Base_AlphaSwitch.xyzw);
	r3.x = r3.x * Base_Alpha_Multiply;
	r3.x = r2.w * r3.x + -r2.w;
	r2.w = Matcap_AlphaMutiplyAfterMatcap * r3.x + r2.w;
	r3.xw = Dissolve_UVSwitch.y * r3.yz + UV0.xy;
	r4.xy = r5.xy * ViewSizeAndInvSize.zw + -r3.xw;
	r3.xw = Dissolve_bScreenUV * r4.xy + r3.xw;
	r3.xw = r3.xw + -0.5;
	r4.x = dot(r3.xw, float2(Dissolve_RotCos.x, (Dissolve_RotSin.x * -1.0)));
	r4.y = dot(r3.xw, float2(Dissolve_RotSin.x, Dissolve_RotCos.x));
	r3.xw = r4.xy + 0.5;
	r4.x = -EffectTimeScale * r0.w + DIssolve_TimeOffset;
	r4.x = Dissolve_bClamp * r4.x + r1.w;
	r4.xy = r4.x * Dissolve_UV.zw;
	r3.xw = r3.xw * Dissolve_UV.xy + r4.xy;
	r3.xw = r4.zw * Dissolve_NoiseStrength + r3.xw;
	r4.xy = saturate(r3.xw);
	r4.xy = -r3.xw + r4.xy;
	r3.xw = Dissolve_bClamp * r4.xy + r3.xw;
	r3.xw = r3.xw + float2(Dissolve_UOffset, Dissolve_VOffset);
	r8.xyzw = Dissolve.SampleBias(DissolveSampler, r3.xw, MaterialTextureMipBias).xyzw;
	r3.x = dot(r8.xyzw, Dissolve_ChannelSwitch.xyzw);
	r3.x = Dissolve_MaskLerp * -r3.x + r3.x;
	r3.w = r3.x * -2.0 + 1.0;
	r3.x = Dissolve_Invert * r3.w + r3.x;
	r3.w = -Dissolve_Smooth + -1.0;
	r3.w = Dissolve_Dissolve * r3.w + Dissolve_Smooth;
	r3.x = r3.x * Dissolve_Smooth + -r3.w;
	r3.w = saturate(r3.x);
	r4.x = r2.w * r3.w;
	r4.y = saturate(r4.x / Refraction_EdgeWidth);
	r4.y = -r4.y + 1.0;
	r4.y = r4.y * Refraction_RefractStrength;
	r6.z = saturate(SvPosition.w / Refraction_RefractDistance);
	r6.z = -r6.z + 1.0;
	r4.y = r4.y * r6.z;
	r6.zw = Refraction_UVSwitch.y * r3.yz + UV0.xy;
	r8.xy = r5.xy * ViewSizeAndInvSize.zw + -r6.zw;
	r6.zw = Refraction_bScreenUV * r8.xy + r6.zw;
