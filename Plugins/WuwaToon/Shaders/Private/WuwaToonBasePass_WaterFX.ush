	r4.xyz = r4.xyz * asfloat(0xBF19999Au);
	r4.xyz = KuroView300.xyz * asfloat(0x3FCCCCCDu) + r4.xyz;
	r4.xyz = r4.xyz * r0.xyz + -r0.xyz;
	r0.xyz = GlobalGIIntensity * r4.xyz + r0.xyz;
	r4.xyz = KuroView298X * KuroView299.xyz + -ShadowColor;
	r4.xyz = GlobalGIIntensity * r4.xyz + ShadowColor;
	r5.xyz = r0.xyz * r4.xyz;
	r1.z = dot(r10.xyz, r6.xyz);
	r1.z = saturate(r1.z * 0.5 + 0.5);
	r1.w = -((ShadowProcess - ShadowWidth)) + (ShadowProcess + ShadowWidth);
	r1.z = r1.z + -((ShadowProcess - ShadowWidth));
	r1.w = 1.0 / r1.w;
	r1.z = saturate(r1.w * r1.z);
	r1.w = r1.z * -2.0 + 3.0;
	r1.z = r1.z * r1.z;
	r1.z = r1.z * r1.w;
	r1.z = min(r1.z, 1.0);
	r1.w = saturate(VertexColor.x + asfloat(0xBE4CCCCDu));
	r1.z = r1.w + r1.z;
	r1.z = min(r1.z, 1.0);
	r0.xyz = -r0.xyz * r4.xyz + r0.xyz;
	r0.xyz = r1.z * r0.xyz + r5.xyz;
	b1_z = asfloat(0x33000002u) >= Roughness;
	r1.w = log2(Roughness);
	r1.w = r1.w * asfloat(0x3DCCCCCDu);
	r1.w = exp2(r1.w);
	r1.z = b1_z ? 0.0 : r1.w;
	r1.w = -r1.z + 1.0;
	r1.w = r1.w * asfloat(0x419F3333u) + asfloat(0x3DCCCCCDu);
	r1.z = r1.z * -999.0 + 1000.0;
	b3_w = Metallic >= asfloat(0x3F59999Au);
	r3.w = b3_w ? 1.0 : 0.0;
	r4.x = -SpecularPower + MetalSpecularPower;
	r3.w = r3.w * r4.x + SpecularPower;
	r2.xyz = -r2.xyz * r0.w + r6.xyz;
	r0.w = dot(r2.xyz, r2.xyz);
	r0.w = sqrt(r0.w);
	r2.xyz = r2.xyz / r0.w;
	r0.w = dot(r10.xyz, r2.xyz);
	r0.w = log2(r0.w);
	r0.w = r0.w * r1.z;
	r0.w = exp2(r0.w);
	r0.w = r3.w * r0.w;
	r1.z = r3.w + 2.0;
	r0.w = r0.w * r1.z;
	r0.w = saturate(r0.w * asfloat(0x3E22F983u));
	r0.w = saturate(r0.w * r1.w);
	r1.z = Metallic * 0.5 + 0.5;
	r1.w = r1.z * asfloat(0x3DA3D70Au);
	r2.xyz = -r1.z * asfloat(0x3DA3D70Au) + r0.xyz;
	r2.xyz = Metallic * r2.xyz + r1.w;
	r0.xyz = r0.w * r2.xyz + r0.xyz;
	r2.xyz = -r0.xyz + SelectionColor.xyz;
	r0.xyz = SelectionColor.w * r2.xyz + r0.xyz;
	r0.w = min(min(E_Dither_DitherValue_MainPass, E_Dither_DitherValue), E_Dither_DitherValue2);
	i1_z = int(r1.x);
	i1_w = int(r1.y);
	i1_z = (i1_z < 0) ? -int(uint(abs(i1_z)) % 3u) : int(uint(abs(i1_z)) % 3u);   // signed x mod 3
	i1_w = (i1_w < 0) ? -int(uint(abs(i1_w)) % 3u) : int(uint(abs(i1_w)) % 3u);
	i1_z = max(i1_z * 3 + i1_w, 0);
	r0.w = saturate(r0.w * 2.0 + -(WuwaWFXGobletDither3x3[i1_z + 0].x));
	b1_z = asfloat(0x3E99999Au) >= max(E_Dither_UseDither, E_Dither_UseDither2);
	r0.w = r0.w + asfloat(0xBB808081u);
	r0.w = b1_z ? asfloat(0x3F2AC083u) : r0.w;
	r1.z = saturate(r8.w * r8.y + (1.0 - WaterOpacity));
	r2.xy = r1.xy + TemporalAAParamsX;
	u2_x = uint(r2.x);
	u2_y = uint(r2.y);
	r1.w = float(((u2_y << 1) + u2_x) % 5u);
	r1.z = r1.w * asfloat(0x3E2AAAABu) + r1.z;
	r1.z = r1.z + -0.5;
	r1.w = -r1.z + r2.w;
	r1.z = VertexColor.x * r1.w + r1.z;
	r1.z = r1.z + -1.0;
	r1.z = VertexColor.y * r1.z + 1.0;
	r0.w = min(r0.w, r1.z);
	clip(WuwaPrimDitherClip(KuroPrimDitherEnable, KuroPrimDitherFade, SvPosition.xy));   // Kuro primitive dither (engine)
	X.Emissive = r0.xyz;
	X.Opacity = r0.w;
	return X;
}

// M_AdvancedEffect_WaterMatCap_CM PS 8a5ec49c07 (#156559, switches UseBase, UseSecondTex, UseNoise, UseMaskTex,
// UseDissolve, WCColor_bUseCurve; no matcap / refraction / water-cloth colour in this compile): Noise distortion,
// Second, Base refine, Dissolve with edge colour, Mask (LOD MipBias - 1), effect colour tail, dither, screen fade.
FWuwaFXOutput WuwaFXWaterMatCap_NoiseSecondDissolveMask(
	Texture2D Noise, SamplerState NoiseSampler, Texture2D Second, SamplerState SecondSampler, Texture2D Base,
	SamplerState BaseSampler, Texture2D Dissolve, SamplerState DissolveSampler, Texture2D Mask,
	SamplerState MaskSampler, float2 UV0, float2 UV1, float4 SvPosition, float3 TranslatedWorldPosition,
	float2 ViewRectMin, float4 ViewSizeAndInvSize, float GameTime, float MaterialTextureMipBias,
	float3 KuroViewLightColorA, float3 KuroViewLightColorB, float KuroEffectSaturation,
	float MPC_KuroEffectColorGradingDesaturate, float3 MPC_KuroEffectColorGradingTint, float3 PreViewTranslation,
	float4 Second_UV, float4 Second_UVSwitch, float Second_bScreenUV, float EffectTime, float UseSpecificTime,
	float EffectTimeScale, float Second_bClamp, float4 Second_UV_Offset, float4 Noise_UV, float4 Noise_UVSwitch,
	float Noise_bScreenUV, float Noise_Offset, float Noise_UseSigned2D, float Noise_Strength, float4 Second_Contorl,
	float4 Base_UVSwitch, float4 Base_UV, float Base_bScreenUV, float Base_bClamp, float4 Base_UV_Offset,
	float Base_NoiseStrength, float Base_bClampAfterNoise, float4 Base_EmissiveSwitch, float Base_bUseChannelAsEmissive,
	float4 Base_Refine, float Base_Emissive_Add, float Base_bAddSecond, float4 Dissolve_UV, float4 Dissolve_UVSwitch,
	float Dissolve_bScreenUV, float DIssolve_TimeOffset, float Dissolve_bClamp, float Dissolve_NoiseStrength,
	float Dissolve_UOffset, float Dissolve_VOffset, float4 Dissolve_ChannelSwitch, float Dissolve_MaskLerp,
	float Dissolve_Invert, float Dissolve_Smooth, float Dissolve_Dissolve, float4 Dissolve_EdgeColor,
	float4 Base_ColorTint, float LightColorStrength, float4 NiagaraShiftLowGrayColor, float4 NiagaraShiftHighGrayColor,
	float NiagaraShiftColorParam, float4 SelectionColor, float4 Base_AlphaSwitch, float Base_Alpha_Multiply,
	float4 Mask_UVSwitch, float4 Mask_UV, float Mask_bScreenUV, float Mask_bClamp, float4 Mask_UV_Offset,
	float Mask_NoiseStrength, float4 Mask_AlphaSwitch, float Mask_Invert, float Mask_Alpha_Multiply,
	float Matcap_AlphaMutiplyAfterMatcap, float Refraction_OpacityMultiplyAfterRefrac, float E_Dither_DitherValue,
	float E_Dither_UseDither, float ScreenFadeFrom, float ScreenFadeDistance, float4 Second_RotCos,
	float4 Second_RotSin, float4 Noise_RotCos, float4 Noise_RotSin, float4 Base_RotCos, float4 Base_RotSin,
	float4 Dissolve_RotCos, float4 Dissolve_RotSin, float4 Mask_RotCos, float4 Mask_RotSin)
{
	FWuwaFXOutput X;
	float4 r0 = 0.0, r1 = 0.0, r2 = 0.0, r3 = 0.0, r4 = 0.0, r5 = 0.0, r6 = 0.0, r7 = 0.0, r8 = 0.0, r9 = 0.0;
	bool b2_z = false;
	bool b8_x = false;
	bool b8_y = false;
	bool b8_z = false;
	r0.xyz = TranslatedWorldPosition;
	r0.xyz = r0.xyz + -PreViewTranslation.xyz;
	r1.xy = -UV0.xy + UV1.xy;
	r1.zw = Second_UVSwitch.y * r1.xy + UV0.xy;
	r2.xy = SvPosition.xy + -ViewRectMin.xy;
	r2.zw = r2.xy * ViewSizeAndInvSize.zw + -r1.zw;
	r1.zw = Second_bScreenUV * r2.zw + r1.zw;
	r1.zw = r1.zw + -0.5;
	r3.x = dot(r1.zw, float2(Second_RotCos.x, (Second_RotSin.x * -1.0)));
	r3.y = dot(r1.zw, float2(Second_RotSin.x, Second_RotCos.x));
	r1.zw = r3.xy + 0.5;
	r0.w = GameTime * asfloat(0x3991A2B4u);
	b2_z = r0.w >= -r0.w;
	r0.w = frac(abs(r0.w));
	r0.w = b2_z ? r0.w : -r0.w;
	r2.z = r0.w * 3600.0;
	r0.w = -r0.w * 3600.0 + EffectTime;
	r0.w = UseSpecificTime * r0.w + r2.z;
	r2.z = r0.w * EffectTimeScale;
	r2.w = EffectTimeScale * r0.w + 1.0;
	r3.x = -r2.w + 1.0;
	r2.w = Second_bClamp * r3.x + r2.w;
	r3.xy = r2.w * Second_UV.zw;
	r1.zw = r1.zw * Second_UV.xy + r3.xy;
	r1.zw = r1.zw + Second_UV_Offset.xy;
	r3.x = r2.z * Noise_UV.z;
	r3.y = r2.z * Noise_UV.w;
	r3.zw = Noise_UVSwitch.y * r1.xy + UV0.xy;
	r4.xy = r2.xy * ViewSizeAndInvSize.zw + -r3.zw;
	r3.zw = Noise_bScreenUV * r4.xy + r3.zw;
	r3.zw = r3.zw + -0.5;
	r4.x = dot(r3.zw, float2(Noise_RotCos.x, (Noise_RotSin.x * -1.0)));
	r4.y = dot(r3.zw, float2(Noise_RotSin.x, Noise_RotCos.x));
	r3.zw = r4.xy + 0.5;
	r3.xy = r3.zw * Noise_UV.xy + r3.xy;
	r3.xy = Noise.SampleBias(NoiseSampler, r3.xy, MaterialTextureMipBias).xy;
	r3.xy = r3.xy + Noise_Offset;
	r3.zw = r3.xy + -0.5;
	r3.zw = r3.zw * 2.0 + -r3.xy;
	r3.xy = Noise_UseSigned2D * r3.zw + r3.xy;
	r3.xy = r3.xy * Noise_Strength;
	r1.zw = Second_Contorl.z * r3.xy + r1.zw;
	r3.zw = saturate(r1.zw);
	r3.zw = -r1.zw + r3.zw;
	r1.zw = Second_bClamp * r3.zw + r1.zw;
	r4.xyz = Second.SampleBias(SecondSampler, r1.zw, MaterialTextureMipBias).xyz;
	r1.z = dot(r4.xyz, float3(asfloat(0x3E99999Au), asfloat(0x3F170A3Du), asfloat(0x3DE147AEu)));
	r5.xyz = -r4.xyz + r1.z;
	r4.xyz = Second_Contorl.x * r5.xyz + r4.xyz;
	r5.xyz = r4.xyz * Second_Contorl.y;
	r1.zw = Base_UVSwitch.y * r1.xy + UV0.xy;
	r3.zw = r2.xy * ViewSizeAndInvSize.zw + -r1.zw;
	r1.zw = Base_bScreenUV * r3.zw + r1.zw;
	r1.zw = r1.zw + -0.5;
	r6.x = dot(r1.zw, float2(Base_RotCos.x, (Base_RotSin.x * -1.0)));
	r6.y = dot(r1.zw, float2(Base_RotSin.x, Base_RotCos.x));
	r1.zw = r6.xy + 0.5;
	r2.w = Base_bClamp * -r2.z + r2.z;
	r3.zw = r2.w * Base_UV.zw;
	r1.zw = r1.zw * Base_UV.xy + r3.zw;
	r1.zw = r1.zw + Base_UV_Offset.xy;
	r6.xyzw = r3.xyxy * Base_NoiseStrength;
	r1.zw = r6.xy * (1.0 - Base_bClampAfterNoise) + r1.zw;
	r3.zw = saturate(r1.zw);
	r3.zw = -r1.zw + r3.zw;
	r1.zw = Base_bClamp * r3.zw + r1.zw;
	r1.zw = r6.zw * Base_bClampAfterNoise + r1.zw;
	r6.xyzw = Base.SampleBias(BaseSampler, r1.zw, MaterialTextureMipBias).xyzw;
	r1.z = dot(r6.xyzw, Base_EmissiveSwitch.xyzw);
	r7.xyz = -r6.xyz + r1.z;
	r7.xyz = Base_bUseChannelAsEmissive * r7.xyz + r6.xyz;
	b8_x = asfloat(0x33000002u) >= r7.x;
	b8_y = asfloat(0x33000002u) >= r7.y;
	b8_z = asfloat(0x33000002u) >= r7.z;
	r9.xyz = log2(r7.xyz);
	r9.xyz = r9.xyz * Base_Refine.x;
	r9.xyz = exp2(r9.xyz);
	r8.x = b8_x ? 0.0 : r9.x;
	r8.y = b8_y ? 0.0 : r9.y;
	r8.z = b8_z ? 0.0 : r9.z;
	r8.xyz = r8.xyz * Base_Refine.y;
	r7.xyz = r7.xyz * Base_Refine.z + -r8.xyz;
	r7.xyz = Base_Refine.w * r7.xyz + r8.xyz;
	r7.xyz = r7.xyz + Base_Emissive_Add;
	r8.xyz = r5.xyz * r7.xyz;
	r4.xyz = r4.xyz * Second_Contorl.y + r7.xyz;
	r4.xyz = -r5.xyz * r7.xyz + r4.xyz;
	r4.xyz = Base_bAddSecond * r4.xyz + r8.xyz;
	r1.zw = Dissolve_UVSwitch.y * r1.xy + UV0.xy;
	r3.zw = r2.xy * ViewSizeAndInvSize.zw + -r1.zw;
	r1.zw = Dissolve_bScreenUV * r3.zw + r1.zw;
	r1.zw = r1.zw + -0.5;
	r5.x = dot(r1.zw, float2(Dissolve_RotCos.x, (Dissolve_RotSin.x * -1.0)));
	r5.y = dot(r1.zw, float2(Dissolve_RotSin.x, Dissolve_RotCos.x));
	r1.zw = r5.xy + 0.5;
	r0.w = -EffectTimeScale * r0.w + DIssolve_TimeOffset;
	r0.w = Dissolve_bClamp * r0.w + r2.z;
	r3.zw = r0.w * Dissolve_UV.zw;
	r1.zw = r1.zw * Dissolve_UV.xy + r3.zw;
	r1.zw = r3.xy * Dissolve_NoiseStrength + r1.zw;
	r3.zw = saturate(r1.zw);
	r3.zw = -r1.zw + r3.zw;
	r1.zw = Dissolve_bClamp * r3.zw + r1.zw;
	r1.zw = r1.zw + float2(Dissolve_UOffset, Dissolve_VOffset);
	r5.xyzw = Dissolve.SampleBias(DissolveSampler, r1.zw, MaterialTextureMipBias).xyzw;
	r0.w = dot(r5.xyzw, Dissolve_ChannelSwitch.xyzw);
	r0.w = Dissolve_MaskLerp * -r0.w + r0.w;
	r1.z = r0.w * -2.0 + 1.0;
	r0.w = Dissolve_Invert * r1.z + r0.w;
	r1.z = -Dissolve_Smooth + -1.0;
	r1.z = Dissolve_Dissolve * r1.z + Dissolve_Smooth;
	r0.w = r0.w * Dissolve_Smooth + -r1.z;
	r1.z = r0.w + -1.0;
	r1.z = min(abs(r1.z), 1.0);
	r1.z = -r1.z + 1.0;
	r5.xyz = r1.z * Dissolve_EdgeColor.xyz;
	r4.xyz = Base_ColorTint.xyz * r4.xyz + r5.xyz;
	r5.xyz = KuroViewLightColorA.xyz + -KuroViewLightColorB.xyz;
	r5.xyz = r5.xyz * 0.5 + KuroViewLightColorB.xyz;
	r5.xyz = r4.xyz * r5.xyz + -r4.xyz;
	r4.xyz = LightColorStrength * r5.xyz + r4.xyz;
	r1.z = dot(r4.xyz, float3(asfloat(0x3DE147AEu), asfloat(0x3F170A3Du), asfloat(0x3E99999Au)));
	r1.w = saturate(r1.z);
	r5.xyz = NiagaraShiftLowGrayColor.xyz + -NiagaraShiftHighGrayColor.xyz;
	r5.xyz = r1.w * r5.xyz + NiagaraShiftHighGrayColor.xyz;
	r5.xyz = r5.xyz * r1.z + -r4.xyz;
	r4.xyz = NiagaraShiftColorParam * r5.xyz + r4.xyz;
	r1.z = dot(r4.xyz, float3(asfloat(0x3E991687u), asfloat(0x3F1645A2u), asfloat(0x3DE978D5u)));
	r5.xyz = -r4.xyz + r1.z;
	r4.xyz = r5.xyz * MPC_KuroEffectColorGradingDesaturate + r4.xyz;
	r5.xyz = r4.xyz * MPC_KuroEffectColorGradingTint.xyz;
	r1.z = dot(r5.xyz, float3(asfloat(0x3E99999Au), asfloat(0x3F170A3Du), asfloat(0x3DE147AEu)));
	r4.xyz = -r4.xyz * MPC_KuroEffectColorGradingTint.xyz + r1.z;
	r4.xyz = KuroEffectSaturation * r4.xyz + r5.xyz;
	r5.xyz = -r4.xyz + SelectionColor.xyz;
	r4.xyz = SelectionColor.w * r5.xyz + r4.xyz;
	r1.z = dot(r6.xyzw, Base_AlphaSwitch.xyzw);
	r1.z = r1.z * Base_Alpha_Multiply;
	r1.xy = Mask_UVSwitch.y * r1.xy + UV0.xy;
	r2.xy = r2.xy * ViewSizeAndInvSize.zw + -r1.xy;
	r1.xy = Mask_bScreenUV * r2.xy + r1.xy;
	r1.xy = r1.xy + -0.5;
	r2.x = dot(r1.xy, float2(Mask_RotCos.x, (Mask_RotSin.x * -1.0)));
	r2.y = dot(r1.xy, float2(Mask_RotSin.x, Mask_RotCos.x));
	r1.xy = r2.xy + 0.5;
	r1.w = Mask_bClamp * -r2.z + r2.z;
	r2.xy = r1.w * Mask_UV.zw;
	r1.xy = r1.xy * Mask_UV.xy + r2.xy;
	r1.xy = r1.xy + Mask_UV_Offset.xy;
	r1.xy = r3.xy * Mask_NoiseStrength + r1.xy;
	r2.xy = saturate(r1.xy);
	r2.xy = -r1.xy + r2.xy;
	r1.xy = Mask_bClamp * r2.xy + r1.xy;
	r1.w = MaterialTextureMipBias + -1.0;
	r2.xyzw = Mask.SampleLevel(MaskSampler, r1.xy, r1.w).xyzw;
	r1.x = dot(r2.xyzw, Mask_AlphaSwitch.xyzw);
	r1.y = r1.x * -2.0 + 1.0;
	r1.x = Mask_Invert * r1.y + r1.x;
	r1.x = r1.x * Mask_Alpha_Multiply;
	r1.x = r1.x * r1.z;
	r1.y = r1.x * r1.x + -r1.x;
	r1.x = Matcap_AlphaMutiplyAfterMatcap * r1.y + r1.x;
	r0.w = saturate(r0.w);
	r0.w = r0.w * r1.x;
	r0.w = r0.w * Refraction_OpacityMultiplyAfterRefrac;
	r1.x = E_Dither_DitherValue * r0.w + -r0.w;
	r0.w = E_Dither_UseDither * r1.x + r0.w;
	r1.x = SvPosition.w + -ScreenFadeFrom;
	r1.x = saturate(r1.x / ScreenFadeDistance);
	r0.w = saturate(r0.w * r1.x);
	X.Emissive = r4.xyz;
	X.Opacity = r0.w;
	return X;
}

// M_AdvancedEffect_ParallaxSubUV_CM (UseAllUV: 4-channel UV select): tangent-space parallax of the view vector
// (object-local position rotated by LocalToWorld) over a sub-UV atlas, four layered Second / SecondMask / Base taps (one
// per parallax layer, frame from the effect clock), noise distortion, mask, vertex-colour alpha. PS 0f3490a90b (#13850):
// + Dissolve.
#pragma warning(push)
#pragma warning(disable : 4008)   // X4008: the parallax tangent frame divides by the screen-derivative determinant (as the original); with uniform inputs (compile checks) fxc proves it is 0
FWuwaFXOutput WuwaFXParallaxSubUV_Dissolve(
	Texture2D Noise, SamplerState NoiseSampler, Texture2D Second, SamplerState SecondSampler, Texture2D SecondMask,
