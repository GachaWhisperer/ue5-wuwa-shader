	float MaterialTextureMipBias, float3 KuroViewLightColorA, float3 KuroViewLightColorB, float KuroEffectSaturation,
	float MPC_KuroEffectColorGradingDesaturate, float3 MPC_KuroEffectColorGradingTint, float3 LocalToWorldRow0,
	float3 LocalToWorldRow1, float3 LocalToWorldRow2, float3 PreViewTranslation, float3 KuroLocalPosition,
	float EffectTime, float UseSpecificTime, float EffectTimeScale, float4 Noise_UVSwitch, float4 Noise_UV,
	float Noise_bScreenUV, float Noise_Offset, float Noise_UseSigned2D, float Noise_Strength,
	float ParallaxSub_NoiseStrength, float ParallaxSub_GridCols, float ParallaxSub_GridRows,
	float ParallaxSub_Index0_Index, float ParallaxSub_Index0_Depth, float4 ParallaxSub_Index0_ScaleNPosOffset,
	float Second_bClamp, float4 Second_UV, float4 Second_Contorl, float4 SecondMask_UV, float4 Mask_UV,
	float SecondMask_NoiseStrength, float Mask_NoiseStrength, float4 SecondMask_AlphaSwitch, float4 Mask_AlphaSwitch,
	float bInvertNSecondMask, float Base_bClamp, float4 Base_UV, float4 Base_UV_Offset, float Base_NoiseStrength,
	float Base_bClampAfterNoise, float4 Base_EmissiveSwitch, float Base_bUseChannelAsEmissive, float4 Base_Refine,
	float Base_Emissive_Add, float Base_bAddSecond, float4 Base_ColorTint, float ParallaxSub_Index1_Index,
	float ParallaxSub_Index1_Depth, float4 ParallaxSub_Index1_ScaleNPosOffset, float4 Base_AlphaSwitch,
	float Base_Alpha_Multiply, float bUse_ParallaxSub_Index1, float ParallaxSub_Index2_Index,
	float ParallaxSub_Index3_Index, float ParallaxSub_Index2_Depth, float4 ParallaxSub_Index2_ScaleNPosOffset,
	float bUse_ParallaxSub_Index2, float ParallaxSub_Index3_Depth, float4 ParallaxSub_Index3_ScaleNPosOffset,
	float bUse_ParallaxSub_Index3, float4 Dissolve_UV, float4 Dissolve_UVSwitch, float Dissolve_bScreenUV,
	float DIssolve_TimeOffset, float Dissolve_bClamp, float Dissolve_NoiseStrength, float Dissolve_UOffset,
