// WuwaToonBasePass_V2Body.ush — M_CharV2_Com BODY (MSM_ToonCommon; GBufferB id 12) base passes.
// Reference variant: PS 63db5573 (#291339, 609 instr), MI_R2T1PlayerFemaleMd10011Down/Up (Rover female).
// B### = evidence/roster/shadermaps/v2/asm/291339_63db557394bd....asm.txt (literal bits: asm_hex/).
// research/shaders/ToonCommonV2.md §5, research/roster/Port_CharV2.md.
//
//   Textures (UES order): Normal_Roughness_Metallic, TypeMask, RegionIDTex, MainTex, MatCapTex, E_Tex_NoiseTex (unused), Ramp.
//   Samplers as compiled: TypeMask (bias read) own s2, RegionIDTex own s3, MatCapTex own s0 (explicit LOD), all others s1
//   (incl. a second TypeMask read at LOD 0 -> TypeMaskLod0Sampler).
//   Interpolators: LightDirVS = (TEXCOORD0.zw, TEXCOORD2.x), MotionEmissiveMask = TEXCOORD2.y; TEXCOORD10/11 = tangent / normal+sign.
//   HLSL name -> Kuro name: <Base><k> -> "<k>_<Base>" for Metallic, Roughness, Spec_Int, Spec_Width, Spec_Smooth, ShadowWidth,
//   RampID, RampInt, FresnelColor, FresnelRangeMin, FresnelRangeMax, FresnelRangePower; MetallicIntensityDebug ->
//   "MetallicIntensity(Debug)", RoughnessIntensityDebug -> "RoughnessIntensity(Debug))".
#pragma once

#include "WuwaToonBasePassV2Shared.ush"

// Kuro per-primitive screen dither (same as WuwaPrimDitherClip in WuwaToonBasePass_WriteStencil.ush, copied: fxc ignores
// #pragma once). Primitive[43].x > 0 enables, .y = fade; returns the value fed to discard (< 0 discards).
float WuwaV2BodyPrimDither(float KuroPrimDitherEnable, float KuroPrimDitherFade, float2 SvPositionXY)
{
	float f = (0.0 < KuroPrimDitherEnable) ? saturate(KuroPrimDitherFade) : 1.0;
	bool  partial = (f < 1.0);
	float thr = (f + f) / (f + 1.0);
	float2 cell = floor(SvPositionXY * 0.25);
	float n = frac(dot(cell, float2(asfloat(0x3D897143u), asfloat(0x3BBF4590u))));   // 0.0671105608, 0.00583714992
	n = frac(n * asfloat(0x4253EE82u));                                             // 52.9829178
	thr = thr - n;
	return partial ? thr : 1.0;
}

// UseXingHen on V2 bodies (PS 2fc55fe0 L254-350, L548-553, L712-719): the M_Char_XinHen star mark, same math as WuwaBPXingHen
// (WuwaToonBasePass_Common.ush) except that cos/sin(Rotation Angle * 2pi) are CPU uniform expressions here (XHRotCos/XHRotSin).
//   uvD = rotate((UV0 - 0.5) * UVScale - (0.5 + UVpos) + 0.5) + (0.5 + UVpos) - UVpos; D / Noise / Noise02 plain samples;
//   XHCol = lerp(k * SDFColor02.rgb, SDFColor.rgb * SDFColor.a, mask); XHOp = saturate(D.a * mask) inside the 0.01..0.99 window;
//   XHG = UV3.x half selection blended by XingHenPosition.
void WuwaV2BodyXingHen(const bool bRot, Texture2D D, SamplerState DSampler, Texture2D Noise, SamplerState NoiseSampler,
	Texture2D Noise02, SamplerState Noise02Sampler, float2 UV0, float UV3X, float GameTime,
	float4 SDFColor, float4 SDFColor02, float ShakeNoiseInt, float UVpositionX, float UVpositionY, float UVScaleX, float UVScaleY,
	float XHRotCos, float XHRotSin, float XingHenControl, float SDFStart, float SoundWaveTiling01, float SoundWaveSpeed01,
	float SoundWaveInt01, float SoundWaveTiling02, float SoundWaveSpeed02, float SoundWaveInt02, float XHMax, float XingHenPosition,
	out float3 XHCol, out float XHOp, out float XHG)
{
	float2 UVpos  = float2(UVpositionX, UVpositionY);
	float2 UVpos5 = min(float2(0.5, 0.5) + UVpos, asfloat(0x7F7FFFFFu));     // preshader 0.5 + UVpos (kept opaque)
	float  shakeAbs = abs(ShakeNoiseInt);
	float  xhc    = min(XingHenControl, asfloat(0x3F59999Au));               // min(XingHenControl, 0.85)
	float  k      = ((shakeAbs >= asfloat(0x3A83126Fu)) ? asfloat(0x3E4CCCCDu) : 0.0) + SDFColor02.a;
	precise float shake03 = ShakeNoiseInt * asfloat(0x3E99999Au);            // preshader ShakeNoiseInt * 0.3

	float2 uvD;
	if (bRot)
	{
		uvD = (UV0 + -0.5) * float2(UVScaleX, UVScaleY) + UVpos5 * -1.0;
		uvD = uvD + 0.5;
		uvD = float2(dot(uvD, float2(XHRotCos, XHRotSin * -1.0)), dot(uvD, float2(XHRotSin, XHRotCos)));
		uvD = uvD + UVpos5;
		uvD = uvD - UVpos;
	}
	else   // maps without the rotator (PS 859c5db4 L160-162): (UV0 - 0.5) * UVScale + 0.5 - UVpos
	{
		uvD = (UV0 + -0.5) * float2(UVScaleX, UVScaleY) + 0.5;
		uvD = uvD - UVpos;
	}
	float4 Dt = D.Sample(DSampler, uvD);

	float inner = 1.0 - Dt.r;
	float s = saturate(shakeAbs * 3.0);                                       // preshader |Shake| * 3
	s = (s * s) * (s * -2.0 + 3.0);
	float mask = s * -inner + inner;

	float4 Q = xhc * (float4(asfloat(0x3F99999Au), 3.5, asfloat(0xBE4CCCCDu), 15.0) - float4(SDFStart, SoundWaveTiling01, SoundWaveSpeed01, SoundWaveInt01))
		+ float4(SDFStart, SoundWaveTiling01, SoundWaveSpeed01, SoundWaveInt01);          // lerp toward (1.2, 3.5, -0.2, 15)
	float  tt = GameTime * asfloat(0x3CAAAAABu);                              // fmod(Time, 48) / 48
	tt = (tt >= -tt) ? frac(abs(tt)) : -frac(abs(tt));
	float2 T = float2(tt * 144.0, tt * 48.0);
	float2 uv1 = uvD * float2(1.0, Q.y) + float2(0.0, Q.z) * float2(tt, T.y);
	float  n1 = Noise.Sample(NoiseSampler, uv1).r;
	n1 = n1 * asfloat(0xBD6A0EC7u) + asfloat(0x3C1C0A8Du);                   // -0.0571429, 0.00952381
	n1 = n1 * max(Q.w * 0.5, 1.0);
	float3 S2 = xhc * (float3(asfloat(0x40333333u), asfloat(0xBECCCCCDu), 15.0) - float3(SoundWaveTiling02, SoundWaveSpeed02, SoundWaveInt02))
		+ float3(SoundWaveTiling02, SoundWaveSpeed02, SoundWaveInt02);                    // toward (2.8, -0.4, 15)
	float2 uv2 = uvD * float2(1.0, S2.x) + float2(tt, T.y) * float2(0.0, S2.y);
	float  n2 = Noise02.Sample(Noise02Sampler, uv2).r;
	n2 = n2 * asfloat(0xBD6A0EC7u) + asfloat(0x3C1C0A8Du);
	float  side = (asfloat(0x3F0353F8u) >= uvD.x) ? 1.0 : 0.0;               // 0.513
	float  wave = side * (n2 * max(S2.z * 0.5, 1.0) - n1) + n1;
	mask = mask + (((Q.x * 0.5 - wave) >= Dt.g) ? 1.0 : 0.0);

	float e = saturate(shakeAbs) * asfloat(0xC1EC3D71u) + 30.0;                // -29.53
	float p = (0.0 >= Dt.b) ? 0.0 : min(exp2(log2(Dt.b) * e), 1.0);
	float x = frac(p * 3.0 + T.x);
	float sm1 = (x * -2.0 + 3.0) * (x * x);
	float w = saturate((x + -1.0) * (1.0 / (XHMax + -1.0)));
	w = (w * w) * (w * -2.0 + 3.0);
	mask = (p * (w * sm1)) * shake03 + mask;

	XHCol = k * SDFColor02.rgb;
	XHCol = mask * (-SDFColor02.rgb * k + SDFColor.rgb * SDFColor.a) + XHCol;
	float inX = ((uvD.x >= asfloat(0x3C23D70Au)) ? 1.0 : 0.0) * ((asfloat(0x3F7D70A4u) >= uvD.x) ? 1.0 : 0.0);   // [0.01, 0.99]
	float inY = ((uvD.y >= asfloat(0x3C23D70Au)) ? 1.0 : 0.0) * ((asfloat(0x3F7D70A4u) >= uvD.y) ? 1.0 : 0.0);
	XHOp = saturate((inY * inX >= 1.0) ? Dt.a * mask : 0.0);
	float c1 = saturate(XingHenPosition * 2.0), c2 = saturate(XingHenPosition * 2.0 - 1.0);   // preshaders
	bool  hi = (UV3X >= 0.5);
	float a = hi ? 1.0 : 1.0 - c1;
	XHG = c2 * ((hi ? 0.0 : 1.0) - a) + a;
}

// E_Link split-screen gate (Use_Char_Wet bodies, PS 373d2cf9 L512-544; same logic as WuwaV2LinkGate in
// WuwaToonBasePass_V2HairFace.ush, but the line rotations are CPU uniform expressions here: LinkRot0/1 =
// (cos(a), -sin(a)) of E_Link_AngleLinePosLineDis.x / .w degrees). Returns 1 (keep) / 0 as the asm's (v - 0.333 >= 0.000667).
float WuwaV2BodyLinkGate(float2 SvPositionXY, float4 ViewSizeAndInvSize, float2 ViewRectMin, float E_Link_UseSplitScreen,
	float4 E_Link_AngleLinePosLineDis, float E_LinkPos, float2 LinkRot0, float2 LinkRot1, bool bPrecise = false)
{
	float link = 1.0;
	if (E_Link_UseSplitScreen >= asfloat(0x3DCCCCCDu))                       // 0.1
	{
		float2 suv = (SvPositionXY - ViewRectMin) * ViewSizeAndInvSize.zw;
		float  asp = max(ViewSizeAndInvSize.x / ViewSizeAndInvSize.y, 1.0);
		float  pos0 = E_Link_AngleLinePosLineDis.y;
		float  pos1 = min(E_Link_AngleLinePosLineDis.y + E_Link_AngleLinePosLineDis.z, asfloat(0x7F7FFFFFu));   // preshader
		float  p0 = asp * pos0;
		float  d0 = dot(float2(suv.x * asp, suv.y) - float2(p0, 0.5), LinkRot0);
		bool   A  = (asp * pos0 + d0) >= p0;
		float  p1 = asp * pos1;
		float  d1 = dot(float2(suv.x * asp, suv.y) - float2(p1, 0.5), LinkRot1);
		bool   B  = (pos1 * asp + d1) >= p1;
		float  fA = A ? 1.0 : 0.0;
		float  fB = B ? 1.0 : 0.0;
		float  x  = max((B ? -1.0 : -0.0) + fA, 0.0);
		x = x + (A ? -0.0 : -1.0);
		x = saturate(E_LinkPos * 2.0) * x + (A ? 0.0 : 1.0);
		x = saturate(E_LinkPos * 2.0 - 1.0) * (fB - x) + x;
		link = x;
	}
	if (bPrecise)   // precise compile (e9ec2704 L706-710): the smoothstep-style remap is not folded into the threshold
	{
		precise float lv = (min(link, 1.0) + asfloat(0xBEAA7EFAu)) * asfloat(0x3FBFE770u);                 // -0.333, 1.49925
		return (lv >= asfloat(0x3A83126Fu)) ? 1.0 : 0.0;                                                  // 0.001
	}
	return (min(link, 1.0) + asfloat(0xBEAA7EFAu) >= asfloat(0x3A2ED99Du)) ? 1.0 : 0.0;    // -0.333, 0.000667
}

// Use_TextRain helper: one "digital rain" layer (PS 285ecf0a L536-573 base, L576-615 bump). c = Text_Tex.r (LOD -1) at the column /
// frame cell, colour = min(smoothstep(RangeMin, RangeMax, c / v), 1) * Color hue-rotated by (c / v + HueShiftColor_Offset * 0.1) * 2pi.
float3 WuwaV2BodyTextRainLayer(float c, float colX, float t100, float vY, float RainSpeed, float Rain_Intensity, float HueOff01,
	float RangeMin, float RangeMax, float3 Color)
{
	float sn = sin(colX * asfloat(0x3F80ADFDu));                                                  // 1.00531
	float cs = cos(colX * asfloat(0x4196CBE4u));                                                  // 18.849556
	float y  = (cs * RainSpeed) * t100 + sn;
	float inv = 1.0 / (frac(y - vY) * Rain_Intensity);
	float ang = (c * inv + HueOff01) * asfloat(0x40C90FDBu);                                       // 2pi
	float a = saturate((c * inv - RangeMin) * (1.0 / (RangeMax - RangeMin)));
	a = min((a * a) * (a * -2.0 + 3.0), 1.0);
	const float3 kGrey = float3(asfloat(0x3F13CD3Au), asfloat(0x3F13CD3Au), asfloat(0x3F13CD3Au));   // 0.57735
	float  hd = dot(kGrey, a * Color);
	float3 hU = a * Color - hd * asfloat(0x3F13CD3Au);
	float3 hT = hU.zxy * kGrey;
	float3 hV = hU.zxy * kGrey - hT.zxy;
	float  hs, hc;
	sincos(ang, hs, hc);
	return hd * kGrey + (hU * hc + hs * hV);
}

// Expression forms (fur round). The fur maps are compiled with `precise` on the pre-PDO material chain (and fxc schedules the
// post-PDO re-evaluation differently), so a few sums / folds keep their source order where the other V2 body maps show fxc's
// re-associated form. `Forms` bit set of the Impl (0 = the verified non-fur forms):
#define WUWA_V2F_DMG    1u    // DamageSkin = sat(((d + 0.5) - 0.502) * 2.008032 * DSI)          (not the folded (d - 0.002) * DSI * 2.008)
#define WUWA_V2F_SPOT   2u    // toon spot term min((1 - spot^2) + distFrac, 1)                  (not (-spot^2 + distFrac) + 1)
#define WUWA_V2F_MCDOT  4u    // matcap view position length dot in x, y, z order                 (not y, z, x)
#define WUWA_V2F_RIMREV 8u    // UseRim reverse rr + Reverse * ((1 - rr) - rr)                     (not rr + Reverse * (1 - 2 rr))
#define WUWA_V2F_RAMPU  16u   // VDL ramp U = sat(HL + (0.5 - thr))                               (not sat((HL - thr) + 0.5))
#define WUWA_V2F_LINKP  64u   // E_Link gate threshold ((min(x, 1) - 0.333) * 1.49925) >= 0.001      (e9ec2704 L706-710; not x - 0.333 >= 0.000667)
#define WUWA_V2F_WETT1  128u  // wet front T1 applied unsquared twice: ((w - v) * t) * t + v      (e9ec2704 L283-300, L628-632)
#define WUWA_V2F_DMG2   32u   // DamageSkin = sat(((d - 0.002) * 2.008032) * DSI)                 (bd79aa07 custom-output chunk L882-885)

// Copy of WuwaBPMainLightDir (WuwaToonBasePassShared.ush, read-only) with the spot-term summation order selectable (WUWA_V2F_SPOT:
// PS 6b7c6be0 L338-341 precise, L843-845 post-PDO). Same arguments otherwise.
float3 WuwaV2BodyMainLightDir(const bool bSpotP, float LightOffset_Pitch,
	float3 MPC_GlobalCharacterAmbientSkinColor, float3 MPC_GlobalCharacterDebugLightDirection,
	float4 ToonLight0, float4 ToonLight1, float4 ToonLight2, float4 ToonLight3,
	float3 ObjectWorldPosition, float3 WorldPosition, float3 LocalLightTarget,
	float CPD13, float CPD1, float3 LightDirVS)
{
	if (!bSpotP)
		return WuwaBPMainLightDir(LightOffset_Pitch, MPC_GlobalCharacterAmbientSkinColor, MPC_GlobalCharacterDebugLightDirection,
			ToonLight0, ToonLight1, ToonLight2, ToonLight3, ObjectWorldPosition, WorldPosition, LocalLightTarget, CPD13, CPD1, LightDirVS);
	float  absPitch  = abs(LightOffset_Pitch);
	float  pitchLerp = saturate(absPitch / asfloat(0x42340000u | (asuint(absPitch) >> 31)));   // CPU preshader: true divide by 45
	float  pitchOn = (absPitch >= 0.5) ? 1.0 : 0.0;
	float3 Lmpc = (MPC_GlobalCharacterAmbientSkinColor - MPC_GlobalCharacterDebugLightDirection) * pitchLerp;
	Lmpc = pitchOn * Lmpc + MPC_GlobalCharacterDebugLightDirection;
	Lmpc = Lmpc / sqrt(dot(Lmpc, Lmpc));
	float3 anchor   = ObjectWorldPosition + float3(0.0, 0.0, 100.0);
	float3 toAnchor = ToonLight0.xyz - anchor;
	float3 toTarget = ToonLight0.xyz - LocalLightTarget;
	float3 Lpt = CPD13 * (toTarget - toAnchor) + toAnchor;
	Lpt = Lpt / sqrt(dot(Lpt, Lpt));
	float3 dA = anchor - ToonLight0.xyz;
	float  distFrac = saturate(sqrt(dot(dA, dA)) * ToonLight0.w);
	float  type = (float)((asuint(ToonLight1.w) >> 16) & 3u);
	float  isT1 = min((1.1 >= type) ? 1.0 : 0.0, (type >= 0.9) ? 1.0 : 0.0);
	float  isT2 = min((2.1 >= type) ? 1.0 : 0.0, (type >= 1.9) ? 1.0 : 0.0);
	float  typeF = isT2 * (-isT1 * 0.5 + 1.0) + isT1 * 0.5;
	float3 toPixel = ToonLight0.xyz - WorldPosition;
	float3 dirL = toPixel * (1.0 / sqrt(dot(toPixel, toPixel)));
	dirL = dirL / sqrt(dot(dirL, dirL));
	float3 axis = ToonLight1.xyz / sqrt(dot(ToonLight1.xyz, ToonLight1.xyz));
	float  spot = saturate((dot(dirL, axis) - ToonLight2.x) * ToonLight2.y);
	precise float sq = 1.0 - spot * spot;
	float  spotTerm = min(sq + distFrac, 1.0);
	float  isSpot = max(typeF * 2.0 - 1.0, 0.0);
	float  blend  = isSpot * (spotTerm - distFrac) + distFrac;
	float3 Lt = blend * (Lmpc - Lpt) + Lpt;
	float3 L  = ToonLight3.z * (Lt - Lmpc) + Lmpc;
	float  vsW = saturate(CPD1);
	L = vsW * (LightDirVS - L) + L;
	return L / sqrt(dot(L, L));
}

// Region ID of the fur / parallax gates (PS 8dec27d6 L86-100, 6b7c6be0 L706-711): RegionIDTex low / high nibble IDs blended by
// the LOD-0 TypeMask.a (the material ID of the main chain blends by the MipBias read instead).
float WuwaV2BodyGateRegionID(Texture2D RegionIDTex, SamplerState RegionIDTexSampler, Texture2D TypeMask, SamplerState TypeMaskLod0Sampler,
	float2 UV, float MaterialTextureMipBias)
{
	int    rid = (int)(RegionIDTex.SampleLevel(RegionIDTexSampler, UV, MaterialTextureMipBias).r * asfloat(0x437F8000u));   // 255.5
	float  tmA = TypeMask.SampleLevel(TypeMaskLod0Sampler, UV, 0.0).a;
	int    idLo = rid & 15, idHi = rid >> 4;
	float  fLo = (float)idLo;
	float  fHi = (0 < idHi) ? (float)idHi : 0.0;
	return (0 < idHi) ? ((tmA >= 0.5 ? 1.0 : 0.0) * (fHi - fLo) + fLo) : fLo;
}

// UseFurryParallax gate (multiplies the height, the loop runs only where it is 1). GateMode 0 (PS 8dec27d6 L101-112): region of
// the UV0 RegionIDTex / LOD-0 TypeMask.a ID in [FurParallaxMin, FurParallaxMax] and not skin: max(inParallax - inSkin, 0).
float WuwaV2BodyParallaxGate(const uint GateMode, Texture2D RegionIDTex, SamplerState RegionIDTexSampler, Texture2D TypeMask,
	SamplerState TypeMaskLod0Sampler, float2 UV0, float MaterialTextureMipBias, float SkinMin, float SkinMax, float FurParallaxMin,
	float FurParallaxMax)
{
	float id = WuwaV2BodyGateRegionID(RegionIDTex, RegionIDTexSampler, TypeMask, TypeMaskLod0Sampler, UV0, MaterialTextureMipBias);
	float gP = id + 0.5, gM = id + -0.5;
	float inSkin = ((gP >= SkinMin) ? 1.0 : 0.0) * ((SkinMax >= gM) ? 1.0 : 0.0);
	float inPar  = ((gP >= FurParallaxMin) ? 1.0 : 0.0) * ((FurParallaxMax >= gM) ? 1.0 : 0.0);
	return max(inPar - inSkin, 0.0);
}

// UseFurryParallax gate, GateMode 1 (PS e9ec2704 L100-106, UseVertexAMask maps): vertex alpha in [0.4, 0.6] * UseVertexAMask.
float WuwaV2BodyParallaxGateV(float VertexColorA, float UseVertexAMask)
{
	precise float g = ((VertexColorA >= 0.4) ? 1.0 : 0.0) * ((0.6 >= VertexColorA) ? 1.0 : 0.0);
	return g * UseVertexAMask;
}

// UseFurryParallax (PS 8dec27d6 L113-189; the same Custom-node loop is inlined once per material output chunk, up to four times):
// parallax occlusion ray march over the height map with a flow-map drift. h = Gate * Height * 0.01; off = -(T.V, B.V) / (N.V) * h;
// uvP0 = UV0 + off * (Plane - 1); steps = lerp(MaxStep, MinStep, min(|N.V|, 1)), loop floor(steps) + 2 times with the
// screen-space derivatives of uvP0 (coarse) for both SampleGrad reads; the layer height steps by 1 / steps, the flow map (UV0 *
// FlowmapScale + off * (Plane - 1) + layer step * FlowmapScale / HeightMapSize) drifts the march by FlowMapInt and FurRootInv;
// the height is faded by the vertex-normal rim smoothstep [ParallaxRimFadeMin, max(ParallaxRimFadeMax, 1e-4)]. Returns the UV of
// the material textures: UV0 + off * (Plane - 1) + accumulated offset / HeightMapSize. GateP = the region / vertex gate (loop only
// when == 1).
float2 WuwaV2BodyParallaxUV(Texture2D HeightMap, SamplerState HeightMapSampler, Texture2D FlowmapMap, SamplerState FlowmapMapSampler,
	float2 UV0, float3 T, float3 Bt, float3 Nv, float3 V, float3 WorldPosition, float3 WorldCameraOrigin, float GateP,
	float Height, float Plane, float HeightMapSize, float MinStep, float MaxStep, float ParallaxRimFadeMin, float ParallaxRimFadeMax,
	float FlowmapScale, float FlowMapInt, float FurRootInv)
{
	const float FLTMAX = asfloat(0x7F7FFFFFu);
	float  h01 = min(Height * 0.01, FLTMAX);                                                   // preshader Height * 0.01
	float  K = min((1.0 - Plane) * -1.0, FLTMAX);                                              // preshader (1 - Plane) * -1
	float  kF = min(FlowmapScale / HeightMapSize, FLTMAX);                                     // preshader FlowmapScale / HeightMapSize
	float  rfMax = max(ParallaxRimFadeMax, asfloat(0x38D1B717u));                              // preshader max(Max, 0.0001)
	float  h = GateP * h01;
	float  tv = dot(T, V), bv = dot(Bt, V), nv = dot(Nv, V);
	float4 off = -float4(tv, bv, tv, bv) / nv;
	off = h * off;
	float4 o7 = off * float4(K, K, HeightMapSize, HeightMapSize);
	float2 uvP0 = off.xy * K + UV0;
	float  steps = min(abs(nv), 1.0) * (MinStep - MaxStep) + MaxStep;
	float  nsteps = floor(steps);
	float  inv = 1.0 / steps;
	float2 stepUV = inv * o7.zw;
	float2 dx = ddx_coarse(uvP0), dy = ddy_coarse(uvP0);
	float3 cv = WorldCameraOrigin - WorldPosition;
	cv = cv / sqrt(dot(cv, cv));
	float  rf = saturate((dot(Nv, cv) - ParallaxRimFadeMin) * (1.0 / (rfMax - ParallaxRimFadeMin)));
	rf = (rf * rf) * (rf * -2.0 + 3.0);
	float  fg = GateP * rf;
	float2 flowBase = UV0 * FlowmapScale + o7.xy;
	float2 acc = float2(0.0, 0.0);
	if (GateP == 1.0)
	{
		float limit = nsteps + 2.0;
		float fri = FurRootInv * -2.0 + 1.0;
		float cur = 1.0, prevL = 1.0, prevH = 1.0;
		[loop] for (int i = 0; ; ++i)
		{
			float fi = (float)i;
			if (fi >= limit)
				break;
			float2 su = stepUV * fi;
			float2 fuv = stepUV * kF + su * kF;
			fuv = flowBase + fuv;
			float2 fl = FlowmapMap.SampleGrad(FlowmapMapSampler, fuv, dx, dy).xy * 2.0 + -1.0;
			fl = fl * FlowMapInt;
			fl = inv * fl;
			float  hh = HeightMap.SampleGrad(HeightMapSampler, uvP0 * HeightMapSize + acc, dx, dy).r;
			float  hz = fg * hh;
			if (cur < hz)
			{
				float d1 = fg * hh - cur;
				float w  = d1 / (d1 + (prevL - prevH));
				acc = -w * (fl * fri + stepUV) + acc;
				break;
			}
			float2 su2 = o7.zw * inv + su;
			float  m = FurRootInv * (fi * -2.0 + limit) + fi;
			acc = m * fl + su2;
			prevL = cur;
			prevH = hz;
			cur = cur - inv;
		}
	}
	return (off.xy * K + acc / HeightMapSize) + UV0;
}

// UseFurry: UE 4.26 ApplyPixelDepthOffsetToMaterialParameters as compiled in the Kuro PS (6b7c6be0 L742-756): device depth with
// the material pixel depth offset (orthographic gate |w - 1| <= 1e-5), clamped to SvPosition.z, the offset recomputed from the
// clamped depth and the world position moved along the camera vector. The original evaluates the GBuffer custom outputs (shadow
// factor, shadow colour, mode-0 opacity, FFT) and the OutOfBoundsMask debug colour AFTER this, at the moved position; emissive and
// the lit colour BEFORE (see the fur entries: two Impl passes). Returns the moved absolute / translated world positions.
void WuwaV2BodyApplyPDO(float PDO, float2 SvPositionZW, float3 CameraVector, float3 WorldPosition, float3 PreViewTranslation,
	out float3 WorldPositionPDO, out float3 TranslatedWorldPositionPDO)
{
	precise float sz = SvPositionZW.x * SvPositionZW.y;                                                // ScreenPosition.z
	precise float sw = 1.0 * SvPositionZW.y;                                                           // ScreenPosition.w
	precise float ortho = ((sw >= asfloat(0x3F7FFF58u)) ? 1.0 : 0.0) * ((asfloat(0x3F800054u) >= sw) ? 1.0 : 0.0);
	precise float pdo = (1.0 - ortho) * PDO;
	precise float d = min(sz / (pdo + sw), SvPositionZW.x);
	precise float pc = (-(sw * d) + sz) / d;
	precise float3 mv = pc * CameraVector;
	WorldPositionPDO = WorldPosition + mv;
	TranslatedWorldPositionPDO = WorldPositionPDO + PreViewTranslation;
}

FWuwaToonGBuffer WuwaToonBodyV2BasePass_Impl(const uint SpecMode, const bool bVDL, const bool bTwoSided, const bool bOnlySkinRamp, const bool bFresnel,
	const bool bBreath, const bool bRampIDMask, const bool bTransCloth, const bool bHETA,
	const bool bEffectSecond, const bool bRim, const bool bSecondNoise, const bool bFlowEdge, const uint SecondMaskCh,
	const bool bSecondBump, const bool bHue, const uint MaskMode, const bool bAlphaBlend, const bool bXingHen, const bool bXHRot, const bool bSparkle, const bool bWet, const bool bRegionID,
	const bool bSkinWet, const bool bBlendParam, const bool bSparkleLegacy, const bool bNormalMap, const bool bEffectMask, const bool bObjScreenUV, const bool bTypeMask, const bool bTextRain,
	const uint FurPass, const uint Forms, const bool bFurry, const bool bParallax, const uint FurClip, const bool bTangentClip,
	const uint FurGate,
	float TwoSidedSign,

	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler,
	Texture2D TypeMask, SamplerState TypeMaskSampler, SamplerState TypeMaskLod0Sampler,
	Texture2D RegionIDTex, SamplerState RegionIDTexSampler, Texture2D MainTex, SamplerState MainTexSampler,
	Texture2D MatCapTex, SamplerState MatCapTexSampler, Texture2D Ramp, SamplerState RampSampler,
	float2 UV0, float3 WorldTangent, float3 WorldNormal, float TangentSign, float3 WorldPosition, float3 TranslatedWorldPosition,
	float3 CameraVector, float3 LightDirVS, float MotionEmissiveMask, float4x4 TranslatedWorldToView,
	// front end
	float DamageIntensity, float Damage_Skin_Intensity, float SkinMin, float SkinMax, float UseFaceAni_SkinMask,
	float3 SkinColor, float3 Damage_Dirty_SkinColorTint, float3 Damage_Dirty_ColorTint, float Damage_Dirty_Intensity,
	float3 Damage_Skin_ColorTint, float3 BaseColorTint, float DecodeShadowThreshold, float DecodeSpecThreshold,
	float NormalStrength, float RaytracingReflectionFix,
	// region ranges
	float FresnelMin, float FresnelMax, float AnisotropyMin, float AnisotropyMax, float ExtraMatcapMin, float ExtraMatcapMax,
	// fresnel
	float3 FresnelColor0, float FresnelRangeMin0, float FresnelRangeMax0, float FresnelRangePower0,
	float3 FresnelColor1, float FresnelRangeMin1, float FresnelRangeMax1, float FresnelRangePower1,
	float UseFresnel1, float FresnelIntensity,
	// PBR by region
	float Metallic0, float Metallic1, float Metallic2, float Metallic3, float Metallic4, float UseIDMetallicParam, float MetallicIntensityDebug,
	float Roughness0, float Roughness1, float Roughness2, float Roughness3, float Roughness4, float UseIDRoughnessParam, float RoughnessIntensityDebug,
	float Spec_Int0, float Spec_Int1, float Spec_Int2, float Spec_Int3, float Spec_Int4,
	float Spec_Width0, float Spec_Width1, float Spec_Width2, float Spec_Width3, float Spec_Width4,
	float Spec_Smooth0, float Spec_Smooth1, float Spec_Smooth2, float Spec_Smooth3, float Spec_Smooth4,
	float PBRAnisotropyU, float PBRAnisotropyV, float UsePixelTangent, float EdgeEnvBRDFIntensity, float UseTexNormal,
	float MatcapMaxMip, float MetalMatCapBack, float NonMetallicMatCapInt, float MetalMatCapInt, float PBRRateIntensity,
	float3 MatcapColor, float3 PBRIndirectColor, float3 PBRSpecularColor,
	// shadow / ramp
	float SolidShadowProcess, float SolidShadowWidth, float LightOffset_Pitch, float ShadowProcess,
	float ShadowWidth, float ShadowWidthUseID, float ShadowWidth0, float ShadowWidth1, float ShadowWidth2, float ShadowWidth3, float ShadowWidth4,
	float AniSwitch_ShadowColorBright, float SolidShadow_RampPosition,
	float RampID0, float RampID1, float RampID2, float RampID3, float RampID4,
	float RampInt0, float RampInt1, float RampInt2, float RampInt3, float RampInt4,
	float Desaturation, float3 SkinSubsurfaceColor, float3 SubsurfaceColor, float SolidShadowStrength,
	// emissive / encode
	float3 EmissionColor, float3 E_Motion_Emissive, float4 SelectionColor,
	float OpacityIntensity, float ToonRimWidth, float SSAOSkinIntensity, float SSAOIntensity,
	float FFTMin, float FFTMax, float FFT_SparkThreshold, float FFT_SparkIntensity, float FFT_SpecularThreshold, float FFT_SpecularIntensity,
	float CPD1, float CPD13,
	float MPC_GlobalCharSkyLightIntensity, float3 MPC_GlobalCharacterAmbientSkinColor, float3 MPC_GlobalCharacterDebugLightDirection,
	float4 ToonLight0, float4 ToonLight1, float4 ToonLight2, float4 ToonLight3,
	float MaterialTextureMipBias, float4 NormalOverrideParameter, float KuroGBufferMode,
	float3 KuroEmissiveScale, float KuroSkipEmissiveScale, float OutOfBoundsMask, float3 ObjectWorldPosition, float3 ObjectBounds,
	uint LightingChannelMask,
	// UseBreathLight (PS 05e0ca78 L152-161): GameTime = Kuro View[148].z
	float GameTime, float BreatheStrength, float BreatheFrequency, float BreathePropotion, float EmissionStrength,
	float EmissionBreathThreshold,
	// no UseRampIDMask: one ramp row / intensity
	float RampIndex, float RampInt,
	// UseTranslucentCloth
	float OpacityMask_Offset, float OpacityMask_Width, float TransClothMin, float TransClothMax, float TranslucentMask_Offset,
	float TranslucentMask_Width, float ViewLightMask_Offset, float ViewLightMask_Width, float LightIntensity,
	float TraClothFresnelMin, float TraClothFresnelMax, float TraClothFresnelInt,
	// UseEffectMaterial second emissive layer (UV1 = Kuro TEXCOORD1.xy, UV2 = TEXCOORD1.zw)
	Texture2D R_Noise_A_Mask, SamplerState R_Noise_A_MaskSampler, Texture2D Second_RGB, SamplerState Second_RGBSampler,
	float2 UV1, float2 UV2, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float4 SecondTex_UVSwitch, float Second_UseScreenUV, float Second_RotCos, float Second_RotSin,
	float4 Second_UV, float4 Second_UV_Offset,
	float4 Noise_UVSwitch, float Noise_UseScreenUV, float4 NoiseUV, float NoiseStrength, float Second_NoiseStrength,
	float4 Second_Refine, float3 Second_ColorTint, float EffectMaskTexUV2Switch, float Effect_Progress,
	// UseRim (effect fresnel rim added to the second layer)
	float FresnelRim_RimRange, float FresnelRim_Smooth, float FresnelRim_Reverse, float3 FresnelRim_RimColor,
	// UseFlowEffectEdge (mask UV pushed by the second texture's red)
	float FlowEffectEdge_Strength,
	// UseBumpOffset on the second layer (tangent-space view parallax)
	float Second_BumpHeightRadio, float Second_BumpHeight,
	// UseHueShift (body: by region [HueShiftMin, HueShiftMax])
	float HueShiftMin, float HueShiftMax, float NoVNoHBlend, float NoVHPower, float HueShiftFlip, float HueTilling,
	float HueSwitch2D3D, float HueOffset, float HueIntensity, float3 HueShiftColor,
	// BLEND_Masked: MaskMode 1 (UseTranslucent) DitherTemporalAA opacity mask, 2 (UseAlphaBlendMode) plain opacity; + Kuro primitive
	// dither; discard inside
	Texture2D DitherTex, SamplerState DitherTexSampler, float TemporalAAParamsX, float TranslucentDitherVaule,
	float KuroPrimDitherEnable, float KuroPrimDitherFade,
	// UseXingHen (star mark; UV3X = Kuro TEXCOORD1.z; XHRotCos/XHRotSin = CPU cos/sin(Rotation Angle (0-1) (S) * 2pi))
	Texture2D D, SamplerState DSampler, Texture2D Noise, SamplerState NoiseSampler, Texture2D Noise02, SamplerState Noise02Sampler,
	float UV3X, float4 SDFColor, float4 SDFColor02, float ShakeNoiseInt, float UVpositionX, float UVpositionY, float UVScaleX,
	float UVScaleY, float XHRotCos, float XHRotSin, float XingHenControl, float SDFStart, float SoundWaveTiling01,
	float SoundWaveSpeed01, float SoundWaveInt01, float SoundWaveTiling02, float SoundWaveSpeed02, float SoundWaveInt02,
	float XHMax, float XingHenPosition,
	// UseSparkle (glitter: CommonNoiseMap .xy, UV0/1/2 switch, view-parallax pan, hue-rotated base colour)
	Texture2D CommonNoiseMap, SamplerState CommonNoiseMapSampler, float4 Sparkle_UV_Switch, float SparkleTiling, float SparkleTimeSpeed,
	float SparkleMin, float SparkleMax, float SparkleRange, float SparkleSoft, float SparkleRangeMode, float SparkleBaseLuminance,
	float SparkleIntensity, float SparkleIntensityMax, float SparkleColorful, float SparkleStep, float3 HueShiftValue,
	float SparkleStrengthFOV, float UseSparkleFOVStrength, float ClipToView00, float3 WorldCameraOrigin, float3 LocalToWorldRow2,
	float3 LocalToWorldRow3,
	// Use_Char_Wet (CPD 26 wet amount, CPD 27 + UV3.y (TEXCOORD1.w) + WaterWet_TransitionTex wet front; wet PBR per region)
	Texture2D WaterWet_TransitionTex, SamplerState WaterWet_TransitionTexSampler, float UV3Y, float CPD_WetAmount,
	float CPD_WetTransition, float WaterWet_TransitionTilling,
	float WetMetallicOffset0, float WetMetallicOffset1, float WetMetallicOffset2, float WetMetallicOffset3, float WetMetallicOffset4,
	float WetRoughnessOffset0, float WetRoughnessOffset1, float WetRoughnessOffset2, float WetRoughnessOffset3, float WetRoughnessOffset4,
	float Wet_Desaturation, float Wet_Lightness, float Wet_OpacityInBaseCol_Blend, float WetSkin_Desaturation, float WetSkin_Lightness,
	float Wet_OpacityPowerMin, float Wet_OpacityPowerMax, float Wet_Opacity,
	float E_Link_UseSplitScreen, float4 E_Link_AngleLinePosLineDis, float E_LinkPos, float2 LinkRot0, float2 LinkRot1,
	// Use_SkinPBR_Wet (wet skin: dual-lobe GGX specular on the mirrored light where SkinF > 0.9)
	float DualSpecBackIntensity, float DualSpecOpacity, float DualSpeRoughness0, float DualSpeRoughness1, float DualSpeLobeMix,
	// LegacyMode sparkle (single noise channel, SparkleColor, optional UV1.y range input)
	float3 SparkleColor, float SparkleMaskUseUV2,
	// UseEffectMaterial without UseSecond: emissive mask colour
	float3 EffectMaskColor,
	// Second_UseObjectScreenUV (second layer UV = object-relative screen offset)
	float4 Second_ScreenObjectUV, float4x4 WorldToClip, float3 PreViewTranslation, float4x4 TranslatedWorldToCameraView,
	// UseTypeMask off: region ID from the vertex colour red (COLOR0.r)
	float VertexColorR,
	// Use_TextRain (glyph rain emissive on UV1)
	Texture2D Text_Tex, SamplerState Text_TexSampler, float Text_Speed, float TextRain_Tilling_Base, float TextRain_Tilling_Bump,
	float Rain_Speed_Base, float Rain_Speed_Bump, float Rain_Intensity, float HueShiftColor_Offset, float TextRain_RangeMin_Base,
	float TextRain_RangeMax_Base, float TextRain_RangeMin_Bump, float TextRain_RangeMax_Bump, float3 TextRain_Color_Base,
	float3 TextRain_Color_Bump, float TexRain_BumpOffset, float Matrix, float TextRain_Base_Intensity, float TextRain_BumpOffset_Intensity,
	float TextRainMin, float TextRainMax,
	// UseFurry (fur shell clip + pixel depth offset, PS 6b7c6be0 L681-756): Fur_Tex.r on UV1 * (FurTexU, 1), view-angle step,
	// vertex-red fade, region gate [FurClusterMin, Max] - skin - [FurParallaxMin, Max]
	Texture2D Fur_Tex, SamplerState Fur_TexSampler, float FurTexU, float FurTexBias, float FurRangeStep, float FurRangeStepOffset,
	float FurAlphaIntensity, float FurClusterMin, float FurClusterMax, float FurParallaxMin, float FurParallaxMax, float UseMainTexAlpha,
	float FurBlendIntensity, float FurBlendUseVertexRFade,
	// UseFurryParallax: UV of the material textures (Normal_Roughness_Metallic, TypeMask, RegionIDTex, MainTex) from
	// WuwaV2BodyParallaxUV (computed by the entry)
	float2 UVP,
	// UseFurry + UseTangentClip (PS bd79aa07 L671-692): fur value * lerp(1, smoothstep(MIN, MAX, (TwoSidedSign * cross(N, T)) . V), fade)
	float FurTangentMin, float FurTangentMax,
	// UseFurry FurGate 1 (PS e9ec2704 L739-765): fur gate from the vertex alpha (0.25 >= lerp(1, COLOR0.a, UseVertexColor)) instead of
	// the region ranges
	float VertexColorA, float UseVertexColor,
	// split pass 2 of UseFurryParallax: the main chunk's shading normal (the custom-output chunk re-samples the other material
	// textures at its own parallax UV but keeps that normal)
	float3 NIn,
	out float FurPDO, out float3 NOut,
	// round 6: RawOut 1 = forward-translucent material part (the V2 translucent bodies, research/roster/round6/v2.md): G carries the
	// raw material values instead of the encoded GBuffer (Emissive before WuwaBPFinalEmissive, C = (colour, opacity), A = (N, Shadow),
	// B = (shadow colour, shadow-factor AO), D.x = SkinF); used only by the translucent entries (WuwaToonBodyV2Trans*)
	const uint RawOut = 0u,
	// round 6 (Mone glass PS f1919d2b L335-349): UseCameraOffsetLightDir on the double-specular light pair: the mirrored and the
	// direct light both lerp toward normalize(V * size) / normalize(V * size + L) by UseCameraOffsetLightDir before the shadow lerp
	const bool bCamOffsetL = false, float CameraOffsetLightSize = 0.0, float UseCameraOffsetLightDir = 0.0)
{
	FWuwaToonGBuffer G;
	FurPDO = 0.0;
	float2 UVM = UV0;      // UV of the material textures (UseFurryParallax: the parallax UV)
	if (bParallax)
		UVM = UVP;
	const float3 V = CameraVector;
	const float3 T = WorldTangent, Nv = WorldNormal;
	const float4 s4 = float4(1, 1, 1, 1);

	// ---- B62-86: tangent-space normal (z reconstructed, clamped 2/255..253/255), NormalStrength -------------------------
	float3 Bt = (Nv.yzx * T.zxy - Nv.zxy * T.yzx) * TangentSign;          // cross(N, T) * sign
	float3 nrm = Normal_Roughness_Metallic.Sample(Normal_Roughness_MetallicSampler, UVM).rga;   // .xyw sampled
	float2 n2 = nrm.xy + nrm.xy;
	float2 nxy = nrm.xy * 2.0 + -1.0;
	float  nz = sqrt(min(max(1.0 - dot(nxy, nxy), asfloat(0x3C007FEDu)), asfloat(0x3F7DFE00u)));
	float3 tn = NormalStrength * (float3(n2, nz) + -1.0) + float3(0.0, 0.0, 1.0);
	float3 Nmap = Bt * tn.y;
	Nmap = tn.x * T + Nmap;
	Nmap = tn.z * Nv + Nmap;

	// ---- B87-99: TypeMask (damage, region select), normal = lerp(Nmap, vertex N, DamageSkin) --------------------------------
	float3 TM = float3(1.0, 0.0, 0.0);   // UseTypeMask off (effect maps, PS c8d4bf2b L93): opacity 1, damage .b 0
	if (bTypeMask)
		TM = TypeMask.SampleLevel(TypeMaskSampler, UVM, MaterialTextureMipBias).rba;      // r opacity, b damage, a region select
	float  d = DamageIntensity * (TM.y - 0.5);
	float  dirtyIn = d + 0.5;
	float  DamageSkin = saturate(((d + asfloat(0xBB031200u)) * Damage_Skin_Intensity) * asfloat(0x40008399u));
	if (Forms & WUWA_V2F_DMG)   // precise compile (PS 6b7c6be0 L114-119): ((d + 0.5) - 0.502) * 2.008032 * DSI
	{
		precise float ds = dirtyIn + asfloat(0xBF008312u);                                             // -0.502
		ds = ds * asfloat(0x40008399u);
		DamageSkin = saturate(ds * Damage_Skin_Intensity);
	}
	else if (Forms & WUWA_V2F_DMG2)
	{
		precise float ds = (d + asfloat(0xBB031200u)) * asfloat(0x40008399u);
		DamageSkin = saturate(ds * Damage_Skin_Intensity);
	}
	float3 Nmix;
	if (bNormalMap)
		Nmix = DamageSkin * (Nv - Nmap) + Nmap;
	else      // UseNormalMap off (PS 0a7bbb48 L83-88): vertex normal only; Normal_Roughness_Metallic still gives the roughness (.a)
		Nmix = Nv;
	float  k = NormalOverrideParameter.w;
	float3 Nu = Nmix * k + (1.0 - k) * Nv;
	float  NuRsq = rsqrt(dot(Nu, Nu));
	float3 N = Nu * NuRsq;
	NOut = N;
	if (FurPass == 2u && bParallax)   // UseFurryParallax custom-output chunk: the shading normal of the main chunk (bd79aa07 L293-295)
		N = NIn;

	// ---- B100-113: RegionIDTex (low nibble ID, high nibble second ID chosen by TypeMask.a >= 0.5) ----------------------------
	int    rid = (int)(RegionIDTex.SampleLevel(RegionIDTexSampler, UVM, MaterialTextureMipBias).r * asfloat(0x437F8000u));   // 255.5
	int    idLo = rid & 15, idHi = rid >> 4;
	bool   hasHi = (0 < idHi);
	float  fLo = (float)idLo;
	float  fHi = hasHi ? (float)idHi : 0.0;
	// UseFurryParallax (PS 8dec27d6 L86-98, L216-219): the region ID of the ranges / ramp rows / skin keeps the UV0 RegionIDTex
	// nibbles (blended by the parallax-UV TypeMask.a); the parallax-UV RegionIDTex read only feeds the per-region metallic / roughness
	int    ridR = rid;
	if (bParallax)
		ridR = (int)(RegionIDTex.SampleLevel(RegionIDTexSampler, UV0, MaterialTextureMipBias).r * asfloat(0x437F8000u));
	int    rLo = ridR & 15, rHi = ridR >> 4;
	bool   rHasHi = (0 < rHi);
	float  rfLo = (float)rLo;
	float  rfHi = rHasHi ? (float)rHi : 0.0;
	float  id = (TM.z >= 0.5 ? 1.0 : 0.0) * (rfHi - rfLo) + rfLo;
	id = rHasHi ? id : rfLo;
	if (!bRegionID)   // UseRegionID off (PS 8d01d973 L108-111): region ranges / rows by floor(min(TypeMask.a, 0.99) * 5); RegionIDTex
		id = floor(min(bTypeMask ? TM.z : VertexColorR, asfloat(0x3F7D70A4u)) * 5.0);   // still selects the per-region metallic /
		                                                   // roughness; without TypeMask (c8d4bf2b L113-115) the region is COLOR0.r
	float  idP = id + 0.5, idM = id + -0.5;

	// ---- B115-130: region ranges, skin ----------------------------------------------------------------------------------------
	float  inFres  = ((idP >= FresnelMin) ? 1.0 : 0.0) * ((FresnelMax >= idM) ? 1.0 : 0.0);
	float  inAniso = ((idP >= AnisotropyMin) ? 1.0 : 0.0) * ((AnisotropyMax >= idM) ? 1.0 : 0.0);
	float  inSkin  = ((idP >= SkinMin) ? 1.0 : 0.0) * ((SkinMax >= idM) ? 1.0 : 0.0);
	float  inExtra = ((idP >= ExtraMatcapMin) ? 1.0 : 0.0) * ((ExtraMatcapMax >= idM) ? 1.0 : 0.0);
	float  Skin  = max(DamageSkin, inSkin);
	float  SkinF = UseFaceAni_SkinMask * (1.0 - Skin) + Skin;

	// ---- B131-145: base colour ---------------------------------------------------------------------------------------------
	float3 SkinTint = SkinF * (SkinColor + -1.0) + 1.0;
	float3 dirty = Skin * (Damage_Dirty_SkinColorTint - Damage_Dirty_ColorTint) + Damage_Dirty_ColorTint;
	dirty = saturate(-(1.0 - saturate(dirtyIn + dirtyIn)) * Damage_Dirty_Intensity + 1.0) * (1.0 - dirty) + dirty;
	float4 Main = MainTex.Sample(MainTexSampler, UVM);
	float3 albedo = DamageSkin * (Damage_Skin_ColorTint - Main.rgb) + Main.rgb;
	float3 dab = (dirty * albedo) * BaseColorTint;
	float3 Base = SkinTint * dab;
	float3 bA = SkinTint, bB = dab;   // Base = bA * bB; the fresnel overlay re-forms -bA * bB + x as one mad (hue: Base0 * tint)

	float3 XHCol = float3(0.0, 0.0, 0.0);
	float  XHOp = 0.0, XHG = 0.0;
	if (bXingHen)
		WuwaV2BodyXingHen(bXHRot, D, DSampler, Noise, NoiseSampler, Noise02, Noise02Sampler, UV0, UV3X, GameTime, SDFColor, SDFColor02,
			ShakeNoiseInt, UVpositionX, UVpositionY, UVScaleX, UVScaleY, XHRotCos, XHRotSin, XingHenControl, SDFStart, SoundWaveTiling01,
			SoundWaveSpeed01, SoundWaveInt01, SoundWaveTiling02, SoundWaveSpeed02, SoundWaveInt02, XHMax, XingHenPosition, XHCol, XHOp, XHG);

	// ---- B230-290: light direction (computed early: the hue shift reads it) --------------------------------------------------------------------------------------------
	float3 L = WuwaV2BodyMainLightDir((Forms & WUWA_V2F_SPOT) != 0u, LightOffset_Pitch, MPC_GlobalCharacterAmbientSkinColor,
		MPC_GlobalCharacterDebugLightDirection, ToonLight0, ToonLight1, ToonLight2, ToonLight3, ObjectWorldPosition, WorldPosition, WorldPosition,
		CPD13, CPD1, LightDirVS);

	if (bHue)   // UseHueShift on the body (PS 4ace99af L142, L205-240): base *= lerp(1, hue(HueShiftColor) * HueIntensity, inHue)
	{
		float  hNoV = dot(N, V);
		float3 hL = L / sqrt(dot(L, L));
		float3 hH = hL + V;
		hH = hH / sqrt(dot(hH, hH));
		float  hb = NoVNoHBlend * (dot(hH, N) - hNoV) + hNoV;
		float  hp = WuwaV2PowSat(hb, NoVHPower);
		hp = HueShiftFlip * (hp * -2.0 + 1.0) + hp;
		float  hu = UV0.x * HueTilling + hp;
		float  ang = HueSwitch2D3D * (HueTilling * hp - hu) + hu;
		ang = (ang + HueOffset) * asfloat(0x40C90FDBu);                                           // 2*pi
		const float3 kGrey = float3(asfloat(0x3F13CD3Au), asfloat(0x3F13CD3Au), asfloat(0x3F13CD3Au));   // 0.57735
		float  hd = dot(kGrey, HueShiftColor);
		float3 hU = HueShiftColor - hd * kGrey;
		float3 hT = hU.zxy * kGrey;
		float3 hV = hU.zxy * kGrey - hT.zxy;
		float  hs, hc;
		sincos(ang, hs, hc);
		float3 Hue = hd * kGrey + (hU * hc + hs * hV);
		float  inHue = ((idP >= HueShiftMin) ? 1.0 : 0.0) * ((HueShiftMax >= idM) ? 1.0 : 0.0);
		inHue = min(1.0 - DamageSkin, inHue);
		float3 tint = inHue * (Hue * HueIntensity + -1.0) + 1.0;
		bA = Base; bB = tint;
		Base = Base * tint;
	}

	// ---- B146-181: lighting normal, two-layer fresnel, overlay on the base ----------------------------------------------------
	// two-sided materials (PS 13a292f4 L75-77, L150-152) flip only the lighting normal by
	// TwoSidedSign = View.CullingSign * Primitive.DeterminantSign * (front ? 1 : -1) (UE: Parameters.TwoSidedSign)
	float3 NL = bTwoSided ? RaytracingReflectionFix * (-N * TwoSidedSign + Nv) + TwoSidedSign * N
	                      : RaytracingReflectionFix * (-N + Nv) + N;
	float  NoV = dot(NL, V);
	float  nds = 1.0 - DamageSkin;
	float3 Base2 = Base;
	if (bFresnel)        // UseFresnel
	{
		float  f0t = saturate((NoV - FresnelRangeMin0) / (FresnelRangeMax0 - FresnelRangeMin0));     // preshader Max - Min
		float  f0p = exp2(log2(f0t) * FresnelRangePower0);
		float3 fr0 = ((asfloat(0x33000002u) >= f0t) ? float3(0.0, 0.0, 0.0) : f0p * (0.5 - FresnelColor0)) + FresnelColor0;
		float  f1t = saturate((NoV - FresnelRangeMin1) / (FresnelRangeMax1 - FresnelRangeMin1));
		float  f1p = exp2(log2(f1t) * FresnelRangePower1);
		f1p = (asfloat(0x33000002u) >= f1t) ? 0.0 : f1p;
		float3 fr = UseFresnel1 * ((f1p * (fr0 - FresnelColor1) + FresnelColor1) - fr0) + fr0;
		fr = FresnelIntensity * (fr + -0.5) + 0.5;
		float3 bf = Base * fr;
		float3 scr = -((-bA * bB + 1.0) * (1.0 - fr)) * 2.0 + 1.0;
		float3 geF = float3(fr.x >= 0.5 ? 1.0 : 0.0, fr.y >= 0.5 ? 1.0 : 0.0, fr.z >= 0.5 ? 1.0 : 0.0);
		float3 ov = geF * (-bf * 2.0 + scr) + (bf + bf);
		inFres = min(nds, inFres);
		Base2 = inFres * (-bA * bB + ov) + Base;
	}
	else
	{
		inFres = 0.0;
	}
	inAniso = min(nds, inAniso);

	// ---- B186-194: MainTex.a decode ----------------------------------------------------------------------------------------------
	float  ShadowPart = min(max(Main.a, 0.0), DecodeShadowThreshold) / DecodeShadowThreshold;
	float  SpecPart = (min(max(Main.a, DecodeSpecThreshold), 1.0) - DecodeSpecThreshold) / (1.0 - DecodeSpecThreshold);
	float3 specBase = SpecPart * Base2;

	// ---- B195-229: metallic / roughness by region (two IDs lerped by TypeMask.a), solid ratio -------------------------------------
	float2 tmGA = TypeMask.SampleLevel(TypeMaskLod0Sampler, UVM, 0.0).ga;
	float4 mv = float4(Metallic0, Metallic1, Metallic2, Metallic3), rv = float4(Roughness0, Roughness1, Roughness2, Roughness3);
	float  M4 = Metallic4, R4 = Roughness4;
	float  WetA = 0.0, WetTex = 0.0, WetT1 = 0.0, WetPre = 0.0, WetT1L = 0.0;
	if (bWet)
	{
		// Use_Char_Wet (PS 373d2cf9 L197-245): k_Metallic -> k_Metallic + k_Wet_Metallic_Offset, k_Roughness -> k_Roughness -
		// k_Wet_Roughness_Offset (preshaders), first by saturate(CPD26), then by the wet front T1 = sat((CPD27 * tex * 0.05 + UV3.y
		// + CPD27 * 18/17 - 1) * 20)^2 (this path scales the noise by CPD27; the colour path below does not)
		const float FLTMAX = asfloat(0x7F7FFFFFu);
		WetA = saturate(CPD_WetAmount);
		WetTex = WaterWet_TransitionTex.Sample(WaterWet_TransitionTexSampler, UV0 * WaterWet_TransitionTilling).r;
		WetPre = CPD_WetTransition * asfloat(0x3F878788u) + -1.0;                                    // 1.058824
		WetT1 = saturate(((CPD_WetTransition * (WetTex * asfloat(0x3D4CCCCDu)) + UV3Y) + WetPre) * 20.0);   // 0.05
		WetT1L = WetT1;
		WetT1 = WetT1 * WetT1;
		float4 mW = min(float4(Metallic0 + WetMetallicOffset0, Metallic1 + WetMetallicOffset1, Metallic2 + WetMetallicOffset2,
			Metallic3 + WetMetallicOffset3), FLTMAX);
		float4 rW = min(float4(Roughness0 - WetRoughnessOffset0, Roughness1 - WetRoughnessOffset1, Roughness2 - WetRoughnessOffset2,
			Roughness3 - WetRoughnessOffset3), FLTMAX);
		float  mW4 = min(Metallic4 + WetMetallicOffset4, FLTMAX), rW4 = min(Roughness4 - WetRoughnessOffset4, FLTMAX);
		mv = WetA * (mW - mv) + mv;
		M4 = WetA * (mW4 - M4) + M4;
		rv = WetA * (rW - rv) + rv;
		R4 = WetA * (rW4 - R4) + R4;
		if (Forms & WUWA_V2F_WETT1)   // precise compile: ((w - v) * t) * t + v
		{
			precise float4 dm = (mW - mv) * WetT1L;
			mv = dm * WetT1L + mv;
			precise float  dm4 = (mW4 - M4) * WetT1L;
			M4 = dm4 * WetT1L + M4;
			precise float4 dr = (rW - rv) * WetT1L;
			rv = dr * WetT1L + rv;
			precise float  dr4 = (rW4 - R4) * WetT1L;
			R4 = dr4 * WetT1L + R4;
		}
		else
		{
			mv = (mW - mv) * WetT1 + mv;
			M4 = (mW4 - M4) * WetT1 + M4;
			rv = (rW - rv) * WetT1 + rv;
			R4 = (rW4 - R4) * WetT1 + R4;
		}
	}
	float2 pr;
	if (bBlendParam)   // UseBlendParameter: metallic / roughness of the low and high RegionIDTex IDs, blended by TypeMask.a
	{
		float4 sLo = float4(idLo == 0 ? 1.0 : 0.0, idLo == 1 ? 1.0 : 0.0, idLo == 2 ? 1.0 : 0.0, idLo == 3 ? 1.0 : 0.0);
		float  lo4 = (idLo == 4) ? 1.0 : 0.0;
		float2 prLo = float2(M4 * lo4 + dot(mv, sLo), R4 * lo4 + dot(rv, sLo));
		float4 sHi = float4(idHi == 0 ? 1.0 : 0.0, idHi == 1 ? 1.0 : 0.0, idHi == 2 ? 1.0 : 0.0, idHi == 3 ? 1.0 : 0.0);
		float  hi4 = (idHi == 4) ? 1.0 : 0.0;
		float2 prHi = float2(M4 * hi4 + dot(mv, sHi), R4 * hi4 + dot(rv, sHi));
		prHi = hasHi ? prHi : float2(0.0, 0.0);
		pr = tmGA.y * (prHi - prLo) + prLo;
		pr = hasHi ? pr : prLo;
	}
	else               // UseBlendParameter off (PS 0c0146c0 L186-191, L317-318): metallic / roughness of the (float) region ID
	{
		float4 selP = float4(id == 0.0 ? 1.0 : 0.0, id == 1.0 ? 1.0 : 0.0, id == 2.0 ? 1.0 : 0.0, id == 3.0 ? 1.0 : 0.0);
		float  is4P = (id == 4.0) ? 1.0 : 0.0;
		pr = float2(M4 * is4P + dot(mv, selP), R4 * is4P + dot(rv, selP));
	}
	float  ms = pr.x + tmGA.x;
	float  metal = (UseIDMetallicParam * (pr.x - ms) + ms) * MetallicIntensityDebug;
	float  solid = WuwaV2SolidRatio(ShadowPart, SolidShadowProcess, SolidShadowWidth);

	// ---- B291-319: view-dependent threshold (VDL offset), region shadow width, half-Lambert band ---------------------------------
	float  SPp = (0.0 + ShadowProcess) + 0.0;
	float  thr = SPp;
	if (bVDL)   // UseVDLShadowoffset
	{
		thr = dot(L, V) * (1.0 - abs(V.z)) + 1.0;
		thr = thr * 0.25 + asfloat(0xBDCCCCCDu);                                                // -0.1
		thr = thr * (1.0 - saturate(NoV)) + SPp;
	}
	float4 sel = float4(id == 0.0 ? 1.0 : 0.0, id == 1.0 ? 1.0 : 0.0, id == 2.0 ? 1.0 : 0.0, id == 3.0 ? 1.0 : 0.0);
	float  is4 = (id == 4.0) ? 1.0 : 0.0;
	float  swid = WuwaV2ShadowWidthByID(id, ShadowWidth, ShadowWidthUseID, float4(ShadowWidth0, ShadowWidth1, ShadowWidth2, ShadowWidth3), ShadowWidth4);
	float  bLo = thr - swid, bHi = thr + swid;
	float  HL = dot(NL, L) * 0.5 + 0.5;
	float  s = saturate((1.0 / (bHi - bLo)) * (HL - bLo));
	s = (s * s) * (s * -2.0 + 3.0);
	float  Shadow = solid * s;

	// ---- B320-400: specular (iso / anisotropic, per-region intensity, width and smoothness) ---------------------------------------
	float  metal9 = metal * asfloat(0x3F8E38E3u);                                               // 1/0.9
	float  nonMetal = saturate(metal * -10.0 + 10.0);
	float  litMetal = saturate(Shadow) * (1.0 - nonMetal) + nonMetal;
	float  metalF = saturate(metal9);
	float  rs = pr.y + nrm.z;
	float  rough = (UseIDRoughnessParam * (pr.y - rs) + rs) * RoughnessIntensityDebug;
	float  rC = min(max(rough, 0.0), asfloat(0x3F666666u));                                      // 0..0.9
	float  rC2 = min(max(rough, asfloat(0x3F666666u)), 1.0);
	float  r9 = rC * asfloat(0x3F8E38E4u);
	float  si = Spec_Int4 * is4 + dot(float4(Spec_Int0, Spec_Int1, Spec_Int2, Spec_Int3), sel);
	float  si67 = si * asfloat(0x40D66666u);                                                     // 6.7
	float  sInt = r9 * (-si * asfloat(0x40D66666u) + asfloat(0x3C23D70Au)) + si67;               // lerp(6.7 si, 0.01, r)
	float  sW = 1.0 - (Spec_Width4 * is4 + dot(float4(Spec_Width0, Spec_Width1, Spec_Width2, Spec_Width3), sel));
	float  sS = Spec_Smooth4 * is4 + dot(float4(Spec_Smooth0, Spec_Smooth1, Spec_Smooth2, Spec_Smooth3), sel);
	float  ex = exp2(log2(r9) * asfloat(0x3DCCCCCDu)) * asfloat(0xC479C000u) + asfloat(0x447A0000u);   // 1000 - 999 r^0.1
	ex = (asfloat(0x32E66669u) >= rC) ? asfloat(0x447A0000u) : ex;
	float  spec;
	float  spNoH, spLobe, spW = 1.0;   // UseSparkle range input: lerp(N.H, lobe * w, SparkleRangeMode)
	if (SpecMode == 0u)
	{
		// UseHQAnisotropy (PS 63db5573 B353-384): iso Blinn vs anisotropic lobe inside [AnisotropyMin, AnisotropyMax]
		float3 H = V + L;
		H = H / sqrt(dot(H, H));
		float  NoH = saturate(dot(NL, H));
		float3 TxN = T.yzx * N.zxy - N.yzx * T.zxy;
		float3 Tp  = N.yzx * TxN.zxy - N.zxy * TxN.yzx;
		float3 Ts  = UsePixelTangent * (Tp - T) + T;
		float  bh = dot(TxN, H), th = dot(Ts, H);
		float  an = (bh * bh) * PBRAnisotropyV + (th * th) * PBRAnisotropyU;
		an = an / (-NoH * NoH + 1.0);
		float  lNoH = log2(NoH);
		float  sAn = exp2(lNoH * (ex * an)) * sqrt((PBRAnisotropyU + 1.0) * (PBRAnisotropyV + 1.0));
		float  sIso = exp2(lNoH * ex);
		spec = inAniso * (sAn * 0.5 - sIso) + sIso;
		spNoH = NoH; spLobe = spec;
	}
	else if (SpecMode == 3u)
	{
		// UseHQAnisotropy + UseDoubleSpecular (PS aedbf5b5 L312-350): the HQ lobe evaluated on N with the mirrored light,
		// then weighted by (2*shadow - 1)^4
		float3 L2 = L * float3(-1.0, -1.0, 1.0) + (Shadow * L) * float3(2.0, 2.0, 0.0);
		float3 H = V + L2;
		H = H / sqrt(dot(H, H));
		float  NoH = saturate(dot(N, H));
		float3 TxN = T.yzx * N.zxy - N.yzx * T.zxy;
		float3 Tp  = N.yzx * TxN.zxy - N.zxy * TxN.yzx;
		float3 Ts  = UsePixelTangent * (Tp - T) + T;
		float  bh = dot(TxN, H), th = dot(Ts, H);
		float  an = (bh * bh) * PBRAnisotropyV + (th * th) * PBRAnisotropyU;
		an = an / (-NoH * NoH + 1.0);
		float  lNoH = log2(NoH);
		float  sAn = exp2(lNoH * (ex * an)) * sqrt((PBRAnisotropyU + 1.0) * (PBRAnisotropyV + 1.0));
		float  sIso = exp2(lNoH * ex);
		float  w = Shadow * 2.0 + -1.0;
		w = w * w;
		w = w * w;
		spLobe = inAniso * (sAn * 0.5 - sIso) + sIso;
		spec = spLobe * w;
		spNoH = NoH; spW = w;
	}
	else if (SpecMode == 2u)
	{
		// neither UseHQAnisotropy nor UseDoubleSpecular (PS 0ca22930 L340-347): plain Blinn on the lighting normal
		float3 H = V + L;
		H = H / sqrt(dot(H, H));
		spNoH = saturate(dot(NL, H));
		spec = exp2(log2(spNoH) * ex);
		spLobe = spec;
	}
	else
	{
		// UseDoubleSpecular without HQ anisotropy (PS 40e72453 L347-360): light mirrored in xy toward the shadow side,
		// N (not the RaytracingReflectionFix normal), weight (2*shadow - 1)^4
		float3 L2 = L * float3(-1.0, -1.0, 1.0) + (Shadow * L) * float3(2.0, 2.0, 0.0);
		if (bCamOffsetL)
		{
			float3 Lm = L * float3(-1.0, -1.0, 1.0);
			float3 vo = V * CameraOffsetLightSize;
			vo = vo / sqrt(dot(vo, vo));
			float3 LmC = UseCameraOffsetLightDir * (vo - Lm) + Lm;
			float3 lv = V * CameraOffsetLightSize + L;
			lv = lv / sqrt(dot(lv, lv));
			float3 LC = UseCameraOffsetLightDir * (lv - L) + L;
			L2 = Shadow * (LC - LmC) + LmC;
		}
		float3 H2 = V + L2;
		H2 = H2 / sqrt(dot(H2, H2));
		spNoH = saturate(dot(N, H2));
		float  sp2 = exp2(log2(spNoH) * ex);
		float  w = Shadow * 2.0 + -1.0;
		w = w * w;
		w = w * w;
		spec = sp2 * w;
		spLobe = sp2; spW = w;
	}
	float  wA = 1.0 - sW;
	float  spHi = min(-wA * sS + (sW + sS), 1.0);
	float  sLo2 = max(wA * sS + (sW - sS), 0.0);
	float  st = saturate((1.0 / (spHi - sLo2)) * (spec - sLo2));
	st = (st * st) * (st * -2.0 + 3.0);
	float  SpecTerm = litMetal * (st * sInt);

	float3 Sk = float3(0.0, 0.0, 0.0);
	if (bSparkle)
	{
		// UseSparkle (PS b318cdb4 L485-562): glitter inside [SparkleMin, SparkleMax] where the lit specular lobe passes the
		// SparkleRange +- SparkleSoft band; CommonNoiseMap.xy sampled twice (bias -2): UV * Tiling and UV * Tiling + 0.2 V.xy
		// (+ time pan) + 0.4; brightness grows with the camera distance to the object point LocalToWorld * (0, 0, 80); colour =
		// Base * HueShiftValue hue-rotated by noise.y * SparkleColorful * 2pi, gated by noise.x >= step; optional FOV strength
		// (4/pi * atan(ClipToView[0][0]))^5. Added to the emissive; also the FFT spark source.
		const float FLTMAX = asfloat(0x7F7FFFFFu);
		float inSpark = ((idP >= SparkleMin) ? 1.0 : 0.0) * ((SparkleMax >= idM) ? 1.0 : 0.0);
		float sv = SparkleRangeMode * (spLobe * spW - spNoH) + spNoH;
		float rLo = min(SparkleRange - SparkleSoft, FLTMAX), rHi = min(SparkleRange + SparkleSoft, FLTMAX);   // preshaders
		float sx = litMetal * sv;
		if (bSparkleLegacy)   // LegacyMode (PS fbe30245 L597-599): the range input can be UV1.y (TEXCOORD1.y) instead
		{
			float lm = sv * litMetal;
			sx = SparkleMaskUseUV2 * (UV1.y - lm) + lm;
		}
		float sr = saturate((1.0 / (rHi - rLo)) * (sx - rLo));
		sr = (sr * sr) * (sr * -2.0 + 3.0);
		float sMask = max(min(nds, inSpark) * sr, SparkleBaseLuminance);
		float3 su3 = float3(UV0.x, UV1.x, UV2.x), sv3 = float3(UV0.y, UV1.y, UV2.y);
		float2 suv = float2(dot(Sparkle_UV_Switch.xzw, su3), dot(Sparkle_UV_Switch.xzw, sv3));
		float3 sc;
		if (bSparkleLegacy)
		{
			float2 n1 = CommonNoiseMap.SampleBias(CommonNoiseMapSampler, suv * SparkleTiling, -2.0).xy;
			float2 po = V.xy * asfloat(0x3E4CCCCDu);                                                    // 0.2
			float2 uv2 = suv * SparkleTiling + float2(po.x, GameTime * SparkleTimeSpeed + po.y);
			uv2 = uv2 + asfloat(0x3ECCCCCDu);                                                           // 0.4
			float2 n2 = CommonNoiseMap.SampleBias(CommonNoiseMapSampler, uv2, -2.0).xy;
			float2 nn = n1 * n2;
			float3 anc = LocalToWorldRow2 * 80.0 + LocalToWorldRow3;
			float3 dc = WorldCameraOrigin - anc;
			float  dist = min(sqrt(dot(dc, dc)) * asfloat(0x3A83126Fu), 1.0);                         // 0.001
			float  sI = dist * (SparkleIntensityMax - SparkleIntensity) + SparkleIntensity;
			nn = sI * nn;
			nn = n1 * nn;
			// LegacyMode (PS fbe30245 L615-634): one noise channel (.r), colour = SparkleColor (no base colour / hue / step gate)
			sc = sI * (nn.x * SparkleColor);
			float3 s32 = sc * asfloat(0x4200EB85u);                                                     // 32.23
			float  fv = atan(ClipToView00) * asfloat(0x3FA30EB2u);                                      // 4/pi
			float  fv4 = fv * fv;
			fv4 = fv4 * fv4;
			float  fs = saturate(fv * fv4) * SparkleStrengthFOV;
			sc = UseSparkleFOVStrength * (sc * fs - s32) + s32;
		}
		else   // WuwaToonBasePassV2Shared.ush (round 6: shared with the PBR face)
		{
			sc = WuwaV2PBRGlitter(suv, V, GameTime, CommonNoiseMap, CommonNoiseMapSampler, SparkleTiling, SparkleTimeSpeed, SparkleIntensity,
				SparkleIntensityMax, SparkleColorful, SparkleStep, Base2, HueShiftValue, SparkleStrengthFOV, UseSparkleFOVStrength, ClipToView00,
				WorldCameraOrigin, LocalToWorldRow2, LocalToWorldRow3);
		}
		Sk = sMask * sc;
	}

	// ---- B401-433: matcap (view-space cross UV, LOD from roughness and the MatCapTex size) ------------------------------------------
	float  edge = inFres * -EdgeEnvBRDFIntensity + EdgeEnvBRDFIntensity;
	// matcap: WuwaToonBasePassV2Shared.ush (round 6: shared with the PBR face)
	float2 mcUV = WuwaV2PBRMatcapUV((Forms & WUWA_V2F_MCDOT) != 0u, TranslatedWorldPosition, TranslatedWorldToView, UseTexNormal, N, Nv);
	uint   mcW, mcH;
	MatCapTex.GetDimensions(mcW, mcH);
	float3 Matcap = WuwaV2PBRMatcapShade(mcUV, mcW, MatCapTex, MatCapTexSampler, MatcapMaxMip, r9, nds, inExtra, metalF, MetalMatCapBack,
		MetalMatCapInt, NonMetallicMatCapInt, solid, s, Shadow, MatcapColor);

	// ---- B434-473: PBR composite (F0, EnvBRDF approx, specular, indirect), PBR mask from roughness and skin -----------------------
	float  f0h = metalF * 0.5 + 0.5;
	float3 baseM = Base2 * metalF;
	float  F0 = f0h * asfloat(0x3DA3D70Au);                                                     // 0.08
	float3 SpecCol = metalF * (-f0h * asfloat(0x3DA3D70Au) + Base2) + F0;
	float  nvE = edge * (NoV + -1.0) + 1.0;
	float4 rb = rC * float4(asfloat(0xBF8E38E4u), asfloat(0xBCFA4FA6u), asfloat(0xBF22B3C6u), asfloat(0x3CC83FB8u))
		+ float4(1.0, asfloat(0x3D2E147Bu), asfloat(0x3F851EB8u), asfloat(0xBD23D70Au));
	float  a004 = min(exp2(nvE * asfloat(0xC1147AE1u)), rb.x * rb.x) * rb.x + rb.y;             // -9.28
	float2 AB = a004 * float2(asfloat(0xBF851EB8u), asfloat(0x3F851EB8u)) + rb.zw;
	float3 env = SpecCol * AB.x + saturate(SpecCol.y * 50.0) * AB.y;                        // UE EnvBRDFApprox: sat(50 * SpecularColor.g)
	float3 mlerp = metalF * (SpecCol * Matcap + -1.0) + 1.0;
	float3 Spec = SpecTerm * (((SpecCol * mlerp) * PBRRateIntensity) * PBRSpecularColor);
	float3 Ind = (env * PBRRateIntensity) * PBRIndirectColor;
	float3 diff = PBRRateIntensity * -baseM + Base2;
	float3 IndM = Ind * Matcap;
	float3 SpecF = Spec, IndF = IndM;   // specular / indirect after the wet-skin replacement
	if (bSkinWet)
	{
		// Use_SkinPBR_Wet (PS 8f2605f4 L452-531): where SkinF > 0.9 the toon specular and the indirect matcap term are replaced by
		// a dual-lobe GGX (UE D_GGX of a0 = lerp(1, max(sat(2 R0 r), 0.02), sat(10 * DualSpecOpacity)) and a1 = the same without the
		// 0.02 floor, mixed by DualSpeLobeMix; Vis_SmithJointApprox; Schlick F with sat(50 SpecularColor.g)) on the mirrored
		// double-specular light, scaled by lerp(DualSpecBackIntensity, region Spec_Int, shadow) and sat(N.L); indirect 0. Both are
		// blended in by sat(CPD26), then by the wet front T1.
		float3 skS = Spec, skI = IndM;
		float  skInt = Shadow * (si - DualSpecBackIntensity) + DualSpecBackIntensity;
		if (0.9 < SkinF)
		{
			float3 Ls = L * float3(-1.0, -1.0, 1.0) + (Shadow * L) * float3(2.0, 2.0, 0.0);
			float  NoL = dot(N, Ls), NoVs = dot(N, V), VoL = dot(V, Ls);
			float  ih = rsqrt(VoL * 2.0 + 2.0);
			float  NoH = saturate(ih * (NoL + NoVs));
			float  VoH = saturate(ih * VoL + ih);
			float  a0 = max(saturate(dot(float2(DualSpeRoughness0, DualSpeRoughness0), float2(r9, r9))), asfloat(0x3CA3D70Au));   // 0.02
			float  a1 = saturate(dot(float2(DualSpeRoughness1, DualSpeRoughness1), float2(r9, r9)));
			float  op = saturate(DualSpecOpacity * 10.0);
			a0 = op * (a0 + -1.0) + 1.0;
			a1 = op * (a1 + -1.0) + 1.0;
			float  NoLs = saturate(NoL);
			float  rr = r9 * r9;
			a0 = a0 * a0; a0 = a0 * a0;
			a1 = a1 * a1; a1 = a1 * a1;
			float  d0 = (NoH * a0 - NoH) * NoH + 1.0;
			d0 = a0 / ((d0 * d0) * asfloat(0x40490FDBu));                                         // pi
			float  d1 = (NoH * a1 - NoH) * NoH + 1.0;
			d1 = a1 / ((d1 * d1) * asfloat(0x40490FDBu));
			float  D = DualSpeLobeMix * (d1 - d0) + d0;
			float  kv = -r9 * r9 + 1.0;
			float  vis = rcp(NoL * (NoVs * kv + rr) + NoVs * (NoL * kv + rr)) * D;
			float  x = 1.0 - VoH;
			float  x2 = x * x;
			float  x4 = x2 * x2;
			float  Fc = x * x4;
			float3 F = saturate(SpecCol.y * 50.0) * Fc + SpecCol * (-x4 * x + 1.0);
			skS = skInt * (NoLs * max(F * (vis * 0.5), 0.0));
			skI = float3(0.0, 0.0, 0.0);
		}
		float3 sa = WetA * (skS - Spec) + Spec;
		SpecF = (skS - sa) * WetT1 + sa;
		float3 ia = WetA * (skI - IndM) + IndM;
		IndF = (skI - ia) * WetT1 + ia;
	}
	float  nsk = 1.0 - SkinF;
	if (bWet)   // PS 373d2cf9 L488-490: wet skin takes the PBR (skin weight * (1 - wet) * (1 - T1))
	{
		float sfw = WetA * -SkinF + SkinF;
		if (Forms & WUWA_V2F_WETT1)
		{
			precise float st = WetT1L * (-sfw * WetT1L);
			sfw = sfw + st;
		}
		else
			sfw = -sfw * WetT1 + sfw;
		nsk = 1.0 - sfw;
	}
	float3 Overflow = max(SpecF * nsk + -1.0, 0.0);
	float3 E;
	if (bBreath)   // UseBreathLight: emission pulses with cos(time * freq) (asm sincos null, cos) except where MainTex.a spec part > EmissionBreathThreshold
	{
		float  br = (BreatheStrength * cos(GameTime * BreatheFrequency) + BreatheStrength * BreathePropotion) * EmissionStrength;
		float3 eb = (specBase * EmissionColor) * br;
		float  keep = (EmissionBreathThreshold >= SpecPart) ? 1.0 : 0.0;
		E = keep * (EmissionColor * specBase - eb) + eb;
		if (bSparkle)
			E = (Sk + Overflow) + E;   // + UseSparkle (PS c002aaf8 L599-600)
		else
			E = E + Overflow;
	}
	else if (bAlphaBlend)
	{
		if (bSparkle)   // + UseSparkle (PS c8d4bf2b L454-456)
			E = SpecPart * EmissionColor + (Sk + Overflow);
		else
			E = SpecPart * EmissionColor + Overflow;   // UseAlphaBlendMode (PS af30c363 L412): emission mask = MainTex.a spec part only
	}
	else if (bSparkle && bXingHen)
	{
		E = (EmissionColor * specBase + (XHCol * XHOp) * XHG) + (Sk + Overflow);   // PS 859c5db4 L576-577
	}
	else if (bSparkle)
	{
		E = EmissionColor * specBase + (Sk + Overflow);   // PS b318cdb4 L561-563
	}
	else if (bXingHen)
	{
		E = EmissionColor * specBase + (XHCol * XHOp) * XHG;   // PS 2fc55fe0 L342-350, overflow added after
		E = E + Overflow;
	}
	else
	{
		E = EmissionColor * specBase + Overflow;
	}
	if (bTextRain)
	{
		// Use_TextRain (PS 285ecf0a L534-623): two scrolling glyph layers from Text_Tex on UV1 (base; bump = UV1 + V.xy * BumpOffset *
		// 0.05), frame = frac(fmod(Time, 100) * Text_Speed); added to the emissive inside [TextRainMin, TextRainMax]
		float  tq = GameTime * asfloat(0x3C23D70Au);                                               // fmod(time, 100)
		float  t100 = ((tq >= -tq) ? frac(abs(tq)) : -frac(abs(tq))) * 100.0;
		float  fr = frac(t100 * Text_Speed);
		float  tb = TextRain_Tilling_Base + asfloat(0x3D4CCCCDu);                                  // preshader + 0.05
		float3 b18 = float3(UV1.x, UV1.x, UV1.y) * tb;
		float2 cellB = floor(fr * float2(256.0, 16.0)) * 0.0625 + b18.yz * asfloat(0x3B800000u);  // 1/256
		float  cB = Text_Tex.SampleLevel(Text_TexSampler, cellB, -1.0).r;
		float  colB = UV1.x * tb - (floor(b18.x * 0.0625) * -16.0 + b18.y);
		float  hOff = HueShiftColor_Offset * asfloat(0x3DCCCCCDu);                                 // preshader * 0.1
		float3 rB = WuwaV2BodyTextRainLayer(cB, colB, t100, UV1.y, Rain_Speed_Base, Rain_Intensity, hOff, TextRain_RangeMin_Base,
			TextRain_RangeMax_Base, TextRain_Color_Base);
		float2 uvb = (V.xy * TexRain_BumpOffset) * asfloat(0x3D4CCCCDu) + UV1;                    // 0.05
		float  tbb = TextRain_Tilling_Bump + asfloat(0x3D4CCCCDu);
		float2 b7 = uvb * tbb;
		float2 b13 = b7 * 0.0625;
		float2 cellM = floor(fr * float2(Matrix * Matrix, Matrix)) / float2(Matrix, Matrix) + b13 / float2(Matrix, Matrix);
		float  cM = Text_Tex.SampleLevel(Text_TexSampler, cellM, -1.0).r;
		float  colM = uvb.x * tbb - (floor(b13.x) * -16.0 + b7.x);
		float3 rM = WuwaV2BodyTextRainLayer(cM, colM, t100, uvb.y, Rain_Speed_Bump, Rain_Intensity, hOff, TextRain_RangeMin_Bump,
			TextRain_RangeMax_Bump, TextRain_Color_Bump);
		float3 rain = rB * TextRain_Base_Intensity + rM * TextRain_BumpOffset_Intensity;
		float  inTR = ((idP >= TextRainMin) ? 1.0 : 0.0) * ((TextRainMax >= idM) ? 1.0 : 0.0);
		E = inTR * rain + E;
	}
	if (bEffectSecond)
	{
		// UseEffectMaterial + UseSecond (PS 81f20dd3 L411-460): second emissive texture (UV0/1/2 or screen UV, rotation, time pan,
		// R_Noise_A_Mask.r distortion), refine curve, tint, masked by R_Noise_A_Mask.r^(1 - Effect_Progress); added with the
		// motion emissive. Second_RotCos / Second_RotSin = cos / sin(Second_Rotation * 2pi): CPU uniform expressions in the original,
		// supplied as uniform_expression inputs (a GPU cos/sin differs by 1 ULP for some angles).
		float3 su = float3(UV0.x, UV1.x, UV2.x), sv = float3(UV0.y, UV1.y, UV2.y);
		float2 suv;
		if (bObjScreenUV)
		{
			// Second_UseObjectScreenUV (PS a5550957 L606-627): screen offset of the pixel from the object origin (WorldToClip,
			// x / w, -y / w), scaled by the object's camera-view depth * 0.01 (|.| <= 99999), then Second_ScreenObjectUV.xy offset /
			// .zw scale; replaces the UV switch / screen UV
			float3 cp = WorldPosition.y * WorldToClip[1].xyw + WorldPosition.x * WorldToClip[0].xyw;
			cp = WorldPosition.z * WorldToClip[2].xyw + cp;
			cp = cp + WorldToClip[3].xyw;
			float3 co = WorldToClip[1].xyw * ObjectWorldPosition.y + ObjectWorldPosition.x * WorldToClip[0].xyw;
			co = ObjectWorldPosition.z * WorldToClip[2].xyw + co;
			co = co + WorldToClip[3].xyw;
			float2 dsc = float2(cp.x / cp.z, -cp.y / cp.z) - float2(co.x / co.z, -co.y / co.z);
			float3 ot = PreViewTranslation + ObjectWorldPosition;
			float  oz = ot.y * TranslatedWorldToCameraView[1].z + ot.x * TranslatedWorldToCameraView[0].z;
			oz = ot.z * TranslatedWorldToCameraView[2].z + oz;
			oz = (oz + TranslatedWorldToCameraView[3].z) * asfloat(0x3C23D70Au);                    // 0.01
			oz = min(abs(oz), 99999.0);
			suv = dsc * oz + Second_ScreenObjectUV.xy;
			suv = suv * Second_ScreenObjectUV.zw + -0.5;
		}
		else
		{
			suv = float2(dot(SecondTex_UVSwitch.xzw, su), dot(SecondTex_UVSwitch.xzw, sv));
			suv = Second_UseScreenUV * ((SvPositionXY - ViewRectMin) * ViewSizeAndInvSize.zw - suv) + suv;
			suv = suv + -0.5;
		}
		suv = float2(dot(suv, float2(Second_RotCos, Second_RotSin * -1.0)), dot(suv, float2(Second_RotSin, Second_RotCos))) + 0.5;
		float  q = GameTime * asfloat(0x3ADA740Eu);                                               // fmod(time, 600)
		float  fq = frac(abs(q));
		float  tm = ((q >= -q) ? fq : -fq) * asfloat(0x44160000u);
		suv = suv * Second_UV.xy + tm * Second_UV.zw;
		suv = suv + Second_UV_Offset.xy;
		if (bSecondNoise)   // UseNoise: R_Noise_A_Mask.r distortion (without it the original adds Second_NoiseStrength * 0)
		{
			float2 nuv = float2(dot(Noise_UVSwitch.xzw, su), dot(Noise_UVSwitch.xzw, sv));
			nuv = Noise_UseScreenUV * ((SvPositionXY - ViewRectMin) * ViewSizeAndInvSize.zw - nuv) + nuv;
			nuv = nuv * NoiseUV.xy;
			nuv = GameTime * NoiseUV.zw + nuv;
			float  nz = R_Noise_A_Mask.SampleBias(R_Noise_A_MaskSampler, nuv, MaterialTextureMipBias).r * NoiseStrength;
			suv = Second_NoiseStrength * nz + suv;
		}
		if (bSecondBump)    // UseBumpOffset (PS b959c3e7 L433-437): suv += (T.V, B.V) * (Radio * Height - Radio * 0.5)
		{
			float  bh = Second_BumpHeightRadio * Second_BumpHeight + Second_BumpHeightRadio * -0.5;
			suv = float2(dot(T, V), dot(Bt, V)) * bh + suv;
		}
		float3 sc = Second_RGB.SampleBias(Second_RGBSampler, suv, MaterialTextureMipBias).rgb;
		float3 sp = exp2(log2(sc) * Second_Refine.x);
		sp = float3(sc.x <= 0.0 ? 0.0 : sp.x, sc.y <= 0.0 ? 0.0 : sp.y, sc.z <= 0.0 ? 0.0 : sp.z);
		sp = sp * Second_Refine.y;
		float3 sec = Second_Refine.w * (sc * Second_Refine.z - sp) + sp;
		if (bRim)   // UseRim (PS d562e5b5 L473-484): rim = lerp(Smooth, 1, (1 - N.V)^RimRange), optionally reversed
		{
			float  rr = exp2(log2(max(abs(1.0 - max(dot(N, V), 0.0)), asfloat(0x38D1B717u))) * FresnelRim_RimRange);   // 1e-4
			rr = rr * min(1.0 - FresnelRim_Smooth, asfloat(0x7F7FFFFFu)) + FresnelRim_Smooth;           // preshader (1 - Smooth)
			if (Forms & WUWA_V2F_RIMREV)
			{
				precise float rv = (1.0 - rr) - rr;                                                    // precise compile (6b7c6be0 L649-652)
				rr = rv * FresnelRim_Reverse + rr;
			}
			else
				rr = FresnelRim_Reverse * (rr * -2.0 + 1.0) + rr;
			sec = sec * Second_ColorTint + rr * FresnelRim_RimColor;
		}
		else
		{
			sec = sec * Second_ColorTint;
		}
		float2 muv = EffectMaskTexUV2Switch * (UV1 - UV0) + UV0;
		if (bFlowEdge)      // UseFlowEffectEdge (PS dbffa179 L480): preshader FlowEffectEdge_Strength * 0.1
		{
			// precise: fxc otherwise drops the min() and re-associates to (sc.x * Strength) * 0.1 (1-ulp UV error, seen with bilinear)
			precise float fe = FlowEffectEdge_Strength * asfloat(0x3DCCCCCDu);
			muv = sc.x * fe + muv;
		}
		float4 mk4 = R_Noise_A_Mask.SampleBias(R_Noise_A_MaskSampler, muv, MaterialTextureMipBias);
		float  mk = SecondMaskCh == 0u ? mk4.r : SecondMaskCh == 1u ? mk4.g : SecondMaskCh == 2u ? mk4.b : mk4.a;   // compiled channel
		float  mp = exp2(log2(mk) * (1.0 - Effect_Progress));
		mp = (mk <= 0.0) ? 0.0 : mp;
		sec = sec * mp;
		E = E + (MotionEmissiveMask * E_Motion_Emissive + sec);
	}
	else if (bEffectMask)
	{
		// UseEffectMaterial without UseSecond (PS 7381ba4d L575-585): emissive EffectMaskColor * mask^(1 - Effect_Progress), mask =
		// R_Noise_A_Mask (compiled channel) at lerp(UV0, UV1, EffectMaskTexUV2Switch); added with the motion emissive
		float2 muv = EffectMaskTexUV2Switch * (UV1 - UV0) + UV0;
		float4 mk4 = R_Noise_A_Mask.SampleBias(R_Noise_A_MaskSampler, muv, MaterialTextureMipBias);
		float  mk = SecondMaskCh == 0u ? mk4.r : SecondMaskCh == 1u ? mk4.g : SecondMaskCh == 2u ? mk4.b : mk4.a;
		float  mp = exp2(log2(mk) * (1.0 - Effect_Progress));
		mp = (mk <= 0.0) ? 0.0 : mp;
		E = E + (MotionEmissiveMask * E_Motion_Emissive + mp * EffectMaskColor);
	}
	else
	{
		E = MotionEmissiveMask * E_Motion_Emissive + E;
	}
	E = SelectionColor.a * (SelectionColor.rgb - E) + E;
	float3 sp = Ind * Matcap + Spec;
	if (bSkinWet)
		sp = SpecF + IndF;   // PS 8f2605f4 L531
	float3 lit = sp + diff;
	float  pbrMask = nsk * (-(rC2 + asfloat(0xBF666666u)) * asfloat(0x411FFFFEu) + 1.0);       // 1 - (r - 0.9) * 10
	lit = pbrMask * (lit - Base2) + Base2;
	float3 lb = lit * AniSwitch_ShadowColorBright;
	if (bXingHen)   // PS 2fc55fe0 L550-553: star mark blended into the lit colour
		lb = XHG * (XHOp * (-lit * AniSwitch_ShadowColorBright + XHCol)) + lb;

	// ---- B475-501: ramp (region row / weight, damage forces region 0), lit colour -> GBufferC.rgb ----------------------------------
	float  ru = bVDL ? saturate((HL - thr) + 0.5) : saturate(HL + (0.5 - SPp));   // no VDL: preshader (0.5 - SP')
	if (bVDL && (Forms & WUWA_V2F_RAMPU))
	{
		precise float ru5 = 0.5 - thr;                                                                 // 6b7c6be0 post-PDO L863-864
		ru = saturate(HL + ru5);
	}
	float  rc = min(ru, SolidShadow_RampPosition);
	float  rampU = solid * (ru - rc) + rc;
	float  rampV, rampW0;
	if (bRampIDMask)   // UseRampIDMask: ramp row / weight per region
	{
		float4 rw = float4(max(1.0 - nds, sel.x), min(float3(nds, nds, nds), sel.yzw));
		float  rw4 = min(nds, is4);
		float4 kv = float4(RampID0, RampID1, RampID2, RampID3) * asfloat(0x3E4CCCCDu) + asfloat(0x3DCCCCCDu);
		rampV = (RampID4 * asfloat(0x3E4CCCCDu) + asfloat(0x3DCCCCCDu)) * rw4 + dot(kv, rw);
		rampW0 = rw4 * RampInt4 + dot(rw, float4(RampInt0, RampInt1, RampInt2, RampInt3));
	}
	else               // single ramp row (PS 66e0e185 L510-517): preshader RampIndex * 0.2 + 0.1 (kept unfused)
	{
		rampV = min(RampIndex * asfloat(0x3E4CCCCDu), asfloat(0x7F7FFFFFu)) + asfloat(0x3DCCCCCDu);
		rampW0 = RampInt;
	}
	float3 RampCol = Ramp.Sample(RampSampler, float2(rampU, rampV)).rgb;
	float  rampW = rampW0 * ((MPC_GlobalCharSkyLightIntensity >= 0.05) ? 1.0 : 0.0);
	float3 l3;
	if (bOnlySkinRamp)   // UseOnlySkinRampColor: skin-weighted half blend toward the ramp
	{
		if (bXingHen)
			l3 = rampW * (RampCol - lb) + (lb + lb);
		else
			l3 = rampW * (-lit * AniSwitch_ShadowColorBright + RampCol) + (lb + lb);
		l3 = l3 * 0.5 - lb;
		l3 = saturate(SkinF * l3 + lb);
	}
	else                 // PS 2183309e: no ramp in the lit colour
	{
		l3 = bXingHen ? saturate(lb) : saturate(lit * AniSwitch_ShadowColorBright);
	}
	G.C.rgb = WuwaBPDesaturate(l3, Desaturation);

	if (FurPass == 1u)
		G.Emissive = E;   // split pass 1: raw; the entry applies WuwaBPFinalEmissive (UseFurry: at the post-PDO world position, OOB debug)
	else
		G.Emissive = WuwaBPFinalEmissive(E, KuroSkipEmissiveScale, KuroEmissiveScale, OutOfBoundsMask,
			WorldPosition, ObjectWorldPosition, ObjectBounds);

	// ---- B554-578: shadow colour, GBufferA.z ---------------------------------------------------------------------------------------
	float3 SSS = SkinF * (SkinSubsurfaceColor - SubsurfaceColor) + SubsurfaceColor;
	float3 ShadowCol = WuwaBPDesaturate(rampW * (RampCol - SSS) + SSS, Desaturation);
	G.A.z = WuwaV2ShadowFactorZ(L, V, solid, Shadow, SolidShadowStrength);

	// ---- B579-598: FFT (spark constant, specular highlight above threshold inside [FFTMin, FFTMax]) --------------------------------
	float FFT = (asfloat(0x3A83126Fu) < FFT_SparkIntensity) ? FFT_SparkIntensity * -FFT_SparkThreshold : 0.0;
	if (bSparkle && asfloat(0x3A83126Fu) < FFT_SparkIntensity)   // PS b318cdb4 L679-685: spark source = the glitter colour
		FFT = (max(Sk.z, max(Sk.y, Sk.x)) * 0.02 - FFT_SparkThreshold) * FFT_SparkIntensity;
	if (asfloat(0x3A83126Fu) < FFT_SpecularIntensity)
	{
		float inR = ((idP >= FFTMin) ? 1.0 : 0.0) * ((FFTMax >= idM) ? 1.0 : 0.0);
		float m = max(sp.x, max(sp.z, sp.y));
		FFT = (max(m - FFT_SpecularThreshold, 0.0) * FFT_SpecularIntensity) * inR + FFT;
	}
	// ---- B599-662: encode; mode-0 GBufferC.a = max(TypeMask.r * OpacityIntensity, luminance(max(specular, 0))) --------------------
	float Opacity = max(TM.x * OpacityIntensity, dot(max(SpecF, 0.0), float3(0.3, 0.59, 0.11)));
	if (bSparkle)   // PS b318cdb4 L731-734: the glitter counts as specular for the mode-0 opacity
		Opacity = max(dot(max(SpecF, Sk), float3(0.3, 0.59, 0.11)), TM.x * OpacityIntensity);
	if (bXingHen)   // PS 2fc55fe0 L712-719: the star mark raises the opacity inside its half (859c5db4: + glitter)
	{
		float lum = dot(max(SpecF, Sk), float3(0.3, 0.59, 0.11));
		Opacity = max(XHG * (max(lum, XHOp) - lum) + lum, TM.x * OpacityIntensity);
	}
	const float OpacityBase = Opacity;   // before wet / cloth: the wet colour blend and the plain masked clip read it (PS e7f5ba80 L519-524)
	float WetT2 = 0.0, WetSm = 0.0, WetS2 = 0.0, WetS3 = 0.0;
	if (bWet)
	{
		// Use_Char_Wet opacity (PS 373d2cf9 L708-718, before the cloth remap: 65563145 L775-798; HETA: both modes, 183f9f11 L666-676):
		// smoothstep(Wet_OpacityPowerMin, Max) - Wet_Opacity, by saturate(CPD26) and the wet front
		// T2 = sat((tex * 0.05 + UV3.y + CPD27 * 18/17 - 1) * 20)^2
		WetT2 = saturate(((WetTex * asfloat(0x3D4CCCCDu) + UV3Y) + WetPre) * 20.0);
		WetT2 = WetT2 * WetT2;
		float s  = saturate((Opacity - Wet_OpacityPowerMin) * (1.0 / (Wet_OpacityPowerMax - Wet_OpacityPowerMin)));
		float s3 = s * -2.0 + 3.0;
		float s2 = s * s;
		WetSm = s2 * s3;
		WetS2 = s2; WetS3 = s3;
		float a2 = s3 * s2 - Wet_Opacity;
		float a1 = WetA * -Wet_Opacity + WetSm;
		Opacity = (a2 - a1) * WetT2 + a1;
	}
	float TransZ = 0.0;
	if (bTransCloth)
	{
		// UseTranslucentCloth (PS ce915d70 L584-625, HETA b241def3 L534-550): inside [TransClothMin, TransClothMax] the opacity
		// is remapped by the OpacityMask smoothstep; mode 0 GBufferD.z = cloth translucency (TranslucentMask on the opacity,
		// view-vs-light mask, vertex-normal fresnel). Preshaders: OpacityMask hi = Offset + max(Width, 0.001), others Offset + Width.
		const float FLTMAX = asfloat(0x7F7FFFFFu);
		float lumOp = Opacity;
		float inCloth = ((idP >= TransClothMin) ? 1.0 : 0.0) * ((TransClothMax >= idM) ? 1.0 : 0.0);
		float omHi = min(OpacityMask_Offset + max(OpacityMask_Width, asfloat(0x3A83126Fu)), FLTMAX);
		float ot = saturate((1.0 / (omHi - OpacityMask_Offset)) * (lumOp - OpacityMask_Offset));
		Opacity = saturate(inCloth * ((ot * -2.0 + 3.0) * (ot * ot) - lumOp) + lumOp);
		float tmHi = min(TranslucentMask_Offset + TranslucentMask_Width, FLTMAX);
		float tt = saturate((1.0 / (tmHi - TranslucentMask_Offset)) * (lumOp - TranslucentMask_Offset));
		float tmi = -(tt * -2.0 + 3.0) * (tt * tt) + 1.0;
		float vlHi = min(ViewLightMask_Offset + ViewLightMask_Width, FLTMAX);
		float vt = saturate((1.0 / (vlHi - ViewLightMask_Offset)) * ((dot(L, V) + 1.0) * 0.5 - ViewLightMask_Offset));
		float vs = min((vt * vt) * (vt * -2.0 + 3.0), 1.0);
		float tr = saturate(vs * -tmi + tmi) * LightIntensity;
		float ft = saturate((1.0 / (TraClothFresnelMax - TraClothFresnelMin)) * (dot(V, Nv) - TraClothFresnelMin));
		float fs = saturate((ft * -2.0 + 3.0) * (ft * ft) + TraClothFresnelInt);
		TransZ = saturate(fs * tr) * inCloth;
	}
	if (bFurry && FurPass != 2u)
	{
		// UseFurry (PS 6b7c6be0 L681-774; FurPass 1 = the pre-PDO pass): fur clip and the material pixel depth offset.
		//   fade = lerp(1, COLOR0.r, FurBlendUseVertexRFade); fur = Fur_Tex.r(UV1 * (FurTexU, 1), bias MipBias + FurTexBias) *
		//   (1 - fade * sat(|N_vertex . normalize(WorldCameraOrigin - WorldPosition)| * FurRangeStep + FurRangeStepOffset));
		//   dither = DitherTemporalAA pattern / 6 (precise divide); region gate on the ID of the LOD-0 TypeMask.a blend:
		//   max([FurCluster] - [Skin] - [FurParallax], 0); clip = lerp(fur * FurAlphaIntensity + dither, 1, ...) see below, - 0.3333,
		//   min the Kuro primitive dither; PDO = ((dither + 0.5) - 0.5) * FurBlendIntensity * fade * gate
		precise float fade = (VertexColorR + -1.0) * FurBlendUseVertexRFade + 1.0;
		float  ft = Fur_Tex.SampleBias(Fur_TexSampler, UV1 * float2(FurTexU, 1.0), MaterialTextureMipBias + FurTexBias).r;
		float3 cv = WorldCameraOrigin - WorldPosition;
		cv = cv / sqrt(dot(cv, cv));
		float  rs = saturate(abs(dot(Nv, cv)) * FurRangeStep + FurRangeStepOffset);
		ft = ft * (fade * -rs + 1.0);
		if (bTangentClip)   // UseTangentClip (PS bd79aa07 L671-685, L692)
		{
			float3 sT  = TwoSidedSign * T;
			float3 tcv = Nv.yzx * sT.zxy - sT.yzx * Nv.zxy;
			float  tct = saturate((dot(tcv, V) - FurTangentMin) * (1.0 / (FurTangentMax - FurTangentMin)));
			float  tcs = (tct * tct) * (tct * -2.0 + 3.0) + -1.0;
			ft = (fade * tcs + 1.0) * ft;
		}
		precise float2 fpp = SvPositionXY - ViewRectMin;
		uint2  fpq = (uint2)(fpp + TemporalAAParamsX);
		precise float fdz = DitherTex.SampleBias(DitherTexSampler, fpp / 64.0, MaterialTextureMipBias).r + (float)(((fpq.y << 1) + fpq.x) % 5u);
		precise float dz6 = fdz / 6.0;
		float  cl = ft * FurAlphaIntensity + dz6;
		float gate;
		if (FurGate == 1u)   // vertex alpha (e9ec2704 L739-741, L762-763)
		{
			precise float va = (VertexColorA + -1.0) * UseVertexColor + 1.0;
			gate = (0.25 >= va) ? 1.0 : 0.0;
		}
		else
		{
			// region of the UV0 RegionIDTex / LOD-0 TypeMask.a (UseFurryParallax maps sample the material textures elsewhere)
			float  idF = WuwaV2BodyGateRegionID(RegionIDTex, RegionIDTexSampler, TypeMask, TypeMaskLod0Sampler, UV0, MaterialTextureMipBias);
			float  fP = idF + 0.5, fM = idF + -0.5;
			float  inSkF = ((fP >= SkinMin) ? 1.0 : 0.0) * ((SkinMax >= fM) ? 1.0 : 0.0);
			float  inClu = ((fP >= FurClusterMin) ? 1.0 : 0.0) * ((FurClusterMax >= fM) ? 1.0 : 0.0);
			float  inPar = ((fP >= FurParallaxMin) ? 1.0 : 0.0) * ((FurParallaxMax >= fM) ? 1.0 : 0.0);
			precise float gr = max((inClu - inSkF) - inPar, 0.0);
			gate = gr;
		}
		cl = gate * (cl + -1.5) + 1.0;
		float  t;
		if (FurClip == 1u)   // with UseTranslucent (6b7c6be0 L727-736): DitherTemporalAA of lerp(TranslucentDitherVaule, 1, opacity)
		{
			float  u = OpacityBase * (1.0 - TranslucentDitherVaule) + TranslucentDitherVaule;
			t = saturate((dz6 + u) + -0.5);
		}
		else if (FurClip == 3u)   // UseTranslucent + Use_Char_Wet (e9ec2704 L766-781): the wet dither opacity
		{
			float  u  = WetSm * (1.0 - TranslucentDitherVaule) + TranslucentDitherVaule;
			float  a2 = u - Wet_Opacity;
			float  a1 = WetA * -Wet_Opacity + u;
			t = saturate((dz6 + ((a2 - a1) * WetT2 + a1)) + -0.5);
		}
		else                 // without (bd79aa07 L708-713): saturate(opacity)
			t = saturate(OpacityBase);
		cl = UseMainTexAlpha * (cl * t - cl) + cl;
		precise float pd = dz6 + 0.5;
		pd = pd + -0.5;
		pd = pd * FurBlendIntensity;
		precise float fg = fade * gate;
		FurPDO = fg * pd;
		precise float om = cl + asfloat(0xBEAAA64Cu);                                                      // -0.3333
		if (min(WuwaV2BodyPrimDither(KuroPrimDitherEnable, KuroPrimDitherFade, SvPositionXY), om) < 0.0)
			discard;
	}
	else if (MaskMode != 0u && FurPass != 2u)
	{
		// BLEND_Masked maps; discard when min(Kuro primitive dither (Primitive[43]), opacity mask - clip 0.3333) < 0.
		float om;
		if (MaskMode == 1u)
		{
			// UseTranslucent (PS 3e981584 L474-507): opacity mask = UE DitherTemporalAA(lerp(TranslucentDitherVaule, 1, Opacity)), the
			// -0.5 and the clip value folded (-0.8333). Pixel = SvPosition - ViewRectMin; pattern (x + 2y + TemporalAAParams.x) % 5
			// plus the engine 64x64 dither texture (own sampler, SampleBias MaterialTextureMipBias), / 6.
			// With Use_Char_Wet the lerp sits between the wet smoothstep and the Wet_Opacity subtraction (PS a6f13c84 L623-635).
			float2 pp = SvPositionXY - ViewRectMin;
			uint2  pq = (uint2)(pp + TemporalAAParamsX);
			float  dz = (float)(((pq.y << 1) + pq.x) % 5u);
			dz = dz + DitherTex.SampleBias(DitherTexSampler, pp * 0.015625, MaterialTextureMipBias).r;
			if (bWet)
			{
				float u  = WetSm * (1.0 - TranslucentDitherVaule) + TranslucentDitherVaule;
				float a2 = u - Wet_Opacity;
				float a1 = WetA * -Wet_Opacity + u;
				om = (a2 - a1) * WetT2 + a1;
			}
			else
			{
				om = OpacityBase * (1.0 - TranslucentDitherVaule) + TranslucentDitherVaule;
			}
			om = dz * asfloat(0x3E2AAAABu) + om;
			om = om + asfloat(0xBF555326u);                                                           // -0.8333
		}
		else
		{
			// UseAlphaBlendMode (PS af30c363 L505-526): opacity mask = Opacity, clip 0.3333; with Use_Char_Wet (PS 0a7bbb48 L498-505)
			// the mask is the wet opacity smoothstep (before the Wet_Opacity terms)
			if (bWet)
				om = WetS3 * WetS2 + asfloat(0xBEAAA64Cu);
			else
				om = OpacityBase + asfloat(0xBEAAA64Cu);                                              // -0.3333
		}
		if (min(WuwaV2BodyPrimDither(KuroPrimDitherEnable, KuroPrimDitherFade, SvPositionXY), om) < 0.0)
			discard;
	}
	if (bWet)
	{
		// Use_Char_Wet colour (PS 373d2cf9 L508-562): dry -> desaturated, lightened wet colour (skin weighted), by saturate(CPD26)
		// and the wet front T2; the opacity blend uses min(E_Link gate, opacity).
		float3 Dry = G.C.rgb;
		float  lumD = dot(Dry, float3(0.3, 0.59, 0.11));
		float3 dl = lumD - Dry;
		float3 wetC = (Wet_Desaturation * dl + Dry) * Wet_Lightness;
		float  gate = WuwaV2BodyLinkGate(SvPositionXY, ViewSizeAndInvSize, ViewRectMin, E_Link_UseSplitScreen, E_Link_AngleLinePosLineDis,
			E_LinkPos, LinkRot0, LinkRot1, (Forms & WUWA_V2F_LINKP) != 0u);
		float  m = min(gate, OpacityBase);
		wetC = Wet_OpacityInBaseCol_Blend * (wetC * m - wetC) + wetC;
		float3 wetCol = SkinF * ((WetSkin_Desaturation * dl + Dry) * WetSkin_Lightness - wetC) + wetC;
		float3 c1 = WetA * (wetCol - Dry) + Dry;
		G.C.rgb = (wetCol - c1) * WetT2 + c1;
	}
	if (RawOut == 1u)
	{
		G.Emissive = E;
		G.A = float4(N, Shadow);
		G.B = float4(ShadowCol, WuwaV2ShadowAO(L, V, solid, SolidShadowStrength));
		G.C.a = Opacity;
		G.D = float4(SkinF, 0.0, 0.0, 0.0);
		return G;
	}
	// HETA + wet: the mode-1 byte saturates the (possibly negative) wet opacity (183f9f11 L714); min(sat(x), 1) = sat(x)
	if (bWet && bHETA && KuroGBufferMode == 1.0)
		Opacity = saturate(Opacity);
	// HETA (IsHairHET): mode 1 GBufferC.a = opacity byte with LSB 1 (shared V2 encode, OpacityMode 1)
	WuwaV2Encode(G, bHETA ? 1u : 0u, N, ShadowCol, Opacity, SkinF, FFT, ToonRimWidth, SSAOSkinIntensity, SSAOIntensity,
		KuroGBufferMode, LightingChannelMask, WUWA_099999);
	if (bTransCloth && KuroGBufferMode != 1.0)
		G.D.z = TransZ;
	return G;
}

// ==== BEGIN GENERATED ENTRIES (tools/shaderdiff/basepass_v2/gen_v2body_entries.py) ====
// One entry per verified switch combination (hashes: Specs/registry/M_CharV2_Com.json). Options: SpecMode 0 = UseHQAnisotropy,
// 1 = UseDoubleSpecular, 2 = neither, 3 = both; bVDL = UseVDLShadowoffset; bTwoSided = TwoSided material; bOnlySkinRamp =
// UseOnlySkinRampColor; bFresnel = UseFresnel; bBreath = UseBreathLight; bRampIDMask = UseRampIDMask; bTransCloth = UseTranslucentCloth;
// bHETA = IsHairHET (mode-1 opacity byte); bEffectSecond = UseEffectMaterial second emissive layer;
// bRim = UseRim (effect rim on the second layer); bSecondNoise = UseNoise on the second layer; bFlowEdge = UseFlowEffectEdge;
// SecondMaskCh = compiled R_Noise_A_Mask channel of the effect mask (0..3 = r..a); bSecondBump = UseBumpOffset on the second layer;
// bHue = UseHueShift (body, by region); MaskMode = BLEND_Masked clip (discard inside the entry):
// 1 = UseTranslucent (DitherTemporalAA opacity), 2 = UseAlphaBlendMode (plain opacity), both min the Kuro primitive dither; bAlphaBlend = UseAlphaBlendMode
// (emission mask = MainTex.a spec part without the base colour); bXingHen = UseXingHen (star mark: emissive, lit colour,
// mode-0 opacity; bXHRot = star UV rotator present in the map); bSparkle = UseSparkle (glitter emissive, FFT spark source);
// bWet = Use_Char_Wet (wet PBR per region, wet colour / opacity; CPD 26 / 27, UV3.y); bRegionID = UseRegionID (off: region
// ranges / ramp rows from TypeMask.a, RegionIDTex only for metallic / roughness); bSkinWet = Use_SkinPBR_Wet (wet skin dual-lobe
// GGX specular replaces the toon specular / indirect where SkinF > 0.9); bBlendParam = UseBlendParameter (off: metallic /
// roughness of the float region ID instead of the TypeMask.a blend of the low / high RegionIDTex IDs); bSparkleLegacy = LegacyMode
// sparkle (one noise channel, SparkleColor, SparkleMaskUseUV2 range input); bNormalMap = UseNormalMap (off: vertex normal); bEffectMask = UseEffectMaterial
// without UseSecond (emissive EffectMaskColor * R_Noise_A_Mask^(1 - Effect_Progress));
