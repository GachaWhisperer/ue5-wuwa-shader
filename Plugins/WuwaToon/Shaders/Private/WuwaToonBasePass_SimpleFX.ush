FWuwaFXOutput WuwaFXSimpleEffect_SecondMask(
	Texture2D Second, SamplerState SecondSampler, Texture2D Base, SamplerState BaseSampler, Texture2D Mask,
	SamplerState MaskSampler, float2 UV0, float2 UV1, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float GameTime, float3 KuroViewLightColorA, float3 KuroViewLightColorB, float UseSpecificTime, float EffectTime,
