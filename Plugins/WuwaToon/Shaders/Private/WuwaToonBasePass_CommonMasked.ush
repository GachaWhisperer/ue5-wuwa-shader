	float SSAOSkinIntensity, float SSAOIntensity, float FFTIntensity, float CPD1, float CPD13,
	float MPC_GlobalCharSkyLightIntensity, float3 MPC_GlobalCharacterAmbientSkinColor,
	float3 MPC_GlobalCharacterDebugLightDirection, float4 ToonLight0, float4 ToonLight1, float4 ToonLight2,
	float4 ToonLight3, float4x4 TranslatedWorldToView, float MaterialTextureMipBias, float4 NormalOverrideParameter,
	float KuroGBufferMode, float3 KuroEmissiveScale, float KuroSkipEmissiveScale, float OutOfBoundsMask,
	float3 ObjectWorldPosition, float3 ObjectBounds, uint LightingChannelMask, float GameTime, float BreatheStrength,
	float BreatheFrequency, float BreathePropotion, float EmissionStrength, float EmissionBreathThreshold,
	Texture2D Second_RGB, SamplerState Second_RGBSampler, Texture2D R_Noise_A_Mask, SamplerState R_Noise_A_MaskSampler,
	float2 UV1, float2 UV2, float2 UV3, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float4 SecondTex_UVSwitch, float Second_UseScreenUV, float Second_RotCos, float Second_RotSin, float4 Second_UV,
	float2 Second_UV_Offset, float4 Second_Refine, float3 Second_ColorTint, float EffectMaskTexUV2Switch,
	float Effect_Progress, float4 Noise_UVSwitch, float Noise_UseScreenUV, float4 NoiseUV, float NoiseStrength,
	float Second_NoiseStrength, float Second_BumpHeightRadio, float Second_BumpHeight, float KuroPrimDitherEnable,
	float KuroPrimDitherFade, out float OpacityMask)
{
	OpacityMask = WuwaCMAlphaMask(MainTex, MainTexSampler, UV0, OpacityIntensity, MaterialTextureMipBias);
	clip(WuwaPrimDitherClip(KuroPrimDitherEnable, KuroPrimDitherFade, SvPositionXY));
	float3 SecondC = WuwaBPSecond(true, false, true, 0, Second_RGB, Second_RGBSampler, R_Noise_A_Mask, R_Noise_A_MaskSampler,
		UV0, UV1, UV2, UV3, SvPositionXY, ViewRectMin, ViewSizeAndInvSize, GameTime, MaterialTextureMipBias,
		SecondTex_UVSwitch, Second_UseScreenUV, Second_RotCos, Second_RotSin, Second_UV, Second_UV_Offset, Second_Refine,
		Second_ColorTint, EffectMaskTexUV2Switch, Effect_Progress,
		Noise_UVSwitch, Noise_UseScreenUV, NoiseUV, NoiseStrength, Second_NoiseStrength, 0.0, Second_BumpHeightRadio, Second_BumpHeight,
		WorldTangent, WorldNormal, TangentSign, CameraVector);
	const float3 Z3 = float3(0.0, 0.0, 0.0);
	return WuwaToonCommonBasePass_Impl(false, false, false, false, true, true, true, false,
		Normal_Roughness_Metallic, Normal_Roughness_MetallicSampler, MainTex, MainTexSampler, MainTex, MainTexSampler,
		MatCapTex, MatCapTexSampler, MainTex, MainTexSampler, UV0, 0.0, VertexColor, WorldTangent, WorldNormal, TangentSign,
