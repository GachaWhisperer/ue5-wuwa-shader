// WuwaToonBasePass_CommonMasked.ush - M_Char_Com BLEND_Masked variants (MSM_ToonCommon, GBufferB id 12).
// GENERATED by tools/shaderdiff/roster_charcom/gen_common_masked.py (round 5, research/roster/round5/common_masked.md).
//
// Each entry = an existing verified Common body (WuwaToonBasePass_Common.ush, #included read-only: an existing entry, or
// WuwaToonCommonBasePass_Impl with an existing switch combination) + the material's opacity mask:
//   * OpacityMask (spec output wired to the material's Opacity Mask, opacity_mask_clip_value 0.3333). UE then discards
//     where OpacityMask - 0.3333 < 0, the original's `x < 0 -> discard_nz` on the same value.
//   * the Kuro primitive dither (Primitive[43]) is clipped inside, as in the masked outline / WriteStencil ports; the
//     original takes min(mask, dither) < 0, i.e. either one negative discards.
//
// UseTranslucent (Kuro static switch, Alpha MIs): the opacity is lerp(TranslucentDitherVaule, 1, MainTex.a * OpacityIntensity)
// fed through UE's DitherTemporalAA material function (engine texture Good64x64TilingNoiseHighFreq, referenced by
// M_Char_Com). PS __195760 l.66, 107-110, 125-155 (hex literals from the hexlit disassembly):
//     add  r1.xy, v7.xy, -cb0[134].xy                       Pix = SvPosition.xy - ViewRectMin
//     mul  r1.w, MainTex.a, OpacityIntensity                A
//     add  r2.w, -TranslucentDitherVaule, 1 ; mad r2.w, A, r2.w, TranslucentDitherVaule
//     add  r4.xy, Pix, cb0[158].x ; ftou ; ishl y,1 ; iadd ; udiv .., 5      q = ((uint(y+T) << 1) + uint(x+T)) % 5
//     mul  r4.xy, Pix, 0x3c800000 ; sample_b t(noise).x at View mip bias
//     add  q + noise ; mad (q + noise) * 0x3e2aaaab + opacity ; add 0xbf555326 (-0.8333)
// -0.8333f (0x3F555326) == 0.5f + 0.3333f exactly: DitherTemporalAA returns opacity + (q + noise)/6 - 0.5 and the masked
// clip subtracts OpacityMaskClipValue 0.3333 (fxc folded the two constants). OpacityMask here is the DitherTemporalAA
// output; with a ∈ [0.25, 1] the (a - 0.5) is exact (Sterbenz), outside it the sign cannot change, so
// sign((a - 0.5) - 0.3333f) == sign(a - 0.8333f) for every a: the discard set is identical.
// Plain BLEND_Masked (no UseTranslucent, PS __237694 l.327 `mad r0.x, MainTex.a, OpacityIntensity, -0.3333`):
//     OpacityMask = MainTex.a * OpacityIntensity.
#pragma once

#include "WuwaToonBasePass_Common.ush"
#include "WuwaToonBasePass_WriteStencil.ush"   // WuwaPrimDitherClip (Kuro primitive dither), read-only

// UE DitherTemporalAA(AlphaThreshold = lerp(TranslucentDitherVaule, 1, MainTex.a * OpacityIntensity)), PS __195760 l.66,
// 107-110, 125-137. The MainTex sample is the body's own sample (same texture / UV / bias; fxc merges them).
float WuwaCMTranslucentDitherMask(Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float OpacityIntensity,
	float TranslucentDitherVaule, Texture2D DitherNoise, SamplerState DitherNoiseSampler, float2 SvPositionXY,
	float2 ViewRectMin, float TemporalAAParamsX, float MaterialTextureMipBias)
{
	float A = MainTex.SampleBias(MainTexSampler, UV0, MaterialTextureMipBias).a * OpacityIntensity;
	float Opacity = A * (1.0 - TranslucentDitherVaule) + TranslucentDitherVaule;
	float2 Pix = SvPositionXY - ViewRectMin;
	uint2 pi = (uint2)(Pix + TemporalAAParamsX);
	float dq = (float)(((pi.y << 1) + pi.x) % 5u);
	float dn = DitherNoise.SampleBias(DitherNoiseSampler, Pix * asfloat(0x3C800000u), MaterialTextureMipBias).x;   // 1/64
	return (dq + dn) * asfloat(0x3E2AAAABu) + Opacity - 0.5;                                                       // 1/6
}

// Plain masked: OpacityMask = MainTex.a * OpacityIntensity (PS __237694 l.327).
float WuwaCMAlphaMask(Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float OpacityIntensity, float MaterialTextureMipBias)
{
	return MainTex.SampleBias(MainTexSampler, UV0, MaterialTextureMipBias).a * OpacityIntensity;
}

