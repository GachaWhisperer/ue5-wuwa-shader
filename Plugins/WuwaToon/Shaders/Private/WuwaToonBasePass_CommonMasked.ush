// PS __297586 (MI_R5Gun505Md20001_Glass): BodyUp + UseRampColor off + UseVDLShadowoffset off + UseBreathLight + UsePBRMask off
// (l.108-118, 266), BLEND_Masked + UseTranslucent (mask l.322-351)
FWuwaToonGBuffer WuwaToonCommonBasePass_BodyUpNoRampNoVDLBreathScalarPBRMaskedDTAA(
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler, Texture2D MainTex,
	SamplerState MainTexSampler, Texture2D MatCapTex, SamplerState MatCapTexSampler, float2 UV0, float4 VertexColor,
	float3 WorldTangent, float3 WorldNormal, float TangentSign, float3 WorldPosition, float3 TranslatedWorldPosition,
	float3 CameraVector, float3 LightDirVS, float MotionEmissiveMask, float3 SkinColor, float3 BaseColorTint,
	float3 EmissionColor, float3 E_Motion_Emissive, float4 SelectionColor, float3 SkinSubsurfaceColor,
	float3 SubsurfaceColor, float LightOffset_Pitch, float NormalStrength, float RaytracingReflectionFix,
	float DefaultSkinFactor, float UseSkinMask_DYN, float UseFaceAni_SkinMask, float MetallicIntensityDebug,
	float RoughnessIntensityDebug, float MetalSpecularPower, float SpecularPower, float ShadowProcess, float ShadowWidth,
	float OpacityIntensity, float DecodeShadowThreshold, float DecodeSpecThreshold, float SolidShadowProcess,
	float ShadowOffsetAdjustFactor, float ShadowOffsetPower, float MaskShadowOffsetStrength, float SolidShadowWidth,
	float PBRRateIntensity, float MetalEmissionStrength, float MetalMatCapBack, float MatCapInt, float MetalMatCapInt,
	float AniSwitch_ShadowColorBright, float Desaturation, float SolidShadowStrength, float ToonRimWidth,
	float SSAOSkinIntensity, float SSAOIntensity, float FFTIntensity, float CPD1, float CPD13,
	float MPC_GlobalCharSkyLightIntensity, float3 MPC_GlobalCharacterAmbientSkinColor,
	float3 MPC_GlobalCharacterDebugLightDirection, float4 ToonLight0, float4 ToonLight1, float4 ToonLight2,
	float4 ToonLight3, float4x4 TranslatedWorldToView, float MaterialTextureMipBias, float4 NormalOverrideParameter,
	float KuroGBufferMode, float3 KuroEmissiveScale, float KuroSkipEmissiveScale, float OutOfBoundsMask,
	float3 ObjectWorldPosition, float3 ObjectBounds, uint LightingChannelMask, float GameTime, float BreatheStrength,
	float BreatheFrequency, float BreathePropotion, float EmissionStrength, float EmissionBreathThreshold,
	float MetalllicScalar, float RoughnessScalar, Texture2D DitherNoise, SamplerState DitherNoiseSampler,
	float2 SvPositionXY, float2 ViewRectMin, float TemporalAAParamsX, float TranslucentDitherVaule,
	float KuroPrimDitherEnable, float KuroPrimDitherFade, out float OpacityMask)
{
	OpacityMask = WuwaCMTranslucentDitherMask(MainTex, MainTexSampler, UV0, OpacityIntensity, TranslucentDitherVaule,
		DitherNoise, DitherNoiseSampler, SvPositionXY, ViewRectMin, TemporalAAParamsX, MaterialTextureMipBias);
	clip(WuwaPrimDitherClip(KuroPrimDitherEnable, KuroPrimDitherFade, SvPositionXY));
	const float3 Z3 = float3(0.0, 0.0, 0.0);
	return WuwaToonCommonBasePass_Impl(false, false, false, false, true, true, true, false,
		Normal_Roughness_Metallic, Normal_Roughness_MetallicSampler, MainTex, MainTexSampler, MainTex, MainTexSampler,
		MatCapTex, MatCapTexSampler, MainTex, MainTexSampler, UV0, 0.0, VertexColor, WorldTangent, WorldNormal, TangentSign,
		WorldPosition, TranslatedWorldPosition, CameraVector, LightDirVS, MotionEmissiveMask, SkinColor, BaseColorTint,
		EmissionColor, E_Motion_Emissive, SelectionColor, SkinSubsurfaceColor, SubsurfaceColor, LightOffset_Pitch,
