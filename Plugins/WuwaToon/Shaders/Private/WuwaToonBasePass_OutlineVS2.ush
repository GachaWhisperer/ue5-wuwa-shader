// WuwaToonBasePass_OutlineVS2.ush — M_CharacterOutline vertex-shader families found on the roster beyond Yangyang's A/B/C
// (research/roster/Port_CharCom_Coverage.md). WuwaToonBasePass_Outline.ush (verified A/B/C) is NOT modified: this file
// carries a copy of its WPO implementation with the families expressed as compile-time switches:
//   bVertexGreen (UseVertexGreen_OutlineWidth)  W = ((1 - VG) * VertexColor.g + VG) * OutlineClipWidth, else W = OutlineClipWidth
//   bInnerB      (UseVertexColorB_InnerOutline)  camera push -0.01 * B * InnerOutlineMulti * InnerOutlineOffset
//   bCurvature   (UseCurvature)                   + 0.01*CurvatureStrength / max(smoothstep(VertexColor.a), 0.001)
//   OutlineMaxCap (UseOutlineMax)                 pixel-floor cap = pixel * OutlineMax instead of pixel * 999
// Families (original VS archive index, verified in tools/shaderdiff/basepass_outline_vs --roster):
//   BC        VS __323613 / __80094  : VertexGreen + InnerB + Curvature            WuwaToonOutlineWPO_BC
//   A_NoVG    VS __72657 / __132315  : no VertexGreen, constant push                WuwaToonOutlineWPO_A_NoVG
//   A_NoVGMax VS __316679            : no VertexGreen + OutlineMax                  WuwaToonOutlineWPO_A_NoVG_Max
// Round 3: B_Max (VS __219899), B_NoVG (VS __214662), BC_Max (VS __104935 / __304446).
// UseClipSpaceOutline did not change any VS instruction (VS __80094 == __323613 symbolically, vs_equiv / symexec).
#pragma once

#include "WuwaToonBasePass_Outline.ush"

float3 WuwaToonOutlineWPO2_Impl(const bool bVertexGreen, const bool bInnerB, const bool bCurvature,
	float2 UV1, float4 VertexColor, float3 VertexTangentWS, float3 VertexBitangentWS, float3 VertexNormalWS,
	float3 ObjectAxisScale, float3 TranslatedWorldPosition, float3 TranslatedWorldCameraOrigin,
	float4x4 TranslatedWorldToClip, float4x4 ClipToTranslatedWorld, float3 PreViewTranslation,
	float ClipToView00, float ClipToView11, float4 ViewSizeAndInvSize, float KuroOutlinePixelScale,
	float VertexGMinWidthFactor, float OutlineClipWidth, float OutlineHoldDistance,
	float InnerOutlineMulti, float InnerOutlineOffset, float CurvatureMin, float CurvatureMax, float CurvatureStrength,
	float OutlineMaxCap, float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	// ---- VS-A:206-215: octahedral decode of the smoothed normal in UV1 (already in [-1,1]) -------------------------
	precise float z  = abs(UV1.y) + abs(UV1.x);
	z = 1.0 - z;
	precise float t  = saturate(z * -1.0);
	precise float nt = t * -1.0;
	precise float2 ge = float2((UV1.x >= 0.0) ? 1.0 : 0.0, (UV1.y >= 0.0) ? 1.0 : 0.0);
	nt = -t + nt;
	precise float2 nxy = nt * ge;
	nxy = t + nxy;
	nxy = UV1 + nxy;

	// ---- VS-A:216-223: to world with the skinned basis, normalise (dp3/sqrt/div) ---------------------------------------
	precise float3 n = VertexTangentWS * nxy.x;
	precise float3 nb = VertexBitangentWS * nxy.y;
	n = nb + n;
	precise float3 nn = VertexNormalWS * z;
	n = n + nn;
	n = n / sqrt(dot(n, n));

	// ---- VS-A:224-227 (+ VS-C:236-251): width scalar --------------------------------------------------------------------
	precise float curv = 0.0;
	if (bCurvature)
	{
		precise float inv = 1.0 / (CurvatureMax - CurvatureMin);
		precise float s = saturate((VertexColor.a - CurvatureMin) * inv);
		precise float k = s * -2.0;
		k = k + 3.0;
		s = s * s;
		s = s * k;
		s = max(s, 0.001);
		s = 1.0 / s;
		curv = s * (CurvatureStrength * 0.01);              // preshader 0.01*CurvatureStrength
	}
	precise float W;
	if (bVertexGreen)
	{
		W = 1.0 - VertexGMinWidthFactor;
		W = W * VertexColor.g;
		W = W + VertexGMinWidthFactor;
		W = W * OutlineClipWidth;
	}
	else
	{
		W = OutlineClipWidth;                               // preshader (0 + (OutlineClipWidth * 1)) == OutlineClipWidth
	}
	if (bCurvature)
	{
		W = W + curv;
	}

	// ---- VS-A:228-243: widthVec = W * per-axis object scale -------------------------------------------------------------
	precise float3 widthVec = W * ObjectAxisScale;

	// ---- VS-A:244-250: clip.w of the un-extruded vertex ----------------------------------------------------------------
	precise float clipW = mul(float4(TranslatedWorldPosition, 1.0), TranslatedWorldToClip).w;

	// ---- VS-A:251-255: normal -> clip (3x3) -----------------------------------------------------------------------------
	precise float3 c0 = n.x * TranslatedWorldToClip[0].xyz;
	precise float3 c1 = n.y * TranslatedWorldToClip[1].xyz;
	precise float3 nClip = c1 + c0;
	precise float3 c2 = n.z * TranslatedWorldToClip[2].xyz;
	nClip = nClip + c2;

	// ---- VS-A:256-261: aspect / FOV normalisation (ref 75° vertical FOV, 16:9), one-pixel floor ----------------------
	precise float aspectK = ClipToView11 / (ClipToView00 * 0.5625);
	precise float fovK    = asfloat(0x3F446F8Bu) / ClipToView11;                       // 0.767327 = tan(37.5°)
	precise float2 pixel  = (clipW * 2.0) * ViewSizeAndInvSize.zw;
	pixel = pixel * KuroOutlinePixelScale;

	// ---- VS-A:262-268: offset in clip units -----------------------------------------------------------------------------
	nClip = rsqrt(dot(nClip, nClip)) * nClip;
	precise float3 off = widthVec * nClip;
	off = off * 0.1;
	off = fovK * off;
	off.xy = aspectK * off.xy;

	// ---- VS-A:269-286: minimum-pixel floor with smooth fade-in -------------------------------------------------------
	precise float2 sgn = float2((0.0 < off.x) ? 1.0 : -1.0, (0.0 < off.y) ? 1.0 : -1.0);
	precise float hold = OutlineHoldDistance * 0.1;
	precise float2 a = abs(off.xy);
	precise float2 floored = max(pixel, a);
	precise float2 cap = pixel * OutlineMaxCap;                // 999 literal, or OutlineMax (UseOutlineMax)
	floored = min(cap, floored);
	precise float2 tt = pixel * hold;
	tt = 1.0 / tt;
	tt = saturate(a * tt);
	precise float2 kk = tt * -2.0;
	kk = kk + 3.0;
	tt = tt * tt;
	tt = tt * kk;
	floored = -a + floored;
	tt = tt * floored;
	precise float2 oxy = a + tt;
	oxy = oxy * sgn;

	// ---- VS-A:287-293: back to world with Kuro ClipToWorld (w = 0, resulting w dropped) -----------------------------
	precise float3 cw0 = ClipToTranslatedWorld[0].xyz - ClipToTranslatedWorld[0].w * PreViewTranslation;
	precise float3 cw1 = ClipToTranslatedWorld[1].xyz - ClipToTranslatedWorld[1].w * PreViewTranslation;
	precise float3 cw2 = ClipToTranslatedWorld[2].xyz - ClipToTranslatedWorld[2].w * PreViewTranslation;
	precise float3 cw3 = ClipToTranslatedWorld[3].xyz - ClipToTranslatedWorld[3].w * PreViewTranslation;
	precise float3 w0 = oxy.x * cw0;
	precise float3 w1 = oxy.y * cw1;
	precise float3 offWS = w0 + w1;
	precise float3 w2 = off.z * cw2;
	offWS = offWS + w2;
	precise float3 w3 = cw3 * 0.0;
	offWS = offWS + w3;

	// ---- VS-A:294-299 / VS-B:301-305: push along the camera direction (negative = away from the camera) ---------
	precise float3 camDir = TranslatedWorldCameraOrigin - TranslatedWorldPosition;
	camDir = camDir / sqrt(dot(camDir, camDir));
	precise float D;
	if (bInnerB)
	{
		D = VertexColor.b * InnerOutlineMulti;
		D = D * InnerOutlineOffset;
		D = D * asfloat(0xBC23D70Au);                                                   // -0.01
	}
	else
	{
		D = InnerOutlineOffset * -0.01;                                                  // preshader -0.01*InnerOutlineOffset
	}
	precise float3 push = camDir * D;
	offWS = offWS + push;

	// ---- VS-A:92-94, 300-301: Kuro primitive offset (Primitive[44], gated by View[308].x) [U] -----------------------
	// Kuro rounds ((offset + TWP) + PrimitiveOffset); UE computes TWP + WPO. With the offset off this is the same sum.
	// With it on, return ((offset + TWP) + PrimitiveOffset) - TWP: the subtraction is exact (Sterbenz) whenever the
	// position and TWP are within a factor of 2 per component, so UE's TWP + WPO reproduces the original's bits; one
	// correction step covers the remaining cases (verified: tools/shaderdiff/basepass_outline_vs, sets *_kuro_offset).
	bool kuroOn = (KuroEnablePrimitiveOffset != 0.0) && (0.0 < KuroPrimitiveOffset.w);
	precise float3 posK = offWS + TranslatedWorldPosition;
	posK = KuroPrimitiveOffset.xyz + posK;
	precise float3 wK = posK - TranslatedWorldPosition;
	precise float3 cK = TranslatedWorldPosition + wK;     // what UE will compute; one correction step for the rare
	precise float3 rK = posK - cK;                        // non-Sterbenz case (component of TWP small vs. the offset)
	wK = wK + rK;
	return kuroOn ? wK : offWS;
}


#define WUWA_OUTLINE2_COMMON_PARAMS 	float2 UV1, float4 VertexColor, float3 VertexTangentWS, float3 VertexBitangentWS, float3 VertexNormalWS, 	float3 ObjectAxisScale, float3 TranslatedWorldPosition, float3 TranslatedWorldCameraOrigin, 	float4x4 TranslatedWorldToClip, float4x4 ClipToTranslatedWorld, float3 PreViewTranslation, 	float ClipToView00, float ClipToView11, float4 ViewSizeAndInvSize, float KuroOutlinePixelScale
#define WUWA_OUTLINE2_COMMON_ARGS 	UV1, VertexColor, VertexTangentWS, VertexBitangentWS, VertexNormalWS, ObjectAxisScale, TranslatedWorldPosition, 	TranslatedWorldCameraOrigin, TranslatedWorldToClip, ClipToTranslatedWorld, PreViewTranslation, ClipToView00, ClipToView11, 	ViewSizeAndInvSize, KuroOutlinePixelScale

// BC: UseVertexGreen_OutlineWidth + UseVertexColorB_InnerOutline + UseCurvature (VS __323613, __80094; Hair/Bangs_OL).
float3 WuwaToonOutlineWPO_BC(WUWA_OUTLINE2_COMMON_PARAMS, float VertexGMinWidthFactor, float OutlineClipWidth,
	float OutlineHoldDistance, float InnerOutlineMulti, float InnerOutlineOffset,
	float CurvatureMin, float CurvatureMax, float CurvatureStrength, float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	return WuwaToonOutlineWPO2_Impl(true, true, true, WUWA_OUTLINE2_COMMON_ARGS, VertexGMinWidthFactor, OutlineClipWidth,
		OutlineHoldDistance, InnerOutlineMulti, InnerOutlineOffset, CurvatureMin, CurvatureMax, CurvatureStrength,
		999.0, KuroEnablePrimitiveOffset, KuroPrimitiveOffset);
}

// A_NoVG: UseVertexGreen_OutlineWidth off, UseVertexColorB_InnerOutline off (VS __72657, __132315; weapons/props).
float3 WuwaToonOutlineWPO_A_NoVG(WUWA_OUTLINE2_COMMON_PARAMS, float OutlineClipWidth, float OutlineHoldDistance,
	float InnerOutlineOffset, float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	return WuwaToonOutlineWPO2_Impl(false, false, false, WUWA_OUTLINE2_COMMON_ARGS, 0.0, OutlineClipWidth,
		OutlineHoldDistance, 0.0, InnerOutlineOffset, 0.0, 1.0, 0.0, 999.0, KuroEnablePrimitiveOffset, KuroPrimitiveOffset);
}

// A_NoVG_Max: as A_NoVG + UseOutlineMax (VS __316679).
float3 WuwaToonOutlineWPO_A_NoVG_Max(WUWA_OUTLINE2_COMMON_PARAMS, float OutlineClipWidth, float OutlineHoldDistance,
	float OutlineMax, float InnerOutlineOffset, float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	return WuwaToonOutlineWPO2_Impl(false, false, false, WUWA_OUTLINE2_COMMON_ARGS, 0.0, OutlineClipWidth,
		OutlineHoldDistance, 0.0, InnerOutlineOffset, 0.0, 1.0, 0.0, OutlineMax, KuroEnablePrimitiveOffset, KuroPrimitiveOffset);
}

// ---- Round 3 (research/roster/Port_CharCom_Coverage.md#round-3; families found with vs_frontier.py) -----------------
// B_Max: UseVertexGreen_OutlineWidth + UseVertexColorB_InnerOutline + UseOutlineMax, no curvature (VS __219899;
//        symbolically = verified VS-B __114157 except the 999 cap -> OutlineMax).
float3 WuwaToonOutlineWPO_B_Max(WUWA_OUTLINE2_COMMON_PARAMS, float VertexGMinWidthFactor, float OutlineClipWidth,
	float OutlineHoldDistance, float OutlineMax, float InnerOutlineMulti, float InnerOutlineOffset,
	float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	return WuwaToonOutlineWPO2_Impl(true, true, false, WUWA_OUTLINE2_COMMON_ARGS, VertexGMinWidthFactor, OutlineClipWidth,
		OutlineHoldDistance, InnerOutlineMulti, InnerOutlineOffset, 0.0, 1.0, 0.0, OutlineMax, KuroEnablePrimitiveOffset, KuroPrimitiveOffset);
}

// B_NoVG: UseVertexColorB_InnerOutline without UseVertexGreen_OutlineWidth / curvature (VS __214662).
float3 WuwaToonOutlineWPO_B_NoVG(WUWA_OUTLINE2_COMMON_PARAMS, float OutlineClipWidth, float OutlineHoldDistance,
	float InnerOutlineMulti, float InnerOutlineOffset, float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	return WuwaToonOutlineWPO2_Impl(false, true, false, WUWA_OUTLINE2_COMMON_ARGS, 0.0, OutlineClipWidth,
		OutlineHoldDistance, InnerOutlineMulti, InnerOutlineOffset, 0.0, 1.0, 0.0, 999.0, KuroEnablePrimitiveOffset, KuroPrimitiveOffset);
}

// BC_Max: BC + UseOutlineMax (VS __104935 / __304446; Kamola Bangs_OL).
float3 WuwaToonOutlineWPO_BC_Max(WUWA_OUTLINE2_COMMON_PARAMS, float VertexGMinWidthFactor, float OutlineClipWidth,
	float OutlineHoldDistance, float OutlineMax, float InnerOutlineMulti, float InnerOutlineOffset,
	float CurvatureMin, float CurvatureMax, float CurvatureStrength, float KuroEnablePrimitiveOffset, float4 KuroPrimitiveOffset)
{
	return WuwaToonOutlineWPO2_Impl(true, true, true, WUWA_OUTLINE2_COMMON_ARGS, VertexGMinWidthFactor, OutlineClipWidth,
		OutlineHoldDistance, InnerOutlineMulti, InnerOutlineOffset, CurvatureMin, CurvatureMax, CurvatureStrength,
		OutlineMax, KuroEnablePrimitiveOffset, KuroPrimitiveOffset);
}

// M_CharacterOutline_Lite PS (PS __71516, MI_R2T1ShenXinMd10011Bangs_OL / Hair_OL; UseUV4ColorBlend): the verified PS-2
// (UseMainTex) with the emissive base E0 = UV4ColorTransition * (saturate((UV3.y + UV4Mask_Offset) * UV4Mask_Power) *
// Ghost_UV4ColorBlend.rgb) + E_Outline_EmissionColor * E_Outline_EmissionIntensity (PS __71516 l.35-40; Kuro "UV4" =
// mesh UV index 3, Kuro TEXCOORD1.w). E0 enters the verified PS-2 entry as EmissionColor with intensity 1.0 (x * 1 exact).
// The Lite VS (__71534: UseCommonWPO ghost / flatten-plane / skin-bound WPO, a VS texture fetch) is NOT ported.
FWuwaToonGBuffer WuwaToonOutlineBasePass_MainTexUV4Blend(Texture2D MainTex, SamplerState MainTexSampler, float2 UV0, float UV3Y,
	float3 WorldTangent, float3 WorldNormal, float TangentSign, float3 WorldPosition,
	float3 OutlineColorTint, float3 BaseColorTint, float3 E_Outline_EmissionColor, float E_Outline_EmissionIntensity, float4 SelectionColor,
	float3 Ghost_UV4ColorBlend, float UV4Mask_Offset, float UV4Mask_Power, float UV4ColorTransition,
	float MaterialTextureMipBias, float4 NormalOverrideParameter, float KuroGBufferMode, float3 KuroEmissiveScale,
	float KuroSkipEmissiveScale, float OutOfBoundsMask, float3 ObjectWorldPosition, float3 ObjectBounds, uint LightingChannelMask)
{
	float  m  = saturate((UV3Y + UV4Mask_Offset) * UV4Mask_Power);
	float3 E0 = UV4ColorTransition * (m * Ghost_UV4ColorBlend) + E_Outline_EmissionColor * E_Outline_EmissionIntensity;
	return WuwaToonOutlineBasePass_MainTex(MainTex, MainTexSampler, UV0, WorldTangent, WorldNormal, TangentSign, WorldPosition,
		OutlineColorTint, BaseColorTint, E0, 1.0, SelectionColor, MaterialTextureMipBias, NormalOverrideParameter, KuroGBufferMode,
		KuroEmissiveScale, KuroSkipEmissiveScale, OutOfBoundsMask, ObjectWorldPosition, ObjectBounds, LightingChannelMask);
}

#undef WUWA_OUTLINE2_COMMON_PARAMS
#undef WUWA_OUTLINE2_COMMON_ARGS
