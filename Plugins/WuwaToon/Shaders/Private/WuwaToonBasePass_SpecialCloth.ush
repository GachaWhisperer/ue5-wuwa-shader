// =====================================================================================================================
// Round 5 (research/roster/round5/facehair_eye_special.md): UseFabricSimulation world position offset of the Augusta cloth
// VS __172068 (8cfeece402, MI_R2T1AogusitaMd10011Cloth / _HETA), SV_POSITION path l.245-378 of
// evidence/roster/shadermaps/weapons/asm_hex/172068_*.asm.txt (all [precise] in the original, kept `precise` here).
// Returns the WPO in translated space, without the Kuro primitive offset (the engine adds TWP, then the offset, as in
// WuwaWaterSwordWPO_*): WPO = E_VertexMotionSwitch * (anim + cloth + lace) + base effects, where
//   p     = normalize((AbsWP.xy - KuroView368.xy - ObjectWorldPosition.xy, ObjectWorldPosition.z)), d = normalize(Direction)
//   w     = dot(p, d); a = w * Frequence; t = GameTime * SpeedFoFabricSimulation
//   n     = FabricTex(0.5, a * 1.34 + 3t).w * FabricTex(0.5, a + t).w   (SampleLevel -1; root texture T_Sin [U]; all three taps read .w)
//   q     = saturate((w - 1) * -0.5); s = q^2 (3 - 2q); f = 4 s (1 - s) * VertexColor.r * n
//   cloth = normalize(p + d) * f * WPOAmount
//   lace  = VertexNormalWS * ((FabricTex(0.5, UV0.y * 5 * Frequence + 3 GameTime * Speed).w - 0.5) * 2 * VertexColor.g * VertexColor.r) * WPOAmountLace
//   anim  = (VertexColor.b * 0.3 + VertexColor.g * VertexColor.r) * MPC_Cloth.DirectionAnim * MPC_Cloth.DirectAnimAmount
// The base effects (hologram jitter / E_Motion) and TEXCOORD2.x are the verified WuwaToonBaseVS_WPO (called with the Kuro
// offset off). MPC_Cloth (VS CB4): [0].x DirectAnimAmount, [1] Direction, [2] DirectionAnim. KuroView368 = Kuro View row 368
// (.xy), a Kuro-only View member with no UE equivalent [U].
float3 WuwaToonSpecialClothVS_FabricWPO(Texture2D FabricTex, SamplerState FabricTexSampler, float2 UV0, float4 VertexColor,
	float3 VertexNormalWS, float3 TranslatedWorldPosition, float3 PreViewTranslation, float3 TranslatedWorldCameraOrigin, float GameTime,
	float4x4 ViewToTranslatedWorld, float3 ObjectWorldPosition, float2 KuroView368,
	float USE_Hologram, float E_Hologram_JitterStrength, float3 E_Hologram_WPOVector,
	float E_MotionRange, float E_Motion_NoiseSpeed, float4 E_Motion_Offset, float E_Motion_NoisePos,
	float Frequence, float SpeedFoFabricSimulation, float WPOAmount, float Speed, float WPOAmountLace, float E_VertexMotionSwitch,
	float MPC_Cloth_DirectAnimAmount, float3 MPC_Cloth_Direction, float3 MPC_Cloth_DirectionAnim, out float MotionEmissiveMask)
{
	precise float3 fx = WuwaToonBaseVS_WPO(UV0, VertexNormalWS, TranslatedWorldPosition, TranslatedWorldCameraOrigin, GameTime,
		ViewToTranslatedWorld, USE_Hologram, E_Hologram_JitterStrength, E_Hologram_WPOVector, E_MotionRange, E_Motion_NoiseSpeed,
		E_Motion_Offset, E_Motion_NoisePos, 0.0, float4(0.0, 0.0, 0.0, 0.0), MotionEmissiveMask);
	// ---- l.284, 315-324: object-relative direction p, wind direction d ---------------------------------------------------------
	precise float3 p = TranslatedWorldPosition - PreViewTranslation;
	p.xy = p.xy - KuroView368;
	p.xy = p.xy - ObjectWorldPosition.xy;
	p.z = ObjectWorldPosition.z;
	p = p / sqrt(dot(p, p));
	precise float3 d = MPC_Cloth_Direction / sqrt(dot(MPC_Cloth_Direction, MPC_Cloth_Direction));
	precise float w = dot(p, d);
	// ---- l.325-340: two fabric-noise taps and the facing window ---------------------------------------------------------
	precise float a = w * Frequence;
	precise float a1 = a * asfloat(0x3FAB851Fu);                                  // 1.34
	precise float t = GameTime * SpeedFoFabricSimulation;
	precise float t3 = t * 3.0;
	precise float v1 = a1 + t3;
	precise float s1 = FabricTex.SampleLevel(FabricTexSampler, float2(0.5, v1), -1.0).w;
	precise float v2 = a + t;
	precise float s2 = FabricTex.SampleLevel(FabricTexSampler, float2(0.5, v2), -1.0).w;
	precise float n = s2 * s1;
	precise float q = saturate((w + -1.0) * -0.5);
	precise float k = q * -2.0;
	k = k + 3.0;
	precise float s = q * q;
	s = s * k;
	precise float om = 1.0 - s;
	precise float f = s * om;
	f = f * 4.0;
	f = VertexColor.r * f;
	f = f * n;
	// ---- l.346-351: cloth offset along normalize(p + d) -----------------------------------------------------------------
	precise float3 h = p + d;
	h = h / sqrt(dot(h, h));
	precise float3 cloth = f * h;
	cloth = cloth * WPOAmount;
	// ---- l.352-364: lace wave along the vertex normal ---------------------------------------------------------------------
	precise float gr = VertexColor.g * VertexColor.r;                             // l.299 (r0.z * r0.w: VC.g * VC.r)
	precise float u = UV0.y * 5.0;
	u = u * Frequence;
	precise float tl = GameTime * 3.0;
	tl = tl * Speed;
	precise float v3 = u + tl;
	precise float s3 = FabricTex.SampleLevel(FabricTexSampler, float2(0.5, v3), -1.0).w;
	precise float lw = s3 + -0.5;
	lw = lw * 2.0;
	lw = lw * gr;
	precise float3 lace = VertexNormalWS * lw;
	lace = lace * WPOAmountLace;
	cloth = cloth + lace;
	// ---- l.365-370: MPC_Cloth directional animation, motion switch, + base effects ----------------------------------------
	precise float an = VertexColor.b * asfloat(0x3E99999Au);                       // 0.3
	an = an + gr;
	precise float3 anim = an * MPC_Cloth_DirectionAnim;
	anim = anim * MPC_Cloth_DirectAnimAmount;
	anim = anim + cloth;
	anim = anim * E_VertexMotionSwitch;
	return anim + fx;
}

