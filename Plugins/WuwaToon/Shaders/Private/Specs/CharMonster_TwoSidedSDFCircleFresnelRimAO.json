{
 "name": "CharMonster_TwoSidedSDFCircleFresnelRimAO",
 "entry": "WuwaToonMonsterBasePass_TwoSidedSDFCircleFresnelRimAO",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_Monster.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12, or 14 when ToonShadowBlendCSMMask > 0)",
 "kuro_asm": "M_CharMonster PS ae5e0333a2 (#50499) / VS 38a18d40a4 (#50469); MIs MI_EFuluoluoHekateMD10011Body; Impl switches: bTwoSided, bSDF, bSDFCircle, bFresnelRim, bMaskR, bAO",
 "kuro_root_material": "M_CharMonster",
 "blend_mode": "BLEND_Opaque",
 "two_sided": true,
 "resolve": true,
 "resolve_note": "toon GBuffer through WuwaToonResolve. M_CharMonster packing: A.xy = oct(N), A.z = MainTex.a solid-shadow factor, A.w = 1/3 (mode 0) / 1 (mode 1); B.rgb = sqrt(saturate(solid-shadow colour)), B.a = id 12 (14 when ToonShadowBlendCSMMask > 0); C.rgb = lit colour (GI tint, ShadowLord colour), C.a = 0 / rim byte (mode 1); D = (ToonRimWidth, (round(saturate(2 rough) 255) & 240) / 255, 0, 0) in mode 0, 0 in mode 1. MainTex.a emission, attack rim and selection colour are in the emissive.",
 "vs_note": null,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
