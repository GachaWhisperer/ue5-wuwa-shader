 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_Glass.ush",
 "kuro_shading_model": "MSM_DefaultLit (UE4.26 lit forward translucent)",
 "kuro_asm": "M_Char_Translucent PS 61a5ff52d7 (#99688, 7 MIs: MI_EKanteleilaShuimuxiaoMd10011_Gaizi/_Piaodai/_Xu, MI_EKanteleilaShuimudaMd10011_Gaizi/_Piaodai/_Xu, MI_EKanteleilaSanshuimuMd10011_Gaizi) / VS 3be53aa34d (#2466); UseRampColor + UseSkinAllRampColor + UseAllRampColor + UseEffect",
 "kuro_root_material": "M_Char_Translucent",
 "blend_mode": "BLEND_Translucent",
 "two_sided": false,
 "resolve": false,
 "resolve_note": "lit forward translucent (UE4.26 MSM_DefaultLit, BLEND_Translucent, TranslucencyLightingMode Surface TranslucencyVolume). Port = the Kuro material graph: Emissive / Opacity (FWuwaFXOutput) + out OutBaseColor, OutMetallic, OutRoughness, OutNormal (tangent space, already x TwoSidedSign as the graph outputs it); Specular is the default 0.5. UE material: translucent DefaultLit, connect BaseColor / Metallic / Roughness / Normal / EmissiveColor / Opacity; UE lights it itself. Engine side, not ported (reproduced in the harness: tools/shaderdiff/weapons/hlsl/kuro_tail_glass.hlsli KuroCharTranslucentTail): BaseColor saturate, roughness override View[145], Diffuse/Specular colour + View[142]/[143] overrides, forward-grid reflection captures + sky View[163], EnvBRDFApprox, planar reflection, translucency lighting volume, Kuro emissive scale / OOB, vertex fog, Kuro effect grading (View[283]/[279]/[286].x/[284]).",
 "vs_note": "VS #2466 (3be53aa34d): engine_only - reads no Material-CB value (cb declarations View / Primitive / GPU-skin only); stock GPU-skin passthrough translucent VS with vertex height fog (TEXCOORD7). See r3/glass_vs_status.py.",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "material Emissive Color (before the engine translucent tail: fog, OOB, Kuro effect grading)"
  },
  "Opacity": {
   "type": "float",
   "kuro": "material Opacity (o0.a = o1.a after the tail)"
  },
  "OutBaseColor": {
   "type": "float3",
   "kuro": "material Base Color (engine saturates it)"
  },
  "OutMetallic": {
   "type": "float",
   "kuro": "material Metallic = saturate(Normal_Roughness_Metallic.z * MetallicIntensity)"
  },
  "OutRoughness": {
   "type": "float",
   "kuro": "material Roughness = saturate(Normal_Roughness_Metallic.w * RoughnessIntensity)"
  },
  "OutNormal": {
   "type": "float3",
   "kuro": "material Normal (tangent space) = lerp((0,0,1), normal map, NormalStrength) * TwoSidedSign"
  }
 },
