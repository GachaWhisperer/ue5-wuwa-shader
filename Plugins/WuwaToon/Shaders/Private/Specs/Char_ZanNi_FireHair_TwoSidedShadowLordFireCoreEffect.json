{
 "name": "Char_ZanNi_FireHair_TwoSidedShadowLordFireCoreEffect",
 "entry": "WuwaToonZaniFireHairBasePass_TwoSidedShadowLordFireCoreEffect",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_ZaniFire.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 15, 12 on tail vertices)",
 "kuro_asm": "M_Char_ZanNi_FireHair PS 72c723cd73 (#201781) / VS 1759e87905 (#201753); UseFireHair, two-sided normal, UseShadowLordMaterial, UseFresnelFireCoreMask, UseSecond, UseEffectMaterial, UseRim, UseNoise",
 "kuro_root_material": "M_Char_ZanNi_FireHair",
 "blend_mode": "BLEND_Masked",
 "two_sided": true,
 "resolve": true,
 "resolve_note": "toon GBuffer through WuwaToonResolve. M_Char_ZanNi_FireHair packing: A = (oct(N), 0.95, skin >= 0.5 ? 0.666 : 0 | mode 1: 1), B = (sqrt(saturate(FireRimColor)), id 15, or 12 on tail vertices VertexColor.y <= 0), C = (lit fire colour, MainTex.a * OpacityIntensity | mode 1: rim byte), D = (ToonRimWidth, 0, 0, 0 | mode 1: 0). Masked: route OpacityMask to the material Opacity Mask (clip 0.3333, Kuro folds it into mad(mask, heta, -0.3333)); the Kuro primitive dither is clipped inside. UseShadowLordMaterial: C.rgb += UseShadowLordMaterialDynamic * ShadowLord colour. UseFresnelFireCoreMask: the black mask is modulated by a camera-relative fire-core fresnel band around the CPD 14..16 -> 18..20 axis [U] and a range / noise band. Effect layer (UseSecond / UseRim / UseNoise / UseEffectMaterial): emissive += (fresnel rim * FresnelRim_RimColor + refined Second_RGB * Second_ColorTint) * pow(R_Noise_A_Mask.r, 1 - Effect_Progress), added before the emission colour term (no change to the GBuffer colour).",
 "vs_note": "VS 1759e87905 (#201753) is the round-3 Lupa tail VS #27986 (fa0ca8e0f8, ported_wpo_verified) instruction for instruction, with only the Material-CB row numbers changed; all 151 Material-CB operands carry the identical preshader expression (r7/zani_vs_r7.py). The fire-hair World Position Offset is the \"wpo\" entry WuwaToonZaniFireHairWPO, verified bit-exact on SV_POSITION for this VS with the head MI values (evidence/validation/shaderdiff/roster_charcom/round7/singletons/zani/results_vs_wpo_toon_zani_r7.json); its E_Hologram / E_Motion WPO block is gated off at the roster MI (USE Hologram = 0, E_Motion_Offset.w = 0) and not ported; TEXCOORD2 (light direction + motion mask) is the #27986 / Body VS #35700 form (round3/zani/vs_status_zani.json).",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  },
  "OpacityMask": {
   "type": "float",
   "kuro": "masked clip input, clip value 0.3333"
  }
 },
