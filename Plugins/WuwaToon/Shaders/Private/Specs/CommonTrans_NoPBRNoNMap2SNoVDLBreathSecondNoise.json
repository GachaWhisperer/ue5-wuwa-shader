 "kuro_asm": "M_Char_Com forward-translucent PS #308298 6aff1580d76b49a1d88c7828184fbc799fdb297d (MI_R5Knuckles506Md20001Effect); material part = the M_Char_Com body graph (bNoNormalMap, bTwoSided, bNoVDL, bBreath, bNoPBR, bNoRamp, bSecond); engine tail (primitive fade, height fog, emissive scale / OOB, screen shadow mask / CSM, Kuro forward toon lighting of the main light and of the local-light list, pre-exposure) not ported. research/roster/round7/trans.md",
 "blend_mode": "BLEND_Translucent",
 "two_sided": true,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "material Emissive Color (before max 0, emissive scale, OOB stripes, fog)"
  },
  "Opacity": {
   "type": "float",
   "kuro": "material Opacity (o0.a = Opacity * primitive fade after the tail)"
  },
  "OutBaseColor": {
   "type": "float3",
   "kuro": "desaturated toon lit colour (albedo of the Kuro forward toon lighting)"
  },
  "OutNormal": {
   "type": "float3",
   "kuro": "world-space normal (Kuro local lights); not connected"
  },
  "OutShadowColor": {
   "type": "float3",
   "kuro": "shadow colour (deferred GBufferB.rgb before sqrt); not connected"
  },
  "OutShadow": {
   "type": "float",
   "kuro": "toon shadow term; not connected"
  },
  "OutShadowAO": {
   "type": "float",
   "kuro": "shadow-factor AO (SolidShadowStrength); not connected"
  }
 },
