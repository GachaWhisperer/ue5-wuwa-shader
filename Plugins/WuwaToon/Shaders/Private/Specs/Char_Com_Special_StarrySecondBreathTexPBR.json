{
 "name": "Char_Com_Special_StarrySecondBreathTexPBR",
 "entry": "WuwaToonSpecialBasePass_StarrySecondBreathTexPBR",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_Special.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_Char_Com_Special PS be31848bb4 (#57106) / VS b80a1088 (#57105); UseStarrySky + UseSecond + UseBreathLight, NRM-texture PBR",
 "kuro_root_material": "M_Char_Com_Special",
 "blend_mode": "BLEND_Opaque",
 "two_sided": false,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12) through WuwaToonResolve. M_Char_Com_Special packing: B.rgb = sqrt(saturate(SubsurfaceColor)), C.rgb = Lit * AniSwitch_ShadowColorBright (no ramp, no desaturation), C.a = MainTex.a * OpacityIntensity (mode 0) / rim byte (mode 1), D = (ToonRimWidth, 0, 0, 0) in mode 0, A.w = 0 / 1 (mode flag); the UseStarrySky colour is in the emissive.",
 "vs_note": null,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
