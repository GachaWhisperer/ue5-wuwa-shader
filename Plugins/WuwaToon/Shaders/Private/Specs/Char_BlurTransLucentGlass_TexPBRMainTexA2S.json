 "entry": "WuwaFXBlurGlass_TexPBRMainTexA2S",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_BlurGlass.ush",
 "kuro_shading_model": "MSM_ToonCommon in the forward translucent base pass (lit translucent toon)",
 "kuro_asm": "M_Char_BlurTransLucentGlass PS 3ebbfe109d (#322245) / VS d4b41ab173 (#242957); switches UseToonMask, UseMainTexA, UseBreathLight, UseNormalMap, UsePBR, UsePBRMask, UseRampColor; two-sided",
 "kuro_root_material": "M_Char_BlurTransLucentGlass",
 "blend_mode": "BLEND_Translucent",
 "two_sided": true,
 "resolve": false,
 "resolve_note": "lit translucent toon: X.Emissive = material emissive (blurred / refracted scene colour x glass tint, metal + motion emissive, selection colour); out ToonLit = Kuro forward ToonCommon lighting (ramp, Kuro view toon block, directional shadow, 16 local lights) / EyeAdaptation. UE: unlit translucent material, Emissive Color = Emissive + ToonLit, Opacity = X.Opacity (0/1 split-screen step; the glass look comes from the scene-colour taps, not from alpha blending). Engine tail not ported: opacity *= Kuro primitive fade (Primitive[43]); c = max(Emissive, 0) (*View[285] unless Primitive[42].w), OOB stripes; o0 = (max((ToonLit + c) * fog.a + fog.rgb, 0), opacity). Verified with that tail in tools/shaderdiff/weapons/hlsl/kuro_tail_blurglass.hlsli.",
 "vs_note": null,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "material Emissive Color (before the engine translucent tail: fog, OOB, Kuro effect grading)"
  },
  "Opacity": {
   "type": "float",
   "kuro": "material Opacity (o0.a = o1.a after the tail)"
  },
  "ToonLit": {
   "type": "float3",
   "kuro": "forward toon lighting / EyeAdaptation (added to the emissive before fog)"
  }
 },
