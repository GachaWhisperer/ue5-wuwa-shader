{
 "name": "Char_Com_Special_FabricRampMaskCloth",
 "entry": "WuwaToonSpecialClothBasePass_Fabric",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_SpecialCloth.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_Char_Com_Special PS ce85f7ed58 (#279875) / VS 8cfeece402 (#172068); UseFabricSimulation + UseBumpOffset + Second_UseObjectScreenUV + UseRampMask + UseTranslucentCloth, masked, two-sided (PS: TypeMask skin + ramp mask, CPU solid shadow)",
 "kuro_root_material": "M_Char_Com_Special",
 "blend_mode": "BLEND_Masked",
 "two_sided": true,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12) through WuwaToonResolve, BLEND_Masked. B.rgb = sqrt(saturate(lerp(SubsurfaceColor, Ramp(u, v), RampW))), C.rgb = Lit * AniSwitch_ShadowColorBright; mode 0: C.a = cloth opacity saturate(lerp(A, smoothstep(OpacityMask_Offset, +max(OpacityMask_Width, 0.001), A), gate)), D = (ToonRimWidth, 0, translucent-cloth back light * fresnel * gate, 0), A.w = 0; mode 1: C.a = rim byte (ToonRimWidth, LSB 0), D = 0, A.w = 1.",
 "vs_note": "VS #172068 (8cfeece402) NOT established: SV_POSITION carries an active UseFabricSimulation WPO (VS texture sample_l x3, GameTime, Frequence / SpeedFoFabricSimulation / Speed, WPOAmount 2 + WPOAmountLace 0.2, E_VertexMotionSwitch = 1 at both MIs); TEXCOORD2 matches the Face VS #35570. The WPO is not ported; the PS is verified, the pair is not registered.",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
