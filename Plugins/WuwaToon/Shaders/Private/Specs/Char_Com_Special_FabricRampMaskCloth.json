   "name": "SolidShadowRatio",
   "type": "float",
   "kind": "uniform_expression",
   "params": [
    "SolidShadowProcess"
   ],
   "expr": "min(SolidShadowProcess, SolidShadowProcess + 0.001) / max(SolidShadowProcess, 0.01)",
   "expr_note": "cb4[87].x of the UseFabricSimulation map: the \"float13(float12(float8(0, 0.001 + SSP), 0), EmissionIntensity).y\" append chain re-runs (float32 preshader opcodes) to 0.001 + SSP; float32 min, max, divide",
   "ue_nodes": "Divide(Min(S, Add(S, 0.001)), Max(S, 0.01)), S = ScalarParameter \"SolidShadowProcess\" (uniform expression)",
   "default": 1.0
  },
  {
   "name": "SolidShadowFactor",
   "type": "float",
   "kind": "uniform_expression",
   "params": [
    "SolidShadowProcess"
   ],
   "expr": "(clamp(min(SolidShadowProcess, SolidShadowProcess + 0.001) / max(SolidShadowProcess, 0.01), 0.9, 1) - 0.9) / max(1 - 0.9, 0.0001)",
   "expr_note": "cb4[87].w; float32: (1 - 0.9) = 0.100000024",
   "ue_nodes": "Divide(Subtract(Clamp(SolidShadowRatio, 0.9, 1), 0.9), Max(Subtract(1, 0.9), 0.0001)) (uniform expression)",
   "default": 1.0
  },
  {
   "name": "SolidShadowAZ",
   "type": "float",
   "kind": "uniform_expression",
   "params": [
    "SolidShadowProcess",
    "SolidShadowStrength"
   ],
   "expr": "1 - (1 - min(SolidShadowProcess, SolidShadowProcess + 0.001) / max(SolidShadowProcess, 0.01)) * SolidShadowStrength",
   "expr_note": "cb4[101].z; float32",
   "ue_nodes": "Subtract(1, Multiply(Subtract(1, SolidShadowRatio), ScalarParameter \"SolidShadowStrength\")) (uniform expression)",
   "default": 1.0
