 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_CharWeapon.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_CharWeapon_Com PS 2fcffab40a (#11132) / VS d58fe679 (#11181); Use_BaseColWarp + UseSecond + UseBreathLight + UseRampColor",
 "kuro_root_material": "M_CharWeapon_Com",
 "blend_mode": "BLEND_Opaque",
 "two_sided": false,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12) through WuwaToonResolve. M_CharWeapon_Com packing: B.rgb = sqrt(saturate(lerp(ShadowColor, Ramp, RampW))), C.rgb = Lit * AniSwitch_ShadowColorBright, mode 0: C.a = 0, D = (ToonRimWidth, packed rough/metal, 0, packed AO/FFT), A.w = 0; mode 1: rim byte in C.a, D = 0, A.w = 1. Second layer / breathing / PBR highlight are in the emissive.",
 "vs_note": null,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
