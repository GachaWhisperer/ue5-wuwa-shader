 "blend_mode": "BLEND_Translucent",
 "two_sided": false,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "material Emissive Color (before max 0, emissive scale, OOB stripes, fog)"
  },
  "Opacity": {
   "type": "float",
   "kuro": "material Opacity (o0.a = Opacity * primitive fade after the tail)"
  },
  "OutBaseColor": {
   "type": "float3",
   "kuro": "desaturated toon lit colour (albedo of the Kuro forward toon lighting)"
  },
  "OutNormal": {
   "type": "float3",
   "kuro": "world-space normal (Kuro local lights); not connected"
  },
  "OutShadowColor": {
   "type": "float3",
   "kuro": "shadow colour (deferred GBufferB.rgb before sqrt); not connected"
  },
  "OutShadow": {
   "type": "float",
   "kuro": "toon shadow term; not connected"
  },
  "OutShadowAO": {
   "type": "float",
   "kuro": "shadow-factor AO (SolidShadowStrength); not connected"
  }
 },
 "input_kinds": {
  "texture": "Texture2D material parameter `param` (Texture Object pin); `default` = parent Material default texture",
  "sampler": "sampler paired with `texture`; ue_expr is the HLSL name inside the Custom node",
  "scalar|vector": "material parameter `param` (Kuro name), `default` = compiled/Material default; vector `channels` used",
  "uv": "TextureCoordinate `index` (optional `channel`)",
  "vertexcolor": "VertexColor (optional `channel`)",
  "worldnormal|worldtangent": "raw interpolated TangentToWorld rows (`channel` sign/bitangent), ue_expr given",
