{
 "name": "Weapon_SP_FlashDiamond",
 "entry": "WuwaToonWeaponSPBasePass",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_WeaponSP.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_Weapon_SP (MI_Weapon_SP_Com; switches Render_FlashDiamond/_In/_Out, Render_Structure) PS 9059e5c8ea9f (#94854, 439 instr) / VS 50591320 (#94834)",
 "kuro_root_material": "M_Weapon_SP",
 "blend_mode": "BLEND_Opaque",
 "two_sided": false,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12) with a black surface: C = 0, B.rgb = 0, A.z = 0, D = 0. The visible colour is the emissive o0 (self-lit PBR + fresnel + structure light + diamond + attack rim); the toon resolve is still the correct wrapper.",
 "vs_note": "VS #94834 adds a UV3 dissolve WPO (E_UV3Dissolve_*: smoothstep(UV3.y) * (vector + sin/cos warp), gated by UseShadowLordMaterialDynamic) and writes TEXCOORD9 = pre-WPO translated world position; at the MI values the WPO strength terms are 0 [VS not ported, see Port_Weapons_Specials.md].",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
