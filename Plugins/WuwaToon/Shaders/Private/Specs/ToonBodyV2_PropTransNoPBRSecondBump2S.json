 "resolve": false,
 "kuro_shading_model": "MSM_ToonCommon (forward BLEND_Translucent base pass)",
 "kuro_asm": "M_CharV2_Com forward-translucent prop body PS 87519bc1 (#283257, 582 lines; BLEND_Translucent, MI_ELuoselaFilmMd10011_Tou_Inst < MI_ELuoselaFilmMd10011_Tou < MI_CharV2_Body). Material part (L63-216, L265-387): V2 body WITHOUT UsePBR / normal map / ramp texture (lit = desat(sat(Base * AniSwitch_ShadowColorBright)), shadow colour = desat(lerp(SubsurfaceColor, SkinSubsurfaceColor, SkinF))), UseVDLShadowoffset, TwoSided, UseEffectMaterial second layer (UV switch / screen UV, rotation, time scroll, UseBumpOffset, refine, R_Noise_A_Mask.b ^ (1 - Effect_Progress)), emissive EmissionColor * Base * SpecPart, UseTranslucent opacity min(E_Link gate, max(TypeMask.r * OpacityIntensity, 0)). Engine tail (not ported): primitive fade (L217-220), volumetric / vertex fog (L221-242), emissive max 0 / scale / OOB (L243-264), screen shadow mask / CSM (L388-462), Kuro forward toon lighting of the main light (L463-534) and of the local-light list b4 (L535-637), pre-exposure (L638-641). Textures: TypeMask t4, MainTex t5, Second_RGB t6, R_Noise_A_Mask t7 (t0 shadow depth, t1 fog volume, t2 pre-exposure, t3 screen shadow mask: engine; E_Tex_NoiseTex is bound but not sampled). VS 8e198801 (#283259) = the verified V2 face VS c9e8451f and, with the face -> hair interpolator packing remap, the V2 hair VS 36679c04 on TEXCOORD0 / TEXCOORD2 / SV_POSITION (vs_equiv_r7.json; its vertex height-fog / local-fog block -> TEXCOORD7 is engine)",
 "kuro_root_material": "M_CharV2_Com",
 "blend_mode": "BLEND_Translucent",
 "two_sided": true,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "material Emissive Color (before the engine tail: max 0, emissive scale, OOB stripes, fog)"
  },
  "Opacity": {
   "type": "float",
   "kuro": "material Opacity (o0.a = Opacity * primitive fade after the tail)"
  },
  "OutBaseColor": {
   "type": "float3",
   "kuro": "desaturated toon lit colour (the albedo of the Kuro forward toon lighting)"
  },
  "OutNormal": {
   "type": "float3",
   "kuro": "world-space shading normal (Kuro: N . L of the local lights); not connected (UE Normal is tangent space)"
  },
  "OutShadowColor": {
   "type": "float3",
   "kuro": "shadow colour (deferred GBufferB.rgb before sqrt); Kuro toon-lighting input, not connected"
  },
  "OutShadow": {
   "type": "float",
   "kuro": "toon shadow term solid * smoothstep (A.z = AO * (S/2 + 1/2)); not connected"
  },
  "OutShadowAO": {
