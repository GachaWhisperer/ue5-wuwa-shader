 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_WeaponFX2.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_AdvancedEffect_ToonMask PS f3fda1d579 (#194720, 319 instr) / VS f35cb1f5 (#12148, stock GPU-skin passthrough = verified XinHen / ToonMask_9595ae VS); UseDitherMask + UseAllUV + UseSecondTex + UseMaskTex + UseNoise + UseDissolve + UseBase, two-sided",
 "kuro_root_material": "M_AdvancedEffect_ToonMask",
 "blend_mode": "BLEND_Masked",
 "two_sided": true,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12): B.rgb = 1, C = 0, A.z = 0, D = 0; A.xy = oct of the two-sided (TwoSidedSign-flipped) shading normal; the visible colour is the effect emissive o0. Masked: the entry CLIPS itself (the original folds the DitherTemporalAA threshold -0.5 and the engine clip 0.3333 into one constant -0.8333, plus the Kuro primitive dither) and returns OpacityMask = 1, so the UE masked clip (0.3333) always passes.",
 "vs_note": null,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  },
  "OpacityMask": {
   "type": "float",
   "kuro": "masked clip input, clip value 0.3333"
  }
 },
