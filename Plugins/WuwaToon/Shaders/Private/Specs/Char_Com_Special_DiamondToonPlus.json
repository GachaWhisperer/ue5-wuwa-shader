{
 "name": "Char_Com_Special_DiamondToonPlus",
 "entry": "WuwaToonSpecialDiamondBasePass_ToonPlus",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_SpecialDiamond.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_Char_Com_Special PS 13da21c481 (#158105) / VS f80c96371d (#158153); UseDiamond + UseToonPlus + UseDoubleSpecular (Carlotta bangs)",
 "kuro_root_material": "M_Char_Com_Special",
 "blend_mode": "BLEND_Opaque",
 "two_sided": false,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12) through WuwaToonResolve. M_Char_Com_Special UseDiamond packing: B.rgb = sqrt(saturate(Diamond + lerp(SubsurfaceColor, Ramp(u, v), RampW))), C.rgb = LitB + Diamond (LitB = Lit * AniSwitch_ShadowColorBright, or lerp(Lit * Dark, Lit * Bright, MaskTex.b) with UseToonSpecular), C.a = MainTex.a * OpacityIntensity (mode 0) / rim byte (mode 1), D = (ToonRimWidth, 0, 0, 0) in mode 0, A.z = (1 - (1 - SolidRatio) * SolidShadowStrength) * (Shadow * 0.5 + 0.5) (UseToonPlus) or the folded 0x409FFFFE form, A.w = 0 / 1 (mode flag); Diamond * DiamondEmissiveStrength is also in the emissive.",
 "vs_note": "VS #158153: no material WPO term differs from the verified Body VS #35700; TEXCOORD2 (dir.xyz, motion mask .w) and SV_POSITION symbolically identical (evidence/validation/shaderdiff/weapons/round3/diamond/vs_status_diamond.json)",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
