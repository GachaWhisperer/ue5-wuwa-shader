{
 "name": "ToonBodyV2_TransGlassDSNoSkinRampXingHenNoRID2S",
 "entry": "WuwaToonBodyV2TransGlassDSNoSkinRampXingHenNoRID2SBasePass",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_V2Glass.ush",
 "resolve": false,
 "kuro_shading_model": "MSM_ToonCommon (forward BLEND_Translucent base pass)",
 "kuro_asm": "M_CharV2_Com forward-translucent UseBlurTranslucentGlass body PS 81b646b8 (#291139, 1123 instr; BLEND_Translucent). Material part: the V2 body graph with UseDoubleSpecular + UseCameraOffsetLightDir, UseVDLShadowoffset, UseFresnel, UseRampIDMask, UseXingHen (rotated), no UseRegionID / UseBlendParameter / UseOnlySkinRampColor, TwoSided (UseAniSwitchShadow: no PS effect) (WuwaToonBodyV2BasePass_Impl, RawOut 1) + the blur glass (scene colour t4, scene depth t2) blended into the emissive, lit colour and shadow colour inside [BlurTranslucentMin, Max]; opacity max(min(lerp(max(XingHen blend of sat(lum(spec) - 1), TypeMask.r * OpacityIntensity), 1, glass region), E_Link gate), 0). Engine tail (not ported): primitive fade, fog, emissive scale / OOB, screen shadow mask t5 / CSM t0, Kuro forward toon lighting, pre-exposure t3. Textures: Normal_Roughness_Metallic t6, TypeMask t7, MainTex t8, D t9, Noise t10, Noise02 t11, MatCapTex t12, BlurNoise t13, DitherTex t14, Ramp t15",
 "kuro_root_material": "M_CharV2_Com",
 "blend_mode": "BLEND_Translucent",
 "two_sided": true,
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "material Emissive Color (before the engine tail: max 0, emissive scale, OOB stripes, fog)"
  },
  "Opacity": {
   "type": "float",
   "kuro": "material Opacity (o0.a = Opacity * primitive fade after the tail)"
  },
  "OutBaseColor": {
   "type": "float3",
   "kuro": "desaturated toon lit colour (the albedo of the Kuro forward toon lighting)"
  },
  "OutNormal": {
   "type": "float3",
   "kuro": "world-space shading normal (Kuro: N . L of the local lights); not connected (UE Normal is tangent space)"
  },
  "OutShadowColor": {
   "type": "float3",
   "kuro": "shadow colour (deferred GBufferB.rgb before sqrt); Kuro toon-lighting input, not connected"
  },
  "OutShadow": {
   "type": "float",
   "kuro": "toon shadow term solid * smoothstep (A.z = AO * (S/2 + 1/2)); not connected"
  },
  "OutShadowAO": {
   "type": "float",
   "kuro": "shadow-factor AO (back-light solid lift, SolidShadowStrength); not connected"
  }
 },
