 "ue_material": {
  "contract": "entry returns FWuwaFXOutput {Emissive, Opacity} + out OutBaseColor (lit-translucent attributes; no toon GBuffer, no WuwaToonResolve); OutNormal (world space), OutShadowColor, OutShadow, OutShadowAO are the Kuro forward toon-lighting inputs, kept as unconnected outputs",
  "shading_model": "MSM_DefaultLit",
  "blend_mode": "BLEND_Translucent",
  "two_sided": true,
  "translucency_lighting_mode": "TLM_SurfacePerPixelLighting (UE lights the translucent surface per pixel; Kuro: its own forward toon lighting with the local-light list)",
  "connect": {
   "EmissiveColor": "X.Emissive",
   "Opacity": "X.Opacity",
   "BaseColor": "OutBaseColor",
   "Metallic": "0 (default)",
   "Roughness": "0.5 (default)",
   "Specular": "0.5 (default)"
  },
  "opacity_mask_clip_value": null,
  "note": "APPROXIMATION: material part bit-exact; engine tail replaced by UE translucency lighting. Kuro lights OutBaseColor with its forward toon lighting (ramp / shadow colour / shadow factor of the material part, screen shadow mask or CSM, local-light list, translucency volume, height fog, emissive scale, pre-exposure); UE applies DefaultLit translucency lighting and fog to BaseColor / Emissive / Opacity instead. The Kuro primitive fade (Primitive[43]) multiplies the opacity in the tail and is not applied. The blur-glass part reads the UE scene colour (SceneColorCopyTexture) and scene depth (SceneTexturesStruct.SceneDepthTexture) through the generator's SCENE_TEXTURES aliases, as Kuro reads its opaque scene colour / device depth."
 },
 "notes": {
  "verification": "material part bit-exact; engine tail replaced by UE translucency lighting (approximation) - tools/shaderdiff/basepass_v2/trans_tdiff_r6.py, research/roster/round6/v2.md",
