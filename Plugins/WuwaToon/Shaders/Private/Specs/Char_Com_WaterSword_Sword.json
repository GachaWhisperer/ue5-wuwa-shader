{
 "name": "Char_Com_WaterSword_Sword",
 "entry": "WuwaToonWaterSwordBasePass_Sword",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_MiscProps.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12)",
 "kuro_asm": "M_Char_Com_WaterSword_Sword (UseMatCap, no UsePBR) PS 4cf7d2c854 (#88938) / VS 0494bcbb67 (#88915)",
 "kuro_root_material": "M_Char_Com_WaterSword_Sword",
 "blend_mode": "BLEND_Masked",
 "two_sided": true,
 "resolve": true,
 "resolve_note": "toon GBuffer (id 12) through WuwaToonResolve, M_Char_Com mode-0/1 packing: A = (oct N, half-Lambert toon shadow x constant solid-shadow terms, mode 0: 0.666 when skin >= 0.5 / mode 1: 1), B = (sqrt(saturate(desat(lerp(SubsurfaceColor, SkinSubsurfaceColor, skin)))), id 12), C = (desaturate(BaseColor x AniSwitch_ShadowColorBright) x water layer, mode 0: MainTex.a x OpacityIntensity / mode 1: rim byte), D = (ToonRimWidth, packed HairLumenIntensity|GiBlend, 0, 0) in mode 0, 0 in mode 1. Masked, two-sided: the entry clips (discard) itself (material mask + screen dither with the clip value folded in, min with the Kuro primitive dither), so use BLEND_Masked with Opacity Mask = 1 (or any value >= the clip value); no OpacityMask output.",
 "vs_note": "VS 0494bcbb67 (#88915): M_Char_Com base VS (TEXCOORD2 light direction + motion mask symbolically identical to the verified Face VS #35570, r3/misc_vs_status.py) + an always-on texture wave WPO, ported as the \"wpo\" entry WuwaWaterSwordWPO_Sword (calls the verified WuwaToonBaseVS_WPO for the gated hologram / E_Motion effects).",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
