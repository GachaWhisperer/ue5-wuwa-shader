    }
   ],
   "custom_node_code": "return WuwaToonEyeLOD2VS_LightDir(CPD0, CPD1, MPC_GlobalCharacterMainLightYaw);",
   "note": "VS __19585 l.274-372: lerp(d(GlobalCharacterMainLightYaw), d(CPD0), saturate(sign(CPD1 - 0.5))), pitch fixed at 45 deg; verified on WARP (round5/facehair/results_vs_eye_lod2.json) and symbolically (vs_symexec_eye_lod2.json)"
  },
