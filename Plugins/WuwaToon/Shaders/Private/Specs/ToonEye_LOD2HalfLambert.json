 "custom_node_code": "FWuwaToonGBuffer G = WuwaToonEyeBasePass_LOD2HalfLambert(HeightLightMap, HeightLightMapSampler, EM, EMSampler, MainTex, MainTexSampler, UV0, VertexColor, WorldNormal, WorldPosition, LightDirVS, MotionEmissiveMask, GameTime, SecondLight_WidthX, SecondLight_WidthY, LightNormlScale, SecondLight_PositionX, SecondLight_PositionY, SecondLight_Position_02X, SecondLight_Position_02Y, LightPositionX, LightPositionY, EyeSize, EyeScale, MainTexColorTint, Rot01Cos, Rot01Sin, ShapeScaleX, ShapeScaleY, EdgeColor, HeightLightColor, OutLineColor, EyeLightSimulation_Color, EyeLightSimulation_TongKong, EyeLightSimulation_YanBai, EmissionColor, E_Motion_Emissive, SelectionColor, ScaleTransition_Speed, EyeLight_TransitionScale, UseEyeScaleTransition, LightDifferentScale, LightShakeSpeed, LightShakeScale, LightShakPositionX, LightShakPositionY, RotateAngle, LightEmissiveInt, LightDisable, ShapePosition01X, ShapePosition01Y, EdgeWidth, UseProLight, OpacityIntensity, Main_EmissionPower, Desaturation, SolidShadowStrength, MPC_EyeEmissive, ToonLight0, ToonLight3, MaterialTextureMipBias, NormalOverrideParameter, KuroGBufferMode, KuroEmissiveScale, KuroSkipEmissiveScale, OutOfBoundsMask, ObjectWorldPosition, ObjectBounds, LightingChannelMask, ShadowColor, ActorPosition, PrimActorWorldPosition, RampShadowColorScale, RampShadowIntensity, SolidShadowThreshold, ShadowOffset, RampShadowRange, SolidShadowSaturation, SolidShadowView, ShadowRange);\nOutA = G.A; OutB = G.B; OutC = G.C; OutD = G.D;\nreturn G.Emissive;",
 "gbuffer_storage": "values are raw MRT registers; apply WuwaToonGBufferStore() to emulate 8-bit targets",
 "input_kinds": {
  "texture": "Texture2D material parameter `param` (Texture Object pin); `default` = parent Material default texture",
  "sampler": "sampler paired with `texture`; ue_expr is the HLSL name inside the Custom node",
  "scalar|vector": "material parameter `param` (Kuro name), `default` = compiled/Material default; vector `channels` used",
  "uv": "TextureCoordinate `index` (optional `channel`)",
  "vertexcolor": "VertexColor (optional `channel`)",
  "worldnormal|worldtangent": "raw interpolated TangentToWorld rows (`channel` sign/bitangent), ue_expr given",
  "worldposition": "`space` absolute (LWC demoted) or translated",
  "cameravector": "Parameters.CameraVector",
  "svposition": "pixel position",
  "interpolator": "value produced in the VS by `source` (vertex_interpolators)",
  "cpd": "CustomPrimitiveData `index` (list = assembled vector), filled by UWuwaToonCharacterComponent",
  "mpc": "Material Parameter Collection `mpc` / `mpc_param` (Kuro asset default in `default`)",
  "toonlight": "ToonShadowLightData CB1 row `index` (float4); no recovered default (see note on [1].w bits)",
  "view": "View uniform field (ue_expr) or Kuro-only View member (ue_expr null, `kuro` row, explicit default)",
  "primitive": "Primitive data (ue_expr) or Kuro-only Primitive member (ue_expr null, explicit default)",
  "output": "out parameter, exposed as an additional Custom node output",
  "uniform_expression": "CPU uniform expression of material parameters `params` (`expr`; UE material nodes `ue_nodes`, folded into a uniform expression evaluated on the CPU)"
 },
