{
 "name": "CharMonster_SP_GhostFaceAni2S",
 "entry": "WuwaToonMonsterSPBasePass_GhostFaceAni2S",
 "include": "/Plugin/WuwaToon/Private/WuwaToonBasePass_Monster.ush",
 "kuro_shading_model": "MSM_ToonCommon (GBufferB id 12, or 15 when Ghost_ToonRimColorMask > 0)",
 "kuro_asm": "M_CharMonster_SP PS caca5ab54d (#236962, 439 instr) / VS 815bd27ed7 (#236944); MI MI_ELuokekeRuanniguaiMd10011B; static switches UseGhost, UseFaceAniMap, UseSkinMask, UseMatCap, UseLightOffset_Yaw / _Pitch",
 "kuro_root_material": "M_CharMonster_SP",
 "blend_mode": "BLEND_Opaque",
 "two_sided": true,
 "resolve": true,
 "resolve_note": "toon GBuffer through WuwaToonResolve. M_CharMonster_SP packing: A.xy = oct(N two-sided, re-normalised), A.z = MainTex.a solid-shadow factor (half-Lambert on the normalised vertex normal), A.w = 0 (mode 0) / 1 (mode 1); B.rgb = sqrt(saturate(Ghost_FresnelColorTex rim colour x Ghost_RimColorIntensity)), B.a = id 15 when Ghost_ToonRimColorMask > 0 else 12; C.rgb = base colour (FaceAniMap over MainTex, attack dark, desaturation / contrast / lightness x BlendStat, ShadowLord colour), C.a = Alpha (mode 0) / even rim byte of ToonRimWidth (mode 1); D = (ToonRimWidth, 0, 0, 0) in mode 0, 0 in mode 1. Ghost layer, MainTex.a / face emission, attack rim and selection colour are in the emissive. NOTE id 15 is not a WuwaToon resolve id yet [U: Kuro shading-model 15 = toon with rim-colour mask].",
 "vs_note": "VS #236944 carries the always-on Ghost WPO (sin / cos sway in object XY x Ghost_WPOsize x COLOR0.b x a bounds factor); connect the wpo block (WuwaToonMonsterSPGhostWPO) to World Position Offset.",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
