 "kuro_asm": "M_Motor_Com PS 6fbc5fb913 (#162137, 595 instr) / VS 839bb8e60c (#162151); MI MI_ETaidaonvDiaoouMd10011 (Hiyuki, skin 81001108)",
 "kuro_root_material": "M_Motor_Com",
 "blend_mode": "BLEND_Opaque",
 "two_sided": false,
 "resolve": true,
 "resolve_note": "toon GBuffer through WuwaToonResolve. M_Motor_Com packing: A.xy = oct(N), A.z = toon shadow factor from the constant ToonShadowRange (SolidShadowThreshold / ShadowOffset / ShadowRange, half-Lambert), A.w = 0 (mode 0) / 1 (mode 1); B.rgb = sqrt(saturate(solid-shadow colour)), B.a = id 12; C.rgb = lit colour (car paint, attack grey, GI tint), C.a = 0 / rim byte (mode 1); D = (ToonRimWidth, (round(saturate(2 RoughA) 255) | round(min(max(metal, 0), 0.9) 15)) / 255, 0, round(saturate(FFTIntensity) 15) / 255) in mode 0, 0 in mode 1. ID_Mask.a / FX_Mask emission, Second layer, attack rim and selection colour are in the emissive.",
 "vs_note": "VS #162151 = stock GPU-skin VS + UV3-dissolve WPO x UseShadowLordMaterialDynamic (0 at the MI): gated, use the stock VS",
 "outputs": {
  "Emissive": {
   "type": "float3",
   "kuro": "o0.rgb SceneColor (o0.a = 0)"
  },
  "A": {
   "type": "float4",
   "kuro": "o1 GBufferA: xy oct normal, z toon shadow factor, w flag"
  },
  "B": {
   "type": "float4",
   "kuro": "o2 GBufferB: rgb sqrt(shadow colour), a (LightingChannelMask<<5 | ShadingModelId)/255"
  },
  "C": {
   "type": "float4",
   "kuro": "o3 GBufferC: rgb lit colour, a MainTex.a*OpacityIntensity / rim byte"
  },
  "D": {
   "type": "float4",
   "kuro": "o6 \"GBufferD\": x ToonRimWidth, y packed nibble, z 0, w packed AO|FFT"
  }
 },
