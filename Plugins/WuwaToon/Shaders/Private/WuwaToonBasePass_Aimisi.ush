		t7.xyz = et.xyz * E_FlowEffectEdge_Strength01;
		t7.w = E_FlowEffectEdgerRevert * (uvn - UV3.y) + UV3.y;
		float4 ch = E_FlowEffectEdgeSwitch * (t7 - et) + et;
		float dv = dot(E_Dissolve_Channel, ch);
		float u = E_UV3Dissolve_Reverse * (UV3.y - uvn) + uvn;
		float s = WuwaWSmoothStep(E_UV3Dissolve_Position, E_UV3Dissolve_PositionRadius, u);
		s = min(s, 1.0);
		s = saturate(s * (dv + -1.0) + 1.0);
		s = UseShadowLordMaterialDynamic * (s - dv) + dv;
		float pr = E_Dissolve_Progress * asfloat(0xBF8CCCCCu) + asfloat(0x3F866666u);
		pr = pr * (-E_Dissolve_Smooth + -1.0) + E_Dissolve_Smooth;
		s = s * E_Dissolve_Smooth - pr;
		s = min(abs(s + -1.0), 1.0);
		eE = dcol * (1.0 - s);
	}
	else
	{
		eE = float3(0.0, 0.0, 0.0);
	}
	// H169-189: portal dissolve
	float3 lp = mul(float4(WorldPosition, 1.0), PrimWorldToLocal).xyz;
	lp = UseLocalSpace * (lp - WorldPosition) + WorldPosition;
	lp = UseActorSpace * ((WorldPosition - PrimActorWorldPosition) - lp) + lp;
	lp = lp - PortalCenter;
	lp = lp / sqrt(dot(lp, lp));
	float pd = dot(PortalAxisN, lp);
	float back = (0.0 >= pd) ? 1.0 : 0.0;
	float edge = ((pd >= PortalEdgeNeg) ? 1.0 : 0.0) * back;
	eE = UsePortalDissolve * (edge * dcol) + eE;
	// H190-243: emission tint, hologram (screen-v scan bands from the actor's view-space position; off: white)
	float3 etc = E_Emission_UseTex * (et.xyz + -1.0) + 1.0;
	float ssv = saturate(sv);
	float3 hl0 = ssv * (E_Emission_ColorI * etc - E_Hologram_HightColor) + E_Hologram_HightColor;
	bool holoOff = asfloat(0x38D1B717u) >= USE_Hologram;
	float holoOffF = holoOff ? 1.0 : 0.0;
	float3 hc;
	if (holoOff)
	{
		hc = float3(1.0, 1.0, 1.0);
	}
	else
	{
		float ht = GameTime * asfloat(0x39800000u);
		ht = (ht >= -ht) ? frac(abs(ht)) : -frac(abs(ht));
		ht = ht * asfloat(0x43CCCCCDu);
		float3 ap = PreViewTranslation + PrimActorWorldPosition;
		float2 vyz = mul(float4(ap, 1.0), TranslatedWorldToCameraView).yz;
		float dz = vyz.y * 0.01;
		float pj = vyz.x / (vyz.y * ClipToView11);
		float f = -pj * -0.5 + sv;
		f = f + -0.5;
		f = dz * f + ht;
		f = frac(f + 0.5);
		f = 1.0 - f;
		float s1 = saturate((f * f) * (1.0 / E_Hologram_Width));
		s1 = (s1 * s1) * (s1 * -2.0 + 3.0);
		float s2 = saturate((1.0 / E_Hologram_Width1m) * (-f * f + 1.0));
		s2 = (s2 * s2) * (s2 * -2.0 + 3.0);
		float m = min(s2, s1);
		float m16 = m * m;
		m16 = m16 * m16;
		m16 = m16 * m16;
		m16 = m16 * m16;
		m16 = m16 * 0.5;
		m = m * asfloat(0x3E4CCCCDu) + m16;
		m = min(m, 1.0);
		hc = m * E_Hologram_Color;
	}
	float3 hsum = hc * ssv + hl0;
	float3 EE = holoOffF * (E_Emission_ColorI * etc - hsum) + hsum;
	EE = EE + eE;
	// H244-267: E_Tex alpha mask x screen "second noise" mask
	float mk;
	if (asfloat(0x3DCCCCCDu) < E_Tex_UseMask)
	{
		mk = exp2(log2(E_Tex_NoiseTex.Sample(E_Tex_NoiseTexSampler, euv).w) * E_Tex_MaskRange);
	}
	else
	{
		mk = 1.0;
	}
	float2 suv = -SP2 * ViewSizeAndInvSize.zw + 1.0;
	float a2 = suv.y + suv.y;
	float sy = suv.x * 2.0 + asfloat(0xBD4CCCCDu);
	sy = -GameTime * asfloat(0x3E99999Au) + sy;
	sy = SP2.y * ViewSizeAndInvSize.w + sy;
	sy = sin(sy * asfloat(0x40C90FDBu));
	a2 = -GameTime * asfloat(0x3E99999Au) + a2;
	a2 = sin(a2 * asfloat(0x40490FDBu));
	float nm = a2 * sy;
	nm = abs(nm) * suv.y + -1.0;
	nm = E_Tex_UseSecondNoiseMask * nm + 1.0;
	mk = mk * nm;
	// H268-306 / K263-308: flow light (UV select, screen UV, rotation, time scroll, bump offset), refine, edge noise
	float t600 = fmod(GameTime, 600.0);
	float t100 = fmod(GameTime, 100.0);
	float2 fuv;
	fuv.x = dot(FlowLightTex_UVSwitch, Ux);
	fuv.y = dot(FlowLightTex_UVSwitch, Uy);
	fuv = FlowLight_UseScreenUV * (SP2 * ViewSizeAndInvSize.zw - fuv) + fuv;
	float2 fd = fuv + -0.5;
	fuv = float2(dot(fd, FlowLight_RotRow0), dot(fd, FlowLight_RotRow1)) + 0.5;
	fuv = fuv * FlowLight_UV.xy + t600 * FlowLight_UV.zw;
	fuv = fuv + FlowLight_UV_Offset2;
	float br;
	if (bFlowNoise)
	{
		float2 nuv;
		nuv.x = dot(FlowLightNoise_UVSwitch, Ux);
		nuv.y = dot(FlowLightNoise_UVSwitch, Uy);
		nuv = FlowLightNoise_UseScreenUV * (SP2 * ViewSizeAndInvSize.zw - nuv) + nuv;
		nuv = nuv * FlowLightNoiseUV.xy;
		nuv = GameTime * FlowLightNoiseUV.zw + nuv;
		float fnz = FlowLight_NoiseTex.SampleBias(FlowLight_NoiseTexSampler, nuv, mb).x;
		float2 nsh = float2(FlowLight_NoiseStrength, FlowLight_BumpHeight) * float2(FlowLight_NoiseStrength, FlowLight_BumpHeightRadio);
		fuv = fnz * nsh.x + fuv;
		br = FlowLight_BumpHeightRadio * -0.5 + nsh.y;
	}
	else
	{
		fuv = fuv + FlowLight_NoiseStrength0;
		br = FlowLight_BumpHeightRadio * -0.5;
		br = FlowLight_BumpHeightRadio * FlowLight_BumpHeight + br;
	}
	float2 Vts = float2(dot(WorldTangent, V), dot(Bt, V));
	float NoV = dot(WorldNormal, V);
	fuv = Vts * br + fuv;
	float3 fc = FlowLight_ColorTex.SampleBias(FlowLight_ColorTexSampler, fuv, mb).xyz;
	float3 fp = float3(WuwaWPowGuard(fc.x, FlowLight_Refine.x), WuwaWPowGuard(fc.y, FlowLight_Refine.x),
		WuwaWPowGuard(fc.z, FlowLight_Refine.x)) * FlowLight_Refine.y;
	float3 fr = FlowLight_Refine.w * (fc * FlowLight_Refine.z - fp) + fp;
	fr = fr * FlowLight_ColorTint;
	float2 nuv2 = fc.x * FlowEffectEdge_Strength01 + UV0;
	float fn = FlowLight_NoiseTex.SampleBias(FlowLight_NoiseTexSampler, nuv2, mb).w;
	fn = WuwaWPowGuard(fn, FlowLightNoise_Progress1m);
	// H307-329: base colour, outline layer colours, implicit heart curve - Heart_Mask.r, flow light
	float4 bc = BaseCol.SampleBias(BaseColSampler, UV0, mb);
	float3 ol = HeartTransition_L1 * (Heart_OutLineColor_Layer2 - Heart_OutLineColor_Layer1) + Heart_OutLineColor_Layer1;
	ol = HeartTransition_L2 * (Heart_OutLineColor_Layer3 - ol) + ol;
	float2 hq = (UV0 + -0.5) * 2.0 + float2(asfloat(0xBE75C28Fu), asfloat(0x3EAB851Fu));
	hq = hq * float2(-2.5, asfloat(0xC00E38E4u));
	float hx2 = hq.x * hq.x;
	float hy2 = hq.y * hq.y;
	float hs = hy2 + hx2;
	hs = hs + -0.5;
	float hv = (hs * hs) * hs - (hq.y * hy2) * hx2;
	float inH = (0.0 >= hv) ? 1.0 : 0.0;
	float2 hm = Heart_Mask.SampleBias(Heart_MaskSampler, UV0, mb).xy;
	float hw = inH - hm.x;
	float3 hcol = hw * (ol - bc.xyz) + bc.xyz;
	hcol = hcol * FlowLightColorBlend;
	hcol = fn * fr + hcol;
	// H330-372: XingHen SDF flow (bump-offset UV, scale / position), shake-noise flow band
	float xr = XingHen_BumpOffset * asfloat(0x3D4CCCCDu) + asfloat(0xBCCCCCCDu);
	float2 xuv = Vts * xr + UV0;
	xuv = (xuv + -0.5) * UVScale2 + 0.5;
	xuv = xuv - UVPosition2;
	float3 xt = XingHen_Tex.SampleBias(XingHen_TexSampler, xuv, mb).xzw;
	float xa = 1.0 - xt.x;
	float xm = saturate(xt.z * xa);
	float ss = saturate(ShakeNoiseAbs3);
	ss = (ss * ss) * (ss * -2.0 + 3.0);
	xa = ss * -xa + xa;
	float xe = ShakeNoiseSatAbs * asfloat(0xC1EC3D71u) + 30.0;
	float xp = min(exp2(log2(xt.y) * xe), 1.0);
	xp = (asfloat(0x33000002u) >= xt.y) ? 0.0 : xp;
	float xf = frac(xp * 3.0 + GameTime * 3.0);
	xf = (xf * xf) * (xf * -2.0 + 3.0);
	float xq = xp * xf;
	float xv = saturate(WuwaWSmoothStep(XingHen_FlowLight_RangeMin, XingHen_FlowLight_RangeMax, xq * ShakeNoise03) + xa);
	float3 xc = xv * XingHenColorShake;
	float3 xcm = xm * xc;
	float lhy = log2(hm.y);
	bool ghy = asfloat(0x33000002u) >= hm.y;
	float p1 = min(exp2(lhy * HeartTransition_L1_20m), 1.0);
	p1 = ghy ? 0.0 : p1;
	float3 xd = xc * xm - xm;
	float3 x12 = p1 * xd + xm;
	// H373-389: refracted view vector (eta 0.750188) in view space, lerp toward the panned UV, diamond texture
	float k2 = -NoV * NoV + 1.0;
	k2 = -k2 * asfloat(0x3F101271u) + 1.0;
	float sq = sqrt(k2);
	sq = NoV * asfloat(0x3F400C4Bu) + sq;
	float3 rf = V * asfloat(0x3F400C4Bu) - sq * WorldNormal;
	if (!(k2 >= 0.0))
		rf = float3(0.0, 0.0, 0.0);
	float2 rv = mul(rf, (float3x3)TranslatedWorldToView).xy;
	float2 duv = UV0 * Diamond_Tiling;
	duv = GameTime * Diamond_PannerSpeed2 + duv;
	duv = UseDiamond_UV_Switch * (duv - rv) + rv;
	float3 dm = Diamond_MainTex.SampleBias(Diamond_MainTexSampler, duv, mb).xyz;
	float3 dmi = dm * HeartPartten_Intensity;
	// H390-427: parallax occlusion march of Heart_FlowLight_Height.b (floor(ParallaxSteps) + 2 steps, coarse gradients)
	float2 huv = UV0 + Heart_FlowLight_Offset2;
	float2 P = -Vts / NoV;
	float2 PB = P * HeartSDF_Bump;
	huv = -HeartSDF_Bump * P + huv;
	float2 stp = PB * ParallaxStepsInv;
	float2 gx = ddx_coarse(huv);
	float2 gy = ddy_coarse(huv);
	float nst = ParallaxStepsFloor + 2.0;
	float2 ofs = float2(0.0, 0.0);
	float ch = 1.0, ph = 1.0, ps = 1.0;
	int i = 0;
	[loop] while (true)
	{
		if ((float)i >= nst)
			break;
		float s = Heart_FlowLight_Height.SampleGrad(Heart_FlowLight_HeightSampler, huv + ofs, gx, gy).z;
		if (ch < s)
		{
			float a = s - ch;
			float t = a / ((ph - ps) + a);
			ofs = -t * stp + ofs;
			break;
		}
		float nh = ch - ParallaxStepsInv;
		ofs = ParallaxStepsInv * PB + ofs;
		i = i + 1;
		ph = ch;
		ps = s;
		ch = nh;
	}
	huv = huv + ofs;
	float2 hm2 = Heart_Mask.SampleBias(Heart_MaskSampler, huv, mb).zw;
	// H428-448: heart flow band
	float hfr = Heart_FlowLight_SatAbsInt * (Heart_FlowLight_Frequency + -40.0) + 40.0;
	float lhx = log2(hm2.x);
	bool ghx = asfloat(0x33000002u) >= hm2.x;
	float hp = min(exp2(hfr * lhx), 1.0);
	hp = ghx ? 0.0 : hp;
	float hp3 = hp * 3.0;
	float hf = frac(hp * 3.0 + Heart_Partten_RangeOffset);
	hf = min(WuwaWSmoothStep(Heart_FlowLight_RangeMin, Heart_FlowLight_RangeMax, hf), 1.0);
	hf = hp * hf;
	hf = hf * Heart_FlowLight_Int03;
	// H449-470: half vector (View[296] + V), structure normal
	float3 Hh = -TranslatedWorldPosition * rs + KuroView296;
	Hh = Hh / sqrt(dot(Hh, Hh));
	float2 snuv = UV0 * StructureNormal_Tilling;
	float sh = StructureNormal_Height * asfloat(0x3D4CCCCDu) + asfloat(0xBCCCCCCDu);
	snuv = Vts * sh + snuv;
	float2 sn = StructureNormal_Tex.SampleBias(StructureNormal_TexSampler, snuv, mb).xy * 2.0 + -1.0;
	float snz = sqrt(max(1.0 - dot(sn, sn), 0.0));
	float3 snw = Bt * sn.y;
	snw = sn.x * WorldTangent + snw;
	snw = snz * WorldNormal + snw;
	snw = StructureNormal_Intensity * (snw - WorldNormal) + WorldNormal;
	float sd = saturate((dot(Hh, snw) + StructureNormal_In_Offset) * StructureNormal_In_Intensity);
	sd = sd * hf;
	// H471-480: layer-1 diamond / XingHen mix
	float sm = hm2.y * sd;
	float3 dd = dmi * sm;
	float3 di = -sm * dmi + 1.0;
	float3 a16 = xm * di + dd;
	float3 b14 = xcm * di + dd;
	float3 c14 = p1 * (b14 - a16) + a16;
	float w1 = sd * hm2.y - xv;
	float3 e14 = w1 * (c14 - x12) + x12;
	// H481-515: colour-blend layers 1..3 (dark colours, transition powers)
	float4 cb = Heart_ColorBlend.SampleBias(Heart_ColorBlendSampler, UV0, mb);
	float3 dk = cb.w * float3(HeartDarkColor_Int_Layer1, HeartDarkColor_Int_Layer2, HeartDarkColor_Int_Layer3);
	float3 l1 = cb.x * (Heart_Layer1_Color2 - Heart_Layer1_Color1) + Heart_Layer1_Color1;
	l1 = dk.x * (Heart_Layer1_DarkColor - l1) + l1;
	l1 = hm.x * (l1 - hcol) + hcol;
	float3 l2 = cb.y * (Heart_Layer2_Color2 - Heart_Layer2_Color1) + Heart_Layer2_Color1;
	l2 = dk.y * (Heart_Layer2_DarkColor - l2) + l2;
	l2 = hm.x * (l2 - hcol) + hcol;
	float3 l12 = p1 * (l2 - l1) + l1;
	float3 l3 = cb.z * (Heart_Layer3_Color2 - Heart_Layer3_Color1) + Heart_Layer3_Color1;
	float pz = exp2(log2(cb.z) * 12.0);
	pz = (asfloat(0x33000002u) >= cb.z) ? 0.0 : pz;
	l3 = pz * (Heart_Layer3_Color3 - l3) + l3;
	l3 = dk.z * (Heart_Layer3_DarkColor - l3) + l3;
	l3 = hm.x * (l3 - hcol) + hcol;
	float p2 = min(exp2(lhy * HeartTransition_L2_20m), 1.0);
	p2 = ghy ? 0.0 : p2;
	float3 L = p2 * (l3 - l12) + l12;
	// H516-589: quad rain x layers + string rain (hue rotated), layer-1 XingHen weight
	float2 bo = V.xy * TexRain_BumpOffset;
	bo = bo * asfloat(0x3D4CCCCDu) + UV2;
	float qx = bo.x * Quad_Tilling_Bump005;
	float qc = floor(qx * 0.0625);
	qc = -qc * 16.0 + qx;
	qc = bo.x * Quad_Tilling_Bump005 - qc;
	float2 q2 = qc * float2(asfloat(0x3F80ADFDu), asfloat(0x4196CBE4u));
	float qr = sin(q2.x);
	float qs = cos(q2.y) * Quad_Speed_Bump;
	qr = qs * t100 + qr;
	float by = 1.0 - bo.y;
	qr = frac(qr + by);
	qr = qr * Quad_Intensity;
	qr = 1.0 / qr;
	qr = min(WuwaWSmoothStep(QuadRain_RangeMin_Bump, QuadRain_RangeMax_Bump, qr), 1.0);
	float2 sbb = bo * StringsRain_Tilling_Bump005;
	float2 s7 = sbb * 0.0625;
	float sf = frac(t100 * String_Speed);
	float2 stuv = s7 / MatrixXY + floor(sf * MatrixXX) / MatrixXY;
	float stv = String_Tex.SampleLevel(String_TexSampler, stuv, mb + -1.0).x;
	float sc = floor(s7.x);
	sc = -sc * 16.0 + sbb.x;
	sc = bo.x * StringsRain_Tilling_Bump005 - sc;
	float2 c2 = sc * float2(asfloat(0x3F80ADFDu), asfloat(0x4196CBE4u));
	float rr = sin(c2.x);
	float rsp = cos(c2.y) * Rain_Speed_Bump;
	rr = rsp * t100 + rr;
	rr = frac(by + rr);
	rr = rr * Rain_Intensity;
	rr = 1.0 / rr;
	float hue = (stv * rr + HueShiftColor_Offset01) * asfloat(0x40C90FDBu);
	float ra = min(WuwaWSmoothStep(StringsRain_RangeMin_Bump, StringsRain_RangeMax_Bump, stv * rr), 1.0);
	float3 rain = WuwaAMHueRotate(ra * StringsRain_Color_Bump, hue);
	float3 LQ = L * qr + rain;
	float3 f15 = LQ + e14;
	float xw = xv * xm - xm;
	float w6 = p1 * xw + xm;
	float3 g14 = w6 * (e14 - f15) + f15;
	// H590-608 / K593-602: highlight (normal-map smoothstep, or the grass highlight texture)
	float3 HL;
	if (bGrassHL)
	{
		float hy = UV2.y * HLScale;
		float hmv = (dot(ViewForward.xy, LocalToWorldRow0.xy) + 1.0) * 0.5;
		hmv = hmv * (HLmoveSpeed - HLmoveSpeedNeg) + HLmoveSpeedNeg;
		float hxx = UV2.x * HLScale + hmv;
		HL = HighLightTex.SampleBias(HighLightTexSampler, float2(hxx, hy) - HLposition2, mb).xyz;
	}
	else
	{
		float2 hn = HighLightTex.SampleBias(HighLightTexSampler, UV0 * HighLight_NormalTilling, mb).xy * 2.0 + -1.0;
		float hz = sqrt(max(1.0 - dot(hn, hn), 0.0));
		float3 hnw = Bt * hn.y;
		hnw = hn.x * WorldTangent + hnw;
		hnw = hz * WorldNormal + hnw;
		HL = WuwaWSmoothStep(Heart_HighLightSmoothMin, Heart_HighLightSmoothMax, dot(hnw, Hh)).xxx;
	}
	// H608-622: final layer 1
	float3 c2a = HL * Heart_HighLightIntensity + g14;
	float s1f = min(WuwaWSmoothStep(FinalCol_RangeMin_Layer1, FinalCol_RangeMax_Layer1, hm.y), 1.0);
	float3 t1 = s1f * (c2a - FinalCol_Tint_Layer1) + FinalCol_Tint_Layer1;
	t1 = HeartTintColor_Layer1_Blend * (t1 - c2a) + c2a;
	float3 c1 = hm.x * (t1 - hcol) + hcol;
	// H623-667: final layer 2 (time-scrolled heart flow band, flow clip)
	float hf2 = frac(GameTime * Heart_FlowLight_Speed + hp3 + Heart_FlowLight_RangeOffset);
	hf2 = min(WuwaWSmoothStep(Heart_FlowLight_RangeMin, Heart_FlowLight_RangeMax, hf2), 1.0);
	hf2 = hp * hf2;
	hf2 = hf2 * Heart_FlowLight_Int03;
	float sm2 = hm2.y * hf2;
	float3 dd2 = dm * sm2;
	float3 di2 = -sm2 * dm + 1.0;
	float3 a2_ = xm * di2 + dd2;
	float3 bd = (xcm * di2 + dd2) - a2_;
	float3 c2_ = p1 * bd + a2_;
	float w2 = hf2 * hm2.y - xv;
	float pc = exp2(lhx * Heart_FlowLight_Clip);
	pc = ghx ? 0.0 : pc;
	w2 = w2 - pc;                                                      // original: (guard ? -0 : -pow) + w2
	float3 e2 = w2 * (c2_ - x12) + x12;
	float3 f2 = LQ + e2;
	float3 g2 = w6 * (e2 - f2) + f2;
	g2 = HL * Heart_HighLightIntensity + g2;
	float s2f = min(WuwaWSmoothStep(FinalCol_RangeMin_Layer2, FinalCol_RangeMax_Layer2, hm.y), 1.0);
	float3 t2 = s2f * (g2 - FinalCol_Tint_Layer2) + FinalCol_Tint_Layer2;
	t2 = HeartTintColor_Layer2_Blend * (t2 - g2) + g2;
	float3 c2c = hm.x * (t2 - hcol) + hcol;
	float3 c12 = p1 * (c2c - c1) + c1;
	// H668-693: final layer 3, effect emission
	float3 a3 = p2 * xd + xm;
	float3 b3 = p2 * bd + a2_;
	float3 e3 = w2 * (b3 - a3) + a3;
	float3 f3 = LQ + e3;
	float w7 = p2 * xw + xm;
	float3 g3 = w7 * (e3 - f3) + f3;
	g3 = HL * Heart_HighLightIntensity + g3;
	float s3f = min(WuwaWSmoothStep(FinalCol_RangeMin_Layer3, FinalCol_RangeMax_Layer4, hm.y), 1.0);
	float3 t3 = s3f * (g3 - FinalCol_Tint_Layer3) + FinalCol_Tint_Layer3;
	t3 = HeartTintColor_Layer3_Blend * (t3 - g3) + g3;
	float3 c3 = hm.x * (t3 - hcol) + hcol;
	float3 C = p2 * (c3 - c12) + c12;
	C = mk * EE + C;
	// H694-709: night lightness (MPC GlobalTimeHour day factor smoothstep(6..7) * smoothstep(19..18)), selection colour
	float3 Cn = C * FinalRender_Lightness_Night;
	float2 hr = MPC_GlobalTimeHour + float2(-6.0, -19.0);
	float da = saturate(hr.x);
	da = (da * -2.0 + 3.0) * (da * da);
	float db = saturate(-hr.y);
	db = (db * db) * (db * -2.0 + 3.0);
	float day = da * db;
	day = SeqSwitchFactor * -day + day;
	C = day * (-C * FinalRender_Lightness_Night + C) + Cn;
	C = SelectionColor.w * (SelectionColor.xyz - C) + C;
	// H710-728: opacity mask = BaseCol.a (engine clip 0.3333), Kuro primitive dither
	OpacityMask = bc.w;
	clip(WuwaPrimDitherClip(KuroPrimDitherEnable, KuroPrimDitherFade, SvPositionXY));
	// H762-830: emissive tail, black-surface GBuffer (normal re-normalised before the octahedral encode)
	G.Emissive = WuwaBPFinalEmissive(C, KuroSkipEmissiveScale, KuroEmissiveScale, OutOfBoundsMask, WorldPosition,
		ObjectWorldPosition, ObjectBounds);
	WuwaWEncodeBlack(G, N * rsqrt(dot(N, N)), KuroGBufferMode, LightingChannelMask);
	return G;
}

