// WuwaToonBasePass_Aimisi.ush — Aemeath (Aimisi) special materials:
//   M_Char_Aimisi_SPSkirt (unlit additive effect shell: spark / wave / scan light, optional circuit light and text rain,
//   Kuro "UseEffect" + "UseDissolveAndDither" blocks) and M_Char_Aimisi_Heart (masked toon GBuffer).
// Every function is transcribed from the cooked DXBC (evidence/roster/shadermaps/weapons/asm_hex/<index>_<hash>.asm.txt);
// line refs: M### = PS 793f627635 (#86403), C### = PS 30a8b76b4a (#264804). research/roster/Port_Weapons_Specials.md
// (round 3).
//
// CPU uniform expressions (spec kind "uniform_expression", evaluated in float32 like the preshaders): the E_Tex rotation rows
// (cos/sin of E_Tex_Rotation * 0.002778 * 6.28319), normalize(PortalAxis) and the small preshader products / min / max.
#ifndef WUWA_TOON_BASEPASS_AIMISI_USH
#define WUWA_TOON_BASEPASS_AIMISI_USH

#include "WuwaToonBasePass_WeaponShared.ush"   // FWuwaFXOutput, WuwaWPowGuard, WuwaWSmoothStep (read-only)

// Kuro 3x3 ordered dither (immediate constant buffer of the SPSkirt PS), index (x mod 3) * 3 + (y mod 3).
static const float kWuwaAMDither[9] = {
	asfloat(0x00000000u), asfloat(0x3F471C72u), asfloat(0x3EAAAAABu), asfloat(0x3F2AAAABu), asfloat(0x3F0E38E4u),
	asfloat(0x3E638E39u), asfloat(0x3EE38E39u), asfloat(0x3DE38E39u), asfloat(0x3F638E39u) };

// ---------------------------------------------------------------------------------------------------------------------
// "UseEffect" + "UseDissolveAndDither" blocks shared by the SPSkirt maps (M133-353): E_Tex layer (UV select, screen UV,
// rotator, panner), flow-edge / dissolve emission, UV3 dissolve, portal dissolve, E_Tex mask + screen "second noise" mask,
// selection colour, dither dissolve, Kuro E_Dither / head-mask hide, gradient translucency.
// E0 = material colour of the root graph, Keep = (EffMask.z >= 0.5 ? 0 : 1), MaskW = EffMask.w.
// ---------------------------------------------------------------------------------------------------------------------
FWuwaFXOutput WuwaAMEffectTail(Texture2D E_Tex_NoiseTex, SamplerState E_Tex_NoiseTexSampler,
	float3 E0, float Keep, float MaskW, float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldPosition, float2 SP2,
	float4 ViewSizeAndInvSize, float GameTime, float4x4 PrimWorldToLocal, float3 PrimActorWorldPosition,
	float3 HeadMaskPosition, float3 HeadMaskAxis0, float3 HeadMaskAxis1, float3 HeadMaskAxis2,
	float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_UseTex, float2 E_Tex_RotRow0, float2 E_Tex_RotRow1,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color, float E_Emission_UseTex,
	float E_FlowEffectEdgeColorSharp, float3 E_Dissolve_Emission, float3 E_Dissolve_EmissionDark, float E_FlowEffectEdgeSwitch,
	float E_Dissolve_Multi01, float E_Dissolve_UseDissolve, float E_FlowEffectEdge_Strength01, float E_FlowEffectEdgerRevert,
	float4 E_Dissolve_Channel, float E_UV3Dissolve_Reverse, float E_UV3Dissolve_Position, float E_UV3Dissolve_PositionRadius,
	float UseShadowLordMaterialDynamic, float E_Dissolve_Progress, float E_Dissolve_Smooth, float UseLocalSpace,
	float UseActorSpace, float3 PortalCenter, float3 PortalAxisN, float PortalEdgeNeg, float UsePortalDissolve,
	float3 E_Emission_ColorI, float E_Tex_UseMask, float E_Tex_MaskRange, float E_Tex_UseSecondNoiseMask, float4 SelectionColor,
	float UseDitherDissolve, float E_Dither_DitherValueMin, float E_Dither_DitherValue2, float E_HeadMaskHigh,
	float E_UseHeadMaskHide, float E_Dither_UseDitherMax, float GradientTranslucency_Offset, float GradientTranslucency_Power,
	float Use_GradientTranslucency)
{
	// M133-139: E_Tex UV = UV select, lerp toward the screen UV
	float2 euv;
	euv.x = dot(E_Tex_UVSwitch, float4(UV0.x, UV1.x, UV2.x, UV3.x));
	euv.y = dot(E_Tex_UVSwitch, float4(UV0.y, UV1.y, UV2.y, UV3.y));
	euv = E_Tex_UseScreenUV * (SP2 * ViewSizeAndInvSize.zw - euv) + euv;
	// M140-151: rotated / scaled / scrolled E_Tex sample x E_Tex_Color (else the colour alone)
	float4 et;
	if (asfloat(0x3DCCCCCDu) < E_Tex_UseTex)
	{
		float2 d = euv + -0.5;
		float2 ruv = float2(dot(d, E_Tex_RotRow0), dot(d, E_Tex_RotRow1)) + 0.5;
		ruv = ruv * E_Tex_ScaleAndOffset.xy + E_Tex_ScaleAndOffset.zw;
		ruv = GameTime * E_Tex_Speed + ruv;
		et = E_Tex_NoiseTex.Sample(E_Tex_NoiseTexSampler, ruv) * E_Tex_Color;
	}
	else
	{
		et = E_Tex_Color;
	}
	// M152-163: emission tint lerp(1, E_Tex, E_Emission_UseTex); flow-edge colour pow(E_Tex.r, sharp) (guarded)
	float3 etc = E_Emission_UseTex * (et.xyz + -1.0) + 1.0;
	bool pg = asfloat(0x33000002u) >= et.x;
	float pw = exp2(log2(et.x) * E_FlowEffectEdgeColorSharp);
	float3 dcol = (E_Dissolve_Emission - E_Dissolve_EmissionDark) * pw;
	if (pg)
		dcol = float3(0.0, 0.0, 0.0);
	dcol = dcol + E_Dissolve_EmissionDark;
	dcol = E_FlowEffectEdgeSwitch * (dcol - E_Dissolve_Emission) + E_Dissolve_Emission;
	dcol = dcol * E_Dissolve_Multi01;
	// M164-198: dissolve (channel of the flow-edge E_Tex / UV3 gradient), UV3 dissolve smoothstep, progress / smooth
	float3 eE;
	float  eOp;
	if (asfloat(0x3DCCCCCDu) < E_Dissolve_UseDissolve)
	{
		float uvn = 1.0 - UV3.y;
		float4 t7;
		t7.xyz = et.xyz * E_FlowEffectEdge_Strength01;
		t7.w = E_FlowEffectEdgerRevert * (uvn - UV3.y) + UV3.y;
		float4 ch = E_FlowEffectEdgeSwitch * (t7 - et) + et;
		float dv = dot(E_Dissolve_Channel, ch);
		float u = E_UV3Dissolve_Reverse * (UV3.y - uvn) + uvn;
		float s = WuwaWSmoothStep(E_UV3Dissolve_Position, E_UV3Dissolve_PositionRadius, u);
		s = min(s, 1.0);
		s = saturate(s * (dv + -1.0) + 1.0);
		s = UseShadowLordMaterialDynamic * (s - dv) + dv;
		float pr = E_Dissolve_Progress * asfloat(0xBF8CCCCCu) + asfloat(0x3F866666u);
		pr = pr * (-E_Dissolve_Smooth + -1.0) + E_Dissolve_Smooth;
		s = s * E_Dissolve_Smooth - pr;
		eOp = saturate(s);
		s = min(abs(s + -1.0), 1.0);
		eE = dcol * (1.0 - s);
	}
	else
	{
		eE = float3(0.0, 0.0, 0.0);
		eOp = 1.0;
	}
	// M199-219: portal dissolve (world / local / actor space position against PortalCenter + normalised axis)
	float3 lp = mul(float4(WorldPosition, 1.0), PrimWorldToLocal).xyz;
	lp = UseLocalSpace * (lp - WorldPosition) + WorldPosition;
	lp = UseActorSpace * ((WorldPosition - PrimActorWorldPosition) - lp) + lp;
	lp = lp - PortalCenter;
	lp = lp / sqrt(dot(lp, lp));
	float pd = dot(PortalAxisN, lp);
	float back = (0.0 >= pd) ? 1.0 : 0.0;
	float edge = ((pd >= PortalEdgeNeg) ? 1.0 : 0.0) * back;
	eE = UsePortalDissolve * (edge * dcol) + eE;
	eE = E_Emission_ColorI * etc + eE;
	// M220-241: E_Tex alpha mask (no pow guard) x screen-space "second noise" mask
	float mk;
	if (asfloat(0x3DCCCCCDu) < E_Tex_UseMask)
	{
		mk = exp2(log2(E_Tex_NoiseTex.Sample(E_Tex_NoiseTexSampler, euv).w) * E_Tex_MaskRange);
	}
	else
	{
		mk = 1.0;
	}
	float2 suv = -SP2 * ViewSizeAndInvSize.zw + 1.0;
	float a2 = suv.y + suv.y;
	float sy = suv.x * 2.0 + asfloat(0xBD4CCCCDu);
	sy = -GameTime * asfloat(0x3E99999Au) + sy;
	sy = SP2.y * ViewSizeAndInvSize.w + sy;
	sy = sin(sy * asfloat(0x40C90FDBu));
	a2 = -GameTime * asfloat(0x3E99999Au) + a2;
	a2 = sin(a2 * asfloat(0x40490FDBu));
	float nm = sy * a2;
	nm = abs(nm) * suv.y + -1.0;
	nm = E_Tex_UseSecondNoiseMask * nm + 1.0;
	mk = nm * mk;
	eE = eE * mk;
	// M242-244: colour = root * keep + effect, selection colour
	FWuwaFXOutput O;
	float3 E = E0 * Keep + eE;
	O.Emissive = SelectionColor.w * (SelectionColor.xyz - E) + E;
	// M245-256: opacity: portal back-face min, interleaved-gradient dither dissolve
	float op = UsePortalDissolve * (min(eOp, back) - eOp) + eOp;
	float2 dn = GameTime * float2(asfloat(0x40B2D2D8u), asfloat(0x40490FD0u)) + SP2;
	float ign = frac(dot(dn, float2(asfloat(0x3D897143u), asfloat(0x3BBF4590u))));
	ign = frac(ign * asfloat(0x4253EE82u));
	op = UseDitherDissolve * (((op >= ign) ? 1.0 : 0.0) - op) + op;
	// M257-300: Kuro E_Dither value / head-mask hide (CPD 2..10 head axes, CPD 23..25 head position), 3x3 dither
	float dvv = min(E_Dither_DitherValueMin, E_Dither_DitherValue2);
	float3 hd = -HeadMaskPosition;
	float3 hp = WorldPosition + hd;
	float3 hl = hp.x * HeadMaskAxis0;
	hl = HeadMaskAxis1 * hp.y + hl;
	hl = HeadMaskAxis2 * hp.z + hl;
	float hx = hl.x - E_HeadMaskHigh;
	float hr = sqrt(dot(hl.yz, hl.yz)) * asfloat(0x3C7C0FC1u) + asfloat(0xBE4CCCCDu);
	hr = saturate(hr * 1.25);
	hr = (hr * hr) * (hr * -2.0 + 3.0);
	hr = hr * saturate(-hl.y + -1.0);
	dvv = min(dvv, 0.0);
	hr = min(hr, 1.0);
	hr = hr * 54.5 + 0.5;
	hr = 1.0 - saturate(hx / hr);
	dvv = E_UseHeadMaskHide * (hr - dvv) + dvv;
	int2 ip = (int2)SP2;                                   // signed (C) remainder of the pixel coordinate by 3
	uint2 um = ((uint2)max(ip, -ip)) % 3u;
	int2 im = (int2)um;
	im.x = (ip.x < 0) ? -im.x : im.x;
	im.y = (ip.y < 0) ? -im.y : im.y;
	int di = max(im.x * 3 + im.y, 0);
	float dt = saturate(dvv * 2.0 - kWuwaAMDither[di]);
	dt = dt + asfloat(0x3EA87CF8u);
	dt = (asfloat(0x3E99999Au) >= E_Dither_UseDitherMax) ? 1.0 : dt;
	float hc = (sqrt(dot(hd, hd)) >= asfloat(0x3C23D70Au)) ? 0.0 : 1.0;
	hc = (asfloat(0x3C23D70Au) >= hx) ? 1.0 : hc;
	hc = hc * E_UseHeadMaskHide;
	dt = hc * (1.0 - dt) + dt;
	op = min(op, dt);
	// M301-307: opacity = mask * (op - 1) + 0.667, gradient translucency (UV0.y)
	op = mk * (op + -1.0) + asfloat(0x3F2AC083u);
	float g = UV0.y + GradientTranslucency_Offset;
	float gp = g * GradientTranslucency_Power;
	float gg = MaskW * (-g * GradientTranslucency_Power + 1.0) + gp;
	O.Opacity = saturate(Use_GradientTranslucency * (gg * op - op) + op);
	return O;
}

// =====================================================================================================================
// M_Char_Aimisi_SPSkirt, PS 793f627635 (#86403; MI_SS1HuliHead_FX, MI_SS1HuliTail2_FX, MI_SS1HuliTail3_FX = Hsin's fox
// "SS1Huli" effect shells), additive unlit, VS #13669 (engine-only). Static switches Use_MilkSpark, UseDissolveAndDither,
// UseEffect. Root colour = wave * spark * BaseColTex + scan light; EffMask (Normal_Metallic_EffMask) .xy normal, .z keep
// mask, .w inside/outside weight.
// =====================================================================================================================
FWuwaFXOutput WuwaFXAimisiSPSkirt_MilkSpark(
	Texture2D BaseColTex, SamplerState BaseColTexSampler,
	Texture2D CommonNoiseMap, SamplerState CommonNoiseMapSampler,
	Texture2D Normal_Metallic_EffMask, SamplerState Normal_Metallic_EffMaskSampler,
	Texture2D E_Tex_NoiseTex, SamplerState E_Tex_NoiseTexSampler,
	float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign,
	float3 WorldPosition, float3 CameraVector, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float GameTime, float MaterialTextureMipBias, float ClipToView00, float3 WorldCameraOrigin, float4x4 TranslatedWorldToView,
	float3 LocalToWorldRow2, float3 LocalToWorldRow3, float4x4 PrimWorldToLocal, float3 PrimActorWorldPosition,
	float3 HeadMaskPosition, float3 HeadMaskAxis0, float3 HeadMaskAxis1, float3 HeadMaskAxis2,
	float4 SparkTillingSpeed, float SparkIntensity, float SparkIntensityMax, float SparkPower_Inside, float SparkPower_Outside,
	float SparkStrength_Inside, float SparkStrength_Outside, float4 FlowLight_UV_Switch, float WaveTiling_Inside,
	float WaveTiling_Outside, float WaveSpeed_Inside, float WaveSpeed_Outside, float NormalStrength, float Normal_ViewBlend,
	float WaveNormalAmount, float WaveAmount_Inside, float WaveAmount_Outside, float ScanLine_Speed, float ScanLightTilling,
	float ScanLightStep, float ScanLine_DistanceFade, float3 ScanLightColor,
	float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_UseTex, float2 E_Tex_RotRow0, float2 E_Tex_RotRow1,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color, float E_Emission_UseTex,
	float E_FlowEffectEdgeColorSharp, float3 E_Dissolve_Emission, float3 E_Dissolve_EmissionDark, float E_FlowEffectEdgeSwitch,
	float E_Dissolve_Multi01, float E_Dissolve_UseDissolve, float E_FlowEffectEdge_Strength01, float E_FlowEffectEdgerRevert,
	float4 E_Dissolve_Channel, float E_UV3Dissolve_Reverse, float E_UV3Dissolve_Position, float E_UV3Dissolve_PositionRadius,
	float UseShadowLordMaterialDynamic, float E_Dissolve_Progress, float E_Dissolve_Smooth, float UseLocalSpace,
	float UseActorSpace, float3 PortalCenter, float3 PortalAxisN, float PortalEdgeNeg, float UsePortalDissolve,
	float3 E_Emission_ColorI, float E_Tex_UseMask, float E_Tex_MaskRange, float E_Tex_UseSecondNoiseMask, float4 SelectionColor,
	float UseDitherDissolve, float E_Dither_DitherValueMin, float E_Dither_DitherValue2, float E_HeadMaskHigh,
	float E_UseHeadMaskHide, float E_Dither_UseDitherMax, float GradientTranslucency_Offset, float GradientTranslucency_Power,
	float Use_GradientTranslucency)
{
	// M43-56: base colour, two spark-noise taps (mip bias - 2; the first scrolled and offset by the camera vector)
	float3 Bt = cross(WorldNormal, WorldTangent) * TangentSign;
	float3 BaseCol = BaseColTex.SampleBias(BaseColTexSampler, UV0, MaterialTextureMipBias).xyz;
	float2 SpUV = UV2 * SparkTillingSpeed.xy;
	float2 SpUV2 = GameTime * SparkTillingSpeed.zw + SpUV;
	float mb2 = MaterialTextureMipBias + -2.0;
	float n1 = CommonNoiseMap.SampleBias(CommonNoiseMapSampler, CameraVector.xy * 0.2 + SpUV2, mb2).x;
	float n2 = CommonNoiseMap.SampleBias(CommonNoiseMapSampler, SpUV, mb2).x;
	// M57-66: camera distance to (object + 80 * local Z) -> spark intensity
	float3 dC = WorldCameraOrigin - (LocalToWorldRow2 * 80.0 + LocalToWorldRow3);
	float d01 = min(sqrt(dot(dC, dC)) * 0.001, 1.0);
	float SI = d01 * (SparkIntensityMax - SparkIntensity) + SparkIntensity;
	float sa = n2 * SI;
	sa = sa * (n1 * n1);
	// M67-75: EffMask, inside/outside spark power and strength, guarded pow
	float4 EM = Normal_Metallic_EffMask.SampleBias(Normal_Metallic_EffMaskSampler, UV0, MaterialTextureMipBias);
	float SPw = EM.w * (SparkPower_Inside - SparkPower_Outside) + SparkPower_Outside;
	float SSt = EM.w * (SparkStrength_Inside - SparkStrength_Outside) + SparkStrength_Outside;
	sa = WuwaWPowGuard(sa, SPw);
	sa = SI * sa;
	// M76-99: field-of-view factor saturate((atan(ClipToView[0][0]) / 0.785)^5)
	float fv = atan(ClipToView00) * asfloat(0x3FA30EACu);
	float fv2 = fv * fv;
	fv2 = fv2 * fv2;
	fv = saturate(fv * fv2);
	sa = sa * (fv * SSt);
	// M100-131: flow-light wave (UV select V, normal-mapped view-space z), scan line
	float fvv = dot(FlowLight_UV_Switch, float4(UV0.y, UV1.y, UV2.y, UV3.y));
	float2 SP2 = SvPositionXY - ViewRectMin;
	float WT = EM.w * (WaveTiling_Inside - WaveTiling_Outside) + WaveTiling_Outside;
	float WS = EM.w * (WaveSpeed_Inside - WaveSpeed_Outside) + WaveSpeed_Outside;
	float wph = fvv * WT - WS * GameTime;
	float2 nxy = (EM.xy * 2.0 + -1.0) * NormalStrength;
	float3 nw = (nxy.x * WorldTangent + Bt * nxy.y) + WorldNormal;
	float vz = mul(nw, (float3x3)TranslatedWorldToView).z;
	vz = Normal_ViewBlend * (1.0 - vz) + vz;
	wph = -vz * WaveNormalAmount + wph;
	float ws = sin(wph * asfloat(0x40C90FDBu)) + 1.0;
	float wh = ws * 0.5;
	float w = (wh * wh) * wh;
	w = (asfloat(0x33800002u) >= ws) ? 0.0 : w;
	float WA = EM.w * (WaveAmount_Inside - WaveAmount_Outside) + WaveAmount_Outside;
	w = WA * w;
	w = w * sa;
	float sc = GameTime * ScanLine_Speed + UV2.y;
	sc = (sc + -0.5) * ScanLightTilling;
	sc = (ScanLightStep >= frac(sc)) ? 1.0 : 0.0;
	float3 dW = WorldCameraOrigin - WorldPosition;
	float df = saturate(1.0 - sqrt(dot(dW, dW)) / ScanLine_DistanceFade);
	sc = df * sc;
	float3 scan = (sc * ScanLightColor) * EM.w;
	float3 E0 = w * BaseCol + scan;
	float Keep = (EM.z >= 0.5) ? 0.0 : 1.0;
	return WuwaAMEffectTail(E_Tex_NoiseTex, E_Tex_NoiseTexSampler, E0, Keep, EM.w, UV0, UV1, UV2, UV3, WorldPosition, SP2,
		ViewSizeAndInvSize, GameTime, PrimWorldToLocal, PrimActorWorldPosition, HeadMaskPosition, HeadMaskAxis0, HeadMaskAxis1,
		HeadMaskAxis2, E_Tex_UVSwitch, E_Tex_UseScreenUV, E_Tex_UseTex, E_Tex_RotRow0, E_Tex_RotRow1, E_Tex_ScaleAndOffset,
		E_Tex_Speed, E_Tex_Color, E_Emission_UseTex, E_FlowEffectEdgeColorSharp, E_Dissolve_Emission, E_Dissolve_EmissionDark,
		E_FlowEffectEdgeSwitch, E_Dissolve_Multi01, E_Dissolve_UseDissolve, E_FlowEffectEdge_Strength01, E_FlowEffectEdgerRevert,
		E_Dissolve_Channel, E_UV3Dissolve_Reverse, E_UV3Dissolve_Position, E_UV3Dissolve_PositionRadius,
		UseShadowLordMaterialDynamic, E_Dissolve_Progress, E_Dissolve_Smooth, UseLocalSpace, UseActorSpace, PortalCenter,
		PortalAxisN, PortalEdgeNeg, UsePortalDissolve, E_Emission_ColorI, E_Tex_UseMask, E_Tex_MaskRange,
		E_Tex_UseSecondNoiseMask, SelectionColor, UseDitherDissolve, E_Dither_DitherValueMin, E_Dither_DitherValue2,
		E_HeadMaskHigh, E_UseHeadMaskHide, E_Dither_UseDitherMax, GradientTranslucency_Offset, GradientTranslucency_Power,
		Use_GradientTranslucency);
}

// Kuro text-rain hue rotation (UE RotateAboutAxis about normalize(1,1,1) by Angle, simplified as emitted: C306-315 / C349-358):
// d = dot(K, V); W = V - d * k; result = d * k + (W * cos + cross(K, W) * sin), k = 0.57735 (0x3F13CD3A).
float3 WuwaAMHueRotate(float3 V, float Angle)
{
	const float k = asfloat(0x3F13CD3Au);
	float d = dot(float3(k, k, k), V);
	float3 W = V - d * k;
	float3 cr = cross(float3(k, k, k), W);
	float s, c;
	sincos(Angle, s, c);
	float3 t = s * cr;
	t = W * c + t;
	return d * k + t;
}

// Kuro inside/outside "light flow" term (C113-126 circuit, C198-211 flow): t = lerp(pow guarded(0.5 * wave + noise - 0.5, 9)
// * 3, cube * amount, 0.5) clamped to [0, 0.75] * 1.333.
float WuwaAMFlowT(float WaveS, float Cube, float Amount, float Noise)
{
	float p = WaveS * 0.5 + Noise;
	p = p + -0.5;
	float q = exp2(log2(p) * 9.0) * 3.0;
	q = (asfloat(0x33000002u) >= p) ? 0.0 : q;
	float t = lerp(q, Cube * Amount, 0.5);
	t = min(max(t, 0.0), 0.75);
	return t * asfloat(0x3FAA9FBEu);
}

// =====================================================================================================================
// M_Char_Aimisi_SPSkirt, PS 30a8b76b4a (#264804; MI_Char_Aimisi_SPSkirt = Aemeath main mesh (+ Invisible Starlight skin),
// MI_R2T1AimisiGDMd10011Head1FX_OL), additive unlit, VS #13669 (engine-only). Static switches Use_CircuitLight,
// Use_FlowLight, Use_MilkSpark, Use_TextRain, UseDissolveAndDither, UseEffect (Use_WaveLight_Inside off).
// Root colour = circuit light x circuit mask + flow light + flow wave * spark * BaseColTex + text rain (base + bump, hue
// rotated) + scan light. Line refs C### = asm_hex line numbers.
// =====================================================================================================================
FWuwaFXOutput WuwaFXAimisiSPSkirt_CircuitFlowSparkTextRain(
	Texture2D Normal_Metallic_EffMask, SamplerState Normal_Metallic_EffMaskSampler,
	Texture2D BaseColTex, SamplerState BaseColTexSampler,
	Texture2D CircuitFlowNoise, SamplerState CircuitFlowNoiseSampler,
	Texture2D Tex_CircuitMask, SamplerState Tex_CircuitMaskSampler,
	Texture2D CommonNoiseMap, SamplerState CommonNoiseMapSampler,
	Texture2D String_Tex, SamplerState String_TexSampler,
	Texture2D E_Tex_NoiseTex, SamplerState E_Tex_NoiseTexSampler,
	float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign,
	float3 WorldPosition, float3 CameraVector, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float GameTime, float MaterialTextureMipBias, float ClipToView00, float3 WorldCameraOrigin, float4x4 TranslatedWorldToView,
	float3 LocalToWorldRow2, float3 LocalToWorldRow3, float4x4 PrimWorldToLocal, float3 PrimActorWorldPosition,
	float3 HeadMaskPosition, float3 HeadMaskAxis0, float3 HeadMaskAxis1, float3 HeadMaskAxis2,
	float4 CircuitLight_UV_Switch, float CircuitLightTiling_Inside, float CircuitLightTiling_Outside, float CircuitLightSpeed_Inside,
	float CircuitLightSpeed_Outside, float NormalStrength, float Normal_ViewBlend, float CircuitLightNormalAmount,
	float CircuitLightAmount_Inside, float CircuitLightAmount_Outside, float3 CircuitLight02_Outside, float3 CircuitLightColor_Outside,
	float3 CircuitLight02_Inside, float3 CircuitLightColor_Inside, float2 CircuitMask_Tiling_Outside, float2 CircuitMask_Offset_Outside,
	float2 CircuitMask_Tiling_Inside, float2 CircuitMask_Offset_Inside, float CircuitMask_GradientUp_SmoothMin_Outside,
	float CircuitMask_GradientUp_SmoothMax_Outside, float CircuitMask_Up_Intensity_Outside, float CircuitMask_GradientUp_SmoothMin_Inside,
	float CircuitMask_GradientUp_SmoothMax_Inside, float CircuitMask_Up_Intensity_Inside, float CircuitMask_GradientDown_SmoothMin_Outside,
	float CircuitMask_GradientDown_SmoothMax_Outside, float CircuitMask_Down_Intensity_Outside,
