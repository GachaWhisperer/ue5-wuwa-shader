// DragonNoiseMaskSecond: M_AdvancedEffect_Depth_CM_ForDragon PS f16e96af63 (#317497) additive; NoiseMask
FWuwaFXOutput WuwaDepthFX_DragonNoiseMaskSecond(
	Texture2D Noise, SamplerState NoiseSampler, Texture2D NoiseMask, SamplerState NoiseMaskSampler, Texture2D Second,
