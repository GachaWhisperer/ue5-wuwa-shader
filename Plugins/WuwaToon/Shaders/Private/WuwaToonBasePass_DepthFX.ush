// WuwaToonBasePass_DepthFX.ush — Kuro "AdvancedEffect ... Depth" effect shells on character / weapon meshes (round 3):
//   M_AdvancedEffect_Depth_CM_ForDragon / _ForDragon_Outline (Galbrena's snake / dragon blueprint parts; translucent and additive)
//   M_AdvancedEffect_Depth_CM (Luuk Herssen sickle prop, Jinxi dragon horn; translucent, unlit)
//
// Same effect graph as M_AdvancedEffect_CM (WuwaToonBasePass_WeaponFX.ush: clock, UV select, rotator, panner, noise, Second / Base /
// Mask / Dissolve layers, Fresnel rim, light colour, Niagara grey shift, Kuro effect grading), compiled with four texture
// coordinates (dot(<L>_UVSwitch, (UV0, UV1, UV2, UV3)) per axis), plus:
//   * "Depth" = a DEPTH DITHER (not a scene-depth read: none of these PS samples SceneDepth / SceneTexture). The opacity is
//     dithered with UE's DitherTemporalAA pattern: ((uint(x + TAA.x) + 2 uint(y + TAA.x)) % 5 + Good64x64TilingNoiseHighFreq(Pix / 64).r) / 6
//     against op * lerp(DepthDitherFactorNight, DepthDitherFactorDay, lerp(MPC GlobalDayNightFactor, 1, UseWholeDayDither >= 0.2)).
//     ForDragon:   Opacity = saturate(op * (op * f + dither - 0.5))   (soft)
//     Depth_CM:    Opacity = saturate(step(0, op * f + dither - 0.5) * op)   (binary)
//     No screen fade in either root.
//   * ForDragon only: a BumpNoise colour layer (UV0 * S_O.xy + GameTime * S_O.zw, lerp by "Lerp") and a 1.2 gain before the
//     selection colour; optional NoiseMask (masks the noise distortion) and the static switch UseAdvancedScreenPosition (bAdvScreen:
//     the "screen UV" of every layer is anchored at the actor's projected position and scaled by its view depth / 100).
//   * Depth_CM: selection on the MPC-tinted colour (M_Refraction_CM form, no View[286].y saturation step).
// Output FWuwaFXOutput {Emissive, Opacity} ("resolve": false). Engine tail (fog, OOB, emissive scale, effect grading / additive
// premultiply) is not ported; tools/shaderdiff/weapons/hlsl/kuro_tail_depthfx.hlsli reproduces it for the diff only.
// Line refs D### = evidence/roster/shadermaps/weapons/asm_hex/229631_a670c694d0*.asm.txt (ForDragon, AdvScreen) unless noted.
#ifndef WUWA_TOON_BASEPASS_DEPTHFX_USH
#define WUWA_TOON_BASEPASS_DEPTHFX_USH

#ifndef WUWA_TOON_BASEPASS_WEAPONFX_USH_INCLUDED
#define WUWA_TOON_BASEPASS_WEAPONFX_USH_INCLUDED
#include "WuwaToonBasePass_WeaponFX.ush"    // WuwaFXClock / WuwaFXRotate / WuwaFXClampLerp / WuwaFXRefine (read-only)
#endif

// 4-channel UV select, then lerp toward the screen UV (passed precomputed: stock Pix * InvViewSize or the AdvScreen UV).
float2 WuwaDFXUV(float4 Switch, float4 Ux, float4 Uy, float bScreenUV, float2 ScreenUV)
{
	float2 uv = float2(dot(Switch, Ux), dot(Switch, Uy));
	return bScreenUV * (ScreenUV - uv) + uv;
}

// D53-71 (UseAdvancedScreenPosition): the actor origin projected to the screen, the pixel's screen UV re-centred on it, aspect
// corrected and scaled by the actor's view depth * 0.01 (texture size constant in world units), + 0.5.
float2 WuwaDFXAdvScreenUV(float2 Pix, float4 ViewSizeAndInvSize, float3 ActorPositionWS, float3 PreViewTranslation,
	float4x4 TranslatedWorldToCameraView, float ClipToView00, float ClipToView11)
{
	float3 ov = mul(float4(ActorPositionWS + PreViewTranslation, 1.0), TranslatedWorldToCameraView).xyz;
	float k = ov.z * asfloat(0x3C23D70Au);                                   // 0.01
	float2 o = ov.xy / float2(ov.z * ClipToView00, ov.z * ClipToView11);
	o = o * float2(0.5, -0.5);
	float2 s = Pix * ViewSizeAndInvSize.zw - o;
	s = s + -0.5;
	s = s * float2(ViewSizeAndInvSize.x / ViewSizeAndInvSize.y, 1.0);
	return k * s + 0.5;
}

// UE DitherTemporalAA threshold (D218-227): ((uint(Pix.x + TAA.x) + 2 * uint(Pix.y + TAA.x)) % 5 + Noise(Pix / 64).r) / 6.
float WuwaDFXDitherTemporalAA(Texture2D DitherNoise, SamplerState DitherNoiseSampler, float2 Pix, float TemporalAAParamsX,
	float MaterialTextureMipBias)
{
	uint2 ip = (uint2)(Pix + TemporalAAParamsX);
	uint ix = (ip.y << 1) + ip.x;
	float dz = (float)(ix % 5u);
	float nz = DitherNoise.SampleBias(DitherNoiseSampler, Pix * 0.015625, MaterialTextureMipBias).x;
	return (nz + dz) * asfloat(0x3E2AAAABu);                                  // 1/6
}

FWuwaFXOutput WuwaDepthFX_Impl(const bool bAdvScreen, const bool bNoise, const bool bNoiseMask, const bool bSecond, const bool bRim,
	const bool bTwoSided, const bool bDragon,
	Texture2D Noise, SamplerState NoiseSampler, Texture2D NoiseMask, SamplerState NoiseMaskSampler,
	Texture2D Second, SamplerState SecondSampler, Texture2D Base, SamplerState BaseSampler,
	Texture2D Dissolve, SamplerState DissolveSampler, Texture2D Mask, SamplerState MaskSampler,
	Texture2D BumpNoise, SamplerState BumpNoiseSampler, Texture2D DitherNoise, SamplerState DitherNoiseSampler,
	float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign, float TwoSidedSign,
	float3 TranslatedWorldPosition, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize, float GameTime,
	float3 ActorPositionWS, float3 PreViewTranslation, float4x4 TranslatedWorldToCameraView, float ClipToView00, float ClipToView11,
	float TemporalAAParamsX, float3 KuroViewLightColorA, float3 KuroViewLightColorB,
	float UseSpecificTime, float EffectTime, float EffectTimeScale,
	float4 Noise_UVSwitch, float Noise_bScreenUV, float Noise_RotCos, float Noise_RotSin, float4 Noise_UV, float Noise_Offset, float Noise_Strength,
	float4 NoiseMask_UVSwitch, float NoiseMask_bScreenUV, float NoiseMask_RotCos, float NoiseMask_RotSin, float4 NoiseMask_UV, float bInvertNoiseMask,
	float4 Second_UVSwitch, float Second_bScreenUV, float Second_RotCos, float Second_RotSin, float4 Second_UV, float4 Second_UV_Offset,
	float Second_bClamp, float4 Second_Contorl,
	float4 Base_UVSwitch, float Base_bScreenUV, float Base_RotCos, float Base_RotSin, float4 Base_UV, float4 Base_UV_Offset,
	float Base_bClamp, float Base_NoiseStrength, float Base_bClampAfterNoise, float4 Base_EmissiveSwitch, float Base_bUseChannelAsEmissive,
	float4 Base_Refine, float Base_Emissive_Add, float Base_bAddSecond, float4 Base_ColorTint, float4 Base_AlphaSwitch, float Base_Alpha_Multiply,
	float Rim_Range, float Rim_BaseReflect, float Rim_Intensity, float4 Rim_Color, float Rim_EffectAsEmissiveColor,
	float Rim_EffectAsAlphaInvert, float Rim_EffectAsAlpha,
	float4 Dissolve_UVSwitch, float Dissolve_bScreenUV, float Dissolve_RotCos, float Dissolve_RotSin, float4 Dissolve_UV,
	float DIssolve_TimeOffset, float Dissolve_bClamp, float Dissolve_NoiseStrength, float Dissolve_UOffset, float Dissolve_VOffset,
	float4 Dissolve_ChannelSwitch, float Dissolve_MaskLerp, float Dissolve_Invert, float Dissolve_Smooth, float Dissolve_Dissolve,
	float4 Dissolve_EdgeColor,
	float4 Mask_UVSwitch, float Mask_bScreenUV, float Mask_RotCos, float Mask_RotSin, float4 Mask_UV, float4 Mask_UV_Offset,
	float Mask_bClamp, float Mask_NoiseStrength, float4 Mask_AlphaSwitch, float Mask_Invert, float Mask_Alpha_Multiply,
	float LightColorStrength, float4 NiagaraShiftLowGrayColor, float4 NiagaraShiftHighGrayColor, float NiagaraShiftColorParam,
	float4 BumpOffsetTexUV_S_O, float4 BumpNoiseColorMul, float Lerp,
	float4 SelectionColor, float E_Dither_DitherValue, float E_Dither_UseDither,
	float UseWholeDayDither, float DepthDitherFactorDay, float DepthDitherFactorNight,
	float MPC_KuroEffectColorGradingDesaturate, float3 MPC_KuroEffectColorGradingTint, float MPC_GlobalDayNightFactor,
	float4 NormalOverrideParameter, float MaterialTextureMipBias)
{
	FWuwaFXOutput X;
	float2 Pix = SvPositionXY - ViewRectMin;
	float4 Ux = float4(UV0.x, UV1.x, UV2.x, UV3.x);
	float4 Uy = float4(UV0.y, UV1.y, UV2.y, UV3.y);
	float2 SUV;
	if (bAdvScreen)
		SUV = WuwaDFXAdvScreenUV(Pix, ViewSizeAndInvSize, ActorPositionWS, PreViewTranslation, TranslatedWorldToCameraView,
			ClipToView00, ClipToView11);
	else
		SUV = Pix * ViewSizeAndInvSize.zw;

	// rim shading normal (Depth_CM, 251136 l.53-74): NormalOverride shading normal [x two-sided sign]
	float3 N = 0.0, V = 0.0;
	if (bRim)
	{
		V = rsqrt(dot(-TranslatedWorldPosition, -TranslatedWorldPosition)) * -TranslatedWorldPosition;
		float3 Bt = cross(WorldNormal, WorldTangent) * TangentSign;
		N = WuwaWShadingNormal(WorldTangent, Bt, WorldNormal, NormalOverrideParameter);
		if (bTwoSided)
			N = N * TwoSidedSign;
	}

	// ---- clock (D79-85) --------------------------------------------------------------------------------------------------
	float t = WuwaFXClock(GameTime, UseSpecificTime, EffectTime);
	float T = t * EffectTimeScale;

	// ---- noise (D53-78, D90-92) [x NoiseMask (317497)] ---------------------------------------------------------------------
	float2 nz = 0.0;
	if (bNoise)
	{
		float2 nuv = WuwaFXRotate(WuwaDFXUV(Noise_UVSwitch, Ux, Uy, Noise_bScreenUV, SUV), Noise_RotCos, Noise_RotSin);
		nuv = nuv * Noise_UV.xy;
		nuv = T * Noise_UV.zw + nuv;
		nz = (Noise.SampleBias(NoiseSampler, nuv, MaterialTextureMipBias).xy + Noise_Offset) * Noise_Strength;
		if (bNoiseMask)
		{
			float2 muv = WuwaFXRotate(WuwaDFXUV(NoiseMask_UVSwitch, Ux, Uy, NoiseMask_bScreenUV, SUV), NoiseMask_RotCos, NoiseMask_RotSin);
			muv = muv * NoiseMask_UV.xy + T * NoiseMask_UV.zw;
			float nm = NoiseMask.SampleBias(NoiseMaskSampler, muv, MaterialTextureMipBias).x;
			nm = bInvertNoiseMask * (nm * -2.0 + 1.0) + nm;
			nz = nz * nm;
		}
	}

	// ---- Second layer (D39-49, D86-100) --------------------------------------------------------------------------------
	float3 S = 0.0, Sk = 0.0;
	if (bSecond)
	{
		float2 suv = WuwaFXRotate(WuwaDFXUV(Second_UVSwitch, Ux, Uy, Second_bScreenUV, SUV), Second_RotCos, Second_RotSin);
		float ts = EffectTimeScale * t + 1.0;
		ts = Second_bClamp * (1.0 - ts) + ts;
		suv = suv * Second_UV.xy + ts * Second_UV.zw;
		suv = suv + Second_UV_Offset.xy;
		if (bNoise)
			suv = Second_Contorl.z * nz + suv;
		suv = WuwaFXClampLerp(suv, Second_bClamp);
		S = Second.SampleBias(SecondSampler, suv, MaterialTextureMipBias).rgb;
		S = Second_Contorl.x * (dot(S, float3(asfloat(0x3E99999Au), asfloat(0x3F170A3Du), asfloat(0x3DE147AEu))) - S) + S;
		Sk = S * Second_Contorl.y;
	}

	// ---- Base layer (D101-140) ---------------------------------------------------------------------------------------------
	float2 buv = WuwaFXRotate(WuwaDFXUV(Base_UVSwitch, Ux, Uy, Base_bScreenUV, SUV), Base_RotCos, Base_RotSin);
	float tb = Base_bClamp * -T + T;
	buv = buv * Base_UV.xy + tb * Base_UV.zw;
	buv = buv + Base_UV_Offset.xy;
	if (bNoise)
	{
		float2 bn = nz * Base_NoiseStrength;
		buv = bn * (1.0 - Base_bClampAfterNoise) + buv;
		buv = WuwaFXClampLerp(buv, Base_bClamp);
		buv = bn * Base_bClampAfterNoise + buv;
	}
	else
	{
		buv = WuwaFXClampLerp(buv, Base_bClamp);
	}
	float4 Bs = Base.SampleBias(BaseSampler, buv, MaterialTextureMipBias);
	float3 Bc = Base_bUseChannelAsEmissive * (dot(Bs, Base_EmissiveSwitch) - Bs.rgb) + Bs.rgb;
	Bc = WuwaFXRefine(Bc, Base_Refine, Base_Emissive_Add);
	float3 C;
	if (bSecond)
	{
		float3 SB = Sk * Bc;
		C = S * Second_Contorl.y + Bc;
		C = -Sk * Bc + C;
		C = Base_bAddSecond * C + SB;
	}
	else
	{
		C = Bc + Base_bAddSecond;
	}

	// ---- rim (Depth_CM) ----------------------------------------------------------------------------------------------------
	float rim = 0.0;
	float3 E = 0.0;
	if (bRim)
	{
		rim = exp2(log2(max(abs(1.0 - max(dot(N, V), 0.0)), asfloat(0x38D1B717u))) * Rim_Range);
		rim = rim * (1.0 - Rim_BaseReflect) + Rim_BaseReflect;
		float3 Ct = C * Base_ColorTint.rgb;
		float3 Cr = rim * (-Base_ColorTint.rgb * C + Rim_Intensity * Rim_Color.rgb);
		E = ceil(Rim_EffectAsEmissiveColor) * Cr + Ct;
	}

	// ---- mask (D157-170) ---------------------------------------------------------------------------------------------------
	float2 muv = WuwaFXRotate(WuwaDFXUV(Mask_UVSwitch, Ux, Uy, Mask_bScreenUV, SUV), Mask_RotCos, Mask_RotSin);
	float tm = Mask_bClamp * -T + T;
	muv = muv * Mask_UV.xy + tm * Mask_UV.zw;
	muv = muv + Mask_UV_Offset.xy;
	if (bNoise)
		muv = nz * Mask_NoiseStrength + muv;
	muv = WuwaFXClampLerp(muv, Mask_bClamp);
	float m = dot(Mask.SampleLevel(MaskSampler, muv, MaterialTextureMipBias - 1.0), Mask_AlphaSwitch);
	m = Mask_Invert * (m * -2.0 + 1.0) + m;
	float mm = m * Mask_Alpha_Multiply;

	// ---- dissolve with edge colour (D141-156, D171-186) ----------------------------------------------------------------------
	float2 duv = WuwaFXRotate(WuwaDFXUV(Dissolve_UVSwitch, Ux, Uy, Dissolve_bScreenUV, SUV), Dissolve_RotCos, Dissolve_RotSin);
	float td = -EffectTimeScale * t + DIssolve_TimeOffset;
	td = Dissolve_bClamp * td + T;
	duv = duv * Dissolve_UV.xy + td * Dissolve_UV.zw;
	if (bNoise)
		duv = nz * Dissolve_NoiseStrength + duv;
	duv = WuwaFXClampLerp(duv, Dissolve_bClamp);
	duv = duv + float2(Dissolve_UOffset, Dissolve_VOffset);
	float d = dot(Dissolve.SampleBias(DissolveSampler, duv, MaterialTextureMipBias), Dissolve_ChannelSwitch);
	d = Dissolve_MaskLerp * (Mask_Alpha_Multiply * m - d) + d;
	d = Dissolve_Invert * (d * -2.0 + 1.0) + d;
	float dd = Dissolve_Dissolve * (-Dissolve_Smooth + -1.0) + Dissolve_Smooth;
	d = d * Dissolve_Smooth - dd;
	float edge = 1.0 - min(abs(d + -1.0), 1.0);
	if (bRim)
		E = edge * Dissolve_EdgeColor.rgb + E;
	else
		E = C * Base_ColorTint.rgb + edge * Dissolve_EdgeColor.rgb;

	// ---- light colour, Niagara grey shift, Kuro effect grading (D187-199) ----------------------------------------------------
	float3 Lc = (KuroViewLightColorA - KuroViewLightColorB) * 0.5 + KuroViewLightColorB;
	E = LightColorStrength * (E * Lc - E) + E;
	float g = dot(E, float3(asfloat(0x3DE147AEu), asfloat(0x3F170A3Du), asfloat(0x3E99999Au)));
	float3 Sh = saturate(g) * (NiagaraShiftLowGrayColor.rgb - NiagaraShiftHighGrayColor.rgb) + NiagaraShiftHighGrayColor.rgb;
	E = NiagaraShiftColorParam * (Sh * g - E) + E;
	float gl = dot(E, float3(asfloat(0x3E991687u), asfloat(0x3F1645A2u), asfloat(0x3DE978D5u)));
	E = (gl - E) * MPC_KuroEffectColorGradingDesaturate + E;
	if (bDragon)
	{
		// D200-209: BumpNoise colour layer, x1.2, selection colour
		E = E * MPC_KuroEffectColorGradingTint;
		float2 kuv = UV0 * BumpOffsetTexUV_S_O.xy + GameTime * BumpOffsetTexUV_S_O.zw;
		float3 K = BumpNoise.SampleBias(BumpNoiseSampler, kuv, MaterialTextureMipBias).rgb;
		E = Lerp * (BumpNoiseColorMul.rgb * K - E) + E;
		float3 E12 = E * asfloat(0x3F99999Au);                                       // 1.2
		X.Emissive = SelectionColor.a * (-E * asfloat(0x3F99999Au) + SelectionColor.rgb) + E12;
	}
	else
	{
		// 251136: selection on the MPC-tinted colour (no View[286].y step)
		float3 Eg = E * MPC_KuroEffectColorGradingTint;
		X.Emissive = SelectionColor.a * (-E * MPC_KuroEffectColorGradingTint + SelectionColor.rgb) + Eg;
	}

	// ---- opacity: base alpha * mask * sat(dissolve) [rim alpha], dither value, depth dither (D210-235) -----------------------
	float op = dot(Bs, Base_AlphaSwitch) * Base_Alpha_Multiply;
	op = mm * op;
	float ds = saturate(d);
	if (bRim)
	{
		float op0 = ds * op;
		float ra = Rim_EffectAsAlphaInvert * (rim * -2.0 + 1.0) + rim;
		float o2 = (-op * ds + Rim_Color.a) * ra;
		op = ceil(Rim_EffectAsAlpha) * o2 + op0;
	}
	else
	{
		op = ds * op;
	}
	op = E_Dither_UseDither * (E_Dither_DitherValue * op - op) + op;
	float f = (UseWholeDayDither >= asfloat(0x3E4CCCCDu)) ? 1.0 : 0.0;          // 0.2
	f = f * (1.0 - MPC_GlobalDayNightFactor) + MPC_GlobalDayNightFactor;
	f = f * (DepthDitherFactorDay - DepthDitherFactorNight) + DepthDitherFactorNight;
	float th = WuwaDFXDitherTemporalAA(DitherNoise, DitherNoiseSampler, Pix, TemporalAAParamsX, MaterialTextureMipBias);
	float q = op * f + th;
	q = q + -0.5;
	if (bDragon)
		X.Opacity = saturate(op * q);
	else
		X.Opacity = saturate(((q >= 0.0) ? 1.0 : 0.0) * op);
	return X;
}

