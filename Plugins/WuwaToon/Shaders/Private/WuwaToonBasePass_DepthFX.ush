// @@DEPTHFX_ENTRIES_BEGIN@@
// DragonAdvScreenNoiseSecond: M_AdvancedEffect_Depth_CM_ForDragon PS a670c694d0 (#229631) translucent; UseAdvancedScreenPosition
FWuwaFXOutput WuwaDepthFX_DragonAdvScreenNoiseSecond(
	Texture2D Noise, SamplerState NoiseSampler, Texture2D Second, SamplerState SecondSampler, Texture2D Base,
	SamplerState BaseSampler, Texture2D Dissolve, SamplerState DissolveSampler, Texture2D Mask, SamplerState MaskSampler,
	Texture2D BumpNoise, SamplerState BumpNoiseSampler, Texture2D DitherNoise, SamplerState DitherNoiseSampler, float2 UV0,
	float2 UV1, float2 UV2, float2 UV3, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize, float GameTime,
	float3 ActorPositionWS, float3 PreViewTranslation, float4x4 TranslatedWorldToCameraView, float ClipToView00,
	float ClipToView11, float TemporalAAParamsX, float3 KuroViewLightColorA, float3 KuroViewLightColorB, float UseSpecificTime,
	float EffectTime, float EffectTimeScale, float4 Noise_UVSwitch, float Noise_bScreenUV, float Noise_RotCos,
	float Noise_RotSin, float4 Noise_UV, float Noise_Offset, float Noise_Strength, float4 Second_UVSwitch,
	float Second_bScreenUV, float Second_RotCos, float Second_RotSin, float4 Second_UV, float4 Second_UV_Offset,
	float Second_bClamp, float4 Second_Contorl, float4 Base_UVSwitch, float Base_bScreenUV, float Base_RotCos,
	float Base_RotSin, float4 Base_UV, float4 Base_UV_Offset, float Base_bClamp, float Base_NoiseStrength,
	float Base_bClampAfterNoise, float4 Base_EmissiveSwitch, float Base_bUseChannelAsEmissive, float4 Base_Refine,
	float Base_Emissive_Add, float Base_bAddSecond, float4 Base_ColorTint, float4 Base_AlphaSwitch, float Base_Alpha_Multiply,
	float4 Dissolve_UVSwitch, float Dissolve_bScreenUV, float Dissolve_RotCos, float Dissolve_RotSin, float4 Dissolve_UV,
	float DIssolve_TimeOffset, float Dissolve_bClamp, float Dissolve_NoiseStrength, float Dissolve_UOffset,
	float Dissolve_VOffset, float4 Dissolve_ChannelSwitch, float Dissolve_MaskLerp, float Dissolve_Invert,
	float Dissolve_Smooth, float Dissolve_Dissolve, float4 Dissolve_EdgeColor, float4 Mask_UVSwitch, float Mask_bScreenUV,
	float Mask_RotCos, float Mask_RotSin, float4 Mask_UV, float4 Mask_UV_Offset, float Mask_bClamp, float Mask_NoiseStrength,
	float4 Mask_AlphaSwitch, float Mask_Invert, float Mask_Alpha_Multiply, float LightColorStrength,
	float4 NiagaraShiftLowGrayColor, float4 NiagaraShiftHighGrayColor, float NiagaraShiftColorParam,
	float4 BumpOffsetTexUV_S_O, float4 BumpNoiseColorMul, float Lerp, float4 SelectionColor, float E_Dither_DitherValue,
	float E_Dither_UseDither, float UseWholeDayDither, float DepthDitherFactorDay, float DepthDitherFactorNight,
	float MPC_KuroEffectColorGradingDesaturate, float3 MPC_KuroEffectColorGradingTint, float MPC_GlobalDayNightFactor,
	float MaterialTextureMipBias)
{
	return WuwaDepthFX_Impl(
		true, true, false, true, false, false, true, Noise, NoiseSampler, Base, BaseSampler, Second, SecondSampler, Base,
		BaseSampler, Dissolve, DissolveSampler, Mask, MaskSampler, BumpNoise, BumpNoiseSampler, DitherNoise, DitherNoiseSampler,
		UV0, UV1, UV2, UV3, (float3)0, (float3)0, 0.0, 0.0, (float3)0, SvPositionXY, ViewRectMin, ViewSizeAndInvSize, GameTime,
		ActorPositionWS, PreViewTranslation, TranslatedWorldToCameraView, ClipToView00, ClipToView11, TemporalAAParamsX,
		KuroViewLightColorA, KuroViewLightColorB, UseSpecificTime, EffectTime, EffectTimeScale, Noise_UVSwitch, Noise_bScreenUV,
		Noise_RotCos, Noise_RotSin, Noise_UV, Noise_Offset, Noise_Strength, (float4)0, 0.0, 0.0, 0.0, (float4)0, 0.0,
		Second_UVSwitch, Second_bScreenUV, Second_RotCos, Second_RotSin, Second_UV, Second_UV_Offset, Second_bClamp,
		Second_Contorl, Base_UVSwitch, Base_bScreenUV, Base_RotCos, Base_RotSin, Base_UV, Base_UV_Offset, Base_bClamp,
		Base_NoiseStrength, Base_bClampAfterNoise, Base_EmissiveSwitch, Base_bUseChannelAsEmissive, Base_Refine,
		Base_Emissive_Add, Base_bAddSecond, Base_ColorTint, Base_AlphaSwitch, Base_Alpha_Multiply, 0.0, 0.0, 0.0, (float4)0, 0.0,
		0.0, 0.0, Dissolve_UVSwitch, Dissolve_bScreenUV, Dissolve_RotCos, Dissolve_RotSin, Dissolve_UV, DIssolve_TimeOffset,
		Dissolve_bClamp, Dissolve_NoiseStrength, Dissolve_UOffset, Dissolve_VOffset, Dissolve_ChannelSwitch, Dissolve_MaskLerp,
		Dissolve_Invert, Dissolve_Smooth, Dissolve_Dissolve, Dissolve_EdgeColor, Mask_UVSwitch, Mask_bScreenUV, Mask_RotCos,
		Mask_RotSin, Mask_UV, Mask_UV_Offset, Mask_bClamp, Mask_NoiseStrength, Mask_AlphaSwitch, Mask_Invert, Mask_Alpha_Multiply,
		LightColorStrength, NiagaraShiftLowGrayColor, NiagaraShiftHighGrayColor, NiagaraShiftColorParam, BumpOffsetTexUV_S_O,
		BumpNoiseColorMul, Lerp, SelectionColor, E_Dither_DitherValue, E_Dither_UseDither, UseWholeDayDither,
		DepthDitherFactorDay, DepthDitherFactorNight, MPC_KuroEffectColorGradingDesaturate, MPC_KuroEffectColorGradingTint,
		MPC_GlobalDayNightFactor, (float4)0, MaterialTextureMipBias);
