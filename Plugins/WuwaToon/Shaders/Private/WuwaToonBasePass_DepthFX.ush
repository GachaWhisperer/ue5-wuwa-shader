		NiagaraShiftHighGrayColor, NiagaraShiftColorParam, (float4)0, (float4)0, 0.0, SelectionColor, E_Dither_DitherValue,
		E_Dither_UseDither, UseWholeDayDither, DepthDitherFactorDay, DepthDitherFactorNight, MPC_KuroEffectColorGradingDesaturate,
		MPC_KuroEffectColorGradingTint, MPC_GlobalDayNightFactor, NormalOverrideParameter, MaterialTextureMipBias);
}
// @@DEPTHFX_ENTRIES_END@@

// =====================================================================================================================
// M_FlashDiamond_MP (MeshParticle root; MI_EYounuoYuegongMd10011_Suishi = Iuno's crescent prop / weapon The Unmeasured One).
// PS 5756a3d8af (#185987), VS 68344a27 (#185988). MSM_Unlit, BLEND_Translucent, two-sided, forward (no GBuffer).
// The M_Weapon_SP flash-diamond graph (WuwaToonBasePass_WeaponSP.ush) on a constant base colour (BaseCol_Tint * Intensity,
// no MainTex), with: a panned / screen-lerped normal map (Char_NormalMap, "NormalMap UV", Base_UVSwitch.y, Base_bScreenUV),
// the toon main light direction (WuwaBPMainLightDir; VS light direction in TEXCOORD1.xyz), a scrolled structure-light matcap
// (+ GameTime * (U_Offset, V_Offset)), the diamond texture refined (Base_Refine, pow guard) and desaturated, the sparkle added
// on the RAW diamond sample, no attack rim; Opacity = saturate(step(0.333, saturate(lerp(1, E_Dither_DitherValue,
// E_Dither_UseDither) * 2 - Pattern3x3[(x % 3) * 3 + y % 3])) * Opacity) (Kuro ordered 3x3 dither, pixel coordinates).
// Line refs M### = evidence/roster/shadermaps/weapons/asm_hex/185987_5756a3d8af*.asm.txt.
// Textures: t1 Char_NormalMap (.xy)  t2 Structure_Light_Tex  t3 Diamond_MainTex  t4 StructureNormal_Tex (.xy)
//           t5 VoronoiNormal_Tex (.xy, triplanar on the pre-WPO world position)   [t-slot <-> name by role, U]
// =====================================================================================================================
static const float kWuwaFDPattern3x3[9] = { 0.0, 0.777777791, 0.333333343, 0.666666687, 0.555555582, 0.222222224, 0.444444448,
	0.111111112, 0.888888896 };   // M-icb: 0, 7/9, 3/9, 6/9, 5/9, 2/9, 4/9, 1/9, 8/9 (exact float32 bits 0x3F471C72 ...)

FWuwaFXOutput WuwaFlashDiamondMP_StructureDiamond(
	Texture2D Char_NormalMap, SamplerState Char_NormalMapSampler,
	Texture2D Structure_Light_Tex, SamplerState Structure_Light_TexSampler,
	Texture2D Diamond_MainTex, SamplerState Diamond_MainTexSampler,
	Texture2D StructureNormal_Tex, SamplerState StructureNormal_TexSampler,
	Texture2D VoronoiNormal_Tex, SamplerState VoronoiNormal_TexSampler,
	float2 UV0, float2 UV1, float3 WorldTangent, float3 WorldNormal, float TangentSign, float TwoSidedSign,
	float3 WorldPosition, float3 TranslatedWorldPosition, float3 WorldPositionNoOffsets, float3 LightDirVS,
	float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize, float4x4 TranslatedWorldToView, float GameTime,
	// material parameters
	float4 NormalMap_UV, float4 Base_UVSwitch, float Base_bScreenUV, float PBR_Normal_Intensity, float3 BaseColor,
	float LightOffset_Pitch, float Metallic, float Roughness, float PBRHardSpecWidth, float PBRHardSpeSmooth,
	float PBRSpecularRangeDessolve_Threshold, float PBRSpecularRangeDessolve_Smooth, float PBRSpecularRangeDessolve_Intensity,
	float4 PBRSpecularColor, float4 PBRIndirectColor, float PBRRate,
	float Fresnel_Normal_Intensity, float FresnelRange_SmoothMin, float FresnelRange_SmoothMax, float4 Fresnel_Color,
	float Structure_Light_UV_X, float Structure_Light_UV_Y, float U_Offset, float V_Offset, float Structure_Height_1,
	float Structure_Light_Intensity, float Structure_Range_Normal_Intensity, float Structure_Range_Offset, float Structure_Range_Power,
	float4 Diamond_Param, float UseDiamond_UV_Switch, float4 Base_Refine, float Desaturation, float3 Diamond_RefractDir, float Diamond_Intensity,
	float StructureNormal_Tilling, float StructureNormal_Height, float StructureNormal_Intensity,
	float StructureNormal_In_Offset, float StructureNormal_In_Intensity, float StructureNormal_Out_Offset, float StructureNormal_Out_Intensity,
	float VoronoiNormal_TextureSize, float VoronoiNormal_Intensity,
	float Voronoi_In_Offset, float Voronoi_In_Intensity, float Voronoi_Out_Offset, float Voronoi_Out_Intensity,
	float Final_Emission, float4 SelectionColor, float E_Dither_DitherValue, float E_Dither_UseDither, float Opacity,
	// engine
	float3 MPC_GlobalCharacterAmbientSkinColor, float3 MPC_GlobalCharacterDebugLightDirection,
	float4 ToonLight0, float4 ToonLight1, float4 ToonLight2, float4 ToonLight3, float CPD13, float CPD1, float3 ObjectWorldPosition,
	float MaterialTextureMipBias, float4 NormalOverrideParameter)
{
	FWuwaFXOutput X;

	// ---- M64-91: TBN, view vector, two-sided shading normal ----------------------------------------------------------
	float3 Bt = cross(WorldNormal, WorldTangent) * TangentSign;
	float2 Pix = SvPositionXY - ViewRectMin;
	float  rsV = rsqrt(dot(-TranslatedWorldPosition, -TranslatedWorldPosition));
	float3 V = rsV * -TranslatedWorldPosition;
	float3 N = WuwaWShadingNormal(WorldTangent, Bt, WorldNormal, NormalOverrideParameter) * TwoSidedSign;
	// Base = (BaseCol_Tint.rgb * BaseCol_Intensity): a CPU preshader constant in the original (cb5[12]); a GPU product would be
	// folded by fxc into the later mads (F0 = Base - 0.04, PBRRate lerp), so it is a uniform_expression input.
	float3 Base = BaseColor;

	// ---- M92-105: panned normal map on lerp(UV0, UV1, Base_UVSwitch.y) / screen UV (tangent xy only) -------------------
	float2 nuv = WuwaFXUV2(Base_UVSwitch.y, UV0, UV1, Base_bScreenUV, Pix, ViewSizeAndInvSize.zw);
	nuv = NormalMap_UV.xy * nuv + GameTime * NormalMap_UV.zw;
	float2 bn = Char_NormalMap.SampleBias(Char_NormalMapSampler, nuv, MaterialTextureMipBias).xy * 2.0 - 1.0;
	float3 Pn = bn.x * WorldTangent + Bt * bn.y;
	float3 Np = PBR_Normal_Intensity * Pn + WorldNormal;

	// ---- M106-163: main character light direction (shared Kuro block, VS direction = TEXCOORD1.xyz) ---------------------
	float3 L = WuwaBPMainLightDir(LightOffset_Pitch, MPC_GlobalCharacterAmbientSkinColor, MPC_GlobalCharacterDebugLightDirection,
		ToonLight0, ToonLight1, ToonLight2, ToonLight3, ObjectWorldPosition, WorldPosition, WorldPosition, CPD13, CPD1, LightDirVS);

	// ---- M164-221: self-lit PBR (as WuwaToonWeaponSPBasePass, constant base colour) -----------------------------------
	float3 H = -TranslatedWorldPosition * rsV + L;
	H = H / sqrt(dot(H, H));
	float NoH = saturate(dot(Np, H));
	float NoVu = dot(Np, V);
	float NoV = saturate(NoVu);
	float NoL = saturate(dot(Np, L));
	float hNoV = NoVu * 0.5 + 0.5;
	float Dk = Metallic * asfloat(0xBF75C28Fu) + asfloat(0x3F75C28Fu);          // 0.96 * (1 - metallic)
	float3 Diff = Dk * Base;
	float3 F0 = Base + asfloat(0xBD23D70Au);                                       // - 0.04
	F0 = Metallic * F0 + asfloat(0x3D23D70Au);
	float4 rr = Roughness * float4(-1.0, asfloat(0xBCE147AEu), asfloat(0xBF126E98u), asfloat(0x3CB43958u))
		+ float4(1.0, asfloat(0x3D2E147Bu), asfloat(0x3F851EB8u), asfloat(0xBD23D70Au));
	float a004 = min(exp2(NoV * asfloat(0xC1147AE1u)), rr.x * rr.x) * rr.x + rr.y;
	float2 AB = a004 * float2(asfloat(0xBF851EB8u), asfloat(0x3F851EB8u)) + rr.zw;
	float3 Env = F0 * AB.x + saturate(F0.y * 50.0) * AB.y;
	float a2 = max(Roughness * Roughness, asfloat(0x3B03126Fu));
	a2 = a2 * a2;
	float d = (NoH * a2 - NoH) * NoH + asfloat(0x3F800054u);
	float Dg = (a2 * asfloat(0x3EA2F983u)) / (d * d + asfloat(0x33D6BF95u));
	float hw = (PBRHardSpeSmooth + 1.0) * PBRHardSpecWidth - PBRHardSpeSmooth;
	float hs = PBRHardSpeSmooth + PBRHardSpecWidth;
	float lo = min(hw, hs + asfloat(0xBA83126Fu));
	float hard = saturate((Dg - lo) * (1.0 / (hs - lo)));
	hard = (hard * hard) * (hard * -2.0 + 3.0);
	float rng = saturate((hNoV - PBRSpecularRangeDessolve_Threshold) * (1.0 / (PBRSpecularRangeDessolve_Smooth - PBRSpecularRangeDessolve_Threshold)));
	rng = (rng * rng) * (rng * -2.0 + 3.0);
	float3 Spec = hard * (Env * PBRSpecularColor.rgb);
	Spec = PBRSpecularRangeDessolve_Intensity * (Spec * rng - Spec) + Spec;
	float hNoL = NoL * 0.5 + 1.0;
	Spec = Base * Dk + Spec;
	float3 Pbr = hNoL * (Diff * PBRIndirectColor.rgb + Env);
	Pbr = Spec * hNoV + Pbr;
	float3 C = PBRRate * (Pbr - Base) + Base;

	// ---- M222-232: fresnel -------------------------------------------------------------------------------------------------
	float3 Nf = Fresnel_Normal_Intensity * Pn + WorldNormal;
	float fr = min(WuwaWSmoothStep(FresnelRange_SmoothMin, FresnelRange_SmoothMax, dot(Nf, V)), 1.0);
	C = (1.0 - fr) * Fresnel_Color.rgb + C;

	// ---- M233-256: structure light (view-space cross matcap, scroll, bump offset), NoV range ------------------------------
	float3 Pv = mul(float4(TranslatedWorldPosition, 1.0), TranslatedWorldToView).xyz;
	// M240 normalises with dp3 r1.xzw = (y*y + z*z) + x*x. fxc canonicalises dot() / an unmarked sum to x, y, z order (1 ulp off
	// on WARP); precise keeps the original summation order (WARP dp3 = rounded products, left-to-right adds).
	precise float pl = Pv.y * Pv.y;
	pl = Pv.z * Pv.z + pl;
	pl = Pv.x * Pv.x + pl;
	Pv = Pv / sqrt(pl);
	float3 Nv = mul(WorldNormal, (float3x3)TranslatedWorldToView);
	float2 sl = float2(Pv.z * Nv.x - Pv.x * Nv.z, Pv.y * Nv.z - Pv.z * Nv.y) * 0.5 + 0.5;
	sl = sl * float2(Structure_Light_UV_X, Structure_Light_UV_Y);
	sl = float2(GameTime * U_Offset + sl.x, GameTime * V_Offset + sl.y);     // one mad per axis, as M251
	float2 Vts = float2(dot(WorldTangent, V), dot(Bt, V));
	sl = Vts * (Structure_Height_1 * asfloat(0x3D4CCCCDu) + asfloat(0xBCCCCCCDu)) + sl;
	float3 St = Structure_Light_Tex.SampleBias(Structure_Light_TexSampler, sl, MaterialTextureMipBias).rgb * Structure_Light_Intensity;
	float3 Ns = Structure_Range_Normal_Intensity * Pn + WorldNormal;
	float sr = saturate((dot(Ns, V) + Structure_Range_Offset) * Structure_Range_Power);
	float3 C2 = sr * (C * St - C) + C;

	// ---- M257-298: diamond (refracted view vector in view space / panned UV0), refine, desaturate, sparkle ----------------
	float3 rv = refract(V, N, asfloat(0x3F400C4Bu));
	float2 rvv = mul(rv, (float3x3)TranslatedWorldToView).xy;
	float2 duv = UV0 * Diamond_Param.xy + GameTime * Diamond_Param.zw;
	float3 Dt = Diamond_MainTex.SampleBias(Diamond_MainTexSampler, UseDiamond_UV_Switch * (duv - rvv) + rvv, MaterialTextureMipBias).rgb;
	float3 Dp = float3(WuwaWPowGuard(Dt.x, Base_Refine.x), WuwaWPowGuard(Dt.y, Base_Refine.x), WuwaWPowGuard(Dt.z, Base_Refine.x)) * Base_Refine.y;
	float3 Dm = Base_Refine.w * (Dt * Base_Refine.z - Dp) + Dp;
	Dm = Desaturation * (dot(Dm, float3(asfloat(0x3E99999Au), asfloat(0x3F170A3Du), asfloat(0x3DE147AEu))) - Dm) + Dm;
	float3 Nvv = mul(N, (float3x3)TranslatedWorldToView);
	float spk = dot(Nvv, Diamond_RefractDir);
	float spark = (asfloat(0x33000002u) >= spk) ? 0.0 : min((exp2(log2(spk) * 12.0) * ((spk >= asfloat(0x3E087FCCu)) ? 1.0 : 0.0)) * 1000.0, 20.0);
	Dm = Dt * spark + Dm;

	// ---- M299-325: structure normal mask (tangent-space normal map with bump offset) ---------------------------------------
	float2 snuv = UV0 * StructureNormal_Tilling;
	snuv = Vts * (StructureNormal_Height * asfloat(0x3D4CCCCDu) + asfloat(0xBCCCCCCDu)) + snuv;
	float2 sn = StructureNormal_Tex.SampleBias(StructureNormal_TexSampler, snuv, MaterialTextureMipBias).xy * 2.0 - 1.0;
	float snz = sqrt(max(1.0 - dot(sn, sn), 0.0));
	float3 Nsn = sn.x * WorldTangent + Bt * sn.y;
	Nsn = snz * WorldNormal + Nsn;
	Nsn = StructureNormal_Intensity * (Nsn - WorldNormal) + WorldNormal;
	float snd = dot(V, Nsn);
	float snm = saturate(((-snd + StructureNormal_Out_Offset) + 1.0) * StructureNormal_Out_Intensity)
		+ saturate((snd + StructureNormal_In_Offset) * StructureNormal_In_Intensity);
	float3 Dd = Dm * Diamond_Intensity - Base;
	float3 C3 = snm * (snm * Dd + Base - C2) + C2;

	// ---- M326-373: voronoi normal mask (triplanar on the pre-WPO absolute world position) ----------------------------------
	float3 wp = WorldPositionNoOffsets / (-abs(VoronoiNormal_TextureSize));
	float2 tx = VoronoiNormal_Tex.SampleBias(VoronoiNormal_TexSampler, wp.xz, MaterialTextureMipBias).xy * 2.0 - 1.0;
	float3 py = float3(-tx.x, sqrt(max(1.0 - dot(tx, tx), 0.0)) * WorldNormal.y, -tx.y);
	float2 ty = VoronoiNormal_Tex.SampleBias(VoronoiNormal_TexSampler, wp.yz, MaterialTextureMipBias).xy * 2.0 - 1.0;
	float3 px = float3(sqrt(max(1.0 - dot(ty, ty), 0.0)) * WorldNormal.x, -ty.x, -ty.y);
	float2 wb = min(abs(WorldNormal.xz), 1.0);
	float3 vn = wb.x * (px - py) + py;
	float2 tz = VoronoiNormal_Tex.SampleBias(VoronoiNormal_TexSampler, wp.xy, MaterialTextureMipBias).xy * 2.0 - 1.0;
	float3 pz = float3(-tz.x, -tz.y, sqrt(max(1.0 - dot(tz, tz), 0.0)) * WorldNormal.z);
	vn = wb.y * (pz - vn) + vn;
	vn = vn / sqrt(dot(vn, vn));
	float3 vt = float3(dot(WorldTangent, vn), dot(Bt, vn), dot(WorldNormal, vn));
	float3 Nvo = Bt * vt.y;
	Nvo = vt.x * WorldTangent + Nvo;
	Nvo = vt.z * WorldNormal + Nvo;
	Nvo = VoronoiNormal_Intensity * (Nvo - WorldNormal) + WorldNormal;
	float vd = dot(V, Nvo);
	float vm = saturate(((-vd + Voronoi_Out_Offset) + 1.0) * Voronoi_Out_Intensity) + saturate((vd + Voronoi_In_Offset) * Voronoi_In_Intensity);
	float3 C4 = vm * (vm * Dd + Base - C3) + C3;

	// ---- M374-376: final emission, selection ---------------------------------------------------------------------------------
	float3 Ce = C4 * Final_Emission;
	X.Emissive = SelectionColor.a * (-C4 * Final_Emission + SelectionColor.rgb) + Ce;

	// ---- M377-391: opacity, Kuro ordered 3x3 dither -------------------------------------------------------------------------
	float op = E_Dither_UseDither * (E_Dither_DitherValue - 1.0) + 1.0;
	int2 ip = (int2)Pix;                                                       // M379-386: signed (x % 3, y % 3) as emitted
	uint2 sg = asuint(ip) & 0x80000000u;
	uint2 rm = ((uint2)max(ip, -ip)) % 3u;
	int mx = (sg.x != 0u) ? -(int)rm.x : (int)rm.x;
	int my = (sg.y != 0u) ? -(int)rm.y : (int)rm.y;
	int k = max(mx * 3 + my, 0);
	float t = saturate(op * 2.0 - kWuwaFDPattern3x3[k]);
	X.Opacity = saturate(((t >= asfloat(0x3EAA7EFAu)) ? 1.0 : 0.0) * Opacity);    // 0.333
	return X;
}

#endif // WUWA_TOON_BASEPASS_DEPTHFX_USH
