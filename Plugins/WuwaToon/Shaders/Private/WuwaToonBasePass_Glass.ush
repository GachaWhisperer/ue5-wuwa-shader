// WuwaToonBasePass_Glass.ush — Kuro lit translucent character glass: M_Char_Glass (Zhezhi / Zani sunglasses / Yuanwu).
// research/roster/Port_Weapons_Specials.md (round 3, batch "glass").
//
// The original is a forward translucent base pass (MSM_ToonCommon, BLEND_Translucent) whose PS lights the material's
// base colour itself with Kuro's view ambient (View[193], [269..275], [299]/[304]/[306]) and Kuro's forward local-light
// array (cbuffer 3: 16 lights x 9 float4 + the light count in row 144.x). Every engine value is an explicit input here
// (spec kinds "view" / "primitive" / "kuro_light_buffer" / "engine_texture"; see the spec notes for the Kuro registers).
//
// Output contract ("resolve": false): FWuwaFXOutput {Emissive = material Emissive Color, Opacity = material Opacity} plus
// out ForwardLighting = the Kuro lit term (ambient + local lights) / EyeAdaptation. The UE material is translucent unlit
// with Emissive Color = Emissive + ForwardLighting, Opacity = Opacity. Kuro's engine tail (primitive fade on opacity,
// max(Emissive, 0) * View[285] unless Primitive[42].w, OOB stripes, + ForwardLighting, vertex / volumetric fog) is
// reproduced only in the diff harness (tools/shaderdiff/weapons/hlsl/kuro_tail_glass.hlsli).
#pragma once
#ifndef WUWA_TOON_BASEPASS_GLASS_USH
#define WUWA_TOON_BASEPASS_GLASS_USH

#include "WuwaToonBasePass_WeaponShared.ush"   // FWuwaFXOutput, WuwaWPowGuard, WuwaWShadingNormal (read-only)

// Kuro forward local-light cbuffer (cb3 of the glass PS) as one array: light i = rows 9i .. 9i+8, row 144.x = light count
// (uint bits). Per-light rows as the PS reads them ([U] = meaning inferred from usage):
//   +0 xyz world position, w 1/radius        +1 xyz spot direction, w uint flags (bits 16..17: 2 = spot)
//   +2 x spot cos outer, y 1/(cos inner - cos outer)
//   +3 xyz "transmission" colour [U], w weight on the ambient-lit albedo [U]
//   +4 x enable + distance-falloff scale, y falloff bias, z falloff multiplier
//   +5 xyz lit colour, w wrap-light threshold [U]     +6 xyz shadow colour [U], w lerp(falloff, radius fade)
//   +7 x intensity, y "transmission" occlusion [U], w uint lighting-channel mask (shifted << 5 against the primitive's)
//   +8 x wrap width [U], y > 0 selects the lerp light model [U]
// A struct, not an array typedef: UE 5.8's shader preprocessing drops the typedef from the material shader source
// ("unknown type name", Round 4 compile fixes). Same 145 x float4 layout; the generator passes (FWuwaGlassLocalLightBuffer)0
// (Kuro forward light list not available in UE: no local lights), the harness copies its cb3 rows into V.
struct FWuwaGlassLocalLightBuffer
{
	float4 V[145];
};

// Kuro 3x3 screen dither (immediate constant buffer of the PS): k/9 in the order 0,7,3,6,5,2,4,1,8.
static const float WuwaGlassDither3x3[9] = {
	0.0, asfloat(0x3f471c72u), asfloat(0x3eaaaaabu), asfloat(0x3f2aaaabu), asfloat(0x3f0e38e4u),
	asfloat(0x3e638e39u), asfloat(0x3ee38e39u), asfloat(0x3de38e39u), asfloat(0x3f638e39u) };

// 4-channel UV select dot(Switch, (UV0, UV1, UV2, UV3)) per axis, then lerp toward the screen UV (as WuwaFXUV4).
float2 WuwaGlassUV4(float4 Switch, float4 Ux, float4 Uy, float bScreenUV, float2 ScreenPix, float2 InvSize)
{
	float2 uv = float2(dot(Switch, Ux), dot(Switch, Uy));
	return bScreenUV * (ScreenPix * InvSize - uv) + uv;
}

// UE Fresnel node as emitted: pow(max(|1 - max(N.V, 0)|, 1e-4), E).
float WuwaGlassFresnelPow(float3 N, float3 V, float E)
{
	float x = 1.0 - max(dot(N, V), 0.0);
	return exp2(log2(max(abs(x), asfloat(0x38d1b717u))) * E);
}

// =====================================================================================================================
// M_Char_Glass PS: 446afb3320 (#58467; two-sided, UseThickColor) / 474cc6dc0d (#215181; one-sided, no UseThickColor).
// Static switches: UseGradientOpacity, UseMatCap, UseVertexNormal, UseHeightLightTex (+ UseThickColor).
// Line refs G### = evidence/roster/shadermaps/weapons/asm_hex/058467_446afb33....asm.txt.
// =====================================================================================================================
FWuwaFXOutput WuwaGlassCharGlass_Impl(const bool bTwoSided, const bool bThickColor,
	Texture2D MatCapTex, SamplerState MatCapTexSampler, Texture2D E_Tex_NoiseTex, SamplerState E_Tex_NoiseTexSampler,
	Texture2D HeightLightTex, SamplerState HeightLightTexSampler,
	float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign, float TwoSidedSign,
	float4 NormalOverrideParameter, float3 CameraVector, float3 WorldPosition, float4 SvPosition, float2 ViewRectMin,
	float4 ViewSizeAndInvSize, float4x4 TranslatedWorldToView, float3 ViewForward, float3 LocalToWorldRow0,
	float MaterialTextureMipBias, float GameTime,
	float3 KuroViewLightColorA, float KuroAmbientBlend, float3 KuroAmbientA0, float3 KuroAmbientA1, float3 KuroAmbientA2,
	float3 KuroAmbientB0, float3 KuroAmbientB1, float3 KuroAmbientB2, float3 KuroGlassAmbientFar, float3 KuroGlassAmbientNear,
	float2 KuroGlassAmbientDistance, float EyeAdaptation, uint LightingChannelMask, FWuwaGlassLocalLightBuffer KuroLocalLights,
	// material parameters
	float MaCapColortInt, float EnvironmentColorInt, float3 BaseColor,
	float E_Tex_UseTex, float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_RotCos, float E_Tex_RotSin,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color,
	float E_Dissolve_UseDissolve, float4 E_Dissolve_Channel, float E_Dissolve_Progress, float E_Dissolve_Smooth,
	float3 E_Dissolve_Emission, float E_Dissolve_Multi,
	float HLScale, float HLmoveSpeed, float HLpositionX, float HLpositionY, float HLOpacityInt, float4 HLColor,
	float4 SelectionColor, float MatCapOpacityInt, float ThickColorScale, float ThickColorWidth, float ThickColorInt,
	float ReflectScale, float ReflecOpacityInt, float OpacityScale, float EdgeColorScale, float EdgeColorWidth, float EdgeOpacityInt,
	float E_Dither_UseDither, float E_Dither_UseDither2, float E_Dither_DitherValue, float E_Dither_DitherValue2,
	out float3 ForwardLighting)
{
	FWuwaFXOutput X;
	// ---- G1-27: bitangent, screen pixel, shading normal (x two-sided sign) ------------------------------------------
	float3 Bt = cross(WorldNormal, WorldTangent) * TangentSign;
	float2 ScreenPix = SvPosition.xy - ViewRectMin;
	float3 V = CameraVector;
	float3 N = WuwaWShadingNormal(WorldTangent, Bt, WorldNormal, NormalOverrideParameter);
	if (bTwoSided)
		N = TwoSidedSign * N;

	// ---- G28-45: vertex-normal matcap, Kuro view ambient on BaseColor ------------------------------------------------
	float2 vn = WorldNormal.y * TranslatedWorldToView[1].xy;
	vn = WorldNormal.x * TranslatedWorldToView[0].xy + vn;
	vn = WorldNormal.z * TranslatedWorldToView[2].xy + vn;
	float2 mu = vn * 0.5 + 0.5;
	float3 mc = MatCapTex.SampleBias(MatCapTexSampler, float2(mu.x, 1.0 - mu.y), MaterialTextureMipBias).xyz;
	float opMat = mc.x * MaCapColortInt;
	const float k3 = asfloat(0x3eaaaaadu);
	float3 a0 = KuroAmbientA1 * k3;
	a0 = KuroAmbientA0 * k3 + a0;
	a0 = KuroAmbientA2 * k3 + a0;
	float3 a1 = KuroAmbientB1 * k3;
	a1 = KuroAmbientB0 * k3 + a1;
	a1 = KuroAmbientB2 * k3 + a1;
	float3 amb = KuroAmbientBlend * a1 + a0;
	amb = max(amb * asfloat(0x3ea2f984u), 0.0) * KuroViewLightColorA;
	amb = BaseColor * amb - BaseColor;
	amb = EnvironmentColorInt * amb + BaseColor;
	float3 base = mc * MaCapColortInt + amb;

	// ---- G46-62: E_Tex layer (UV channel select, screen UV, rotator, scale/offset, panner) ---------------------------
	float4 et;
	[branch] if (asfloat(0x3dcccccdu) < E_Tex_UseTex)
	{
		float2 uv = WuwaGlassUV4(E_Tex_UVSwitch, float4(UV0.x, UV1.x, UV2.x, UV3.x), float4(UV0.y, UV1.y, UV2.y, UV3.y),
			E_Tex_UseScreenUV, ScreenPix, ViewSizeAndInvSize.zw);
		float2 d = uv - 0.5;
		uv = float2(dot(d, float2(E_Tex_RotCos, -E_Tex_RotSin)), dot(d, float2(E_Tex_RotSin, E_Tex_RotCos))) + 0.5;
		uv = uv * E_Tex_ScaleAndOffset.xy + E_Tex_ScaleAndOffset.zw;
		uv = GameTime * E_Tex_Speed + uv;
		et = E_Tex_NoiseTex.Sample(E_Tex_NoiseTexSampler, uv) * E_Tex_Color;
	}
	else
	{
		et = E_Tex_Color;
	}

	// ---- G63-80: dissolve (edge emission, alpha) ----------------------------------------------------------------------
	float3 dEmis = float3(0.0, 0.0, 0.0);
	float dAlpha = 1.0;
	[branch] if (asfloat(0x3dcccccdu) < E_Dissolve_UseDissolve)
	{
		float m = dot(E_Dissolve_Channel, et);
		float p = E_Dissolve_Progress * asfloat(0xbf8cccccu) + asfloat(0x3f866666u);
		p = p * (-E_Dissolve_Smooth + -1.0) + E_Dissolve_Smooth;
		float x = m * E_Dissolve_Smooth - p;
		dAlpha = saturate(x);
		float e = 1.0 - min(abs(x - 1.0), 1.0);
		dEmis = e * (E_Dissolve_Emission * (E_Dissolve_Multi * asfloat(0x3c23d70au)));
	}
	base = base + dEmis;

	// ---- G81-95: height light (UV2 panned by the view/object facing), selection colour --------------------------------
	float hy = UV2.y * HLScale;
	float f = (dot(ViewForward.xy, LocalToWorldRow0.xy) + 1.0) * 0.5;
	float sNeg = -HLmoveSpeed;
	float hx = UV2.x * HLScale + (f * (HLmoveSpeed - sNeg) + sNeg);
	float3 ht = HeightLightTex.SampleBias(HeightLightTexSampler, float2(hx, hy) - float2(HLpositionX, HLpositionY),
		MaterialTextureMipBias).xyz * HLOpacityInt;
	base = HLColor.w * (ht * (HLColor.xyz - base)) + base;
	float3 h = base * 0.5;
	X.Emissive = SelectionColor.w * (SelectionColor.xyz - base * 0.5) + h;

	// ---- G96-140: opacity (matcap, thick colour, reflection fresnel, gradient, edge) ----------------------------------
	float dStep = (dAlpha >= asfloat(0x3ea8f5c3u)) ? 1.0 : 0.0;
	float op = opMat * MatCapOpacityInt + ht.x;
	float dist = sqrt(dot(UV2 - 0.5, UV2 - 0.5));
	float rf = WuwaGlassFresnelPow(WorldNormal, V, asfloat(0x3f8ccccdu)) * (1.0 - ReflectScale) + ReflectScale;
	rf = saturate(rf * ReflecOpacityInt);
	if (bThickColor)
	{
		float3 tn = ThickColorScale * (float3(0.0, 1.0, 0.0) - WorldNormal) + WorldNormal;
		float fr = 1.0 - (WuwaGlassFresnelPow(tn, V, asfloat(0x3e99999au)) * asfloat(0x3eccccccu) + asfloat(0x3f19999au));
		float th = saturate(fr * WuwaWPowGuard(dist - ThickColorWidth, ThickColorInt));
		op = op + (th + rf);
	}
	else
	{
		op = op + rf;
	}
	float go = WuwaWPowGuard(UV2.y, OpacityScale);
	float ex = dist - EdgeColorScale;
	float ed = (asfloat(0x33000002u) >= ex) ? 0.0 : exp2(log2(ex) * EdgeColorWidth) * EdgeOpacityInt;
	go = ed * (1.0 - go) + go;
	op = op + go;
	op = op * dStep;

	// ---- G141-153: Kuro 3x3 screen dither ------------------------------------------------------------------------------
	int2 ip = (int2)ScreenPix;                         // signed (C) remainder of the pixel coordinate by 3
	uint2 um = ((uint2)max(ip, -ip)) % 3u;
	int2 im = (int2)um;
	im.x = (ip.x < 0) ? -im.x : im.x;
	im.y = (ip.y < 0) ? -im.y : im.y;
	int k = max(im.x * 3 + im.y, 0);
	float dv = saturate(min(E_Dither_DitherValue, E_Dither_DitherValue2) * 2.0 - WuwaGlassDither3x3[k]);
	dv = (asfloat(0x3e99999au) >= max(E_Dither_UseDither, E_Dither_UseDither2)) ? 1.0 : dv;
	X.Opacity = max(min(op, dv), 0.0);

	// ---- G193-206: Kuro glass ambient (view-depth lerp) on the albedo, multi-bounce factor (AO = 1 folded) -------------
	uint chan = (LightingChannelMask & 7u) << 5;
	float t = saturate(SvPosition.w / max(KuroGlassAmbientDistance.x, asfloat(0x3a83126fu)));
	t = exp2(log2(t) * KuroGlassAmbientDistance.y);
	float3 ac = t * (KuroGlassAmbientFar - KuroGlassAmbientNear) + KuroGlassAmbientNear;
	float3 mb = base * asfloat(0x400295eau) + asfloat(0xbeaa3055u);
	mb = base * asfloat(0xc0997176u) + mb;
	mb = base * asfloat(0x40305532u) + mb;
	mb = mb + asfloat(0x3faa7efau);
	mb = max(mb, 1.0);
	float3 ad = base * (ac * mb) * asfloat(0x3f333333u);

	// ---- G207-289: Kuro forward local lights ---------------------------------------------------------------------------
	float3 acc = float3(0.0, 0.0, 0.0);
	float lw = 1.0;
	[loop] for (uint i = 0; i < asuint(KuroLocalLights.V[144].x); i++)
	{
		uint b = i * 9;
		if (0.0 != KuroLocalLights.V[b + 4].x)
		{
			if (((asuint(KuroLocalLights.V[b + 7].w) << 5) & chan) == 0)
				continue;
			float3 d = KuroLocalLights.V[b].xyz - WorldPosition;
			float dd = dot(d, d);
			float r2 = KuroLocalLights.V[b].w * KuroLocalLights.V[b].w * dd;
			[branch] if (1.0 >= r2)
			{
				float fa = saturate(r2 * 2.5 + -1.5);
				fa = -(fa * fa) * (fa * -2.0 + 3.0) + 1.0;
				float3 Ld = d * rsqrt(dd);
				float nl = dot(N, Ld) + 1.0;
				float lo = KuroLocalLights.V[b + 5].w * asfloat(0x3f70a3d7u) - 0.5 * KuroLocalLights.V[b + 8].x;
				float hi = KuroLocalLights.V[b + 8].x * 1.5 + KuroLocalLights.V[b + 5].w;
				float ws = saturate((nl * 0.5 - lo) * (1.0 / (hi - lo)));
				ws = min((ws * ws) * (ws * -2.0 + 3.0), 1.0);
				float3 sh = ad * KuroLocalLights.V[b + 6].xyz;
				float3 lc = ws * (base * KuroLocalLights.V[b + 5].xyz - sh) + sh;
				lc = lc * KuroLocalLights.V[b + 7].x;
				float3 dn = d * KuroLocalLights.V[b].w;
				float at = dot(dn, dn) * KuroLocalLights.V[b + 4].x + KuroLocalLights.V[b + 4].y;
				at = 1.0 / (at + asfloat(0x38d1b717u)) - 1.0;
				at = at * KuroLocalLights.V[b + 4].z;
				at = min(at * at, 1.0);
				bool bSpot = ((asuint(KuroLocalLights.V[b + 1].w) >> 16) & 3u) == 2u;
				float sp = saturate((dot(Ld, KuroLocalLights.V[b + 1].xyz) - KuroLocalLights.V[b + 2].x) * KuroLocalLights.V[b + 2].y);
				sp = sp * sp;
				sp = sp * sp;
				at = bSpot ? at * sp : at;
				float3 tr = ad * KuroLocalLights.V[b + 3].w;
				float3 trc = tr * KuroLocalLights.V[b + 3].xyz;
				float kk = saturate((KuroLocalLights.V[b + 3].x + KuroLocalLights.V[b + 3].y + KuroLocalLights.V[b + 3].z + KuroLocalLights.V[b + 7].x) * 10.0)
					* KuroLocalLights.V[b + 7].y;
				float la = KuroLocalLights.V[b + 6].w * (fa - at) + at;
				float3 sc = la * sh * kk;
				float3 direct = at * lc;
				float3 cA = (at * (trc - sc) + sc + direct) * lw + acc;
				float3 cB = (trc * at + direct) * lw + acc;
				if (0.0 < KuroLocalLights.V[b + 8].y)
					acc = cA;
				else
					acc = cB;
				lw = lw * (-la * kk + 1.0);
			}
		}
	}
	ForwardLighting = (lw * ad + acc) / EyeAdaptation;
	return X;
}

// =====================================================================================================================
// Entries (one per compiled PS hash)
// =====================================================================================================================
// PS 446afb3320 (#58467): MI_R2T1ZhezhiMd10011Glass, MI_EZanniSunniesMd10011Glass; two-sided, UseThickColor
FWuwaFXOutput WuwaGlassCharGlass_2SThick(
	Texture2D MatCapTex, SamplerState MatCapTexSampler, Texture2D E_Tex_NoiseTex,
	SamplerState E_Tex_NoiseTexSampler, Texture2D HeightLightTex, SamplerState HeightLightTexSampler, float2 UV0,
	float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign,
	float TwoSidedSign, float4 NormalOverrideParameter, float3 CameraVector, float3 WorldPosition,
	float4 SvPosition, float2 ViewRectMin, float4 ViewSizeAndInvSize, float4x4 TranslatedWorldToView,
	float3 ViewForward, float3 LocalToWorldRow0, float MaterialTextureMipBias, float GameTime,
	float3 KuroViewLightColorA, float KuroAmbientBlend, float3 KuroAmbientA0, float3 KuroAmbientA1,
	float3 KuroAmbientA2, float3 KuroAmbientB0, float3 KuroAmbientB1, float3 KuroAmbientB2,
	float3 KuroGlassAmbientFar, float3 KuroGlassAmbientNear, float2 KuroGlassAmbientDistance, float EyeAdaptation,
	uint LightingChannelMask, FWuwaGlassLocalLightBuffer KuroLocalLights, float MaCapColortInt,
	float EnvironmentColorInt, float3 BaseColor, float E_Tex_UseTex, float4 E_Tex_UVSwitch,
	float E_Tex_UseScreenUV, float E_Tex_RotCos, float E_Tex_RotSin, float4 E_Tex_ScaleAndOffset,
	float2 E_Tex_Speed, float4 E_Tex_Color, float E_Dissolve_UseDissolve, float4 E_Dissolve_Channel,
	float E_Dissolve_Progress, float E_Dissolve_Smooth, float3 E_Dissolve_Emission, float E_Dissolve_Multi,
	float HLScale, float HLmoveSpeed, float HLpositionX, float HLpositionY, float HLOpacityInt, float4 HLColor,
	float4 SelectionColor, float MatCapOpacityInt, float ThickColorScale, float ThickColorWidth,
	float ThickColorInt, float ReflectScale, float ReflecOpacityInt, float OpacityScale, float EdgeColorScale,
	float EdgeColorWidth, float EdgeOpacityInt, float E_Dither_UseDither, float E_Dither_UseDither2,
	float E_Dither_DitherValue, float E_Dither_DitherValue2, out float3 ForwardLighting)
{
	return WuwaGlassCharGlass_Impl(true, true,
		MatCapTex, MatCapTexSampler, E_Tex_NoiseTex, E_Tex_NoiseTexSampler, HeightLightTex, HeightLightTexSampler, UV0,
		UV1, UV2, UV3, WorldTangent, WorldNormal, TangentSign, TwoSidedSign, NormalOverrideParameter, CameraVector,
		WorldPosition, SvPosition, ViewRectMin, ViewSizeAndInvSize, TranslatedWorldToView, ViewForward,
		LocalToWorldRow0, MaterialTextureMipBias, GameTime, KuroViewLightColorA, KuroAmbientBlend, KuroAmbientA0,
		KuroAmbientA1, KuroAmbientA2, KuroAmbientB0, KuroAmbientB1, KuroAmbientB2, KuroGlassAmbientFar,
		KuroGlassAmbientNear, KuroGlassAmbientDistance, EyeAdaptation, LightingChannelMask, KuroLocalLights,
		MaCapColortInt, EnvironmentColorInt, BaseColor, E_Tex_UseTex, E_Tex_UVSwitch, E_Tex_UseScreenUV, E_Tex_RotCos,
		E_Tex_RotSin, E_Tex_ScaleAndOffset, E_Tex_Speed, E_Tex_Color, E_Dissolve_UseDissolve, E_Dissolve_Channel,
		E_Dissolve_Progress, E_Dissolve_Smooth, E_Dissolve_Emission, E_Dissolve_Multi, HLScale, HLmoveSpeed,
		HLpositionX, HLpositionY, HLOpacityInt, HLColor, SelectionColor, MatCapOpacityInt, ThickColorScale,
		ThickColorWidth, ThickColorInt, ReflectScale, ReflecOpacityInt, OpacityScale, EdgeColorScale, EdgeColorWidth,
		EdgeOpacityInt, E_Dither_UseDither, E_Dither_UseDither2, E_Dither_DitherValue, E_Dither_DitherValue2,
		ForwardLighting);
}

// PS 474cc6dc0d (#215181): MI_R2T1YuanwuMd10011Glass; one-sided, no UseThickColor
FWuwaFXOutput WuwaGlassCharGlass_1S(
	Texture2D MatCapTex, SamplerState MatCapTexSampler, Texture2D E_Tex_NoiseTex,
	SamplerState E_Tex_NoiseTexSampler, Texture2D HeightLightTex, SamplerState HeightLightTexSampler, float2 UV0,
	float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign,
	float4 NormalOverrideParameter, float3 CameraVector, float3 WorldPosition, float4 SvPosition,
	float2 ViewRectMin, float4 ViewSizeAndInvSize, float4x4 TranslatedWorldToView, float3 ViewForward,
	float3 LocalToWorldRow0, float MaterialTextureMipBias, float GameTime, float3 KuroViewLightColorA,
	float KuroAmbientBlend, float3 KuroAmbientA0, float3 KuroAmbientA1, float3 KuroAmbientA2, float3 KuroAmbientB0,
	float3 KuroAmbientB1, float3 KuroAmbientB2, float3 KuroGlassAmbientFar, float3 KuroGlassAmbientNear,
	float2 KuroGlassAmbientDistance, float EyeAdaptation, uint LightingChannelMask,
	FWuwaGlassLocalLightBuffer KuroLocalLights, float MaCapColortInt, float EnvironmentColorInt, float3 BaseColor,
	float E_Tex_UseTex, float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_RotCos, float E_Tex_RotSin,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color, float E_Dissolve_UseDissolve,
	float4 E_Dissolve_Channel, float E_Dissolve_Progress, float E_Dissolve_Smooth, float3 E_Dissolve_Emission,
	float E_Dissolve_Multi, float HLScale, float HLmoveSpeed, float HLpositionX, float HLpositionY,
	float HLOpacityInt, float4 HLColor, float4 SelectionColor, float MatCapOpacityInt, float ReflectScale,
	float ReflecOpacityInt, float OpacityScale, float EdgeColorScale, float EdgeColorWidth, float EdgeOpacityInt,
	float E_Dither_UseDither, float E_Dither_UseDither2, float E_Dither_DitherValue, float E_Dither_DitherValue2,
	out float3 ForwardLighting)
{
	return WuwaGlassCharGlass_Impl(false, false,
		MatCapTex, MatCapTexSampler, E_Tex_NoiseTex, E_Tex_NoiseTexSampler, HeightLightTex, HeightLightTexSampler, UV0,
		UV1, UV2, UV3, WorldTangent, WorldNormal, TangentSign, 1.0, NormalOverrideParameter, CameraVector,
		WorldPosition, SvPosition, ViewRectMin, ViewSizeAndInvSize, TranslatedWorldToView, ViewForward,
		LocalToWorldRow0, MaterialTextureMipBias, GameTime, KuroViewLightColorA, KuroAmbientBlend, KuroAmbientA0,
		KuroAmbientA1, KuroAmbientA2, KuroAmbientB0, KuroAmbientB1, KuroAmbientB2, KuroGlassAmbientFar,
		KuroGlassAmbientNear, KuroGlassAmbientDistance, EyeAdaptation, LightingChannelMask, KuroLocalLights,
		MaCapColortInt, EnvironmentColorInt, BaseColor, E_Tex_UseTex, E_Tex_UVSwitch, E_Tex_UseScreenUV, E_Tex_RotCos,
		E_Tex_RotSin, E_Tex_ScaleAndOffset, E_Tex_Speed, E_Tex_Color, E_Dissolve_UseDissolve, E_Dissolve_Channel,
		E_Dissolve_Progress, E_Dissolve_Smooth, E_Dissolve_Emission, E_Dissolve_Multi, HLScale, HLmoveSpeed,
		HLpositionX, HLpositionY, HLOpacityInt, HLColor, SelectionColor, MatCapOpacityInt, 0.0, 0.0, 0.0, ReflectScale,
		ReflecOpacityInt, OpacityScale, EdgeColorScale, EdgeColorWidth, EdgeOpacityInt, E_Dither_UseDither,
		E_Dither_UseDither2, E_Dither_DitherValue, E_Dither_DitherValue2, ForwardLighting);
}

// =====================================================================================================================
// M_Char_Translucent PS: 61a5ff52d7 (#99688; UseAllRampColor) / d418fc628e (#136234; no UseAllRampColor) - Cantarella's
// jellyfish props (MI_EKanteleila*Md10011_*). Static switches UseRampColor, UseSkinAllRampColor, UseEffect (+ UseAllRampColor).
// The original is a UE4.26 lit forward translucent base pass (DefaultLit, "Surface TranslucencyVolume" lighting): the Kuro
// material graph (toon ramp lit by the Kuro character light direction View[296], hue shift, E_Tex / flow-edge dissolve,
// portal dissolve, rim with foot mask, screen wave, dithers) produces Emissive / Opacity / BaseColor / Metallic / Roughness /
// Normal; the engine then lights BaseColor/Metallic/Roughness/Normal with the stock UE translucency lighting (reflection
// captures of the forward grid, planar reflection, sky, EnvBRDFApprox, translucency lighting volume). That engine lighting is
// UE's own (UE 5.8 lights a lit translucent material itself), so it is reproduced only in the harness tail
// (tools/shaderdiff/weapons/hlsl/kuro_tail_glass.hlsli, KuroCharTranslucentTail), not ported.
// Line refs C### = evidence/roster/shadermaps/weapons/asm_hex/099688_61a5ff52d7....asm.txt.
// =====================================================================================================================
FWuwaFXOutput WuwaGlassCharTranslucent_Impl(const bool bAllRampColor,
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler, Texture2D MainTex, SamplerState MainTexSampler,
	Texture2D Ramp, SamplerState RampSampler, Texture2D E_Tex_NoiseTex, SamplerState E_Tex_NoiseTexSampler,
	float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent, float3 WorldNormal, float TangentSign, float TwoSidedSign,
	float4 NormalOverrideParameter, float3 CameraVector, float3 WorldPosition, float2 SvPositionXY, float2 ViewRectMin,
	float4 ViewSizeAndInvSize, float MaterialTextureMipBias, float GameTime, float3 KuroCharLightDirection,
	float MPC_GlobalCharSkyLightIntensity, float4x4 WorldToLocal, float3 PrimActorWorldPosition,
	// material parameters
	float NormalStrength, float3 BaseColorTint, float4 BaseColor_ColorAdjust, float3 SubsurfaceColor, float ShadowProcess,
	float ShadowWidth, float RampPosition, float RampInt, float ToonColorIntensity,
	float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_UseTex, float E_Tex_RotCos, float E_Tex_RotSin,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color,
	float E_FlowEffectEdgeColorSharp, float3 E_Dissolve_Emission, float3 E_Dissolve_EmissionDark, float E_FlowEffectEdgeSwitch,
	float E_Dissolve_Multi, float E_Dissolve_UseDissolve, float E_FlowEffectEdge_Strength, float E_FlowEffectEdgerRevert,
	float4 E_Dissolve_Channel, float E_UV3Dissolve_Reverse, float E_UV3Dissolve_Position, float E_UV3Dissolve_End,
	float UseShadowLordMaterialDynamic, float E_Dissolve_Progress, float E_Dissolve_Smooth,
	float UseLocalSpace, float UseActorSpace, float3 PortalCenter, float3 PortalAxisN, float PortalEmissionEdageWith, float UsePortalDissolve,
	float E_Rim_UseRim, float4 E_Rim_Channel, float E_Rim_UseTex, float E_Rim_FootMaskBias, float E_Rim_FootMaskRange,
	float E_Rim_FootMaskLRCenter, float E_Rim_FootMaskLRSwitch, float E_Rim_UseFootMask, float E_Rim_RimRange, float3 E_Rim_RimColor,
	float E_Rim_Intensity, float E_Tex_UseMask, float E_Tex_MaskRange, float E_Tex_UseSecondNoiseMask, float4 SelectionColor,
	float MetallicIntensity, float RoughnessIntensity, float OpacityIntensityPower, float OpacityIntensity, float UseDitherDissolve,
	float E_Dither_UseDither, float E_Dither_UseDither2, float E_Dither_DitherValue, float E_Dither_DitherValue2,
	out float3 OutBaseColor, out float OutMetallic, out float OutRoughness, out float3 OutNormal)
{
	FWuwaFXOutput X;
	// ---- C69-104: bitangent, normal map (lerp to (0,0,1) by NormalStrength) x two-sided sign, shading normal ------------
	float3 Bt = cross(WorldNormal, WorldTangent) * TangentSign;
	float3 V = CameraVector;
	float4 nrm = Normal_Roughness_Metallic.SampleBias(Normal_Roughness_MetallicSampler, UV0, MaterialTextureMipBias);
	float2 q = nrm.xy * 2.0 - 1.0;
	float3 nv = float3(nrm.xy + nrm.xy, sqrt(1.0 - dot(q, q))) - 1.0;
	float3 nts = NormalStrength * nv + float3(0.0, 0.0, 1.0);
	OutNormal = TwoSidedSign * nts;
	float3 no = OutNormal * NormalOverrideParameter.w + NormalOverrideParameter.xyz;
	no = no * rsqrt(dot(no, no));
	float3 N = Bt * no.y;
	N = no.x * WorldTangent + N;
	N = no.z * WorldNormal + N;
	N = N * rsqrt(dot(N, N));
	N = TwoSidedSign * N;

	// ---- C105-127: MainTex x tint, hue shift (UE RotateAboutAxis about (1,1,1)/sqrt3), desaturation, contrast pow -------
	float4 mt = MainTex.SampleBias(MainTexSampler, UV0, MaterialTextureMipBias);
	float3 P = mt.xyz * BaseColorTint;
	const float ka = asfloat(0x3f13cd3au);
	float3 axis = float3(ka, ka, ka);
	float3 closest = axis * dot(axis, P);
	float3 U = P - closest;
	float3 Vax = cross(axis, U);
	float sa, ca;
	sincos(saturate(BaseColor_ColorAdjust.x) * asfloat(0x40c90fdbu), sa, ca);
	float3 R = U * ca + Vax * sa;
	float3 c = (closest + R - P) + P;
	float lum = dot(c, float3(asfloat(0x3e99999au), asfloat(0x3f170a3du), asfloat(0x3de147aeu)));
	c = (1.0 - BaseColor_ColorAdjust.y) * (lum - c) + c;
	c = c * min(max(BaseColor_ColorAdjust.z, 0.0), BaseColor_ColorAdjust.z);
	c = c * (BaseColor_ColorAdjust.w * BaseColor_ColorAdjust.w);
	c = float3(WuwaWPowGuard(c.x, BaseColor_ColorAdjust.w), WuwaWPowGuard(c.y, BaseColor_ColorAdjust.w), WuwaWPowGuard(c.z, BaseColor_ColorAdjust.w));
	OutBaseColor = c;

	// ---- C128-154: toon ramp (Kuro character light View[296]), shadow colour, all-ramp lit colour ------------------------
	float3 sh = c * SubsurfaceColor;
	float3 L = KuroCharLightDirection / sqrt(dot(KuroCharLightDirection, KuroCharLightDirection));
	float ndl = dot(N, L);
	float hl = ndl * 0.5 + 0.5;
	float3 rp = Ramp.SampleBias(RampSampler, float2(saturate(ndl * 0.5 + 1.0 - ShadowProcess), RampPosition), MaterialTextureMipBias).xyz;
	float rw = ((MPC_GlobalCharSkyLightIntensity >= asfloat(0x3d4ccccdu)) ? 1.0 : 0.0) * RampInt;
	float3 toon = rw * (rp - sh * 0.5) + sh * 0.5;
	float3 lit;
	if (bAllRampColor)
		lit = (rw * (rp - c) + (c + c)) * 0.5;
	else
		lit = c;
	toon = lerp(toon, lit, asfloat(0x3ecccccdu));
	float lo = ShadowProcess - ShadowWidth;
	float sm = saturate((hl - lo) * (1.0 / ((ShadowProcess + ShadowWidth) - lo)));
	sm = (sm * sm) * (sm * -2.0 + 3.0);
	toon = sm * (lit - toon) + toon;

	// ---- C155-175: E_Tex layer ----------------------------------------------------------------------------------------
	float2 ScreenPix = SvPositionXY - ViewRectMin;
	float2 suv = WuwaGlassUV4(E_Tex_UVSwitch, float4(UV0.x, UV1.x, UV2.x, UV3.x), float4(UV0.y, UV1.y, UV2.y, UV3.y),
		E_Tex_UseScreenUV, ScreenPix, ViewSizeAndInvSize.zw);
	float4 et;
	[branch] if (asfloat(0x3dcccccdu) < E_Tex_UseTex)
	{
		float2 d = suv - 0.5;
		float2 uv = float2(dot(d, float2(E_Tex_RotCos, -E_Tex_RotSin)), dot(d, float2(E_Tex_RotSin, E_Tex_RotCos))) + 0.5;
		uv = uv * E_Tex_ScaleAndOffset.xy + E_Tex_ScaleAndOffset.zw;
		uv = GameTime * E_Tex_Speed + uv;
		et = E_Tex_NoiseTex.Sample(E_Tex_NoiseTexSampler, uv) * E_Tex_Color;
	}
	else
	{
		et = E_Tex_Color;
	}

	// ---- C176-222: flow-edge emission colour, UV3 / channel dissolve -------------------------------------------------------
	float fp = exp2(log2(et.x) * E_FlowEffectEdgeColorSharp);
	float3 fe = fp * (E_Dissolve_Emission - E_Dissolve_EmissionDark);
	if (asfloat(0x33000002u) >= et.x)
		fe = float3(0.0, 0.0, 0.0);
	fe = E_FlowEffectEdgeSwitch * (fe + E_Dissolve_EmissionDark - E_Dissolve_Emission) + E_Dissolve_Emission;
	fe = fe * (E_Dissolve_Multi * asfloat(0x3c23d70au));
	float3 dEmis = float3(0.0, 0.0, 0.0);
	float dAlpha = 1.0;
	[branch] if (asfloat(0x3dcccccdu) < E_Dissolve_UseDissolve)
	{
		float v3 = 1.0 - UV3.y;
		float4 fl = float4(et.xyz * (E_FlowEffectEdge_Strength * asfloat(0x3dcccccdu)), E_FlowEffectEdgerRevert * (v3 - UV3.y) + UV3.y);
		fl = E_FlowEffectEdgeSwitch * (fl - et) + et;
		float dm = dot(E_Dissolve_Channel, fl);
		float um = E_UV3Dissolve_Reverse * (UV3.y - v3) + v3;
		float us = saturate((um - E_UV3Dissolve_Position) * (1.0 / (E_UV3Dissolve_End - E_UV3Dissolve_Position)));
		us = min((us * us) * (us * -2.0 + 3.0), 1.0);
		us = saturate(us * (dm - 1.0) + 1.0);
		dm = UseShadowLordMaterialDynamic * (us - dm) + dm;
		float p = E_Dissolve_Progress * asfloat(0xbf8cccccu) + asfloat(0x3f866666u);
		p = p * (-E_Dissolve_Smooth + -1.0) + E_Dissolve_Smooth;
		float x = dm * E_Dissolve_Smooth - p;
		dAlpha = saturate(x);
		dEmis = fe * (1.0 - min(abs(x - 1.0), 1.0));
	}

	// ---- C223-243: portal dissolve (world / local / actor space side of a plane) --------------------------------------------
	float3 pw = WorldPosition.y * WorldToLocal[1].xyz;
	pw = WorldPosition.x * WorldToLocal[0].xyz + pw;
	pw = WorldPosition.z * WorldToLocal[2].xyz + pw;
	pw = pw + WorldToLocal[3].xyz;
	pw = UseLocalSpace * (pw - WorldPosition) + WorldPosition;
	pw = UseActorSpace * ((WorldPosition - PrimActorWorldPosition) - pw) + pw;
	pw = pw - PortalCenter;
	pw = pw / sqrt(dot(pw, pw));
	float pd = dot(PortalAxisN, pw);
	float pBack = (0.0 >= pd) ? 1.0 : 0.0;
	float pEdge = ((pd >= -PortalEmissionEdageWith) ? 1.0 : 0.0) * pBack;
	float3 em = UsePortalDissolve * (pEdge * fe) + dEmis;

	// ---- C244-273: rim (raw tangent-space normal through TBN), channel / foot mask --------------------------------------------
	float3 rim;
	[branch] if (asfloat(0x3dcccccdu) < E_Rim_UseRim)
	{
		float3 rn = Bt * nts.y;
		rn = nts.x * WorldTangent + rn;
		rn = nts.z * WorldNormal + rn;
		float rv = dot(rn, V);
		float3 rm;
		if (E_Rim_Channel.x >= 0.0)
		{
			float rc = dot(E_Rim_Channel, et);
			rm = float3(rc, rc, rc);
		}
		else
		{
			rm = et.xyz;
		}
		rm = E_Rim_UseTex * (rm - 1.0) + 1.0;
		float2 fm = (float2(UV3.y, UV3.x) + float2(E_Rim_FootMaskBias, E_Rim_FootMaskLRCenter)) * float2(E_Rim_FootMaskRange, E_Rim_FootMaskLRSwitch);
		float foot = saturate(fm.x) * ((0.0 >= fm.y) ? 1.0 : 0.0);
		rm = E_Rim_UseFootMask * (foot - rm) + rm;
		float rr = exp2(log2(max(1.0 - abs(rv), asfloat(0x3a83126fu))) * E_Rim_RimRange);
		rim = rm * (rr * E_Rim_RimColor);
		rim = rim * E_Rim_Intensity;
	}
	else
	{
		rim = float3(0.0, 0.0, 0.0);
	}
	em = rim + em;

	// ---- C274-300: E_Tex mask, screen wave, toon colour, selection colour -------------------------------------------------
	float m;
	[branch] if (asfloat(0x3dcccccdu) < E_Tex_UseMask)
	{
		m = exp2(log2(E_Tex_NoiseTex.Sample(E_Tex_NoiseTexSampler, suv).w) * E_Tex_MaskRange);
	}
	else
	{
		m = 1.0;
	}
	float2 sv = 1.0 - ScreenPix * ViewSizeAndInvSize.zw;
	float w1 = sv.x * 2.0 + asfloat(0xbd4ccccdu);
	w1 = -GameTime * asfloat(0x3e99999au) + w1;
	w1 = ScreenPix.y * ViewSizeAndInvSize.w + w1;
	float w2 = -GameTime * asfloat(0x3e99999au) + (sv.y + sv.y);
	float wv = sin(w1 * asfloat(0x40c90fdbu)) * sin(w2 * asfloat(0x40490fdbu));
	wv = abs(wv) * sv.y - 1.0;
	m = m * (E_Tex_UseSecondNoiseMask * wv + 1.0);
	em = em * m;
	em = toon * ToonColorIntensity + em;
	X.Emissive = SelectionColor.w * (SelectionColor.xyz - em) + em;

	// ---- C301-337: metallic / roughness, opacity (MainTex.a pow, portal / noise / 3x3 dither) -------------------------------
	float2 mr = saturate(nrm.zw * float2(MetallicIntensity, RoughnessIntensity));
	OutMetallic = mr.x;
	OutRoughness = mr.y;
	float ma = saturate(mt.w);
	float oa = saturate(exp2(log2(ma) * OpacityIntensityPower) * OpacityIntensity);
	float da = UsePortalDissolve * (min(dAlpha, pBack) - dAlpha) + dAlpha;
	float2 nz = GameTime * float2(asfloat(0x40b2d2d8u), asfloat(0x40490fd0u)) + ScreenPix;
	float ign = frac(frac(dot(nz, float2(asfloat(0x3d897143u), asfloat(0x3bbf4590u)))) * asfloat(0x4253ee82u));
	da = UseDitherDissolve * (((da >= ign) ? 1.0 : 0.0) - da) + da;
	float op = m * (da - 1.0) + 1.0;
	float dv;
	[branch] if (asfloat(0x3e99999au) < max(E_Dither_UseDither, E_Dither_UseDither2))
	{
		int2 ip = (int2)ScreenPix;                     // signed (C) remainder of the pixel coordinate by 3
		uint2 um = ((uint2)max(ip, -ip)) % 3u;
		int2 im = (int2)um;
		im.x = (ip.x < 0) ? -im.x : im.x;
		im.y = (ip.y < 0) ? -im.y : im.y;
		int k = max(im.x * 3 + im.y, 0);
		dv = saturate(min(E_Dither_DitherValue2, E_Dither_DitherValue) * 2.0 - WuwaGlassDither3x3[k]) * 255.0;
	}
	else
	{
		dv = 1.0;
	}
	op = saturate(min(op, dv)) * oa;
	X.Opacity = (asfloat(0x33000002u) >= ma) ? 0.0 : op;
	return X;
}

// Entries (M_Char_Translucent)
// PS 61a5ff52d7 (#99688): 7 MIs MI_EKanteleilaShuimuxiao/Shuimuda/SanshuimuMd10011_*; UseAllRampColor
FWuwaFXOutput WuwaGlassCharTranslucent_AllRamp(
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler, Texture2D MainTex,
	SamplerState MainTexSampler, Texture2D Ramp, SamplerState RampSampler, Texture2D E_Tex_NoiseTex,
	SamplerState E_Tex_NoiseTexSampler, float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent,
	float3 WorldNormal, float TangentSign, float TwoSidedSign, float4 NormalOverrideParameter, float3 CameraVector,
	float3 WorldPosition, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float MaterialTextureMipBias, float GameTime, float3 KuroCharLightDirection,
	float MPC_GlobalCharSkyLightIntensity, float4x4 WorldToLocal, float3 PrimActorWorldPosition,
	float NormalStrength, float3 BaseColorTint, float4 BaseColor_ColorAdjust, float3 SubsurfaceColor,
	float ShadowProcess, float ShadowWidth, float RampPosition, float RampInt, float ToonColorIntensity,
	float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_UseTex, float E_Tex_RotCos, float E_Tex_RotSin,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color, float E_FlowEffectEdgeColorSharp,
	float3 E_Dissolve_Emission, float3 E_Dissolve_EmissionDark, float E_FlowEffectEdgeSwitch, float E_Dissolve_Multi,
	float E_Dissolve_UseDissolve, float E_FlowEffectEdge_Strength, float E_FlowEffectEdgerRevert,
	float4 E_Dissolve_Channel, float E_UV3Dissolve_Reverse, float E_UV3Dissolve_Position, float E_UV3Dissolve_End,
	float UseShadowLordMaterialDynamic, float E_Dissolve_Progress, float E_Dissolve_Smooth, float UseLocalSpace,
	float UseActorSpace, float3 PortalCenter, float3 PortalAxisN, float PortalEmissionEdageWith,
	float UsePortalDissolve, float E_Rim_UseRim, float4 E_Rim_Channel, float E_Rim_UseTex, float E_Rim_FootMaskBias,
	float E_Rim_FootMaskRange, float E_Rim_FootMaskLRCenter, float E_Rim_FootMaskLRSwitch, float E_Rim_UseFootMask,
	float E_Rim_RimRange, float3 E_Rim_RimColor, float E_Rim_Intensity, float E_Tex_UseMask, float E_Tex_MaskRange,
	float E_Tex_UseSecondNoiseMask, float4 SelectionColor, float MetallicIntensity, float RoughnessIntensity,
	float OpacityIntensityPower, float OpacityIntensity, float UseDitherDissolve, float E_Dither_UseDither,
	float E_Dither_UseDither2, float E_Dither_DitherValue, float E_Dither_DitherValue2, out float3 OutBaseColor,
	out float OutMetallic, out float OutRoughness, out float3 OutNormal)
{
	return WuwaGlassCharTranslucent_Impl(true,
		Normal_Roughness_Metallic, Normal_Roughness_MetallicSampler, MainTex, MainTexSampler, Ramp, RampSampler,
		E_Tex_NoiseTex, E_Tex_NoiseTexSampler, UV0, UV1, UV2, UV3, WorldTangent, WorldNormal, TangentSign, TwoSidedSign,
		NormalOverrideParameter, CameraVector, WorldPosition, SvPositionXY, ViewRectMin, ViewSizeAndInvSize,
		MaterialTextureMipBias, GameTime, KuroCharLightDirection, MPC_GlobalCharSkyLightIntensity, WorldToLocal,
		PrimActorWorldPosition, NormalStrength, BaseColorTint, BaseColor_ColorAdjust, SubsurfaceColor, ShadowProcess,
		ShadowWidth, RampPosition, RampInt, ToonColorIntensity, E_Tex_UVSwitch, E_Tex_UseScreenUV, E_Tex_UseTex,
		E_Tex_RotCos, E_Tex_RotSin, E_Tex_ScaleAndOffset, E_Tex_Speed, E_Tex_Color, E_FlowEffectEdgeColorSharp,
		E_Dissolve_Emission, E_Dissolve_EmissionDark, E_FlowEffectEdgeSwitch, E_Dissolve_Multi, E_Dissolve_UseDissolve,
		E_FlowEffectEdge_Strength, E_FlowEffectEdgerRevert, E_Dissolve_Channel, E_UV3Dissolve_Reverse,
		E_UV3Dissolve_Position, E_UV3Dissolve_End, UseShadowLordMaterialDynamic, E_Dissolve_Progress,
		E_Dissolve_Smooth, UseLocalSpace, UseActorSpace, PortalCenter, PortalAxisN, PortalEmissionEdageWith,
		UsePortalDissolve, E_Rim_UseRim, E_Rim_Channel, E_Rim_UseTex, E_Rim_FootMaskBias, E_Rim_FootMaskRange,
		E_Rim_FootMaskLRCenter, E_Rim_FootMaskLRSwitch, E_Rim_UseFootMask, E_Rim_RimRange, E_Rim_RimColor,
		E_Rim_Intensity, E_Tex_UseMask, E_Tex_MaskRange, E_Tex_UseSecondNoiseMask, SelectionColor, MetallicIntensity,
		RoughnessIntensity, OpacityIntensityPower, OpacityIntensity, UseDitherDissolve, E_Dither_UseDither,
		E_Dither_UseDither2, E_Dither_DitherValue, E_Dither_DitherValue2, OutBaseColor, OutMetallic, OutRoughness,
		OutNormal);
}

// PS d418fc628e (#136234): MI_EKanteleilaSanshuimuMd10011_Xu; no UseAllRampColor
FWuwaFXOutput WuwaGlassCharTranslucent(
	Texture2D Normal_Roughness_Metallic, SamplerState Normal_Roughness_MetallicSampler, Texture2D MainTex,
	SamplerState MainTexSampler, Texture2D Ramp, SamplerState RampSampler, Texture2D E_Tex_NoiseTex,
	SamplerState E_Tex_NoiseTexSampler, float2 UV0, float2 UV1, float2 UV2, float2 UV3, float3 WorldTangent,
	float3 WorldNormal, float TangentSign, float TwoSidedSign, float4 NormalOverrideParameter, float3 CameraVector,
	float3 WorldPosition, float2 SvPositionXY, float2 ViewRectMin, float4 ViewSizeAndInvSize,
	float MaterialTextureMipBias, float GameTime, float3 KuroCharLightDirection,
	float MPC_GlobalCharSkyLightIntensity, float4x4 WorldToLocal, float3 PrimActorWorldPosition,
	float NormalStrength, float3 BaseColorTint, float4 BaseColor_ColorAdjust, float3 SubsurfaceColor,
	float ShadowProcess, float ShadowWidth, float RampPosition, float RampInt, float ToonColorIntensity,
	float4 E_Tex_UVSwitch, float E_Tex_UseScreenUV, float E_Tex_UseTex, float E_Tex_RotCos, float E_Tex_RotSin,
	float4 E_Tex_ScaleAndOffset, float2 E_Tex_Speed, float4 E_Tex_Color, float E_FlowEffectEdgeColorSharp,
	float3 E_Dissolve_Emission, float3 E_Dissolve_EmissionDark, float E_FlowEffectEdgeSwitch, float E_Dissolve_Multi,
	float E_Dissolve_UseDissolve, float E_FlowEffectEdge_Strength, float E_FlowEffectEdgerRevert,
	float4 E_Dissolve_Channel, float E_UV3Dissolve_Reverse, float E_UV3Dissolve_Position, float E_UV3Dissolve_End,
	float UseShadowLordMaterialDynamic, float E_Dissolve_Progress, float E_Dissolve_Smooth, float UseLocalSpace,
	float UseActorSpace, float3 PortalCenter, float3 PortalAxisN, float PortalEmissionEdageWith,
	float UsePortalDissolve, float E_Rim_UseRim, float4 E_Rim_Channel, float E_Rim_UseTex, float E_Rim_FootMaskBias,
	float E_Rim_FootMaskRange, float E_Rim_FootMaskLRCenter, float E_Rim_FootMaskLRSwitch, float E_Rim_UseFootMask,
	float E_Rim_RimRange, float3 E_Rim_RimColor, float E_Rim_Intensity, float E_Tex_UseMask, float E_Tex_MaskRange,
	float E_Tex_UseSecondNoiseMask, float4 SelectionColor, float MetallicIntensity, float RoughnessIntensity,
	float OpacityIntensityPower, float OpacityIntensity, float UseDitherDissolve, float E_Dither_UseDither,
	float E_Dither_UseDither2, float E_Dither_DitherValue, float E_Dither_DitherValue2, out float3 OutBaseColor,
	out float OutMetallic, out float OutRoughness, out float3 OutNormal)
{
	return WuwaGlassCharTranslucent_Impl(false,
		Normal_Roughness_Metallic, Normal_Roughness_MetallicSampler, MainTex, MainTexSampler, Ramp, RampSampler,
		E_Tex_NoiseTex, E_Tex_NoiseTexSampler, UV0, UV1, UV2, UV3, WorldTangent, WorldNormal, TangentSign, TwoSidedSign,
		NormalOverrideParameter, CameraVector, WorldPosition, SvPositionXY, ViewRectMin, ViewSizeAndInvSize,
		MaterialTextureMipBias, GameTime, KuroCharLightDirection, MPC_GlobalCharSkyLightIntensity, WorldToLocal,
		PrimActorWorldPosition, NormalStrength, BaseColorTint, BaseColor_ColorAdjust, SubsurfaceColor, ShadowProcess,
		ShadowWidth, RampPosition, RampInt, ToonColorIntensity, E_Tex_UVSwitch, E_Tex_UseScreenUV, E_Tex_UseTex,
		E_Tex_RotCos, E_Tex_RotSin, E_Tex_ScaleAndOffset, E_Tex_Speed, E_Tex_Color, E_FlowEffectEdgeColorSharp,
